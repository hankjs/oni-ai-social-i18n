      "description": "",
      "arguments": [],
      "richText": false
    },
    {
      "key": "STRINGS.SOCIAL.EFFECTS.GRIEF.DESC",
      "seq": 633,
      "source": "失去了心上人，士气下降。",
      "description": "",
      "arguments": [],
      "richText": false
    },
    {
      "key": "STRINGS.SOCIAL.EFFECTS.GRIEF_SOFT.NAME",
      "seq": 634,
      "source": "丧偶悲伤（有人陪着）",
      "description": "",
      "arguments": [],
      "richText": false
    },
    {
      "key": "STRINGS.SOCIAL.EFFECTS.GRIEF_SOFT.DESC",
      "seq": 635,
      "source": "失去了心上人，但殖民地的陪伴减轻了痛苦。",
      "description": "",
      "arguments": [],
      "richText": false
    },
    {
      "key": "STRINGS.SOCIAL.EFFECTS.COLONY_COHESION.NAME",
