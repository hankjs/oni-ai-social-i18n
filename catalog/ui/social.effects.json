      "arguments": [],
      "richText": false
    },
    {
      "key": "STRINGS.SOCIAL.EFFECTS.COLONY_DISCORD.DESC",
      "seq": 639,
      "source": "殖民地关系紧张，全员士气下降。",
      "description": "",
      "arguments": [],
      "richText": false
    },
    {
      "key": "STRINGS.SOCIAL.EFFECTS.SIDE_BY_SIDE.NAME",
      "seq": 640,
