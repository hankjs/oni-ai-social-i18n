      "description": "",
      "arguments": [],
      "richText": false
    },
    {
      "key": "STRINGS.SOCIAL.EFFECTS.COLONY_COHESION.DESC",
      "seq": 637,
      "source": "殖民地上下一条心，全员士气提升。",
      "description": "",
      "arguments": [],
      "richText": false
    },
    {
      "key": "STRINGS.SOCIAL.EFFECTS.COLONY_DISCORD.NAME",
