{"schemaVersion":2,"requestedLocale":"en","fallbackChain":["en","zh"],"entries":[{"promptId":"prompt.conversation.affect","text":"Current affect: [[nameA]]=[[emotionA]]; [[nameB]]=[[emotionB]].","resolvedLocale":"en","requiredSlots":["emotionA","emotionB","nameA","nameB"],"contractRevision":1},{"promptId":"prompt.conversation.draft","text":"Matched authored draft: [[draft]]","resolvedLocale":"en","requiredSlots":["draft"],"contractRevision":1},{"promptId":"prompt.conversation.instruction","text":"Polish the draft without changing the event, either speaker's affect, or the speaker order.","resolvedLocale":"en","requiredSlots":[],"contractRevision":1},{"promptId":"prompt.conversation.no-traits","text":"no notable traits","resolvedLocale":"en","requiredSlots":[],"contractRevision":1},{"promptId":"prompt.conversation.participant-a","text":"A: [[profile]]","resolvedLocale":"en","requiredSlots":["profile"],"contractRevision":1},{"promptId":"prompt.conversation.participant-b","text":"B: [[profile]]","resolvedLocale":"en","requiredSlots":["profile"],"contractRevision":1},{"promptId":"prompt.conversation.profile","text":"[[name]] (traits: [[traits]]; stress: [[stress]])","resolvedLocale":"en","requiredSlots":["name","stress","traits"],"contractRevision":1},{"promptId":"prompt.conversation.relationship","text":"Relationship: [[stage]], affinity [[affinity]].","resolvedLocale":"en","requiredSlots":["affinity","stage"],"contractRevision":1},{"promptId":"prompt.conversation.scene","text":"Resolved game event: [[storylet]]; cause: [[cause]].","resolvedLocale":"en","requiredSlots":["cause","storylet"],"contractRevision":1},{"promptId":"prompt.conversation.stress-hint","text":"Stress \"breaking\" means on the verge of an emotional breakdown: let the strain show in that duplicant's lines (short temper, weary, barely holding on).","resolvedLocale":"en","requiredSlots":[],"contractRevision":1},{"promptId":"prompt.conversation.system","text":"You are polishing dialogue between duplicants in the survival sim Oxygen Not Included. The game engine has already resolved the event, relationship outcome, each speaker's affect, and speaker order; do not change those facts. Duplicants are 3D-printed little people mining and building a colony in space. Match the game's tone: dark humor, grumbling about work, and caring for each other. Keep each line under 25 words. Output ONLY JSON, nothing else. Format:\n{\"turns\":[{\"speaker\":\"name\",\"text\":\"line\"},...2 to 4 entries]}.","resolvedLocale":"en","requiredSlots":[],"contractRevision":1},{"promptId":"prompt.narrative.cause","text":"Cause: [[value]]","resolvedLocale":"en","requiredSlots":["value"],"contractRevision":1},{"promptId":"prompt.narrative.colony","text":"Colony: [[value]]","resolvedLocale":"en","requiredSlots":["value"],"contractRevision":1},{"promptId":"prompt.narrative.colony-both","text":"famine ongoing, collective wrath ongoing","resolvedLocale":"en","requiredSlots":[],"contractRevision":1},{"promptId":"prompt.narrative.colony-famine","text":"famine ongoing","resolvedLocale":"en","requiredSlots":[],"contractRevision":1},{"promptId":"prompt.narrative.colony-wrath","text":"collective wrath ongoing","resolvedLocale":"en","requiredSlots":[],"contractRevision":1},{"promptId":"prompt.narrative.current-state","text":"Current relationship: [[value]]","resolvedLocale":"en","requiredSlots":["value"],"contractRevision":1},{"promptId":"prompt.narrative.event","text":"Event: [[value]]","resolvedLocale":"en","requiredSlots":["value"],"contractRevision":1},{"promptId":"prompt.narrative.history-heading","text":"Their recent history:","resolvedLocale":"en","requiredSlots":[],"contractRevision":1},{"promptId":"prompt.narrative.history-line","text":"Cycle [[cycle]] · [[event]]","resolvedLocale":"en","requiredSlots":["cycle","event"],"contractRevision":1},{"promptId":"prompt.narrative.instruction","text":"Rewrite it as one chronicle sentence.","resolvedLocale":"en","requiredSlots":[],"contractRevision":1},{"promptId":"prompt.narrative.new-state","text":"New relationship: [[value]]","resolvedLocale":"en","requiredSlots":["value"],"contractRevision":1},{"promptId":"prompt.narrative.person-a","text":"A: [[value]]","resolvedLocale":"en","requiredSlots":["value"],"contractRevision":1},{"promptId":"prompt.narrative.person-b","text":"B: [[value]]","resolvedLocale":"en","requiredSlots":["value"],"contractRevision":1},{"promptId":"prompt.narrative.place","text":"Place: [[value]]","resolvedLocale":"en","requiredSlots":["value"],"contractRevision":1},{"promptId":"prompt.narrative.system","text":"You are the chronicler of a space colony. Rewrite the given social event as a single sentence of at most 25 words: plain, restrained, with a sense of history. Never change names or facts; no quotes, no emoji, no numbers. Output only the sentence.","resolvedLocale":"en","requiredSlots":[],"contractRevision":1},{"promptId":"prompt.narrative.witnesses","text":"Witnesses: [[count]]","resolvedLocale":"en","requiredSlots":["count"],"contractRevision":1}]}
