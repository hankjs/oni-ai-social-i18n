msgstr "Mở rộng tầm mắt đi. Bắt đầu từ cái mặt ấy."

#. resolved-locale: vi
#. STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_15
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_15"
