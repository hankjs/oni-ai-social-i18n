msgstr "Cái miệng bạn còn bẩn hơn ống xả không lọc."

#. resolved-locale: vi
#. STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_3
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_3"
msgid "我从未见过有如此厚颜无耻之人！"
msgstr "Chưa từng thấy ai mặt dày đến thế."

#. resolved-locale: vi
#. STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_4
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_4"
msgid "回答我！LOOK IN MY EYES!"
msgstr "Nhìn mình đây. NHÌN ĐÂY!"

#. resolved-locale: vi
#. STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_5
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_5"
msgid "就这？就这？"
msgstr "Chỉ vậy thôi? Hết rồi à?"

#. resolved-locale: vi
#. STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_6
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_6"
msgid "你在教我做事啊？"
msgstr "Ồ, giờ bạn dạy mình làm việc cơ đấy?"

#. resolved-locale: vi
#. STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_7
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_7"
msgid "怎么不找找你自己的问题？"
msgstr "Có bao giờ nghĩ vấn đề nằm ở bạn không?"

#. resolved-locale: vi
#. STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_8
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_8"
msgid "半场开香槟？"
msgstr "Mới nửa chừng đã mở sâm banh à?"

#. resolved-locale: vi
#. STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_9
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_9"
msgid "你急了？你急了？"
msgstr "Ồ, có người cáu rồi đấy."

#. resolved-locale: vi
#. STRINGS.SOCIAL.SCENE.BREAKUP_KEY
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.BREAKUP_KEY"
msgid "我们还是到这里吧。"
msgstr "Mình dừng ở đây thôi."

#. resolved-locale: vi
#. STRINGS.SOCIAL.SCENE.BREAKUP_REPLY
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.BREAKUP_REPLY"
msgid "……我知道了。"
msgstr "……Mình biết rồi."

#. resolved-locale: vi
#. STRINGS.SOCIAL.SCENE.CHAT_KEY
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.CHAT_KEY"
msgid "嗨。"
msgstr "Chào."

#. resolved-locale: vi
#. STRINGS.SOCIAL.SCENE.CONFESSION_FAIL_REPLY
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.CONFESSION_FAIL_REPLY"
msgid "对不起，我不能答应。"
msgstr "Xin lỗi, mình không thể nhận."

#. resolved-locale: vi
#. STRINGS.SOCIAL.SCENE.CONFESSION_FAIL_RESULT
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.CONFESSION_FAIL_RESULT"
msgid "……我明白了。"
msgstr "……Mình hiểu rồi."

#. resolved-locale: vi
#. STRINGS.SOCIAL.SCENE.CONFESSION_INTRO
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.CONFESSION_INTRO"
msgid "我有件重要的事想告诉你。"
msgstr "Mình có chuyện quan trọng muốn nói với bạn."

#. resolved-locale: vi
#. STRINGS.SOCIAL.SCENE.CONFESSION_KEY
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.CONFESSION_KEY"
msgid "我喜欢你。"
msgstr "Mình thích bạn."

#. resolved-locale: vi
#. STRINGS.SOCIAL.SCENE.CONFESSION_REPLY
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.CONFESSION_REPLY"
msgid "我也一直喜欢你。"
msgstr "Mình cũng thích bạn từ lâu."

#. resolved-locale: vi
#. STRINGS.SOCIAL.SCENE.CONFESSION_RESULT
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.CONFESSION_RESULT"
msgid "那就一起走下去吧。"
msgstr "Vậy cùng đi tiếp nhé."

#. resolved-locale: vi
#. STRINGS.SOCIAL.SCENE.FAMINE_BUTCHER_1
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.FAMINE_BUTCHER_1"
msgid "对不起……对不起……"
msgstr "Xin lỗi... xin lỗi..."

#. resolved-locale: vi
#. STRINGS.SOCIAL.SCENE.FAMINE_BUTCHER_2
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.FAMINE_BUTCHER_2"
msgid "别看我。谁都别看我。"
msgstr "Đừng nhìn mình. Đừng ai nhìn cả."

#. resolved-locale: vi
#. STRINGS.SOCIAL.SCENE.FAMINE_BUTCHER_3
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.FAMINE_BUTCHER_3"
msgid "我们得活下去。就这样而已。"
msgstr "Chúng ta phải sống. Chỉ có vậy thôi."

#. resolved-locale: vi
#. STRINGS.SOCIAL.SCENE.FAMINE_BUTCHER_4
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.FAMINE_BUTCHER_4"
