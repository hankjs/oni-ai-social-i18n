msgstr "Ồ, có người cáu rồi đấy."

#. resolved-locale: vi
#. STRINGS.SOCIAL.SCENE.BREAKUP_KEY
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.BREAKUP_KEY"
