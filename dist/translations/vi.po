msgstr "Được. Được rồi! Bạn thắng."

#. resolved-locale: vi
#. STRINGS.SOCIAL.SCENE.BRAWL_SURRENDER_3
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.BRAWL_SURRENDER_3"
