msgstr "Mình có chuyện quan trọng muốn nói với bạn."

#. resolved-locale: vi
#. STRINGS.SOCIAL.SCENE.CONFESSION_KEY
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.CONFESSION_KEY"
msgid "我喜欢你。"
msgstr "Mình thích bạn."

#. resolved-locale: vi
#. STRINGS.SOCIAL.SCENE.CONFESSION_REPLY
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.CONFESSION_REPLY"
