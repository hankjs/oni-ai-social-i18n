msgstr "Xin lỗi, mình không thể nhận."

#. resolved-locale: vi
#. STRINGS.SOCIAL.SCENE.CONFESSION_FAIL_RESULT
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.CONFESSION_FAIL_RESULT"
msgid "……我明白了。"
msgstr "……Mình hiểu rồi."

#. resolved-locale: vi
