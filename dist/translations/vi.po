msgstr "Cái miệng bạn còn bẩn hơn ống xả không lọc."

#. resolved-locale: vi
#. STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_3
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_3"
msgid "你非得动手是吧？"
msgstr "Chưa từng thấy ai mặt dày đến thế."

#. resolved-locale: vi
#. STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_4
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_4"
msgid "看着我，把话说完！"
msgstr "Nhìn mình đây. NHÌN ĐÂY!"

#. resolved-locale: vi
#. STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_5
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_5"
msgid "还没完呢！"
msgstr "Chỉ vậy thôi? Hết rồi à?"

#. resolved-locale: vi
#. STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_6
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_6"
msgid "别冲我指手画脚！"
msgstr "Ồ, giờ bạn dạy mình làm việc cơ đấy?"

#. resolved-locale: vi
#. STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_7
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_7"
msgid "你就一点错都没有？"
msgstr "Có bao giờ nghĩ vấn đề nằm ở bạn không?"

#. resolved-locale: vi
#. STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_8
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_8"
msgid "先别得意！"
msgstr "Mới nửa chừng đã mở sâm banh à?"

#. resolved-locale: vi
#. STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_9
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_9"
