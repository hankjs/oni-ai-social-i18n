msgstr "Hóa ra thằng hề là mình, từ lúc tin bạn."

#. resolved-locale: vi
#. STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_16
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_16"
msgid "旧账也不是你想翻就翻！"
msgstr "Trước là trước, giờ là giờ."

#. resolved-locale: vi
