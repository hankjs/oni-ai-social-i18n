msgstr "Bọn trẻ bây giờ, chẳng còn tí đạo nghĩa nào."

#. resolved-locale: vi
#. STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_18
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_18"
msgid "退！退！退！"
msgstr "Lùi. Lùi. LÙI RA!"

#. resolved-locale: vi
#. STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_19
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_19"
msgid "我最讨厌事后道歉！"
msgstr "Khỏi xin lỗi. Mình ghét nhất kiểu xin lỗi sau."

#. resolved-locale: vi
#. STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_2
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_2"
msgid "菜就多练！"
msgstr "Kém thì tập thêm đi."

#. resolved-locale: vi
#. STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_20
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_20"
