"Language: vi\n"

#. resolved-locale: vi
#. STRINGS.SOCIAL.ANNOUNCE.ANNIVERSARY_BODY
msgctxt "ONIAiSocial.STRINGS.SOCIAL.ANNOUNCE.ANNIVERSARY_BODY"
msgid "{0} 和 {1} 的纪念日约会圆满结束，甜蜜加倍。"
msgstr "Buổi hẹn ngày kỷ niệm của {0} và {1} viên mãn, ngọt ngào nhân đôi."

#. resolved-locale: vi
#. STRINGS.SOCIAL.ANNOUNCE.ANNIVERSARY_MISSED_BODY
msgctxt "ONIAiSocial.STRINGS.SOCIAL.ANNOUNCE.ANNIVERSARY_MISSED_BODY"
msgid "{0} 和 {1} 的纪念日在忙碌中溜走了，两人都有点闷闷不乐。"
msgstr "Ngày kỷ niệm của {0} và {1} trôi mất trong bộn bề, cả hai hơi u uất."

#. resolved-locale: vi
#. STRINGS.SOCIAL.ANNOUNCE.ANNIVERSARY_MISSED_TITLE
msgctxt "ONIAiSocial.STRINGS.SOCIAL.ANNOUNCE.ANNIVERSARY_MISSED_TITLE"
msgid "错过的纪念日"
msgstr "Ngày kỷ niệm bị bỏ lỡ"

#. resolved-locale: vi
#. STRINGS.SOCIAL.ANNOUNCE.ANNIVERSARY_TITLE
msgctxt "ONIAiSocial.STRINGS.SOCIAL.ANNOUNCE.ANNIVERSARY_TITLE"
msgid "纪念日"
msgstr "Ngày kỷ niệm"

#. resolved-locale: vi
#. STRINGS.SOCIAL.ANNOUNCE.BESTFRIEND_BODY
msgctxt "ONIAiSocial.STRINGS.SOCIAL.ANNOUNCE.BESTFRIEND_BODY"
msgid "{0} 和 {1} 成为彼此的挚友。"
msgstr "{0} và {1} trở thành bạn thân của nhau."

#. resolved-locale: vi
#. STRINGS.SOCIAL.ANNOUNCE.BESTFRIEND_TITLE
msgctxt "ONIAiSocial.STRINGS.SOCIAL.ANNOUNCE.BESTFRIEND_TITLE"
msgid "挚友"
msgstr "Bạn thân"

#. resolved-locale: vi
#. STRINGS.SOCIAL.ANNOUNCE.BRAWL_BODY
msgctxt "ONIAiSocial.STRINGS.SOCIAL.ANNOUNCE.BRAWL_BODY"
msgid "{0} 和 {1} 从争吵升级成互殴。点到为止，但两人都要挂彩。"
msgstr "{0} và {1} từ cãi vã nâng thành đánh nhau. Dừng khi vừa đủ, nhưng cả hai đều mang thương."

#. resolved-locale: vi
#. STRINGS.SOCIAL.ANNOUNCE.BRAWL_BOND_BODY
msgctxt "ONIAiSocial.STRINGS.SOCIAL.ANNOUNCE.BRAWL_BOND_BODY"
msgid "{0} 和 {1} 打完这一架反而认了对方，宿怨就此了结。"
msgstr "{0} và {1} đánh xong trận này lại nhận nhau, oán cũ khép lại."

#. resolved-locale: vi
#. STRINGS.SOCIAL.ANNOUNCE.BRAWL_BOND_TITLE
msgctxt "ONIAiSocial.STRINGS.SOCIAL.ANNOUNCE.BRAWL_BOND_TITLE"
msgid "不打不相识"
msgstr "Đánh nhau mới thành bạn"

#. resolved-locale: vi
#. STRINGS.SOCIAL.ANNOUNCE.BRAWL_TITLE
msgctxt "ONIAiSocial.STRINGS.SOCIAL.ANNOUNCE.BRAWL_TITLE"
msgid "打起来了！"
msgstr "Đánh nhau rồi!"

#. resolved-locale: vi
#. STRINGS.SOCIAL.ANNOUNCE.BREAKDOWN_BODY
msgctxt "ONIAiSocial.STRINGS.SOCIAL.ANNOUNCE.BREAKDOWN_BODY"
msgid "{0} 当场{2}，{1} 个人停下来看着他。这几个周期里，有人愿意过去坐一下的话，他会记一辈子。"
msgstr "{0} {2} ngay tại chỗ, {1} người dừng lại nhìn. Vài chu kỳ tới, nếu có người chịu lại ngồi bên, họ sẽ nhớ cả đời."

#. resolved-locale: vi
#. STRINGS.SOCIAL.ANNOUNCE.BREAKDOWN_COMFORT_BODY
msgctxt "ONIAiSocial.STRINGS.SOCIAL.ANNOUNCE.BREAKDOWN_COMFORT_BODY"
msgid "{0} 过去陪 {1} 坐了一会儿。没说什么要紧的话——但 {1} 会一直记得是谁第一个过来。"
msgstr "{0} tới ngồi với {1} một lúc. Chẳng nói gì trọng đại — nhưng {1} sẽ nhớ mãi ai đến trước."

#. resolved-locale: vi
#. STRINGS.SOCIAL.ANNOUNCE.BREAKDOWN_COMFORT_TITLE
msgctxt "ONIAiSocial.STRINGS.SOCIAL.ANNOUNCE.BREAKDOWN_COMFORT_TITLE"
msgid "第一个坐下来的人"
msgstr "Người đầu tiên ngồi xuống"

#. resolved-locale: vi
#. STRINGS.SOCIAL.ANNOUNCE.BREAKDOWN_TITLE
msgctxt "ONIAiSocial.STRINGS.SOCIAL.ANNOUNCE.BREAKDOWN_TITLE"
msgid "整个房间都看着"
msgstr "Cả phòng đều nhìn"

#. resolved-locale: vi
#. STRINGS.SOCIAL.ANNOUNCE.BREAKUP_BODY
msgctxt "ONIAiSocial.STRINGS.SOCIAL.ANNOUNCE.BREAKUP_BODY"
msgid "{0} 和 {1} 的感情走到了尽头。"
msgstr "Tình cảm của {0} và {1} đã đi đến hồi kết."

#. resolved-locale: vi
#. STRINGS.SOCIAL.ANNOUNCE.BREAKUP_TITLE
msgctxt "ONIAiSocial.STRINGS.SOCIAL.ANNOUNCE.BREAKUP_TITLE"
msgid "分手了"
msgstr "Chia tay rồi"

#. resolved-locale: vi
#. STRINGS.SOCIAL.ANNOUNCE.COHESION_OFF_BODY
msgctxt "ONIAiSocial.STRINGS.SOCIAL.ANNOUNCE.COHESION_OFF_BODY"
msgid "殖民地的集体情绪回到了平常状态。"
msgstr "Tâm trạng tập thể của thuộc địa trở lại bình thường."

#. resolved-locale: vi
#. STRINGS.SOCIAL.ANNOUNCE.COHESION_OFF_TITLE
msgctxt "ONIAiSocial.STRINGS.SOCIAL.ANNOUNCE.COHESION_OFF_TITLE"
msgid "气氛回归平静"
msgstr "Không khí lắng lại"

#. resolved-locale: vi
#. STRINGS.SOCIAL.ANNOUNCE.COHESION_ON_BODY
msgctxt "ONIAiSocial.STRINGS.SOCIAL.ANNOUNCE.COHESION_ON_BODY"
msgid "殖民地人心凝聚，全员士气提升。"
msgstr "Lòng người thuộc địa quy tụ, sĩ khí cả nhóm tăng."

#. resolved-locale: vi
#. STRINGS.SOCIAL.ANNOUNCE.COHESION_ON_TITLE
msgctxt "ONIAiSocial.STRINGS.SOCIAL.ANNOUNCE.COHESION_ON_TITLE"
msgid "殖民地羁绊"
msgstr "Gắn kết thuộc địa"

#. resolved-locale: vi
#. STRINGS.SOCIAL.ANNOUNCE.COLDWAR_BODY
msgctxt "ONIAiSocial.STRINGS.SOCIAL.ANNOUNCE.COLDWAR_BODY"
msgid "{0} 和 {1} 进入冷战，关系岌岌可危。给他们一个牵线标记可以促成和解。"
msgstr "{0} và {1} bước vào chiến tranh lạnh, quan hệ mong manh. Gắn đánh dấu se duyên có thể thúc đẩy hòa giải."

#. resolved-locale: vi
#. STRINGS.SOCIAL.ANNOUNCE.COLDWAR_TITLE
msgctxt "ONIAiSocial.STRINGS.SOCIAL.ANNOUNCE.COLDWAR_TITLE"
msgid "冷战"
msgstr "Chiến tranh lạnh"

#. resolved-locale: vi
#. STRINGS.SOCIAL.ANNOUNCE.COMFORT_BODY
msgctxt "ONIAiSocial.STRINGS.SOCIAL.ANNOUNCE.COMFORT_BODY"
msgid "{0} 坐在 {1} 身边，默默陪伴着悲伤中的伙伴。"
msgstr "{0} ngồi bên {1}, lặng lẽ bầu bạn với người đang đau buồn."

#. resolved-locale: vi
#. STRINGS.SOCIAL.ANNOUNCE.COMFORT_TITLE
msgctxt "ONIAiSocial.STRINGS.SOCIAL.ANNOUNCE.COMFORT_TITLE"
msgid "低谷陪伴"
msgstr "Bên cạnh lúc sa sút"

#. resolved-locale: vi
#. STRINGS.SOCIAL.ANNOUNCE.CONFESSION_BODY
msgctxt "ONIAiSocial.STRINGS.SOCIAL.ANNOUNCE.CONFESSION_BODY"
msgid "{0} 向 {1} 告白成功，两人正式成为恋人！"
msgstr "{0} tỏ tình thành công với {1}, hai người chính thức thành người yêu!"

#. resolved-locale: vi
#. STRINGS.SOCIAL.ANNOUNCE.CONFESSION_FAIL_BODY
msgctxt "ONIAiSocial.STRINGS.SOCIAL.ANNOUNCE.CONFESSION_FAIL_BODY"
msgid "{0} 向 {1} 表明了心意，但没有得到回应。"
msgstr "{0} bày tỏ với {1}, nhưng không được đáp lại."

#. resolved-locale: vi
#. STRINGS.SOCIAL.ANNOUNCE.CONFESSION_FAIL_TITLE
msgctxt "ONIAiSocial.STRINGS.SOCIAL.ANNOUNCE.CONFESSION_FAIL_TITLE"
msgid "告白被拒"
msgstr "Tỏ tình bị từ chối"

#. resolved-locale: vi
#. STRINGS.SOCIAL.ANNOUNCE.CONFESSION_TITLE
msgctxt "ONIAiSocial.STRINGS.SOCIAL.ANNOUNCE.CONFESSION_TITLE"
msgid "喜结连理"
msgstr "Nên duyên"

#. resolved-locale: vi
#. STRINGS.SOCIAL.ANNOUNCE.DISCORD_ON_BODY
msgctxt "ONIAiSocial.STRINGS.SOCIAL.ANNOUNCE.DISCORD_ON_BODY"
msgid "殖民地气氛紧张，全员士气受挫。"
msgstr "Không khí thuộc địa căng thẳng, sĩ khí cả nhóm sụt."

#. resolved-locale: vi
#. STRINGS.SOCIAL.ANNOUNCE.DISCORD_ON_TITLE
msgctxt "ONIAiSocial.STRINGS.SOCIAL.ANNOUNCE.DISCORD_ON_TITLE"
msgid "殖民地不和"
msgstr "Bất hòa thuộc địa"

#. resolved-locale: vi
#. STRINGS.SOCIAL.ANNOUNCE.FALLOUT_BODY
msgctxt "ONIAiSocial.STRINGS.SOCIAL.ANNOUNCE.FALLOUT_BODY"
msgid "{0} 和 {1} 积怨爆发，正式闹掰——一段时间内感情难以升温，一次道歉就能和好清账。"
msgstr "{0} và {1} vỡ oán, chính thức cạch mặt — một thời gian tình cảm khó ấm lên, một lần xin lỗi là hòa và xóa sổ."

#. resolved-locale: vi
#. STRINGS.SOCIAL.ANNOUNCE.FALLOUT_TITLE
msgctxt "ONIAiSocial.STRINGS.SOCIAL.ANNOUNCE.FALLOUT_TITLE"
msgid "闹掰了"
msgstr "Cạch mặt"

#. resolved-locale: vi
#. STRINGS.SOCIAL.ANNOUNCE.FAMINE_AVERTED_BODY
msgctxt "ONIAiSocial.STRINGS.SOCIAL.ANNOUNCE.FAMINE_AVERTED_BODY"
msgid "食物及时送到，殖民地从边缘退了回来。没有人提起前几天在想什么。"
msgstr "Thức ăn tới kịp, thuộc địa lùi khỏi mép vực. Không ai nhắc mấy ngày trước từng nghĩ gì."

#. resolved-locale: vi
#. STRINGS.SOCIAL.ANNOUNCE.FAMINE_AVERTED_TITLE
msgctxt "ONIAiSocial.STRINGS.SOCIAL.ANNOUNCE.FAMINE_AVERTED_TITLE"
msgid "危机解除"
msgstr "Khủng hoảng qua rồi"

#. resolved-locale: vi
#. STRINGS.SOCIAL.ANNOUNCE.FAMINE_CULL_BODY
msgctxt "ONIAiSocial.STRINGS.SOCIAL.ANNOUNCE.FAMINE_CULL_BODY"
msgid "{0} 和 {1} 之间的事已经不是吵架了。饥饿把最后一点体面也拿走了。"
msgstr "Chuyện giữa {0} và {1} không còn là cãi nhau. Đói đã lấy nốt chút thể diện cuối."

#. resolved-locale: vi
#. STRINGS.SOCIAL.ANNOUNCE.FAMINE_CULL_TITLE
msgctxt "ONIAiSocial.STRINGS.SOCIAL.ANNOUNCE.FAMINE_CULL_TITLE"
msgid "活下去！"
msgstr "Sống sót!"

#. resolved-locale: vi
#. STRINGS.SOCIAL.ANNOUNCE.FAMINE_LAST_ONE_BODY
msgctxt "ONIAiSocial.STRINGS.SOCIAL.ANNOUNCE.FAMINE_LAST_ONE_BODY"
msgid "只剩一个人了。基地很安静，食物也够了。"
msgstr "Chỉ còn một người. Căn cứ im ắng, thức ăn cũng đủ."

#. resolved-locale: vi
#. STRINGS.SOCIAL.ANNOUNCE.FAMINE_LAST_ONE_TITLE
msgctxt "ONIAiSocial.STRINGS.SOCIAL.ANNOUNCE.FAMINE_LAST_ONE_TITLE"
msgid "最后的殖民者"
msgstr "Người thuộc địa cuối cùng"

#. resolved-locale: vi
#. STRINGS.SOCIAL.ANNOUNCE.FAMINE_OVER_BODY
msgctxt "ONIAiSocial.STRINGS.SOCIAL.ANNOUNCE.FAMINE_OVER_BODY"
msgid "储藏室重新有了食物。没有人问那是什么。"
msgstr "Kho lại có thức ăn. Không ai hỏi đó là gì."

#. resolved-locale: vi
#. STRINGS.SOCIAL.ANNOUNCE.FAMINE_OVER_TITLE
msgctxt "ONIAiSocial.STRINGS.SOCIAL.ANNOUNCE.FAMINE_OVER_TITLE"
msgid "饥荒过去了"
msgstr "Nạn đói đã qua"

#. resolved-locale: vi
#. STRINGS.SOCIAL.ANNOUNCE.FAMINE_WARNING_BODY
msgctxt "ONIAiSocial.STRINGS.SOCIAL.ANNOUNCE.FAMINE_WARNING_BODY"
msgid "储藏室空了，多人正在挨饿。再这样下去，他们会开始自己想办法——现在补上粮食还来得及。"
msgstr "Kho trống, nhiều người đang đói. Cứ thế họ sẽ tự lo lấy — giờ bổ sung lương vẫn còn kịp."

#. resolved-locale: vi
#. STRINGS.SOCIAL.ANNOUNCE.FAMINE_WARNING_TITLE
msgctxt "ONIAiSocial.STRINGS.SOCIAL.ANNOUNCE.FAMINE_WARNING_TITLE"
msgid "粮仓见底了"
msgstr "Kho lương cạn đáy"

#. resolved-locale: vi
#. STRINGS.SOCIAL.ANNOUNCE.INTRO_BODY
msgctxt "ONIAiSocial.STRINGS.SOCIAL.ANNOUNCE.INTRO_BODY"
msgid "复制人有了自己的社交生活：聊天、交友、恋爱、争执都会自然发生。顶部管理菜单的「社交」可以旁观全局并牵线搭桥；复制人详情的「社交」标签可以查看每个人的关系。"
msgstr "Người nhân bản có đời sống xã hội của riêng họ: trò chuyện, kết bạn, yêu đương, cãi vã đều xảy ra tự nhiên. Menu quản lý trên cùng mục «Xã hội» cho phép xem toàn cục và se duyên; thẻ «Xã hội» trong chi tiết người nhân bản xem quan hệ của từng người."

#. resolved-locale: vi
#. STRINGS.SOCIAL.ANNOUNCE.INTRO_TITLE
msgctxt "ONIAiSocial.STRINGS.SOCIAL.ANNOUNCE.INTRO_TITLE"
msgid "社交生活已开始"
msgstr "Đời sống xã hội đã bắt đầu"

#. resolved-locale: vi
#. STRINGS.SOCIAL.ANNOUNCE.LOVE_MATURE_BODY
msgctxt "ONIAiSocial.STRINGS.SOCIAL.ANNOUNCE.LOVE_MATURE_BODY"
msgid "{0} 和 {1} 相伴日久，感情进入细水长流的阶段。"
msgstr "{0} và {1} bên nhau đã lâu, tình cảm vào giai đoạn chảy chậm mà bền."

#. resolved-locale: vi
#. STRINGS.SOCIAL.ANNOUNCE.LOVE_MATURE_TITLE
msgctxt "ONIAiSocial.STRINGS.SOCIAL.ANNOUNCE.LOVE_MATURE_TITLE"
msgid "老夫老妻"
msgstr "Cặp đôi lâu năm"

#. resolved-locale: vi
#. STRINGS.SOCIAL.ANNOUNCE.MOURNING_BODY
msgctxt "ONIAiSocial.STRINGS.SOCIAL.ANNOUNCE.MOURNING_BODY"
msgid "{0} 在心里悼念逝去的 {1}。"
msgstr "{0} thầm tưởng niệm {1} đã khuất."

#. resolved-locale: vi
#. STRINGS.SOCIAL.ANNOUNCE.MOURNING_TITLE
msgctxt "ONIAiSocial.STRINGS.SOCIAL.ANNOUNCE.MOURNING_TITLE"
msgid "默默哀悼"
msgstr "Thầm tưởng niệm"

#. resolved-locale: vi
#. STRINGS.SOCIAL.ANNOUNCE.RECONCILE_BODY
msgctxt "ONIAiSocial.STRINGS.SOCIAL.ANNOUNCE.RECONCILE_BODY"
msgid "{0} 和 {1} 冰释前嫌，重归于好。"
msgstr "{0} và {1} gỡ hết hiềm khích, lại vui vẻ với nhau."

#. resolved-locale: vi
#. STRINGS.SOCIAL.ANNOUNCE.RECONCILE_TITLE
msgctxt "ONIAiSocial.STRINGS.SOCIAL.ANNOUNCE.RECONCILE_TITLE"
msgid "和好如初"
msgstr "Lại như xưa"

#. resolved-locale: vi
#. STRINGS.SOCIAL.ANNOUNCE.REKINDLE_BODY
msgctxt "ONIAiSocial.STRINGS.SOCIAL.ANNOUNCE.REKINDLE_BODY"
msgid "{0} 和 {1} 决定重新开始。"
msgstr "{0} và {1} quyết định bắt đầu lại."

#. resolved-locale: vi
#. STRINGS.SOCIAL.ANNOUNCE.REKINDLE_TITLE
msgctxt "ONIAiSocial.STRINGS.SOCIAL.ANNOUNCE.REKINDLE_TITLE"
msgid "重新牵起手"
msgstr "Lại nắm tay"

#. resolved-locale: vi
#. STRINGS.SOCIAL.ANNOUNCE.RIVAL_BODY
msgctxt "ONIAiSocial.STRINGS.SOCIAL.ANNOUNCE.RIVAL_BODY"
msgid "{0} 和 {1} 积怨到底，正式结下宿敌——这段关系不再自行回暖，除非你出手牵线调解。"
msgstr "{0} và {1} oán đến đáy, chính thức kết thù địch — quan hệ này không tự ấm lại, trừ khi bạn ra tay se duyên hòa giải."

#. resolved-locale: vi
#. STRINGS.SOCIAL.ANNOUNCE.RIVAL_DIED_BODY
msgctxt "ONIAiSocial.STRINGS.SOCIAL.ANNOUNCE.RIVAL_DIED_BODY"
msgid "{1} 走了。{0} 嘴上什么都没说，心情却好了一阵。"
msgstr "{1} đã đi. {0} miệng không nói gì, tâm trạng lại khá hơn một lúc."

#. resolved-locale: vi
#. STRINGS.SOCIAL.ANNOUNCE.RIVAL_DIED_TITLE
msgctxt "ONIAiSocial.STRINGS.SOCIAL.ANNOUNCE.RIVAL_DIED_TITLE"
msgid "对头不在了"
msgstr "Đối thủ đã mất"

#. resolved-locale: vi
#. STRINGS.SOCIAL.ANNOUNCE.RIVAL_OVER_BODY
msgctxt "ONIAiSocial.STRINGS.SOCIAL.ANNOUNCE.RIVAL_OVER_BODY"
msgid "{0} 和 {1} 的宿怨终于化开，关系回到了正常轨道。"
msgstr "Oán cũ của {0} và {1} cuối cùng tan, quan hệ trở lại đường thường."

#. resolved-locale: vi
#. STRINGS.SOCIAL.ANNOUNCE.RIVAL_OVER_TITLE
msgctxt "ONIAiSocial.STRINGS.SOCIAL.ANNOUNCE.RIVAL_OVER_TITLE"
msgid "宿敌和解"
msgstr "Thù địch hòa giải"

#. resolved-locale: vi
#. STRINGS.SOCIAL.ANNOUNCE.RIVAL_TITLE
msgctxt "ONIAiSocial.STRINGS.SOCIAL.ANNOUNCE.RIVAL_TITLE"
msgid "结下宿敌"
msgstr "Kết thù địch"

#. resolved-locale: vi
#. STRINGS.SOCIAL.ANNOUNCE.STRAW_SUFFIX
msgctxt "ONIAiSocial.STRINGS.SOCIAL.ANNOUNCE.STRAW_SUFFIX"
msgid "压垮感情的最后一根稻草：{0}（周期 {1}）。"
msgstr "Giọt nước tràn ly: {0} (chu kỳ {1})."

#. resolved-locale: vi
#. STRINGS.SOCIAL.ANNOUNCE.WIDOWED_BODY
msgctxt "ONIAiSocial.STRINGS.SOCIAL.ANNOUNCE.WIDOWED_BODY"
msgid "{0} 失去了伴侣 {1}，陷入悲伤。"
msgstr "{0} mất người thương {1}, chìm trong đau buồn."

#. resolved-locale: vi
#. STRINGS.SOCIAL.ANNOUNCE.WIDOWED_TITLE
msgctxt "ONIAiSocial.STRINGS.SOCIAL.ANNOUNCE.WIDOWED_TITLE"
msgid "失去了伴侣"
msgstr "Mất người thương"

#. resolved-locale: vi
#. STRINGS.SOCIAL.ANNOUNCE.WRATH_BLAME_BODY
msgctxt "ONIAiSocial.STRINGS.SOCIAL.ANNOUNCE.WRATH_BLAME_BODY"
msgid "殖民地刚出了事，而 {0} 是人缘垫底的那个——帐就这么算在 TA 头上了。现在把 TA 和一位受人敬重的同事牵线，那人会站出来说句公道话；错过这段时间，TA 会被孤立起来。"
msgstr "Thuộc địa vừa có chuyện, mà {0} là người duyên kém nhất — món nợ cứ thế tính lên đầu họ. Hãy se duyên họ với một đồng nghiệp được kính nể, người ấy sẽ đứng ra nói lời công bằng; bỏ lỡ khoảng này, họ sẽ bị cô lập."

#. resolved-locale: vi
#. STRINGS.SOCIAL.ANNOUNCE.WRATH_BLAME_TITLE
msgctxt "ONIAiSocial.STRINGS.SOCIAL.ANNOUNCE.WRATH_BLAME_TITLE"
msgid "总得有人负责"
msgstr "Phải có người chịu"

#. resolved-locale: vi
#. STRINGS.SOCIAL.ANNOUNCE.WRATH_FADED_BODY
msgctxt "ONIAiSocial.STRINGS.SOCIAL.ANNOUNCE.WRATH_FADED_BODY"
msgid "没人救 {0}，但也没人再记得那件事了。日子照过。"
msgstr "Không ai cứu {0}, nhưng cũng chẳng ai còn nhớ chuyện ấy. Ngày vẫn trôi."

#. resolved-locale: vi
#. STRINGS.SOCIAL.ANNOUNCE.WRATH_FADED_TITLE
msgctxt "ONIAiSocial.STRINGS.SOCIAL.ANNOUNCE.WRATH_FADED_TITLE"
msgid "被淡忘了"
msgstr "Bị lãng quên"

#. resolved-locale: vi
#. STRINGS.SOCIAL.ANNOUNCE.WRATH_ISOLATED_BODY
msgctxt "ONIAiSocial.STRINGS.SOCIAL.ANNOUNCE.WRATH_ISOLATED_BODY"
msgid "没人替 {0} 说话。现在起同事路过会别开脸，同桌的人提前离席。任何一个人愿意去照顾 TA、找 TA 聊聊或一起吃顿饭，这件事就到此为止。"
