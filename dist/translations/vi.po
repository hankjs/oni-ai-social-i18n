msgstr "Chào."

#. resolved-locale: vi
#. STRINGS.SOCIAL.SCENE.CONFESSION_FAIL_REPLY
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.CONFESSION_FAIL_REPLY"
