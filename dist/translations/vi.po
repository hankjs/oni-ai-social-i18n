msgstr "Vậy cùng đi tiếp nhé."

#. resolved-locale: vi
#. STRINGS.SOCIAL.SCENE.FAMINE_BUTCHER_1
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.FAMINE_BUTCHER_1"
msgid "对不起……对不起……"
msgstr "Xin lỗi... xin lỗi..."

#. resolved-locale: vi
#. STRINGS.SOCIAL.SCENE.FAMINE_BUTCHER_2
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.FAMINE_BUTCHER_2"
msgid "别看我。谁都别看我。"
msgstr "Đừng nhìn mình. Đừng ai nhìn cả."

#. resolved-locale: vi
#. STRINGS.SOCIAL.SCENE.FAMINE_BUTCHER_3
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.FAMINE_BUTCHER_3"
msgid "我们得活下去。就这样而已。"
msgstr "Chúng ta phải sống. Chỉ có vậy thôi."

#. resolved-locale: vi
#. STRINGS.SOCIAL.SCENE.FAMINE_BUTCHER_4
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.FAMINE_BUTCHER_4"
msgid "这不算杀人。这是活下去。"
msgstr "Đây không phải giết người. Đây là sống sót."

#. resolved-locale: vi
#. STRINGS.SOCIAL.SCENE.FAMINE_BUTCHER_5
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.FAMINE_BUTCHER_5"
msgid "闭上眼睛，很快就好。"
msgstr "Đừng nhìn. Sẽ nhanh thôi."

#. resolved-locale: vi
#. STRINGS.SOCIAL.SCENE.FAMINE_BUTCHER_6
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.FAMINE_BUTCHER_6"
msgid "我会记得你的名字。"
msgstr "Mình sẽ nhớ tên bạn."

#. resolved-locale: vi
#. STRINGS.SOCIAL.SCENE.FAMINE_BUTCHER_7
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.FAMINE_BUTCHER_7"
msgid "总得有人做这件事。"
msgstr "Rồi cũng phải có người làm."

#. resolved-locale: vi
#. STRINGS.SOCIAL.SCENE.GRIEF_KEY
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.GRIEF_KEY"
msgid "我会记得你的。"
msgstr "Mình sẽ nhớ bạn."

#. resolved-locale: vi
#. STRINGS.SOCIAL.SCENE.RECONCILE_KEY
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.RECONCILE_KEY"
msgid "别再这样僵下去了。"
msgstr "Đừng cứng như thế nữa."

#. resolved-locale: vi
#. STRINGS.SOCIAL.SCENE.RECONCILE_REPLY
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.RECONCILE_REPLY"
msgid "好，我们重新来过。"
msgstr "Được, mình làm lại từ đầu."

#. resolved-locale: vi
#. STRINGS.SOCIAL.SCENE.REKINDLE_INTRO
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.REKINDLE_INTRO"
msgid "有些话，我还是想再说一次。"
msgstr "Có vài lời, mình vẫn muốn nói lại."

#. resolved-locale: vi
#. STRINGS.SOCIAL.SCENE.REKINDLE_KEY
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.REKINDLE_KEY"
msgid "我们能重新开始吗？"
msgstr "Mình bắt đầu lại được không?"

#. resolved-locale: vi
#. STRINGS.SOCIAL.SCENE.REKINDLE_REPLY
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.REKINDLE_REPLY"
msgid "这次别再错过了。"
msgstr "Lần này đừng bỏ lỡ nữa."

#. resolved-locale: vi
#. STRINGS.SOCIAL.SCENE.REKINDLE_RESULT
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.REKINDLE_RESULT"
msgid "重新认识彼此吧。"
msgstr "Cùng làm quen lại nhau."

#. resolved-locale: vi
#. STRINGS.SOCIAL.SCENE.RIVAL_KEY
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.RIVAL_KEY"
msgid "这笔账，我不会就这么算了。"
msgstr "Món này, mình không tính xong thế."

#. resolved-locale: vi
#. STRINGS.SOCIAL.SCENE.RIVAL_REPLY
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.RIVAL_REPLY"
msgid "正好，我也没打算和你和解。"
msgstr "Vừa hay, mình cũng chẳng định hòa giải."

#. resolved-locale: vi
#. STRINGS.SOCIAL.SCENE.WRATH_MEAL_SNUB_1
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.WRATH_MEAL_SNUB_1"
msgid "我去别处坐。"
msgstr "Mình ăn xong rồi."

#. resolved-locale: vi
#. STRINGS.SOCIAL.SCENE.WRATH_MEAL_SNUB_2
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.WRATH_MEAL_SNUB_2"
msgid "……我端到那边去。"
msgstr "...Mình mang qua bên kia ăn."

#. resolved-locale: vi
#. STRINGS.SOCIAL.SCENE.WRATH_MEAL_SNUB_3
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.WRATH_MEAL_SNUB_3"
msgid "我想自己吃。"
msgstr "Bàn này đầy rồi."

#. resolved-locale: vi
#. STRINGS.SOCIAL.SCENE.WRATH_MEAL_SNUB_4
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.WRATH_MEAL_SNUB_4"
msgid "这顿我想清静点。"
msgstr "À, mình còn việc chưa xong."

#. resolved-locale: vi
#. STRINGS.SOCIAL.SETTINGS.AFFINITY_POPUPS
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SETTINGS.AFFINITY_POPUPS"
msgid "好感增减飘字"
msgstr "Số nổi thiện cảm"

#. resolved-locale: vi
#. STRINGS.SOCIAL.SETTINGS.AI_WIP_HINT
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SETTINGS.AI_WIP_HINT"
msgid "AI 对话仍在完善中，默认关闭。关闭时使用内置台词，社交玩法照常运行。"
msgstr "Lời AI chưa hoàn thiện, mặc định tắt; khi tắt dùng toàn bộ lời có sẵn, lối chơi vẫn đủ"

#. resolved-locale: vi
#. STRINGS.SOCIAL.SETTINGS.AMBIENT_CHAT_COOLDOWN
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SETTINGS.AMBIENT_CHAT_COOLDOWN"
msgid "模组闲聊：同一复制人的间隔（秒）"
msgstr "Hồi chiêu tán gẫu do Mod thêm cho mỗi người nhân bản (giây)"

