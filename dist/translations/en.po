#. resolved-locale: en
#. STRINGS.SOCIAL.MANAGEMENT.STORY_INVOLVED_BADGE
msgctxt "ONIAiSocial.STRINGS.SOCIAL.MANAGEMENT.STORY_INVOLVED_BADGE"
