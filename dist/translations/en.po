msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG.SECTION_MILESTONES"
msgid "—— 大事记 ——"
msgstr "—— Milestones ——"

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG.SECTION_RECENT"
msgid "—— 最近 ——"
msgstr "—— Recent ——"

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.PAIR_JOINER"
msgid "{0} 和 {1}"
msgstr "{0} and {1}"

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.SELF_NAME"
msgid "我"
msgstr "I"

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.GREET_1"
msgid "{pair}擦肩而过,互相点了点头。"
msgstr "{pair} crossed paths and exchanged a nod."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.GREET_2"
msgid "{pair}在走廊里打了个招呼。"
msgstr "{pair} said hello in the corridor."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.GREET_3"
msgid "{pair}碰面时寒暄了两句。"
msgstr "{pair} traded a few pleasantries when they met."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.GREET_4"
msgid "{pair}远远地挥了挥手。"
msgstr "{pair} waved at each other from afar."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.GREET_5"
msgid "{pair}隔着半条走廊对视了一眼,心照不宣。"
msgstr "{pair} exchanged a glance across half the corridor; nothing needed saying."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.GREET_6"
msgid "{pair}在打印舱前排着队,顺便打了招呼。"
msgstr "{pair} queued at the printing pod and said hello while they waited."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.CHAT_1"
msgid "{pair}聊了会儿天。"
msgstr "{pair} chatted for a while."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.CHAT_2"
msgid "{pair}凑在一起闲聊,气氛不错。"
msgstr "{pair} sat together shooting the breeze; the mood was good."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.CHAT_3"
msgid "{pair}聊起了家长里短。"
msgstr "{pair} talked about everyday things."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.CHAT_4"
msgid "{pair}聊起了{topic}。"
msgstr "{pair} talked about {topic}."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.CHAT_5"
msgid "{pair}交换了今天的见闻。"
msgstr "{pair} traded the day's stories."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.CHAT_6"
msgid "{pair}有一搭没一搭地聊着,时间过得飞快。"
msgstr "{pair} chatted idly, and the time flew by."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.VENT_1"
msgid "{actor}向{other}倒了一肚子苦水。"
msgstr "{actor} poured their troubles out to {other}."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.VENT_2"
msgid "{other}听{actor}倾诉了很久。"
msgstr "{other} listened to {actor} for a long time."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.VENT_3"
msgid "{actor}把今天的糟心事一件一件数给{other}听。"
msgstr "{actor} laid out the day's grievances for {other}, one by one."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.VENT_4"
msgid "{actor}问{other}这日子什么时候是个头,{other}答不上来。"
msgstr "{actor} asked {other} when this life gets any easier; {other} had no answer."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.VENT_5"
msgid "苦水倒完了,{actor}觉得肩上的浮土都轻了些。"
msgstr "Troubles aired, {actor} felt the regolith on their shoulders weigh a little less."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.VENT_STRESS_1"
msgid "{actor}的情绪快压不住了,{other}陪他坐了一会儿。"
msgstr "{actor} was close to breaking; {other} sat with them a while."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.TEACH_1"
msgid "{actor}手把手教{other}干活。"
msgstr "{actor} showed {other} the work, step by step."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.TEACH_2"
msgid "{actor}给{other}讲了些独门窍门。"
msgstr "{actor} shared a few tricks of the trade with {other}."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.TEACH_3"
msgid "{actor}演示了一遍,{other}看得眼睛都不眨。"
msgstr "{actor} demonstrated it once; {other} watched without blinking."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.TEACH_4"
msgid "{actor}说只教一遍,{other}决定回去自己偷偷练。"
msgstr "{actor} said they'd only teach it once, so {other} resolved to practice in secret."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.TEACH_5"
msgid "有些手艺是排班表上学不到的,{actor}传给了{other}。"
msgstr "Some skills aren't on any work schedule; {actor} passed one on to {other}."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.BESTFRIEND_1"
msgid "{pair}聊到深夜,成了彼此的挚友。"
msgstr "{pair} talked late into the night and became best friends."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.BESTFRIEND_2"
msgid "{pair}说了些从没对别人说过的话。"
msgstr "{pair} said things they had never told anyone."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.BESTFRIEND_3"
msgid "{pair}交换了彼此的秘密,从此不分你我。"
msgstr "{pair} traded secrets, and from then on kept nothing from each other."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.BESTFRIEND_4"
msgid "那晚{pair}聊到天亮,谁也没提该睡觉的事。"
msgstr "{pair} talked until morning; neither mentioned bedtime."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.BESTFRIEND_5"
msgid "有些人认识很久才是朋友,{pair}只花了一个晚上。"
msgstr "Some friendships take years. {pair} managed it in one night."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.CARE_1"
msgid "{actor}照顾了{other}。"
msgstr "{actor} took care of {other}."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.CARE_2"
msgid "{actor}帮{other}处理了伤势。"
msgstr "{actor} tended {other}'s injuries."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.CARE_3"
msgid "{actor}给{other}换了绷带,动作很轻。"
msgstr "{actor} changed {other}'s bandages, gentle as could be."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.CARE_4"
msgid "{other}嘴上说着没事,还是让{actor}照看了一整天。"
msgstr "{other} insisted it was nothing, then let {actor} fuss over them all day."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.CARE_5"
msgid "{actor}守在{other}旁边,连药都提前晾温了。"
msgstr "{actor} stayed by {other}'s side, the medicine cooled and ready."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.COMFORT_1"
msgid "{actor}陪着{other},直到他缓过来。"
msgstr "{actor} stayed with {other} until they came around."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.COMFORT_2"
msgid "{other}在{actor}的陪伴下平静了下来。"
msgstr "{other} calmed down in {actor}'s company."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.COMFORT_3"
msgid "{actor}没说什么大道理,只是陪着{other}。"
msgstr "{actor} offered no grand wisdom — just stayed with {other}."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.COMFORT_4"
msgid "{other}想说谢谢,{actor}摆摆手让他省点力气。"
msgstr "{other} tried to say thanks; {actor} waved it off to save them the breath."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.COMFORT_5"
msgid "有些夜晚只能熬过去,好在{other}不是一个人熬。"
msgstr "Some nights can only be endured. At least {other} didn't endure this one alone."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.MEAL_1"
msgid "{pair}在{place}一起吃了顿饭。"
msgstr "{pair} shared a meal at {place}."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.MEAL_2"
msgid "{pair}边吃边聊,很放松。"
msgstr "{pair} ate and talked, at ease."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.MEAL_3"
msgid "{pair}拼了一桌,聊了很久。"
msgstr "{pair} shared a table and talked for a long time."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.MEAL_4"
msgid "{pair}端着餐盘坐到了一起。"
msgstr "{pair} carried their trays to the same table."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.MEAL_5"
msgid "{pair}分食了一份软泥糕,谁也没嫌弃谁。"
msgstr "{pair} split a mush bar between them; neither complained."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.MEAL_6"
msgid "饭菜还是老样子,但{pair}这桌的笑声是新的。"
msgstr "The food was the same as ever, but the laughter at {pair}'s table was new."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.MEAL_COLD_1"
msgid "{pair}隔着一张桌子,谁也没先开口。"
msgstr "{pair} sat across the table; neither spoke first."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.MEAL_COUPLE_1"
msgid "{pair}挨着坐下,这顿饭吃得很甜。"
msgstr "{pair} sat close, and the meal was sweet."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.REST_1"
msgid "{pair}同屋睡了一晚,作息很合拍。"
msgstr "{pair} shared a room for the night; their schedules matched."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.REST_2"
msgid "{pair}的床铺挨着,夜里翻身都怕吵到对方。"
msgstr "{pair} bunked side by side, each turning over carefully so as not to wake the other."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.REST_3"
msgid "熄灯之后,{pair}又小声聊了一会儿才睡。"
msgstr "After lights-out, {pair} whispered a while longer before sleeping."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.REST_4"
msgid "同一个屋檐下,{pair}连打鼾的节奏都磨合出来了。"
msgstr "Under one roof, {pair} have even synced up their snoring."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.REST_CLASH_1"
msgid "{pair}作息不合,谁都没睡好。"
msgstr "{pair}'s schedules clashed; neither slept well."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.SOCIALIZE_1"
msgid "{pair}在{place}一起玩了一会儿。"
msgstr "{pair} spent some time together at {place}."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.SOCIALIZE_2"
msgid "{pair}在休息区碰头,玩得很开心。"
msgstr "{pair} met in the recreation area and had a good time."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.SOCIALIZE_3"
msgid "{pair}在{place}消磨了一段好时光。"
msgstr "{pair} whiled away a pleasant stretch at {place}."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.SOCIALIZE_4"
msgid "{pair}较量了几局,输赢已经不重要了。"
msgstr "{pair} played a few rounds; by the end, the score didn't matter."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.SOCIALIZE_5"
msgid "{pair}把一天的疲惫都玩没了。"
msgstr "{pair} played the day's exhaustion clean away."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.PARTY_1"
msgid "{pair}参加了{place}的聚会。"
msgstr "{pair} attended the party at {place}."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.PARTY_2"
msgid "{pair}在聚会上玩开了。"
msgstr "{pair} let loose at the party."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.PARTY_3"
msgid "{pair}在聚会上碰了杯,果汁都快喝出酒味了。"
msgstr "{pair} toasted at the party; the juice nearly passed for wine."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.PARTY_4"
msgid "聚会的灯光下,{pair}比平时健谈了不少。"
msgstr "In the party lights, {pair} were chattier than usual."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.PARTY_5"
msgid "{pair}一直待到聚会散场,还意犹未尽。"
msgstr "{pair} stayed until the party wound down, reluctant to leave."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.DATE_1"
msgid "{pair}约了一次会,气氛正好。"
msgstr "{pair} went on a date; the mood was just right."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.DATE_2"
msgid "{pair}独处了一会儿,眼里只有彼此。"
msgstr "{pair} stole a moment alone, with eyes only for each other."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.DATE_3"
msgid "{pair}并肩散步,谁也没提回工作站的事。"
msgstr "{pair} walked side by side; neither mentioned going back to work."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.DATE_4"
msgid "{pair}在望远镜旁约会,轮流看同一片星空。"
msgstr "{pair} had their date by the telescope, taking turns at the same patch of stars."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.DATE_5"
msgid "约会的规矩是{pair}定的:不许谈排班表。"
msgstr "{pair} set one rule for the date: no talk of work schedules."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.ANNIVERSARY_1"
msgid "{pair}纪念了在一起的日子。"
msgstr "{pair} marked the day they got together."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.ANNIVERSARY_2"
msgid "{pair}又安稳地走过了一年,值得碰一杯。"
msgstr "{pair} made it through another year together — worth a toast."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.ANNIVERSARY_3"
msgid "在这个连日历都要自己记的地方,{pair}没有忘记今天。"
msgstr "In a place where you keep the calendar yourself, {pair} remembered the day."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.ANNIVERSARY_4"
msgid "{pair}把纪念日过成了全殖民地的节日——至少他们自己是这么觉得的。"
msgstr "{pair} celebrated like it was a colony-wide holiday — as far as they were concerned, it was."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.ANNIVERSARY_MISSED_1"
msgid "{actor}忘了和{other}的纪念日。"
msgstr "{actor} forgot the anniversary with {other}."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.ANNIVERSARY_MISSED_2"
msgid "{actor}的排班表上唯独漏掉了和{other}的纪念日。"
msgstr "{actor}'s schedule had everything on it except the anniversary with {other}."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.ANNIVERSARY_MISSED_3"
msgid "{other}等了一晚上,{actor}在矿井里浑然不觉。"
msgstr "{other} waited all evening; {actor}, down in the mines, noticed nothing."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.ANNIVERSARY_MISSED_4"
msgid "日子一忙就糊涂,{actor}把最重要的那天忘了。"
msgstr "Busy days blur together, and {actor} let the most important one slip."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.CONFESSION_1"
msgid "{actor}向{other}表明了心意——{other}答应了。"
msgstr "{actor} confessed their feelings to {other} — {other} said yes."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.CONFESSION_2"
msgid "{actor}鼓起勇气告白,{other}红着脸点了头。"
msgstr "{actor} found the courage to confess; {other}, blushing, nodded."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.CONFESSION_3"
msgid "{actor}把练习了十遍的话说到一半,{other}就答应了。"
msgstr "{actor} got halfway through the rehearsed speech before {other} said yes."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.CONFESSION_4"
msgid "在打印舱的见证下,{actor}和{other}牵起了手。"
msgstr "With the printing pod as their witness, {actor} took {other}'s hand."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.CONFESSION_5"
msgid "{other}等这句话等了很久,{actor}终于说出口了。"
msgstr "{other} had waited a long time for those words; {actor} finally said them."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.REKINDLE_1"
msgid "{pair}重新走到了一起。"
msgstr "{pair} found their way back to each other."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.REKINDLE_2"
msgid "{pair}绕了一圈,又回到了彼此身边。"
msgstr "{pair} took the long way around and ended up back together."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.REKINDLE_3"
msgid "有些分开只是为了想清楚,{pair}想清楚了。"
msgstr "Some partings are just for thinking things through. {pair} thought it through."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.REKINDLE_4"
msgid "{pair}再次牵起手,比第一次还要用力。"
msgstr "{pair} held hands again, tighter than the first time."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.CONFESSION_FAIL_1"
msgid "{actor}向{other}表白了,但{other}没有答应。"
msgstr "{actor} confessed to {other}, but {other} did not say yes."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.CONFESSION_FAIL_2"
msgid "{actor}的心意,{other}没能接住。"
msgstr "{other} could not return {actor}'s feelings."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.CONFESSION_FAIL_3"
msgid "{actor}说完那句排练好的告白,{other}沉默了很久。"
msgstr "{actor} delivered the rehearsed confession; {other} stayed silent for a long while."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.CONFESSION_FAIL_4"
msgid "不是所有真心都有回音,{actor}今天明白了。"
msgstr "Not every heartfelt word finds an echo; {actor} learned that today."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.BREAKUP_1"
msgid "{pair}分手了。"
msgstr "{pair} broke up."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.BREAKUP_2"
msgid "{pair}的感情走到了尽头。"
msgstr "{pair}'s relationship reached its end."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.BREAKUP_3"
msgid "{pair}把话说开,然后各自转身。"
msgstr "{pair} said what needed saying, then turned and walked away."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.BREAKUP_4"
msgid "{pair}的关系,像气压服的氧气一样耗尽了。"
msgstr "{pair}'s relationship ran out like an atmo suit's oxygen."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.BREAKUP_5"
msgid "{other}还想挽回,{actor}已经不想再谈了。"
msgstr "{other} wanted to try again; {actor} was done talking."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.BOUND_BLOCK_1"
msgid "{pair}之间像隔着一层看不见的墙,关系停在了原地。"
msgstr "An invisible wall stands between {pair}; nothing moved."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.BOUND_BLOCK_2"
msgid "某种说不清的力量按住了{pair}的缘分,谁也没有再进一步。"
msgstr "Some unnameable force held the bond between {pair} exactly where it was."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.BOUND_BLOCK_3"
msgid "{pair}的故事刚要翻页,又被无形的手轻轻按住。"
msgstr "{pair}'s story was about to turn a page, until an unseen hand held it down."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.BOUND_BLOCK_4"
msgid "命运在{pair}之间画了一条线,谁也没有跨过去。"
msgstr "Fate drew a line between {pair}, and neither one crossed it."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.BOUND_BLOCK_5"
msgid "{pair}的关系起了波澜,又莫名其妙地平息了。"
msgstr "Things stirred between {pair}, then inexplicably settled again."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.FALLOUT_1"
msgid "{pair}大吵一架,从此形同陌路。"
msgstr "{pair} had a bitter fight and became strangers."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.FALLOUT_2"
msgid "{pair}之间那点情分,一夜之间清了零。"
msgstr "Whatever warmth {pair} had left was gone overnight."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.FALLOUT_3"
msgid "从那天起,{pair}在走廊里遇见都绕着走。"
msgstr "Since that day, {pair} take detours to avoid each other in the corridors."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.FALLOUT_4"
msgid "朋友做到头,{pair}连招呼都省了。"
msgstr "The friendship ran its course; {pair} don't even nod anymore."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.RECONCILE_1"
msgid "{pair}冰释前嫌,重归于好。"
msgstr "{pair} let go of old grievances and made up."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.RECONCILE_2"
msgid "{pair}把旧账翻篇,重新坐到了一张桌上。"
msgstr "{pair} closed the old ledger and sat down at the same table again."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.RECONCILE_3"
msgid "谁先开的口已经不重要,{pair}和好了。"
msgstr "Whoever spoke first no longer matters; {pair} made up."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.RECONCILE_4"
msgid "冷战结束的那天,{pair}都松了一口气。"
msgstr "The day the cold war ended, {pair} both breathed easier."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.APOLOGY_1"
msgid "{actor}向{other}道了歉。"
msgstr "{actor} apologized to {other}."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.APOLOGY_2"
msgid "{actor}先低了头,{other}也就顺势原谅了。"
msgstr "{actor} yielded first, and {other} forgave."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.APOLOGY_3"
msgid "{actor}把「对不起」三个字说得磕磕绊绊,{other}收下了。"
msgstr "{actor} stumbled through the word \"sorry\"; {other} accepted it."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.APOLOGY_4"
msgid "{actor}递过去一块软泥糕,算是赔罪。"
msgstr "{actor} offered a mush bar by way of apology."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.APOLOGY_5"
msgid "面子和{other}之间,{actor}选了{other}。"
msgstr "Between pride and {other}, {actor} chose {other}."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.APOLOGY_BOND_1"
msgid "一场冲突反倒让{pair}成了好朋友。"
msgstr "A conflict, of all things, made {pair} good friends."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.APOLOGY_BOND_2"
msgid "{pair}把话说透,反倒成了朋友。"
msgstr "{pair} talked it all out and came out of it friends."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.APOLOGY_BOND_3"
msgid "道完歉的{pair},比吵架前还要亲近。"
msgstr "After the apology, {pair} were closer than before the fight."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.APOLOGY_BOND_4"
msgid "{pair}先是吵了一架,然后成了朋友——事情就是这样。"
msgstr "{pair} had a fight, then became friends. That's just how it went."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.ARGUMENT_1"
msgid "{pair}吵了一架。"
msgstr "{pair} had an argument."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.ARGUMENT_2"
msgid "{pair}争执了起来,谁也不让谁。"
msgstr "{pair} quarreled, neither willing to back down."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.ARGUMENT_3"
msgid "{pair}的声音越抬越高,惊动了隔壁的哈奇。"
msgstr "{pair}'s voices rose high enough to startle the hatches next door."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.ARGUMENT_4"
msgid "{pair}为一点小事红了脸,事后想想都不值。"
msgstr "{pair} got heated over something trivial; in hindsight, neither could say what."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.ARGUMENT_5"
msgid "一场架吵完,{pair}都觉得是对方先不讲理的。"
msgstr "When the shouting was over, {pair} each blamed the other for starting it."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.ARGUMENT_CAUSE_1"
msgid "因为{cause},{pair}吵了起来。"
msgstr "Over {cause}, {pair} got into an argument."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.RIVAL_1"
msgid "{pair}结下了梁子,成了宿敌。"
msgstr "{pair} made enemies of each other."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.RIVAL_2"
msgid "{pair}的恩怨从此有了名字:宿敌。"
msgstr "{pair}'s grudge finally has a name: nemesis."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.RIVAL_3"
msgid "往后很长一段日子,{pair}都不会给对方好脸色。"
msgstr "For a long time to come, {pair} won't be exchanging pleasantries."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.RIVAL_OVER_1"
msgid "{pair}放下了宿怨。"
msgstr "{pair} let the old feud go."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.RIVAL_OVER_2"
msgid "{pair}握了握手,宿怨到此为止。"
msgstr "{pair} shook hands; the feud ends here."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.RIVAL_OVER_3"
msgid "恨一个人也挺累的,{pair}决定算了。"
msgstr "Hating someone is exhausting, so {pair} decided to stop."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.RIVAL_DIED_1"
msgid "{other}死了,{actor}心里说不出是什么滋味。"
msgstr "{other} died, and {actor} could not name what they felt."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.RIVAL_DIED_2"
msgid "宿敌死了,{actor}突然发现走廊安静了不少。"
msgstr "The nemesis was dead, and {actor} noticed how quiet the corridors had become."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.RIVAL_DIED_3"
msgid "{actor}曾盼着赢过{other},如今再也没有对手了。"
msgstr "{actor} always wanted to beat {other}; now there is no one left to beat."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.JEALOUSY_1"
msgid "{actor}看见{other}和{third}有说有笑,心里很不是滋味。"
msgstr "{actor} watched {other} laughing with {third}, and it stung."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.JEALOUSY_2"
msgid "{actor}吃醋了。"
msgstr "{actor} was jealous."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.JEALOUSY_3"
msgid "{third}和{other}聊得投机,{actor}在旁边数了很久的浮土。"
msgstr "{third} and {other} were deep in conversation; {actor} stood nearby, counting regolith."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.JEALOUSY_4"
msgid "那股酸劲儿,{actor}自己也说不清来由。"
msgstr "The sour feeling crept up on {actor}, who couldn't say where it came from."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.LOSS_PARTNER_1"
msgid "{actor}失去了{other},整个人都垮了。"
msgstr "{actor} lost {other} and fell apart."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.LOSS_PARTNER_2"
msgid "{other}的床铺空了下来,{actor}很久都不去看那个方向。"
msgstr "{other}'s bunk sits empty now, and {actor} has stopped looking that way."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.LOSS_PARTNER_3"
msgid "往后的排班表上再没有{other}的名字,{actor}的日子也空了一块。"
msgstr "{other}'s name is gone from the schedule, and a piece of {actor}'s days went with it."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.LOSS_CRUSH_1"
msgid "{other}走了,{actor}把没说出口的话咽了回去。"
msgstr "{other} was gone; {actor} swallowed the words never said."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.LOSS_CRUSH_2"
msgid "{other}没能等到{actor}鼓起勇气的那一天。"
msgstr "{other} never got to see the day {actor} finally found the nerve."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.LOSS_CRUSH_3"
msgid "{actor}把准备了好久的话,说给了{other}空着的床铺。"
msgstr "{actor} recited the long-prepared words to {other}'s empty bunk."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.WITNESS_1"
msgid "{actor}崩溃的样子,{other}都看在眼里。"
msgstr "{other} saw every moment of {actor}'s breakdown."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.WITNESS_2"
msgid "{other}别过脸去,却没能忘掉{actor}崩溃的那一幕。"
msgstr "{other} looked away, but couldn't unsee {actor}'s breakdown."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.WITNESS_3"
msgid "看着{actor}崩溃,{other}第一次觉得基地这么安静。"
msgstr "Watching {actor} come apart, {other} realized how quiet the base could be."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.WITNESS_SOLO_1"
msgid "{subject}目睹了同伴的崩溃,心里很沉重。"
msgstr "{subject} witnessed a crewmate's breakdown, and it weighed heavy."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.WITNESS_SOLO_2"
msgid "{subject}撞见了同伴的崩溃,之后一整天都心不在焉。"
msgstr "{subject} stumbled onto a crewmate's breakdown and was distracted all day."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.BRAWL_1"
msgid "{pair}打了起来。"
msgstr "{pair} came to blows."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.BRAWL_2"
msgid "{pair}的争执升级成了拳脚。"
msgstr "{pair}'s quarrel turned to fists."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.BRAWL_3"
msgid "{pair}扭作一团,工具散了一地。"
msgstr "{pair} grappled and tumbled, tools scattering everywhere."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.BRAWL_4"
msgid "这一架打得难看,{pair}都挂了彩。"
msgstr "It was an ugly fight; {pair} both walked away bruised."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.BRAWL_5"
msgid "劝架的都来了,{pair}才肯撒手。"
msgstr "Only when others pulled them apart did {pair} finally let go."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.HAZARD_RESENT_1"
msgid "{actor}又下了一天危险区,对{other}的轻松差事有了怨气。"
msgstr "{actor} spent another day in the hazard zone and resented {other}'s easy duty."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.HAZARD_RESENT_2"
msgid "同样是下矿井,凭什么{actor}总去危险的那头——{actor}越想越不是滋味。"
msgstr "Same mine, so why does {actor} always draw the dangerous end? {actor} couldn't let it go."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.HAZARD_RESENT_3"
msgid "{actor}数着{other}的清闲日子,心里的账越记越厚。"
msgstr "{actor} tallied {other}'s easy days, and the ledger of grievances grew."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.HAZARD_EASED_1"
msgid "{actor}对{other}的那点怨气,慢慢散了。"
msgstr "{actor}'s resentment toward {other} slowly faded."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.HAZARD_EASED_2"
msgid "{actor}想通了:危险活总得有人干,不该怨{other}。"
msgstr "{actor} came around: someone has to take the dangerous work; blaming {other} was wrong."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.HAZARD_EASED_3"
msgid "时间把那点火气磨平了,{actor}看{other}顺眼多了。"
msgstr "Time wore the anger smooth; {other} looks a lot more agreeable to {actor} now."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.HAZARD_GRATITUDE_1"
msgid "{other}替{actor}挡了危险活,{actor}记在了心里。"
msgstr "{other} took the dangerous work off {actor}'s hands, and {actor} remembered."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.HAZARD_GRATITUDE_2"
msgid "危险活落下来的时候,{other}先一步接了,{actor}不会忘。"
msgstr "When the dangerous assignment came down, {other} took it first. {actor} won't forget."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.HAZARD_GRATITUDE_3"
msgid "{actor}欠{other}一个人情,还是拿命换的那种。"
msgstr "{actor} owes {other} a favor — the life-risking kind."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.HAZARD_COMRADE_1"
msgid "{pair}一起扛过了危险的活,有了过命的交情。"
msgstr "{pair} got through dangerous work side by side — comrades now."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.HAZARD_COMRADE_2"
msgid "从危险区活着出来,{pair}看彼此的眼神都不一样了。"
msgstr "Coming out of the hazard zone alive, {pair} looked at each other differently."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.HAZARD_COMRADE_3"
msgid "生死关头上{pair}谁都没先跑,这交情假不了。"
msgstr "{pair} faced the danger and neither ran first; that kind of bond can't be faked."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.WRATH_BLAME_1"
msgid "{actor}带头把账算到了{other}头上。"
msgstr "{actor} led the colony in blaming {other}."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.WRATH_BLAME_2"
msgid "出了事,总得有人背锅——{actor}领着大家选了{other}。"
msgstr "Something went wrong, so someone had to take the fall — {actor} led everyone in picking {other}."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.WRATH_BLAME_3"
msgid "{actor}一句话,就把众人的怒火引向了{other}。"
msgstr "One sentence from {actor} was enough to turn everyone's anger on {other}."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.WRATH_ISOLATED_1"
msgid "{other}被孤立了,没人愿意跟他说话。"
msgstr "{other} was shunned; no one would speak to them."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.WRATH_ISOLATED_2"
msgid "{other}走进餐厅,一整桌的人都收了声。"
msgstr "{other} walked into the mess hall, and a whole table went quiet."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.WRATH_ISOLATED_3"
msgid "现在连哈奇都比{other}受欢迎。"
msgstr "These days, even the hatches are more popular than {other}."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.WRATH_SPEAK_UP_1"
msgid "{actor}当众替{other}说了句公道话。"
msgstr "{actor} spoke up for {other} in front of everyone."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.WRATH_SPEAK_UP_2"
msgid "{actor}当着所有人的面替{other}说话,没人再吭声。"
msgstr "{actor} stood up for {other} in front of everyone, and the room fell silent."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.WRATH_SPEAK_UP_3"
msgid "众怒汹汹的时候,{actor}是唯一肯替{other}开口的人。"
msgstr "With the mob howling, {actor} was the only one willing to speak for {other}."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.WRATH_RESCUE_1"
msgid "{actor}向{other}伸出了援手。"
msgstr "{actor} reached out a hand to {other}."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.WRATH_RESCUE_2"
msgid "{actor}端着餐盘坐到{other}旁边,孤立的墙塌了一角。"
msgstr "{actor} carried a tray over and sat by {other}, and the wall of silence cracked."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.WRATH_RESCUE_3"
msgid "所有人都绕开{other}的时候,{actor}偏偏走了过去。"
msgstr "While everyone else steered clear of {other}, {actor} walked straight over."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.WRATH_PUNCH_1"
msgid "{actor}趁没人注意,揍了{other}一顿。"
msgstr "{actor} beat {other} while no one was watching."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.WRATH_PUNCH_2"
msgid "排班表的空档里,{actor}堵住了{other}。"
msgstr "In a gap between shifts, {actor} cornered {other}."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.WRATH_PUNCH_3"
msgid "{actor}挑了个四下无人的时候,把火气撒在了{other}身上。"
msgstr "{actor} picked a moment when no one was around and took the anger out on {other}."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.WRATH_WITNESS_1"
msgid "{subject}看见了那场私刑。"
msgstr "{subject} saw the lynching."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.WRATH_WITNESS_2"
msgid "{subject}撞见了那一幕,慌忙装作没看见。"
msgstr "{subject} stumbled onto the scene and hurriedly pretended not to see."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.WRATH_WITNESS_3"
msgid "有些事看见了也只能咽下去,{subject}把嘴闭得很紧。"
msgstr "Some things, once seen, must be swallowed; {subject} kept their mouth firmly shut."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.WRATH_SAW_CRYING_1"
msgid "{subject}撞见他一个人躲着哭。"
msgstr "{subject} found them crying alone in hiding."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.WRATH_SAW_CRYING_2"
msgid "{subject}路过时听见哭声,放轻了脚步。"
msgstr "Passing by, {subject} heard the crying and softened their steps."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.WRATH_SAW_CRYING_3"
msgid "躲在角落里的那个人哭了很久,{subject}没有上前。"
msgstr "The one hiding in the corner cried for a long time; {subject} didn't go over."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.WRATH_FADED_1"
msgid "针对{subject}的孤立,总算过去了。"
msgstr "The isolation of {subject} finally passed."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.WRATH_FADED_2"
msgid "殖民地找到了新的谈资,{subject}的那档子事没人再提。"
msgstr "The colony found fresh gossip, and no one brings up {subject}'s business anymore."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.WRATH_FADED_3"
msgid "日子一长,连怒火也会过期——{subject}重新融进了人群。"
msgstr "Given time, even anger expires — {subject} has blended back into the crowd."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.FAMINE_WARNING_1"
msgid "粮仓见了底,恐慌在殖民地蔓延。"
msgstr "The granary ran empty, and panic spread through the colony."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.FAMINE_WARNING_2"
msgid "最后一块软泥糕也见了底,没人敢想明天。"
msgstr "The last mush bar is gone, and no one dares think about tomorrow."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.FAMINE_WARNING_3"
msgid "饿肚子的消息比氧气传得还快。"
msgstr "Word of empty stomachs travels faster than oxygen."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.FAMINE_AVERTED_1"
msgid "粮食补上了,大家松了一口气。"
msgstr "Food arrived; the colony breathed again."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.FAMINE_AVERTED_2"
msgid "储藏室重新有了存货,咀嚼声又回来了。"
msgstr "The pantry has stock again, and with it the sound of chewing."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.FAMINE_AVERTED_3"
msgid "危机解除了,没人追问粮食从哪来的。"
msgstr "The crisis passed, and nobody asked where the food came from."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.FAMINE_CULL_1"
msgid "{actor}和{other}为了最后一口吃的动了手。"
msgstr "{actor} and {other} fought over the last bite of food."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.FAMINE_CULL_2"
msgid "饿极了的人不讲道理,{actor}和{other}为了一口吃的撕破了脸。"
msgstr "Starving people don't reason; {actor} and {other} fell out over a single bite."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.FAMINE_CULL_3"
msgid "{actor}盯上了{other}的那份口粮,拳头比理智先到。"
msgstr "{actor} fixed their eyes on {other}'s ration, and fists moved faster than thought."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.FAMINE_OVER_1"
msgid "断粮的日子终于过去了。"
msgstr "The days of hunger were finally over."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.FAMINE_OVER_2"
msgid "粮仓重新满了,有些事大家心照不宣地不再提。"
msgstr "The granary is full again; some things are silently never mentioned."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.FAMINE_OVER_3"
msgid "又能吃饱的日子来了,仿佛饥荒从没发生过。"
msgstr "Full bellies are back, as if the famine never happened."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.WELCOME_1"
msgid "{pair}迎接了新来的同伴。"
msgstr "{pair} welcomed the newcomer."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.WELCOME_2"
msgid "{pair}帮新来的同伴安顿下来,讲了讲基地的规矩。"
msgstr "{pair} helped the newcomer settle in and explained the base's rules."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.WELCOME_3"
msgid "打印舱又吐出一个新人,{pair}第一个迎了上去。"
msgstr "The printing pod spat out another newcomer, and {pair} were the first to greet them."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.WELCOME_4"
msgid "新人的第一顿饭,是{pair}陪着吃的。"
msgstr "The newcomer's first meal was shared with {pair}."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.STRESS_BAD_1"
msgid "{subject}的压力又重了一分。"
msgstr "{subject}'s stress grew heavier."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.STRESS_BAD_2"
msgid "{subject}的眉头又拧紧了一分。"
msgstr "{subject}'s brow creased a notch tighter."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.STRESS_BAD_3"
msgid "弦绷得太久,{subject}自己都能听见响声。"
msgstr "A string pulled taut for too long — {subject} can almost hear it hum."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.STRESS_GOOD_1"
msgid "{subject}松了一口气。"
msgstr "{subject} breathed a sigh of relief."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.STRESS_GOOD_2"
msgid "{subject}睡了个好觉,脸色缓过来了。"
msgstr "{subject} finally got a good night's sleep, and it shows."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.STRESS_GOOD_3"
msgid "压在心口的那块浮土,{subject}总算掸掉了些。"
msgstr "The weight on {subject}'s chest has lifted a little."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.GREET_LOUD_1"
msgid "{actor}大老远就冲{other}嚷了一嗓子问好。"
msgstr "{actor} bellowed a hello at {other} from across the room."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.GREET_HOTHEAD_1"
msgid "{actor}打招呼跟下命令似的,{other}还是应了。"
msgstr "{actor}'s greeting sounded like an order; {other} answered anyway."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.GREET_NERVOUS_1"
msgid "{actor}左右看了看,才小声跟{other}打了招呼。"
msgstr "{actor} glanced around before quietly saying hi to {other}."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.GREET_GENTLE_1"
msgid "{actor}轻轻朝{other}点了点头,笑得很暖。"
msgstr "{actor} gave {other} a soft nod and a warm smile."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.GREET_EATER_1"
msgid "{actor}嘴里还嚼着米虱糕,含混地跟{other}打了招呼。"
msgstr "Mouth full of lice loaf, {actor} mumbled a greeting to {other}."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.CHAT_LOUD_1"
msgid "{actor}大着嗓门跟{other}聊了个痛快。"
msgstr "{actor} chatted with {other} at full volume, thoroughly enjoying it."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.CHAT_HOTHEAD_1"
msgid "{actor}说着说着就提高了音量,{other}居然没介意。"
msgstr "{actor}'s voice kept rising; {other} somehow didn't mind."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.CHAT_HOTHEAD_2"
msgid "{actor}越聊越激动,差点拍了桌子。"
msgstr "{actor} got so worked up mid-chat they nearly slammed the table."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.CHAT_NERVOUS_1"
msgid "{actor}压低声音跟{other}嘀咕了半天,不知在担心什么。"
msgstr "{actor} muttered to {other} in hushed tones, worried about who knows what."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.CHAT_GENTLE_1"
msgid "{actor}说话轻声细语,{other}听得直点头。"
msgstr "{actor} spoke softly, and {other} nodded along."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.CHAT_CRYBABY_1"
msgid "{actor}说着说着眼圈就红了,{other}赶紧岔开了话题。"
msgstr "{actor}'s eyes welled up mid-sentence; {other} quickly changed the subject."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.CHAT_EATER_1"
msgid "{actor}边吃边聊,{other}的话头总被咀嚼声盖过去。"
msgstr "{actor} talked between bites, chewing over {other}'s every sentence."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.MEAL_EATER_1"
msgid "{actor}把自己那份点心拨给了{other}。"
msgstr "{actor} slid their own dessert onto {other}'s tray."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.MEAL_EATER_2"
msgid "{pair}的餐盘收得格外干净。"
msgstr "{pair}'s trays came back spotless."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.MEAL_GENTLE_1"
msgid "{actor}把热乎的那份让给了{other}。"
msgstr "{actor} gave {other} the warmer portion."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.MEAL_LOUD_1"
msgid "{pair}这桌最热闹,{actor}的嗓门半个餐厅都听得见。"
msgstr "{pair}'s table was the loudest; half the mess hall heard {actor}."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.MEAL_HOTHEAD_1"
msgid "{actor}嫌饭菜淡了,{other}默默把盐罐推了过去。"
msgstr "{actor} complained the food was bland; {other} quietly passed the salt."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.MEAL_NERVOUS_1"
msgid "{actor}吃得心不在焉,{other}问了三遍才应声。"
msgstr "{actor} picked at the food distractedly; {other} had to ask three times."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.REST_NERVOUS_1"
msgid "{actor}翻来覆去睡不着,{other}陪着说了会儿话。"
msgstr "{actor} tossed and turned; {other} stayed up talking a while."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.REST_CRYBABY_1"
msgid "{actor}夜里掉了几滴眼泪,{other}装作没听见。"
msgstr "{actor} shed a few tears in the night; {other} pretended not to hear."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.REST_LOUD_1"
msgid "{actor}的呼噜声,{other}听了一整夜。"
msgstr "{other} spent the whole night listening to {actor}'s snoring."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.REST_GENTLE_1"
msgid "{actor}起夜轻手轻脚,生怕吵醒{other}。"
msgstr "{actor} tiptoed around at night, careful not to wake {other}."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.REST_EATER_1"
msgid "{actor}睡前又摸出一块点心,{other}闻着香味睡不着。"
msgstr "{actor} snuck out a snack before bed; the smell kept {other} awake."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.SOCIALIZE_HOTHEAD_1"
msgid "玩游戏时{actor}又急了眼,{other}笑着让了他一把。"
msgstr "{actor} lost their temper over a game again; {other} laughed and went easy on them."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.SOCIALIZE_LOUD_1"
msgid "就数{actor}的笑声最响,{other}的耳朵遭了殃。"
msgstr "{actor}'s laughter rang loudest of all; {other}'s ears paid the price."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.SOCIALIZE_CRYBABY_1"
msgid "{actor}输了游戏差点哭出来,{other}赶紧让了他一局。"
msgstr "{actor} nearly cried over losing a game; {other} quickly threw the next round."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.SOCIALIZE_GENTLE_1"
msgid "{actor}总把输赢让给{other},两个人都玩得开心。"
msgstr "{actor} kept letting {other} win, and both had a great time."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.SOCIALIZE_NERVOUS_1"
msgid "{actor}玩得提心吊胆,{other}一直在旁边打气。"
msgstr "{actor} played on pins and needles while {other} cheered them on."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.VENT_CRYBABY_1"
msgid "{actor}说着说着就哭了,{other}默默递了张纸巾。"
msgstr "{actor} burst into tears mid-vent; {other} silently offered a tissue."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.VENT_HOTHEAD_1"
msgid "{actor}骂骂咧咧倒完苦水,{other}从头听到尾。"
msgstr "{actor} cursed through the whole story; {other} heard them out to the end."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.VENT_NERVOUS_1"
msgid "{actor}絮絮叨叨说了半天担心,{other}一条条帮他理清。"
msgstr "{actor} rattled off worry after worry; {other} helped sort them one by one."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.VENT_LOUD_1"
msgid "{actor}的苦水,半个休息区都听见了。"
msgstr "{actor}'s troubles were audible across half the rec room."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.VENT_GENTLE_1"
msgid "{actor}连诉苦都轻声细语,{other}听得格外认真。"
msgstr "{actor} even complained softly; {other} listened all the more carefully."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.CHAT_EX_1"
msgid "{pair}聊了几句,客气得像刚认识。"
msgstr "{pair} exchanged a few words, polite as strangers."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.CHAT_RIVAL_1"
msgid "{pair}话里带刺,聊得像在过招。"
msgstr "{pair} traded barbed words; the chat was a duel."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.CHAT_CRUSH_1"
msgid "{pair}聊着聊着,目光就躲到了别处。"
msgstr "{pair} chatted, eyes drifting away from each other."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.CHAT_COLD_1"
msgid "{pair}僵着脖子,交换了几句必要的话。"
msgstr "{pair} stiffly exchanged the few words that were necessary."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.CHAT_COUPLE_1"
msgid "{pair}凑在一起说悄悄话,旁若无人。"
msgstr "{pair} whispered together, oblivious to everyone else."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.MEAL_EX_1"
msgid "{pair}同桌吃饭,各自盯着餐盘。"
msgstr "{pair} shared a table, each staring at their own tray."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.MEAL_RIVAL_1"
msgid "{pair}同桌吃饭,刀叉碰得格外响。"
msgstr "{pair} shared a table; the cutlery clattered louder than usual."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.MEAL_CRUSH_1"
msgid "{pair}同桌吃饭,谁都吃得心不在焉。"
msgstr "{pair} shared a table, neither really tasting the food."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.REST_EX_1"
msgid "{pair}同屋睡了一晚,谁也没提从前。"
msgstr "{pair} shared a room for the night; neither mentioned the past."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.REST_RIVAL_1"
msgid "{pair}同屋睡了一晚,背对着背。"
msgstr "{pair} shared a room for the night, back to back."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.REST_CRUSH_1"
msgid "{pair}同屋睡了一晚,都睡得不踏实。"
msgstr "{pair} shared a room for the night; neither slept soundly."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.REST_COLD_1"
msgid "{pair}同屋睡了一晚,屋里冷得像冰窖。"
msgstr "{pair} shared a room for the night; the air was freezing."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.REST_COUPLE_1"
msgid "{pair}挤一张床睡了一晚,醒来还牵着手。"
msgstr "{pair} squeezed into one bunk and woke up holding hands."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.GREET_BRAWL_BOND_1"
msgid "{pair}一照面就乐了,谁还记得当初那一架。"
msgstr "{pair} grinned at each other on sight — who remembers that old brawl?"

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.CHAT_BRAWL_BOND_1"
msgid "{pair}聊得热络——不打不相识。"
msgstr "{pair} hit it off — no friendship like one forged in a fight."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.CHAT_COMRADE_1"
msgid "{pair}聊起那次死里逃生,话就没个完。"
msgstr "{pair} got talking about that narrow escape and couldn't stop."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.MEAL_COMRADE_1"
msgid "{pair}边吃边碰了碰杯,过命的交情都在里头。"
msgstr "{pair} clinked cups over the meal — a bond forged in danger."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.CHAT_WAITED_1"
msgid "{pair}有说有笑,当初那次拒绝如今成了笑谈。"
msgstr "{pair} laughed together; that old rejection is just a funny story now."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.MEAL_WAITED_1"
msgid "{pair}挨着坐下,这顿饭等了不止一天。"
msgstr "{pair} sat close; this meal was a long time coming."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.SEQ_APOLOGY"
msgid "继那次争吵之后,"
msgstr "After that argument, "

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.SEQ_CONFESSION_AFTER_FAIL"
msgid "上次的拒绝没有让{actor}放弃,"
msgstr "The last rejection did not stop {actor}, "

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.SEQ_REKINDLE"
msgid "分开之后,他们还是放不下彼此,"
msgstr "After the time apart, they still could not let each other go, "

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.SEQ_COMFORT"
msgid "目睹了那场崩溃之后,"
msgstr "After witnessing that breakdown, "

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.SEQ_RECONCILE"
msgid "冷战了这些日子,"
msgstr "After all these days of silence, "

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.SEQ_BRAWL"
msgid "那场争吵终究没收住,"
msgstr "That quarrel could not be contained, "

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.SEQ_RIVAL"
msgid "积怨已久,"
msgstr "Resentment had been building for a long time, "

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.SEQ_BREAKUP"
msgid "裂痕再也没能弥合,"
msgstr "The rift never healed, "

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.RECUR_AGAIN"
msgid "又一次,"
msgstr "Once again, "

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.RECUR_MANY"
msgid "这已经是第{0}次了,"
msgstr "For the {0}th time, "

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.ERA_FAMINE"
msgid "在断粮的阴影下,"
msgstr "In the shadow of the famine, "

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.ERA_WRATH"
msgid "在众怒未平的日子里,"
msgstr "In those days of unspent anger, "

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.REACT_GOOD_1"
msgid "消息很快传开,大家都在谈论他们。"
msgstr "Word spread quickly; everyone was talking about them."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.REACT_GOOD_2"
msgid "整个殖民地都替他们高兴。"
msgstr "The whole colony was happy for them."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.REACT_BAD_1"
msgid "殖民地里的空气沉了几天。"
msgstr "The air in the colony hung heavy for days."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.REACT_BAD_2"
msgid "大家看在眼里,都不好受。"
msgstr "Everyone saw it, and no one felt good about it."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.MERGE_CHAT_1"
msgid "{pair}这天凑在一起聊了好几回。"
msgstr "{pair} kept finding each other to talk that day."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.MERGE_CHAT_2"
msgid "{pair}这一天有说不完的话。"
msgstr "{pair} had no end of things to say that day."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.MERGE_GREET_1"
msgid "{pair}这一天打了不少照面,越来越熟络。"
msgstr "{pair} kept crossing paths that day, and grew familiar."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.MERGE_MEAL_1"
msgid "{pair}这天一起吃了好几顿饭。"
msgstr "{pair} shared several meals that day."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.MERGE_SOCIALIZE_1"
msgid "{pair}这天一有空就凑在一块儿玩。"
msgstr "{pair} spent every spare moment together that day."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.TOPIC_WORK"
msgid "手上的活计"
msgstr "the work at hand"

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.TOPIC_ROLE"
msgid "彼此的差事"
msgstr "their respective duties"

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.TOPIC_MINING"
msgid "挖掘的进展"
msgstr "how the digging was going"

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.TOPIC_BUILDING"
msgid "建造的门道"
msgstr "the tricks of construction"

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.TOPIC_COOKING"
msgid "新琢磨的菜谱"
msgstr "a new recipe"

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.TOPIC_FARMING"
msgid "庄稼的长势"
msgstr "how the crops were coming along"

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.TOPIC_RANCHING"
msgid "小动物的脾气"
msgstr "the critters' tempers"

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.TOPIC_RESEARCH"
msgid "研究的新发现"
msgstr "a new finding from the lab"

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.TOPIC_OPERATING"
msgid "机器的维护"
msgstr "machine maintenance"

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.TOPIC_DOCTORING"
msgid "包扎的手法"
msgstr "bandaging technique"

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.TOPIC_HAULING"
msgid "搬货的路线"
msgstr "the best hauling routes"

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.TOPIC_ART"
msgid "新挂的装饰"
msgstr "the new decor"

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.TOPIC_ATHLETICS"
msgid "锻炼的心得"
msgstr "workout routines"

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.TOPIC_SUITS"
msgid "穿气压服的窍门"
msgstr "atmo suit tips"

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.TOPIC_JOB_MINER"
msgid "矿道里的事"
msgstr "things down in the mines"

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.TOPIC_JOB_BUILDER"
msgid "新盖的走廊"
msgstr "the newly built corridors"

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.TOPIC_JOB_COOK"
msgid "灶台上的新花样"
msgstr "new tricks at the stove"

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.TOPIC_JOB_FARMER"
msgid "地里的收成"
msgstr "the harvest in the fields"

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.TOPIC_JOB_RANCHER"
msgid "圈里的小家伙们"
msgstr "the little critters in the pen"

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.TOPIC_JOB_RESEARCHER"
msgid "实验台前的发现"
msgstr "findings from the lab bench"

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.TOPIC_JOB_OPERATOR"
msgid "机器的毛病"
msgstr "the machines' quirks"

msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.TOPIC_JOB_DOCTOR"
msgid "医务室的药箱"
msgstr "the med bay's supplies"

msgctxt "ONIAiSocial.STRINGS.SOCIAL.ANNOUNCE.INTRO_TITLE"
msgid "社交生活已开始"
msgstr "Social life has begun"

msgctxt "ONIAiSocial.STRINGS.SOCIAL.ANNOUNCE.INTRO_BODY"
msgid "复制人有了自己的社交生活：聊天、交友、恋爱、争执都会自然发生。顶部管理菜单的「社交」可以旁观全局并牵线搭桥；复制人详情的「社交」标签可以查看每个人的关系。"
msgstr "Your duplicants now have social lives of their own: chatting, friendships, romance and quarrels all happen naturally. Open the Social entry in the top management menu to watch the colony and play matchmaker; each duplicant's Social tab shows their relationships."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.ANNOUNCE.CONFESSION_TITLE"
msgid "喜结连理"
msgstr "A New Couple"

msgctxt "ONIAiSocial.STRINGS.SOCIAL.ANNOUNCE.CONFESSION_BODY"
msgid "{0} 向 {1} 告白成功，两人正式成为恋人！"
msgstr "{0} confessed to {1} — they are now a couple!"

msgctxt "ONIAiSocial.STRINGS.SOCIAL.ANNOUNCE.BREAKUP_TITLE"
msgid "分手了"
msgstr "Broken Up"

msgctxt "ONIAiSocial.STRINGS.SOCIAL.ANNOUNCE.BREAKUP_BODY"
msgid "{0} 和 {1} 的感情走到了尽头。"
msgstr "{0} and {1} have gone their separate ways."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.ANNOUNCE.STRAW_SUFFIX"
msgid "压垮感情的最后一根稻草：{0}（周期 {1}）。"
msgstr " The final straw: {0} (cycle {1})."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.ANNOUNCE.WIDOWED_TITLE"
msgid "失去了伴侣"
msgstr "Lost a Partner"

msgctxt "ONIAiSocial.STRINGS.SOCIAL.ANNOUNCE.WIDOWED_BODY"
msgid "{0} 失去了伴侣 {1}，陷入悲伤。"
msgstr "{0} lost their partner {1} and is grieving."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.ANNOUNCE.COLDWAR_TITLE"
msgid "冷战"
msgstr "Cold War"

msgctxt "ONIAiSocial.STRINGS.SOCIAL.ANNOUNCE.COLDWAR_BODY"
msgid "{0} 和 {1} 进入冷战，关系岌岌可危。给他们一个牵线标记可以促成和解。"
msgstr "{0} and {1} are giving each other the cold shoulder. A matchmaking mark can nudge them toward reconciliation."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.ANNOUNCE.RECONCILE_TITLE"
msgid "和好如初"
msgstr "Reconciled"

msgctxt "ONIAiSocial.STRINGS.SOCIAL.ANNOUNCE.RECONCILE_BODY"
msgid "{0} 和 {1} 冰释前嫌，重归于好。"
msgstr "{0} and {1} have patched things up."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.ANNOUNCE.MOURNING_TITLE"
msgid "默默哀悼"
msgstr "Quiet Mourning"

msgctxt "ONIAiSocial.STRINGS.SOCIAL.ANNOUNCE.MOURNING_BODY"
msgid "{0} 在心里悼念逝去的 {1}。"
msgstr "{0} quietly mourns the late {1}."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.ANNOUNCE.BESTFRIEND_TITLE"
msgid "挚友"
msgstr "Best Friends"

msgctxt "ONIAiSocial.STRINGS.SOCIAL.ANNOUNCE.BESTFRIEND_BODY"
msgid "{0} 和 {1} 成为彼此的挚友。"
msgstr "{0} and {1} are now best friends."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.ANNOUNCE.COHESION_ON_TITLE"
msgid "殖民地羁绊"
msgstr "Colony Cohesion"

msgctxt "ONIAiSocial.STRINGS.SOCIAL.ANNOUNCE.COHESION_ON_BODY"
msgid "殖民地人心凝聚，全员士气提升。"
msgstr "The colony stands together. Morale up for everyone."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.ANNOUNCE.DISCORD_ON_TITLE"
msgid "殖民地不和"
msgstr "Colony Discord"

msgctxt "ONIAiSocial.STRINGS.SOCIAL.ANNOUNCE.DISCORD_ON_BODY"
msgid "殖民地气氛紧张，全员士气受挫。"
msgstr "Tensions run high. Morale down for everyone."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.ANNOUNCE.COHESION_OFF_TITLE"
msgid "气氛回归平静"
msgstr "Back to Normal"

msgctxt "ONIAiSocial.STRINGS.SOCIAL.ANNOUNCE.COHESION_OFF_BODY"
msgid "殖民地的集体情绪回到了平常状态。"
msgstr "The colony's collective mood has settled down."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.ANNOUNCE.ANNIVERSARY_TITLE"
msgid "纪念日"
msgstr "Anniversary"

msgctxt "ONIAiSocial.STRINGS.SOCIAL.ANNOUNCE.ANNIVERSARY_BODY"
msgid "{0} 和 {1} 的纪念日约会圆满结束，甜蜜加倍。"
msgstr "{0} and {1} celebrated their anniversary date. Twice as sweet."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.ANNOUNCE.ANNIVERSARY_MISSED_TITLE"
msgid "错过的纪念日"
msgstr "Missed Anniversary"

msgctxt "ONIAiSocial.STRINGS.SOCIAL.ANNOUNCE.ANNIVERSARY_MISSED_BODY"
msgid "{0} 和 {1} 的纪念日在忙碌中溜走了，两人都有点闷闷不乐。"
msgstr "{0} and {1} let their anniversary slip by. Both are a little glum."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.ANNOUNCE.FALLOUT_TITLE"
msgid "闹掰了"
msgstr "Falling-Out"

msgctxt "ONIAiSocial.STRINGS.SOCIAL.ANNOUNCE.FALLOUT_BODY"
msgid "{0} 和 {1} 积怨爆发，正式闹掰——一段时间内感情难以升温，一次道歉就能和好清账。"
msgstr "{0} and {1} have had a falling-out. Warmth will be slow to return for a while, but one apology clears the air."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.ANNOUNCE.COMFORT_TITLE"
msgid "低谷陪伴"
msgstr "Quiet Company"

msgctxt "ONIAiSocial.STRINGS.SOCIAL.ANNOUNCE.COMFORT_BODY"
msgid "{0} 坐在 {1} 身边，默默陪伴着悲伤中的伙伴。"
msgstr "{0} sits with {1}, quietly keeping them company through the grief."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.ANNOUNCE.LOVE_MATURE_TITLE"
msgid "老夫老妻"
msgstr "Seasoned Love"

msgctxt "ONIAiSocial.STRINGS.SOCIAL.ANNOUNCE.LOVE_MATURE_BODY"
msgid "{0} 和 {1} 相伴日久，感情进入细水长流的阶段。"
msgstr "{0} and {1} have been together a long while. Their love has settled into a steady warmth."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.ANNOUNCE.RIVAL_TITLE"
msgid "结下宿敌"
msgstr "A rivalry is born"

msgctxt "ONIAiSocial.STRINGS.SOCIAL.ANNOUNCE.RIVAL_BODY"
msgid "{0} 和 {1} 积怨到底，正式结下宿敌——这段关系不再自行回暖，除非你出手牵线调解。"
msgstr "{0} and {1} have nursed their grudge to the bottom and are now rivals. This relationship will no longer warm up on its own unless you step in with a matchmaking mark."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.ANNOUNCE.RIVAL_OVER_TITLE"
msgid "宿敌和解"
msgstr "Rivalry settled"

msgctxt "ONIAiSocial.STRINGS.SOCIAL.ANNOUNCE.RIVAL_OVER_BODY"
msgid "{0} 和 {1} 的宿怨终于化开，关系回到了正常轨道。"
msgstr "{0} and {1} have finally let the grudge go. Things are back to normal between them."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.ANNOUNCE.BRAWL_TITLE"
msgid "打起来了！"
msgstr "They're fighting!"

msgctxt "ONIAiSocial.STRINGS.SOCIAL.ANNOUNCE.BRAWL_BODY"
msgid "{0} 和 {1} 从争吵升级成互殴。点到为止，但两人都要挂彩。"
msgstr "An argument between {0} and {1} has escalated into a brawl. They will stop short of serious harm, but both are going to be bruised."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.ANNOUNCE.WRATH_BLAME_TITLE"
msgid "总得有人负责"
msgstr "Somebody has to answer for it"

msgctxt "ONIAiSocial.STRINGS.SOCIAL.ANNOUNCE.WRATH_BLAME_BODY"
msgid "殖民地刚出了事，而 {0} 是人缘垫底的那个——帐就这么算在 TA 头上了。现在把 TA 和一位受人敬重的同事牵线，那人会站出来说句公道话；错过这段时间，TA 会被孤立起来。"
msgstr "The colony has just been through something, and {0} is the least liked person here - so the bill lands on them. Pair them with a well-respected colleague now and that person will speak up; miss this window and {0} gets frozen out."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.ANNOUNCE.WRATH_ISOLATED_TITLE"
msgid "没人跟他说话了"
msgstr "Nobody talks to them anymore"

msgctxt "ONIAiSocial.STRINGS.SOCIAL.ANNOUNCE.WRATH_ISOLATED_BODY"
msgid "没人替 {0} 说话。现在起同事路过会别开脸，同桌的人提前离席。任何一个人愿意去照顾 TA、找 TA 聊聊或一起吃顿饭，这件事就到此为止。"
msgstr "Nobody spoke up for {0}. From now on colleagues look away when they pass, and anyone sharing their table finishes early. It ends the moment a single person tends to them, talks with them, or eats with them."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.ANNOUNCE.WRATH_SPEAK_UP_TITLE"
msgid "有人说了句公道话"
msgstr "Somebody said the fair thing"

msgctxt "ONIAiSocial.STRINGS.SOCIAL.ANNOUNCE.WRATH_SPEAK_UP_BODY"
msgid "{0} 当众替 {1} 说了话。没人再提这件事了。"
msgstr "{0} spoke up for {1} in front of everyone. Nobody is bringing it up again."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.ANNOUNCE.WRATH_RESCUE_TITLE"
msgid "第一个坐下来的人"
msgstr "The first one to sit down"

msgctxt "ONIAiSocial.STRINGS.SOCIAL.ANNOUNCE.WRATH_RESCUE_BODY"
msgid "{0} 坐到了 {1} 旁边。孤立到此结束——这种事从来只需要一个人先动。"
msgstr "{0} sat down next to {1}. The freeze-out ends here - it only ever takes one person going first."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.ANNOUNCE.WRATH_PUNCH_TITLE"
msgid "没人看见"
msgstr "Nobody saw it"

msgctxt "ONIAiSocial.STRINGS.SOCIAL.ANNOUNCE.WRATH_PUNCH_BODY"
msgid "四下无人的时候，{0} 动手打了 {1}。同事都不知道——这件事只有你看见了。"
msgstr "With nobody around, {0} hit {1}. None of their colleagues know - you are the only one who saw this."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.ANNOUNCE.WRATH_FADED_TITLE"
msgid "被淡忘了"
msgstr "Forgotten about"

msgctxt "ONIAiSocial.STRINGS.SOCIAL.ANNOUNCE.WRATH_FADED_BODY"
msgid "没人救 {0}，但也没人再记得那件事了。日子照过。"
msgstr "Nobody came for {0}, but nobody remembers the whole business either. Life goes on."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.ANNOUNCE.BREAKDOWN_TITLE"
msgid "整个房间都看着"
msgstr "The whole room is watching"

msgctxt "ONIAiSocial.STRINGS.SOCIAL.ANNOUNCE.BREAKDOWN_BODY"
msgid "{0} 当场{2}，{1} 个人停下来看着他。这几个周期里，有人愿意过去坐一下的话，他会记一辈子。"
msgstr "{0} {2} right there, and {1} of them stopped to watch. For the next few cycles, anyone willing to go over and sit with them will be remembered for it forever."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.ANNOUNCE.BREAKDOWN_COMFORT_TITLE"
msgid "第一个坐下来的人"
msgstr "The first one to sit down"

msgctxt "ONIAiSocial.STRINGS.SOCIAL.ANNOUNCE.BREAKDOWN_COMFORT_BODY"
msgid "{0} 过去陪 {1} 坐了一会儿。没说什么要紧的话——但 {1} 会一直记得是谁第一个过来。"
msgstr "{0} went over and sat with {1} for a while. Nothing important was said - but {1} will always remember who came over first."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.ANNOUNCE.BRAWL_BOND_TITLE"
msgid "不打不相识"
msgstr "Fought it out"

msgctxt "ONIAiSocial.STRINGS.SOCIAL.ANNOUNCE.BRAWL_BOND_BODY"
msgid "{0} 和 {1} 打完这一架反而认了对方，宿怨就此了结。"
msgstr "{0} and {1} came out of that fight with a grudging respect for each other. The rivalry is over."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.ANNOUNCE.FAMINE_WARNING_TITLE"
msgid "粮仓见底了"
msgstr "The pantry is empty"

msgctxt "ONIAiSocial.STRINGS.SOCIAL.ANNOUNCE.FAMINE_WARNING_BODY"
msgid "储藏室空了，多人正在挨饿。再这样下去，他们会开始自己想办法——现在补上粮食还来得及。"
msgstr "The larder is bare and several duplicants are starving. Left like this, they will start solving the problem themselves - there is still time to get food in."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.ANNOUNCE.FAMINE_AVERTED_TITLE"
msgid "危机解除"
msgstr "Crisis averted"

msgctxt "ONIAiSocial.STRINGS.SOCIAL.ANNOUNCE.FAMINE_AVERTED_BODY"
msgid "食物及时送到，殖民地从边缘退了回来。没有人提起前几天在想什么。"
msgstr "Food arrived in time and the colony stepped back from the edge. Nobody mentions what they were thinking a few days ago."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.ANNOUNCE.FAMINE_CULL_TITLE"
msgid "活下去！"
msgstr "Survive!"

msgctxt "ONIAiSocial.STRINGS.SOCIAL.ANNOUNCE.FAMINE_CULL_BODY"
msgid "{0} 和 {1} 之间的事已经不是吵架了。饥饿把最后一点体面也拿走了。"
msgstr "Whatever is between {0} and {1}, it stopped being an argument a while ago. Hunger has taken the last of their decency."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.ANNOUNCE.FAMINE_OVER_TITLE"
msgid "饥荒过去了"
msgstr "The famine has passed"

msgctxt "ONIAiSocial.STRINGS.SOCIAL.ANNOUNCE.FAMINE_OVER_BODY"
msgid "储藏室重新有了食物。没有人问那是什么。"
msgstr "There is food in the larder again. Nobody asks what it is."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.ANNOUNCE.FAMINE_LAST_ONE_TITLE"
msgid "最后的殖民者"
msgstr "The last colonist"

msgctxt "ONIAiSocial.STRINGS.SOCIAL.ANNOUNCE.FAMINE_LAST_ONE_BODY"
msgid "只剩一个人了。基地很安静，食物也够了。"
msgstr "One left. The base is very quiet now, and there is plenty to eat."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.ANNOUNCE.RIVAL_DIED_TITLE"
msgid "对头不在了"
msgstr "The rival is gone"

msgctxt "ONIAiSocial.STRINGS.SOCIAL.ANNOUNCE.RIVAL_DIED_BODY"
msgid "{1} 走了。{0} 嘴上什么都没说，心情却好了一阵。"
msgstr "{1} is dead. {0} said nothing about it, and has been in a noticeably good mood since."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.DEATHS.SURVIVE.NAME"
msgid "活下去"
msgstr "Survival"

msgctxt "ONIAiSocial.STRINGS.SOCIAL.DEATHS.SURVIVE.DESC"
msgid "在粮仓见底的日子里，被同伴夺去了性命。"
msgstr "Killed by a fellow colonist in the days after the pantry ran dry."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.FOOD.CANNIBAL_MEAT.NAME"
msgid "「同事」肉"
msgstr "\"Colleague\" Meat"

msgctxt "ONIAiSocial.STRINGS.SOCIAL.FOOD.CANNIBAL_MEAT.DESC"
msgid "断粮那几天留下来的。没有人问这是谁，也没有人愿意先动筷子。"
msgstr "Left over from the days the food ran out. Nobody asks whose it is, and nobody wants to reach for it first."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.EFFECTS.LOVE.NAME"
msgid "恋爱中"
msgstr "In Love"

msgctxt "ONIAiSocial.STRINGS.SOCIAL.EFFECTS.LOVE.DESC"
msgid "有心上人了，士气提升。"
msgstr "Has a sweetheart. Morale up."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.EFFECTS.LOVE_MATURE.NAME"
msgid "老夫老妻"
msgstr "Seasoned Love"

msgctxt "ONIAiSocial.STRINGS.SOCIAL.EFFECTS.LOVE_MATURE.DESC"
msgid "相伴已久,是彼此最安心的存在。士气大幅提升。"
msgstr "Long together, and each other's safest place. Morale way up."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.EFFECTS.DATE_AFTERGLOW.NAME"
msgid "约会余韵"
msgstr "Date Afterglow"

msgctxt "ONIAiSocial.STRINGS.SOCIAL.EFFECTS.DATE_AFTERGLOW.DESC"
msgid "刚度过愉快的约会，士气提升。"
msgstr "Fresh from a lovely date. Morale up."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.EFFECTS.CANNIBAL.NAME"
msgid "吃了同事"
msgstr "Ate a colleague"

msgctxt "ONIAiSocial.STRINGS.SOCIAL.EFFECTS.CANNIBAL.DESC"
msgid "那顿饭是谁，心里清楚。有些事情吃下去就吐不出来了。"
msgstr "They know exactly who that meal was. Some things do not come back up once they are down."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.EFFECTS.RIVAL_DIED.NAME"
msgid "幸灾乐祸"
msgstr "Schadenfreude"

msgctxt "ONIAiSocial.STRINGS.SOCIAL.EFFECTS.RIVAL_DIED.DESC"
msgid "看不顺眼的那个人不在了。嘴上不说，心情确实不错。"
msgstr "That one duplicant they could not stand is gone. They would never say so out loud, but the mood is good."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.EFFECTS.GRIEF.NAME"
msgid "丧偶悲伤"
msgstr "Grieving"

msgctxt "ONIAiSocial.STRINGS.SOCIAL.EFFECTS.GRIEF.DESC"
msgid "失去了心上人，士气下降。"
msgstr "Lost a sweetheart. Morale down."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.EFFECTS.GRIEF_SOFT.NAME"
msgid "丧偶悲伤（有人陪着）"
msgstr "Grieving (Supported)"

msgctxt "ONIAiSocial.STRINGS.SOCIAL.EFFECTS.GRIEF_SOFT.DESC"
msgid "失去了心上人，但殖民地的陪伴减轻了痛苦。"
msgstr "Lost a sweetheart, but the colony's warmth softens the blow."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.EFFECTS.COLONY_COHESION.NAME"
msgid "殖民地羁绊"
msgstr "Colony Cohesion"

msgctxt "ONIAiSocial.STRINGS.SOCIAL.EFFECTS.COLONY_COHESION.DESC"
msgid "殖民地上下一条心，全员士气提升。"
msgstr "The colony stands together. Morale up for everyone."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.EFFECTS.COLONY_DISCORD.NAME"
msgid "殖民地不和"
msgstr "Colony Discord"

msgctxt "ONIAiSocial.STRINGS.SOCIAL.EFFECTS.COLONY_DISCORD.DESC"
msgid "殖民地关系紧张，全员士气下降。"
msgstr "Tensions run high. Morale down for everyone."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.EFFECTS.SIDE_BY_SIDE.NAME"
msgid "并肩作战"
msgstr "Side by Side"

msgctxt "ONIAiSocial.STRINGS.SOCIAL.EFFECTS.SIDE_BY_SIDE.DESC"
msgid "和要好的人一起干活，效率提升。"
msgstr "Working alongside a friend. Efficiency up."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.EFFECTS.STRAINED.NAME"
msgid "情绪紧绷"
msgstr "Strained"

msgctxt "ONIAiSocial.STRINGS.SOCIAL.EFFECTS.STRAINED.DESC"
msgid "压力已经逼近极限，随时可能崩溃。找人聊聊、吃顿好的，或者让 TA 歇一歇。"
msgstr "Stress is close to the breaking point. A chat, a good meal or some downtime could pull them back."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.EFFECTS.STRAINED.BUBBLE"
msgid "深吸一口气……忍住了"
msgstr "Deep breath... holding it together"

msgctxt "ONIAiSocial.STRINGS.SOCIAL.EFFECTS.WRATH_ISOLATED.NAME"
msgid "被孤立"
msgstr "Frozen out"

msgctxt "ONIAiSocial.STRINGS.SOCIAL.EFFECTS.WRATH_ISOLATED.DESC"
msgid "殖民地出了事，而 TA 是人缘垫底的那个——所以帐算在 TA 头上了，跟事情是不是 TA 做的无关。有人愿意照顾 TA、找 TA 说话或跟 TA 一起吃顿饭，这个状态就会解除；再久一点，事情也会被淡忘。"
msgstr "Something went wrong in the colony and they were the least liked person here - so the bill landed on them, whether or not they had anything to do with it. It lifts the moment somebody tends to them, talks with them, or shares a meal; given long enough, it fades on its own."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.SETTINGS.TITLE"
msgid "社交生活 · 设置"
msgstr "Social Life · Settings"

msgctxt "ONIAiSocial.STRINGS.SOCIAL.SETTINGS.BUTTON"
msgid "设置"
msgstr "Settings"

msgctxt "ONIAiSocial.STRINGS.SOCIAL.SETTINGS.BUTTON_TOOLTIP"
msgid "打开「复制人社交生活」的设置面板"
msgstr "Open the settings panel for Duplicant Social Life"

msgctxt "ONIAiSocial.STRINGS.SOCIAL.SETTINGS.SAVE"
msgid "保存"
msgstr "Save"

msgctxt "ONIAiSocial.STRINGS.SOCIAL.SETTINGS.CANCEL"
msgid "取消"
msgstr "Cancel"

msgctxt "ONIAiSocial.STRINGS.SOCIAL.SETTINGS.RESET"
msgid "恢复默认"
msgstr "Restore defaults"

msgctxt "ONIAiSocial.STRINGS.SOCIAL.SETTINGS.SAVED_FEEDBACK"
msgid "已保存，并已对当前会话生效。"
msgstr "Saved and applied to the current session."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.SETTINGS.SAVE_FAILED"
msgid "保存失败，详情见日志。"
msgstr "Save failed, see the log for details."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.SETTINGS.RESET_FEEDBACK"
msgid "已恢复默认值，点「保存」后生效。"
msgstr "Defaults restored. Click Save to apply."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.SETTINGS.RESTART_SUFFIX"
msgid "（重启后生效）"
msgstr " (restart required)"

msgctxt "ONIAiSocial.STRINGS.SOCIAL.SETTINGS.ON"
msgid "开"
msgstr "On"

msgctxt "ONIAiSocial.STRINGS.SOCIAL.SETTINGS.OFF"
msgid "关"
msgstr "Off"

msgctxt "ONIAiSocial.STRINGS.SOCIAL.SETTINGS.SECTION_AI"
msgid "AI 对话"
msgstr "AI Dialogue"

msgctxt "ONIAiSocial.STRINGS.SOCIAL.SETTINGS.ENABLE_AI"
msgid "启用 AI 生成对话"
msgstr "Enable AI-generated dialogue"

msgctxt "ONIAiSocial.STRINGS.SOCIAL.SETTINGS.AI_WIP_HINT"
msgid "AI 台词尚未开发完善，默认关闭；关闭时全程使用内置台词，玩法完整"
msgstr "AI dialogue is still a work in progress and off by default. With it off, built-in lines cover the whole game."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.SETTINGS.BASE_URL"
msgid "API 地址"
msgstr "API base URL"

msgctxt "ONIAiSocial.STRINGS.SOCIAL.SETTINGS.API_KEY"
msgid "API Key"
msgstr "API key"

msgctxt "ONIAiSocial.STRINGS.SOCIAL.SETTINGS.MODEL"
msgid "模型"
msgstr "Model"

msgctxt "ONIAiSocial.STRINGS.SOCIAL.SETTINGS.BASE_URL_PLACEHOLDER"
msgid "https://api.example.com/v1"
msgstr "https://api.example.com/v1"

msgctxt "ONIAiSocial.STRINGS.SOCIAL.SETTINGS.API_KEY_PLACEHOLDER"
msgid "粘贴你的 API Key"
msgstr "Paste your API key"

msgctxt "ONIAiSocial.STRINGS.SOCIAL.SETTINGS.MODEL_PLACEHOLDER"
msgid "模型名称"
msgstr "Model name"

msgctxt "ONIAiSocial.STRINGS.SOCIAL.SETTINGS.LANGUAGE"
msgid "对话语言"
msgstr "Dialogue language"

msgctxt "ONIAiSocial.STRINGS.SOCIAL.SETTINGS.LANGUAGE_FOLLOW"
msgid "跟随游戏"
msgstr "Follow game"

msgctxt "ONIAiSocial.STRINGS.SOCIAL.SETTINGS.LANGUAGE_ZH"
msgid "中文"
msgstr "中文"

msgctxt "ONIAiSocial.STRINGS.SOCIAL.SETTINGS.LANGUAGE_EN"
msgid "English"
msgstr "English"

msgctxt "ONIAiSocial.STRINGS.SOCIAL.SETTINGS.MAX_CONVERSATIONS"
msgid "每周期 AI 对话上限"
msgstr "AI conversations per cycle"

msgctxt "ONIAiSocial.STRINGS.SOCIAL.SETTINGS.PAIR_COOLDOWN"
msgid "同一对复制人的对话冷却（秒）"
msgstr "Per-pair conversation cooldown (s)"

msgctxt "ONIAiSocial.STRINGS.SOCIAL.SETTINGS.TIMEOUT"
msgid "AI 请求超时（秒）"
msgstr "AI request timeout (s)"

msgctxt "ONIAiSocial.STRINGS.SOCIAL.SETTINGS.MAX_TOKENS"
msgid "单次生成上限（token）"
msgstr "Max tokens per generation"

msgctxt "ONIAiSocial.STRINGS.SOCIAL.SETTINGS.API_KEY_SET"
msgid "Key 已填写，保存后立即生效"
msgstr "Key entered; takes effect as soon as you save"

msgctxt "ONIAiSocial.STRINGS.SOCIAL.SETTINGS.API_KEY_MISSING"
msgid "未填写 Key，AI 对话不会发起，仅使用内置台词"
msgstr "No key set. AI dialogue stays off and built-in lines are used."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.SETTINGS.API_ENDPOINT_MISSING"
msgid "Key 已填写，但 API 地址或模型未填写/无效，AI 对话不会发起"
msgstr "Key is filled in, but the API address or model is missing or invalid - AI dialogue will not be attempted"

msgctxt "ONIAiSocial.STRINGS.SOCIAL.SETTINGS.SECTION_SOCIAL"
msgid "社交系统"
msgstr "Social System"

msgctxt "ONIAiSocial.STRINGS.SOCIAL.SETTINGS.OBSERVE_NATIVE"
msgid "观察原生社交事件（关系引擎输入）"
msgstr "Observe native social events (engine input)"

msgctxt "ONIAiSocial.STRINGS.SOCIAL.SETTINGS.LOCKED_SUFFIX"
msgid "（本版本固定开启）"
msgstr " (always on in this version)"

msgctxt "ONIAiSocial.STRINGS.SOCIAL.SETTINGS.OBSERVE_NATIVE_HINT"
msgid "关系引擎目前完全建立在原生社交事件之上，暂不支持关闭"
msgstr "The relationship engine is built entirely on native social events, so it cannot be turned off yet."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.SETTINGS.HOTKEYS"
msgid "F9/F10/F11 牵线热键"
msgstr "F9/F10/F11 matchmaking hotkeys"

msgctxt "ONIAiSocial.STRINGS.SOCIAL.SETTINGS.NOTIFICATIONS"
msgid "关系大事通知"
msgstr "Relationship event notifications"

msgctxt "ONIAiSocial.STRINGS.SOCIAL.SETTINGS.PRESENTATION_MODE"
msgid "关系事件演出"
msgstr "Relationship event presentation"

msgctxt "ONIAiSocial.STRINGS.SOCIAL.SETTINGS.PRESENTATION_COMPACT"
msgid "简洁"
msgstr "Compact"

msgctxt "ONIAiSocial.STRINGS.SOCIAL.SETTINGS.PRESENTATION_STANDARD"
msgid "标准"
msgstr "Standard"

msgctxt "ONIAiSocial.STRINGS.SOCIAL.SETTINGS.PRESENTATION_FOCUS"
msgid "聚焦"
msgstr "Focus"

msgctxt "ONIAiSocial.STRINGS.SOCIAL.SETTINGS.PRESENTATION_HINT"
msgid "标准不抢镜头；只有聚焦会自动移动镜头。不改变事件会不会发生，也不改变数值。"
msgstr "Standard does not move the camera. Only Focus automatically moves to the event. This does not change outcomes or values."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.SETTINGS.AUTO_PAUSE"
msgid "重大事件自动暂停"
msgstr "Pause on major events"

msgctxt "ONIAiSocial.STRINGS.SOCIAL.SETTINGS.AUTO_PAUSE_HINT"
msgid "独立开关，默认关闭。打开后重大关系事件发生时暂停游戏。"
msgstr "Independent setting, off by default. When enabled, major relationship events pause the game."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.SETTINGS.PENDING_WINDOW"
msgid "待发生窗口"
msgstr "Pending event window"

msgctxt "ONIAiSocial.STRINGS.SOCIAL.SETTINGS.PENDING_WINDOW_HINT"
msgid "关闭后告白等事件立即发生，但仍有演出和通知。不改变结果，只改变时机。"
msgstr "When disabled, confession events happen immediately but still have presentation and notifications. Only timing changes."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.SETTINGS.PENDING_CYCLES"
msgid "待发生等待周期"
msgstr "Pending window (cycles)"

msgctxt "ONIAiSocial.STRINGS.SOCIAL.SETTINGS.NOTIFY_MILESTONES"
msgid "关系里程碑通知"
msgstr "Relationship milestones"

msgctxt "ONIAiSocial.STRINGS.SOCIAL.SETTINGS.NOTIFY_GRIEF"
msgid "悲伤与失去通知"
msgstr "Grief and loss"

msgctxt "ONIAiSocial.STRINGS.SOCIAL.SETTINGS.NOTIFY_CONFLICT"
msgid "冲突与危险通知"
msgstr "Conflict and danger"

msgctxt "ONIAiSocial.STRINGS.SOCIAL.SETTINGS.NOTIFY_EVERYDAY"
msgid "日常纪念通知"
msgstr "Everyday commemorations"

msgctxt "ONIAiSocial.STRINGS.SOCIAL.SETTINGS.DELIVERY_OFF"
msgid "关闭"
msgstr "Off"

msgctxt "ONIAiSocial.STRINGS.SOCIAL.SETTINGS.DELIVERY_ARCHIVE"
msgid "仅封存"
msgstr "Archive only"

msgctxt "ONIAiSocial.STRINGS.SOCIAL.SETTINGS.DELIVERY_INSTANT"
msgid "即时通知"
msgstr "Instant"

msgctxt "ONIAiSocial.STRINGS.SOCIAL.SETTINGS.PENDING_TITLE"
msgid "一件重要的事即将发生"
msgstr "An important moment is coming"

msgctxt "ONIAiSocial.STRINGS.SOCIAL.SETTINGS.PENDING_BODY"
msgid "{0} 准备向 {1} 说一件重要的事，还剩 {2} 周期。"
msgstr "{0} is preparing to tell {1} something important. {2} cycles remain."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.SETTINGS.CHAT_FEED_COOLDOWN"
msgid "同一对复制人的好感进账间隔（秒）"
msgstr "Minimum interval between affinity gains for a pair (seconds)"

msgctxt "ONIAiSocial.STRINGS.SOCIAL.SETTINGS.CHAT_FEED_COOLDOWN_HINT"
msgid "原生聊天转化为好感的每对最短间隔，社交事件节奏的总阀门：聊天里的争执/告白/倾诉等判定机会随之增减。默认 150 ≈ 每对每周期 3-4 次进账；调小节奏更快，30 即旧版的刷屏节奏"
msgstr "Master valve for social event pacing: argument, confession and venting checks inside chats scale with it. Default 150 = 3-4 gains per pair per cycle; lower is faster, 30 restores the old rapid-fire pace."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.SETTINGS.LOG_CAPACITY"
msgid "纪事容量（条）"
msgstr "Chronicle capacity (entries)"

msgctxt "ONIAiSocial.STRINGS.SOCIAL.SETTINGS.LOG_CAPACITY_HINT"
msgid "事件日志滚动区的条数上限。默认 5000 条 ≈ 预留 1MB 存档空间（未压缩估算，压缩后远小于此）；告白/死亡等里程碑另存大事记，不占此额度。读档或新局后生效"
msgstr "Rolling section size of the event log. Default 5000 entries ≈ 1MB reserved (uncompressed estimate; far less after save compression). Milestones are kept in a separate section and don't count. Takes effect on next load or new colony."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.SETTINGS.SECTION_DARK"
msgid "黑暗内容（人性考验）"
msgstr "Dark content (tests of character)"

msgctxt "ONIAiSocial.STRINGS.SOCIAL.SETTINGS.DARK_CONTENT"
msgid "启用黑暗内容"
msgstr "Enable dark content"

msgctxt "ONIAiSocial.STRINGS.SOCIAL.SETTINGS.DARK_CONTENT_HINT"
msgid "总开关，默认关。打开后下面的黑暗事件才会生效——互殴、断粮相残，以及后续加入的人性考验事件。这些内容涉及复制人之间的暴力与死亡；不想要的话保持关闭即可，其余社交功能完全不受影响"
msgstr "Master switch, off by default. The dark events below only take effect once this is on - brawls, famine cannibalism, and the tests of character added later. This content involves violence and death between duplicants; leave it off if you would rather not have it, and every other social feature carries on unchanged."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.SETTINGS.DARK_GATE_CLOSED"
msgid "（黑暗内容总开关关闭中，下列项目暂不生效）"
msgstr "(Dark content is switched off, so the items below are inactive)"

msgctxt "ONIAiSocial.STRINGS.SOCIAL.SETTINGS.FAMINE"
msgid "允许断粮相残"
msgstr "Allow famine cannibalism"

msgctxt "ONIAiSocial.STRINGS.SOCIAL.SETTINGS.FAMINE_HINT"
msgid "粮仓见底且多人挨饿时，殖民地会陷入自相残杀，死者会被做成食物。事前有警告与倒数，这段时间补上粮食即可解除；一场事件只死一人，粮食恢复就停止；问题没解决的话会再次触发。这是本 Mod 最黑暗的内容，需要同时打开总开关"
msgstr "When the larder is empty and several duplicants are starving, the colony turns on itself and the dead become food. A warning and a countdown come first, and restocking during that window calls it off; one death per episode, and it stops once food recovers. This is the darkest content in the mod - it needs the master switch as well."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.SETTINGS.BREAKDOWN_DRAMA"
msgid "把崩溃演成一场戏"
msgstr "Play breakdowns as a scene"

msgctxt "ONIAiSocial.STRINGS.SOCIAL.SETTINGS.BREAKDOWN_DRAMA_HINT"
msgid "复制人压力满格真的崩溃时（嚎啕大哭／尖叫／呕吐／暴食／砸东西／放电），同房间的人会停下来看着他，事后在关系里留下「我看过他最糟的样子」。接下来几个周期内，第一个过去找他说话／照顾他／跟他同桌吃饭的人，会把他从崩溃里拉出来——两人好感大涨，那个人自己吃一点压力。你也可以直接牵线钦点谁去。**不改任何数值**：崩溃频率、压力、死亡率全部照旧，这一项只加演出、记忆与那道出口。预设开启"
msgstr "When a duplicant's stress maxes out and they actually break down (ugly crying / screaming / vomiting / binge eating / smashing things / throwing sparks), everyone in the room stops to watch, and the relationship keeps a memory of it. For the next few cycles, the first person to talk to them, tend to them or share their table pulls them out of it - a large affinity gain for both, and a little stress for the one who went. You can also pick that person yourself with a matchmaking mark. It changes no numbers: breakdown frequency, stress and death rate are all untouched. On by default."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.SETTINGS.HAZARD_RESENTMENT"
msgid "危险工时会积怨"
msgstr "Hazard duty breeds resentment"

msgctxt "ONIAiSocial.STRINGS.SOCIAL.SETTINGS.HAZARD_RESENTMENT_HINT"
msgid "同一个工种里，如果有人一直被派去危险的地方（低氧、不能呼吸的气体、正在窒息或烫伤冻伤），而另一个人从来没下去过，前者会开始记恨后者：好感只跌不涨，一路下去甚至可能结成宿敌。穿着气压服工作不算——所以「谁有气压服」自动变成一个社交问题。[b]出口在你身上[/b]：去改优先级。旧帐会滑出统计窗口，不平自然消退，还会留下「他最近也下来了」。这是整个 mod 里唯一一项由[b]你改变自己的管理方式[/b]来化解的内容，而且用的是游戏原生的操作，没有新界面。两个人[b]一起[/b]在危险里也算数：那会变成战友情。而同一件事在朋友之间是另一种结果——「他替我下去了」，好感反而上升。[b]不加任何压力、不扣任何东西[/b]：恶劣环境的压力游戏本身已经给过了。全殖民地同时最多两对处于不平。预设开启；「戏剧强度」设为「安静」时强制关闭"
msgstr "Within one trade, a duplicant who keeps getting sent somewhere dangerous (thin air, unbreathable gas, actively suffocating or burning or freezing) starts to resent the colleague who never goes down: affinity toward them can only fall, and it can end in outright rivalry. Working in an atmo suit does not count - which quietly turns \"who has a suit\" into a social question. The way out is yours: change the priorities. Old duty slides out of the rolling window, the grievance fades on its own, and it leaves behind \"they've been going down too lately\". This is the only feature in the mod resolved by you changing how you manage the colony, and it uses the game's own controls - no new UI. Two duplicants down there together counts as well: that becomes comradeship. And the same sacrifice reads differently between friends - \"they went down in my place\" raises affinity instead. It adds no stress and takes nothing away: the game already charges for bad environments. At most two grievances run at once. On by default; the Quiet drama preset force-disables it."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.SETTINGS.COLLECTIVE_WRATH"
msgid "允许集体迁怒"
msgstr "Allow collective scapegoating"

msgctxt "ONIAiSocial.STRINGS.SOCIAL.SETTINGS.COLLECTIVE_WRATH_HINT"
msgid "殖民地出大事之后（有人死亡／多人崩溃／粮仓见底），全员会把帐算在人缘最差的那个人头上，无论是不是 TA 的错：好感一次性下跌，接着滑进被孤立状态——垫底三人对 TA 只跌不涨、其他人路过会闪厌恶、同桌的人提前离席。两道出口都是玩家的工具：第一幕把 TA 和一位高声望者牵线，那人会仗义执言；第二幕任何人来照顾／倾诉／共餐都算破局。没人管也不会永久卡死，时间会冲淡。需要同时打开总开关；「戏剧强度」设为「安静」时强制关闭"
msgstr "After something bad happens to the colony (a death, several breakdowns, an empty larder), everyone pins it on whoever is least liked, guilty or not: a one-off affinity drop, then a slide into being frozen out - the three who like them least stop warming up at all, others flash disgust in passing, and tablemates leave early. Both exits are your tools: in act one, pair them with a well-respected colleague and that person will speak up; in act two, anyone tending, venting or eating with them breaks it. Nothing gets stuck forever - time fades it. Needs the master switch too, and Drama intensity set to Quiet disables it outright."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.SETTINGS.BRAWLS"
msgid "允许宿敌互殴"
msgstr "Allow rivals to brawl"

msgctxt "ONIAiSocial.STRINGS.SOCIAL.SETTINGS.BRAWLS_HINT"
msgid "宿敌之间的争执有几率升级成真的打起来：回合制互殴、点到为止（任一方掉到半血双双收手），宿敌互殴不会打死人（断粮相残是另一回事，见下）。默认关——想看好戏的自己开。拆散标记可以彻底禁止一对互殴；「戏剧强度」设为「安静」时即使打开也不会触发"
msgstr "Arguments between rivals can escalate into an actual fight: turn-based, and stopped short (both back off once either drops to half health) - rival brawls never kill (famine cannibalism is a separate matter, see below). Off by default; turn it on if you want the drama. A block mark bans brawling for a pair outright, and setting Drama intensity to Quiet disables it even when this is on."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.SETTINGS.BOOST_NATIVE"
msgid "调快原生对话节奏"
msgstr "Boost native conversation pacing"

msgctxt "ONIAiSocial.STRINGS.SOCIAL.SETTINGS.COOLDOWN_MULT"
msgid "原生对话冷却倍率"
msgstr "Native conversation cooldown multiplier"

msgctxt "ONIAiSocial.STRINGS.SOCIAL.SETTINGS.DISTANCE_MULT"
msgid "原生对话距离倍率"
msgstr "Native conversation distance multiplier"

