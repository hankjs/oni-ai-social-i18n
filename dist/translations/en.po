#. resolved-locale: en
#. STRINGS.SOCIAL.MANAGEMENT.UNDO_BUTTON
msgctxt "ONIAiSocial.STRINGS.SOCIAL.MANAGEMENT.UNDO_BUTTON"
msgid "撤销"
msgstr "Undo"

#. resolved-locale: en
#. STRINGS.SOCIAL.MANAGEMENT.UNDO_COMPLETED
msgctxt "ONIAiSocial.STRINGS.SOCIAL.MANAGEMENT.UNDO_COMPLETED"
msgid "已撤销上一项标记操作"
msgstr "Undid the previous mark change."

#. resolved-locale: en
#. STRINGS.SOCIAL.SCENE.BOUND_BLOCK_COUPLE_1
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.BOUND_BLOCK_COUPLE_1"
msgid "话到嘴边，又咽了回去……"
msgstr "The words rose up... and died in my throat."

#. resolved-locale: en
#. STRINGS.SOCIAL.SCENE.BOUND_BLOCK_COUPLE_2
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.BOUND_BLOCK_COUPLE_2"
msgid "心跳得厉害，却怎么也说不出口。"
msgstr "My heart raced, but nothing came out."

#. resolved-locale: en
#. STRINGS.SOCIAL.SCENE.BOUND_BLOCK_COUPLE_3
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.BOUND_BLOCK_COUPLE_3"
msgid "也许……我们再等等。"
msgstr "Maybe... we should wait."

#. resolved-locale: en
#. STRINGS.SOCIAL.SCENE.BOUND_BLOCK_FADE_1
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.BOUND_BLOCK_FADE_1"
msgid "好像很久没说话了，但又没什么变化。"
msgstr "We haven't talked in ages, yet nothing's changed."

#. resolved-locale: en
#. STRINGS.SOCIAL.SCENE.BOUND_BLOCK_FADE_2
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.BOUND_BLOCK_FADE_2"
msgid "感情淡不下去，也挺奇怪的。"
msgstr "Strange — this friendship refuses to fade."

#. resolved-locale: en
#. STRINGS.SOCIAL.SCENE.BOUND_BLOCK_RIVAL_1
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.BOUND_BLOCK_RIVAL_1"
msgid "算了……犯不着。"
msgstr "Forget it... not worth it."

#. resolved-locale: en
#. STRINGS.SOCIAL.SCENE.BOUND_BLOCK_RIVAL_2
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.BOUND_BLOCK_RIVAL_2"
msgid "火气上来，又莫名其妙消了。"
msgstr "The anger flared, then faded for no reason."

#. resolved-locale: en
#. STRINGS.SOCIAL.SCENE.BOUND_BLOCK_RIVAL_3
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.BOUND_BLOCK_RIVAL_3"
msgid "我不想再见到他——大概吧。"
msgstr "I never want to see them again. Probably."

#. resolved-locale: en
#. STRINGS.SOCIAL.SCENE.BOUND_BLOCK_SPLIT_1
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.BOUND_BLOCK_SPLIT_1"
msgid "吵到一半，突然不想吵了。"
msgstr "Halfway through the fight, neither of us wanted to finish it."

#. resolved-locale: en
#. STRINGS.SOCIAL.SCENE.BOUND_BLOCK_SPLIT_2
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.BOUND_BLOCK_SPLIT_2"
msgid "狠话到了嘴边，谁也没说出口。"
msgstr "The harsh words never left our lips."

#. resolved-locale: en
#. STRINGS.SOCIAL.SCENE.BOUND_BLOCK_SPLIT_3
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.BOUND_BLOCK_SPLIT_3"
msgid "……就当没发生过吧。"
msgstr "...Let's pretend this never happened."

#. resolved-locale: en
#. STRINGS.SOCIAL.SCENE.BOUND_BLOCK_UP_1
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.BOUND_BLOCK_UP_1"
msgid "总感觉……还是差了一点火候。"
msgstr "Feels like... something's still missing."

#. resolved-locale: en
#. STRINGS.SOCIAL.SCENE.BOUND_BLOCK_UP_2
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.BOUND_BLOCK_UP_2"
msgid "有些话，现在还不是时候。"
msgstr "Some words are better saved for later."

#. resolved-locale: en
#. STRINGS.SOCIAL.SCENE.BOUND_BLOCK_UP_3
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.BOUND_BLOCK_UP_3"
msgid "就到这里吧，也挺好的。"
msgstr "This is fine. This is enough."

#. resolved-locale: en
#. STRINGS.SOCIAL.SCENE.BRAWL_CHEER_1
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.BRAWL_CHEER_1"
msgid "打起来了！打起来了！"
msgstr "FIGHT! FIGHT! FIGHT!"

#. resolved-locale: en
#. STRINGS.SOCIAL.SCENE.BRAWL_CHEER_2
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.BRAWL_CHEER_2"
msgid "都别拦着！……哦，没人拦。"
msgstr "Nobody hold them back! ...Oh. Nobody was going to."

#. resolved-locale: en
#. STRINGS.SOCIAL.SCENE.BRAWL_CHEER_3
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.BRAWL_CHEER_3"
msgid "让他们打！"
msgstr "Let them go!"

#. resolved-locale: en
#. STRINGS.SOCIAL.SCENE.BRAWL_CHEER_4
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.BRAWL_CHEER_4"
msgid "我就吃个瓜。"
msgstr "I'm just here for the show."

#. resolved-locale: en
#. STRINGS.SOCIAL.SCENE.BRAWL_CHEER_5
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.BRAWL_CHEER_5"
msgid "加油！呃……都加油！"
msgstr "Get him! Er — get both of them!"

#. resolved-locale: en
#. STRINGS.SOCIAL.SCENE.BRAWL_CHEER_6
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.BRAWL_CHEER_6"
msgid "你这瓜保熟吗？"
msgstr "Should somebody be filming this?"

#. resolved-locale: en
#. STRINGS.SOCIAL.SCENE.BRAWL_SURRENDER_1
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.BRAWL_SURRENDER_1"
msgid "大意了，没有闪！"
msgstr "I wasn't ready! I wasn't READY!"

#. resolved-locale: en
#. STRINGS.SOCIAL.SCENE.BRAWL_SURRENDER_2
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.BRAWL_SURRENDER_2"
msgid "耗子尾汁……我耗子尾汁……"
msgstr "Okay. Okay! You win. You win."

#. resolved-locale: en
#. STRINGS.SOCIAL.SCENE.BRAWL_SURRENDER_3
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.BRAWL_SURRENDER_3"
msgid "已老实，求放过！"
msgstr "I yield! I yield!"

#. resolved-locale: en
#. STRINGS.SOCIAL.SCENE.BRAWL_SURRENDER_4
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.BRAWL_SURRENDER_4"
msgid "别打了别打了，我错了！"
msgstr "Stop — stop, I was wrong, I was wrong!"

#. resolved-locale: en
#. STRINGS.SOCIAL.SCENE.BRAWL_SURRENDER_5
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.BRAWL_SURRENDER_5"
msgid "不打了不打了！"
msgstr "No more. No more."

#. resolved-locale: en
#. STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_1
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_1"
msgid "我不是针对你，我是说在座的各位——都是垃圾！"
msgstr "Nothing personal. I just think everyone here is dead weight — you especially."

#. resolved-locale: en
#. STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_10
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_10"
msgid "犹豫，就会败北！"
msgstr "Hesitate and you lose. You hesitated."

#. resolved-locale: en
#. STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_11
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_11"
msgid "你给我翻译翻译，什么叫惊喜！"
msgstr "Cry about it."

#. resolved-locale: en
#. STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_12
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_12"
msgid "压力给到你这边了！"
msgstr "The pressure is on YOUR side of the table now."

#. resolved-locale: en
#. STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_13
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_13"
msgid "不是吧阿Sir？"
msgstr "Bold words for someone within punching range."

#. resolved-locale: en
#. STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_14
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_14"
msgid "格局打开！"
msgstr "Get a bigger perspective. Starting with your face."

#. resolved-locale: en
#. STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_15
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_15"
msgid "小丑竟是我自己！"
msgstr "Turns out the clown was me for ever trusting you."

#. resolved-locale: en
#. STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_16
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_16"
msgid "以前是以前，现在是现在！"
msgstr "That was then. This is now."

#. resolved-locale: en
#. STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_17
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_17"
msgid "年轻人，不讲武德！"
msgstr "Kids these days. No honor at all."

#. resolved-locale: en
#. STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_18
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_18"
msgid "退！退！退！"
msgstr "Back. Back. BACK."

#. resolved-locale: en
#. STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_19
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_19"
msgid "我最讨厌事后道歉！"
msgstr "Save the apology. I hate apologies."

#. resolved-locale: en
#. STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_2
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_2"
msgid "菜就多练！"
msgstr "Skill issue."

#. resolved-locale: en
#. STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_20
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_20"
msgid "你的嘴比没接过滤器的排气口还脏！"
msgstr "Your mouth is filthier than an unfiltered gas vent."

#. resolved-locale: en
#. STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_3
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_3"
msgid "我从未见过有如此厚颜无耻之人！"
msgstr "I have never met a man so utterly without shame."

#. resolved-locale: en
#. STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_4
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_4"
msgid "回答我！LOOK IN MY EYES!"
msgstr "Look at me. LOOK AT ME."

#. resolved-locale: en
#. STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_5
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_5"
msgid "就这？就这？"
msgstr "That's it? That's the whole thing?"

#. resolved-locale: en
#. STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_6
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_6"
msgid "你在教我做事啊？"
msgstr "Oh, you're teaching me my job now?"

#. resolved-locale: en
#. STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_7
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_7"
msgid "怎么不找找你自己的问题？"
msgstr "Ever considered the problem might be you?"

#. resolved-locale: en
#. STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_8
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_8"
msgid "半场开香槟？"
msgstr "Popping the champagne at halftime, are we?"

#. resolved-locale: en
#. STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_9
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_9"
msgid "你急了？你急了？"
msgstr "Ohhh, someone's mad."

#. resolved-locale: en
#. STRINGS.SOCIAL.SCENE.BREAKUP_KEY
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.BREAKUP_KEY"
msgid "我们还是到这里吧。"
msgstr "I think this is where we part."

#. resolved-locale: en
#. STRINGS.SOCIAL.SCENE.BREAKUP_REPLY
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.BREAKUP_REPLY"
msgid "……我知道了。"
msgstr "...I understand."

#. resolved-locale: en
#. STRINGS.SOCIAL.SCENE.CHAT_KEY
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.CHAT_KEY"
msgid "嗨。"
msgstr "Hi."

#. resolved-locale: en
#. STRINGS.SOCIAL.SCENE.CONFESSION_FAIL_REPLY
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.CONFESSION_FAIL_REPLY"
msgid "对不起，我不能答应。"
msgstr "I'm sorry. I can't."

#. resolved-locale: en
#. STRINGS.SOCIAL.SCENE.CONFESSION_FAIL_RESULT
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.CONFESSION_FAIL_RESULT"
msgid "……我明白了。"
msgstr "...I understand."

#. resolved-locale: en
#. STRINGS.SOCIAL.SCENE.CONFESSION_INTRO
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.CONFESSION_INTRO"
msgid "我有件重要的事想告诉你。"
msgstr "There is something important I need to tell you."

#. resolved-locale: en
#. STRINGS.SOCIAL.SCENE.CONFESSION_KEY
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.CONFESSION_KEY"
msgid "我喜欢你。"
msgstr "I like you."

#. resolved-locale: en
#. STRINGS.SOCIAL.SCENE.CONFESSION_REPLY
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.CONFESSION_REPLY"
msgid "我也一直喜欢你。"
msgstr "I have always liked you too."

#. resolved-locale: en
#. STRINGS.SOCIAL.SCENE.CONFESSION_RESULT
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.CONFESSION_RESULT"
msgid "那就一起走下去吧。"
msgstr "Then let's face whatever comes next together."

#. resolved-locale: en
#. STRINGS.SOCIAL.SCENE.FAMINE_BUTCHER_1
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.FAMINE_BUTCHER_1"
msgid "对不起……对不起……"
msgstr "I'm sorry. I'm sorry."

#. resolved-locale: en
#. STRINGS.SOCIAL.SCENE.FAMINE_BUTCHER_2
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.FAMINE_BUTCHER_2"
msgid "别看我。谁都别看我。"
msgstr "Don't look at me. Nobody look at me."

#. resolved-locale: en
#. STRINGS.SOCIAL.SCENE.FAMINE_BUTCHER_3
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.FAMINE_BUTCHER_3"
msgid "我们得活下去。就这样而已。"
msgstr "We have to live. That is all this is."

#. resolved-locale: en
#. STRINGS.SOCIAL.SCENE.FAMINE_BUTCHER_4
