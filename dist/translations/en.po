msgid "人际关系"
msgstr "Relationships"

msgctxt "ONIAiSocial.STRINGS.SOCIAL.DETAILS.AFFINITY_LABEL"
msgid "好感"
msgstr "Affinity"

msgctxt "ONIAiSocial.STRINGS.SOCIAL.DETAILS.BEST_FRIEND_MARK"
msgid "挚友"
msgstr "Best friend"

msgctxt "ONIAiSocial.STRINGS.SOCIAL.DETAILS.REPUTATION_LABEL"
msgid "声望（仅供观察）"
msgstr "Reputation (observation only)"

msgctxt "ONIAiSocial.STRINGS.SOCIAL.DETAILS.REPUTATION_TOOLTIP"
msgid "与全体存活复制人的平均好感。目前只反映人缘高低，不影响任何判定；声望玩法留待后续版本。"
msgstr "Average affinity with all living duplicants. For now it only reflects popularity and affects nothing; reputation gameplay is planned for a later version."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.DETAILS.COLONY_LABEL"
msgid "殖民地"
msgstr "Colony"

msgctxt "ONIAiSocial.STRINGS.SOCIAL.DETAILS.COLONY_TOOLTIP"
msgid "全体存活复制人两两好感的平均值。≥40 触发殖民地羁绊（全员士气 +1）；多对冷战会触发殖民地不和（全员士气 -1，争执更频繁）。共餐、聚会和牵线都能提升羁绊。"
msgstr "Average pairwise affinity across all living duplicants. At 40+, Colony Cohesion grants +1 morale to everyone; multiple cold wars trigger Colony Discord (-1 morale, more arguments). Shared meals, parties and matchmaking all help."

msgctxt "ONIAiSocial.STRINGS.SOCIAL.DETAILS.SYSTEM_UNAVAILABLE"
msgid "社交系统尚未就绪"
msgstr "The social system is not ready"

