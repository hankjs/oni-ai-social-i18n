msgid "失去了心上人，士气下降。"
msgstr "Lost a sweetheart. Morale down."

#. resolved-locale: en
#. STRINGS.SOCIAL.EFFECTS.GRIEF.NAME
msgctxt "ONIAiSocial.STRINGS.SOCIAL.EFFECTS.GRIEF.NAME"
msgid "丧偶悲伤"
msgstr "Grieving"

#. resolved-locale: en
#. STRINGS.SOCIAL.EFFECTS.GRIEF_SOFT.DESC
msgctxt "ONIAiSocial.STRINGS.SOCIAL.EFFECTS.GRIEF_SOFT.DESC"
msgid "失去了心上人，但殖民地的陪伴减轻了痛苦。"
msgstr "Lost a sweetheart, but the colony's warmth softens the blow."

#. resolved-locale: en
#. STRINGS.SOCIAL.EFFECTS.GRIEF_SOFT.NAME
msgctxt "ONIAiSocial.STRINGS.SOCIAL.EFFECTS.GRIEF_SOFT.NAME"
msgid "丧偶悲伤（有人陪着）"
msgstr "Grieving (Supported)"

#. resolved-locale: en
#. STRINGS.SOCIAL.EFFECTS.LOVE.DESC
msgctxt "ONIAiSocial.STRINGS.SOCIAL.EFFECTS.LOVE.DESC"
msgid "有心上人了，士气提升。"
msgstr "Has a sweetheart. Morale up."

#. resolved-locale: en
#. STRINGS.SOCIAL.EFFECTS.LOVE.NAME
msgctxt "ONIAiSocial.STRINGS.SOCIAL.EFFECTS.LOVE.NAME"
msgid "恋爱中"
msgstr "In Love"

#. resolved-locale: en
#. STRINGS.SOCIAL.EFFECTS.LOVE_MATURE.DESC
msgctxt "ONIAiSocial.STRINGS.SOCIAL.EFFECTS.LOVE_MATURE.DESC"
msgid "相伴已久,是彼此最安心的存在。士气大幅提升。"
msgstr "Long together, and each other's safest place. Morale way up."

#. resolved-locale: en
#. STRINGS.SOCIAL.EFFECTS.LOVE_MATURE.NAME
msgctxt "ONIAiSocial.STRINGS.SOCIAL.EFFECTS.LOVE_MATURE.NAME"
msgid "老夫老妻"
msgstr "Seasoned Love"

#. resolved-locale: en
#. STRINGS.SOCIAL.EFFECTS.RIVAL_DIED.DESC
msgctxt "ONIAiSocial.STRINGS.SOCIAL.EFFECTS.RIVAL_DIED.DESC"
msgid "看不顺眼的那个人不在了。嘴上不说，心情确实不错。"
msgstr "That one duplicant they could not stand is gone. They would never say so out loud, but the mood is good."

#. resolved-locale: en
#. STRINGS.SOCIAL.EFFECTS.RIVAL_DIED.NAME
msgctxt "ONIAiSocial.STRINGS.SOCIAL.EFFECTS.RIVAL_DIED.NAME"
msgid "幸灾乐祸"
msgstr "Schadenfreude"

#. resolved-locale: en
#. STRINGS.SOCIAL.EFFECTS.SIDE_BY_SIDE.DESC
msgctxt "ONIAiSocial.STRINGS.SOCIAL.EFFECTS.SIDE_BY_SIDE.DESC"
msgid "和要好的人一起干活，效率提升。"
msgstr "Working alongside a friend. Efficiency up."

#. resolved-locale: en
#. STRINGS.SOCIAL.EFFECTS.SIDE_BY_SIDE.NAME
msgctxt "ONIAiSocial.STRINGS.SOCIAL.EFFECTS.SIDE_BY_SIDE.NAME"
msgid "并肩作战"
msgstr "Side by Side"

#. resolved-locale: en
#. STRINGS.SOCIAL.EFFECTS.STRAINED.BUBBLE
msgctxt "ONIAiSocial.STRINGS.SOCIAL.EFFECTS.STRAINED.BUBBLE"
msgid "深吸一口气……忍住了"
msgstr "Deep breath... holding it together"

#. resolved-locale: en
#. STRINGS.SOCIAL.EFFECTS.STRAINED.DESC
msgctxt "ONIAiSocial.STRINGS.SOCIAL.EFFECTS.STRAINED.DESC"
msgid "压力已经逼近极限，随时可能崩溃。找人聊聊、吃顿好的，或者让 TA 歇一歇。"
msgstr "Stress is close to the breaking point. A chat, a good meal or some downtime could pull them back."

#. resolved-locale: en
#. STRINGS.SOCIAL.EFFECTS.STRAINED.NAME
msgctxt "ONIAiSocial.STRINGS.SOCIAL.EFFECTS.STRAINED.NAME"
msgid "情绪紧绷"
msgstr "Strained"

#. resolved-locale: en
#. STRINGS.SOCIAL.EFFECTS.WRATH_ISOLATED.DESC
msgctxt "ONIAiSocial.STRINGS.SOCIAL.EFFECTS.WRATH_ISOLATED.DESC"
msgid "殖民地出了事，而 TA 是人缘垫底的那个——所以帐算在 TA 头上了，跟事情是不是 TA 做的无关。有人愿意照顾 TA、找 TA 说话或跟 TA 一起吃顿饭，这个状态就会解除；再久一点，事情也会被淡忘。"
msgstr "Something went wrong in the colony and they were the least liked person here - so the bill landed on them, whether or not they had anything to do with it. It lifts the moment somebody tends to them, talks with them, or shares a meal; given long enough, it fades on its own."

#. resolved-locale: en
#. STRINGS.SOCIAL.EFFECTS.WRATH_ISOLATED.NAME
msgctxt "ONIAiSocial.STRINGS.SOCIAL.EFFECTS.WRATH_ISOLATED.NAME"
msgid "被孤立"
msgstr "Frozen out"

#. resolved-locale: en
#. STRINGS.SOCIAL.FOOD.CANNIBAL_MEAT.DESC
msgctxt "ONIAiSocial.STRINGS.SOCIAL.FOOD.CANNIBAL_MEAT.DESC"
msgid "断粮那几天留下来的。没有人问这是谁，也没有人愿意先动筷子。"
msgstr "Left over from the days the food ran out. Nobody asks whose it is, and nobody wants to reach for it first."

#. resolved-locale: en
#. STRINGS.SOCIAL.FOOD.CANNIBAL_MEAT.NAME
msgctxt "ONIAiSocial.STRINGS.SOCIAL.FOOD.CANNIBAL_MEAT.NAME"
msgid "「同事」肉"
msgstr "\"Colleague\" Meat"

#. resolved-locale: en
#. STRINGS.SOCIAL.LOG.ENTRY_PAIR
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG.ENTRY_PAIR"
msgid "周期{0} · {1} 和 {2} [{3}]{4}"
msgstr "Cycle {0} · {1} and {2} [{3}]{4}"

#. resolved-locale: en
#. STRINGS.SOCIAL.LOG.ENTRY_SELF
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG.ENTRY_SELF"
msgid "周期{0} · [{1}]{2}"
msgstr "Cycle {0} · [{1}]{2}"

#. resolved-locale: en
#. STRINGS.SOCIAL.LOG.ENTRY_SOLO
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG.ENTRY_SOLO"
msgid "周期{0} · {1} [{2}]{3}"
msgstr "Cycle {0} · {1} [{2}]{3}"

#. resolved-locale: en
#. STRINGS.SOCIAL.LOG.ENTRY_STORY
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG.ENTRY_STORY"
msgid "周期{0} · {1}{2}"
msgstr "Cycle {0} · {1}{2}"

#. resolved-locale: en
#. STRINGS.SOCIAL.LOG.ENTRY_WITH
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG.ENTRY_WITH"
msgid "周期{0} · 与 {1} [{2}]{3}"
msgstr "Cycle {0} · with {1} [{2}]{3}"

#. resolved-locale: en
#. STRINGS.SOCIAL.LOG.SECTION_MILESTONES
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG.SECTION_MILESTONES"
msgid "—— 大事记 ——"
msgstr "—— Milestones ——"

#. resolved-locale: en
#. STRINGS.SOCIAL.LOG.SECTION_RECENT
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG.SECTION_RECENT"
msgid "—— 最近 ——"
msgstr "—— Recent ——"

#. resolved-locale: en
#. STRINGS.SOCIAL.LOG.VALUE_AFFINITY
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG.VALUE_AFFINITY"
msgid " 好感{0:+#;-#;0}"
msgstr " Affinity {0:+#;-#;0}"

#. resolved-locale: en
#. STRINGS.SOCIAL.LOG.VALUE_MORALE
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG.VALUE_MORALE"
msgid " 士气{0:+#.#;-#.#;0}"
msgstr " Morale {0:+#.#;-#.#;0}"

#. resolved-locale: en
#. STRINGS.SOCIAL.LOG.VALUE_STRESS
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG.VALUE_STRESS"
msgid " 压力{0:+#.#;-#.#;0}"
msgstr " Stress {0:+#.#;-#.#;0}"

#. resolved-locale: en
#. STRINGS.SOCIAL.LOG.VALUE_STRESS_PAIR
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG.VALUE_STRESS_PAIR"
msgid " 压力{0:+#.#;-#.#;0}/{1:+#.#;-#.#;0}"
msgstr " Stress {0:+#.#;-#.#;0}/{1:+#.#;-#.#;0}"

#. resolved-locale: en
#. STRINGS.SOCIAL.LOG_STORY.ANNIVERSARY_1
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.ANNIVERSARY_1"
msgid "{pair}纪念了在一起的日子。"
msgstr "{pair} marked the day they got together."

#. resolved-locale: en
#. STRINGS.SOCIAL.LOG_STORY.ANNIVERSARY_2
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.ANNIVERSARY_2"
msgid "{pair}又安稳地走过了一年,值得碰一杯。"
msgstr "{pair} made it through another year together — worth a toast."

#. resolved-locale: en
#. STRINGS.SOCIAL.LOG_STORY.ANNIVERSARY_3
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.ANNIVERSARY_3"
msgid "在这个连日历都要自己记的地方,{pair}没有忘记今天。"
msgstr "In a place where you keep the calendar yourself, {pair} remembered the day."

#. resolved-locale: en
#. STRINGS.SOCIAL.LOG_STORY.ANNIVERSARY_4
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.ANNIVERSARY_4"
msgid "{pair}把纪念日过成了全殖民地的节日——至少他们自己是这么觉得的。"
msgstr "{pair} celebrated like it was a colony-wide holiday — as far as they were concerned, it was."

#. resolved-locale: en
#. STRINGS.SOCIAL.LOG_STORY.ANNIVERSARY_MISSED_1
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.ANNIVERSARY_MISSED_1"
msgid "{actor}忘了和{other}的纪念日。"
msgstr "{actor} forgot the anniversary with {other}."

#. resolved-locale: en
#. STRINGS.SOCIAL.LOG_STORY.ANNIVERSARY_MISSED_2
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.ANNIVERSARY_MISSED_2"
msgid "{actor}的排班表上唯独漏掉了和{other}的纪念日。"
msgstr "{actor}'s schedule had everything on it except the anniversary with {other}."

#. resolved-locale: en
#. STRINGS.SOCIAL.LOG_STORY.ANNIVERSARY_MISSED_3
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.ANNIVERSARY_MISSED_3"
msgid "{other}等了一晚上,{actor}在矿井里浑然不觉。"
msgstr "{other} waited all evening; {actor}, down in the mines, noticed nothing."

#. resolved-locale: en
#. STRINGS.SOCIAL.LOG_STORY.ANNIVERSARY_MISSED_4
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.ANNIVERSARY_MISSED_4"
msgid "日子一忙就糊涂,{actor}把最重要的那天忘了。"
msgstr "Busy days blur together, and {actor} let the most important one slip."

#. resolved-locale: en
#. STRINGS.SOCIAL.LOG_STORY.APOLOGY_1
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.APOLOGY_1"
msgid "{actor}向{other}道了歉。"
msgstr "{actor} apologized to {other}."

#. resolved-locale: en
#. STRINGS.SOCIAL.LOG_STORY.APOLOGY_2
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.APOLOGY_2"
msgid "{actor}先低了头,{other}也就顺势原谅了。"
msgstr "{actor} yielded first, and {other} forgave."

#. resolved-locale: en
#. STRINGS.SOCIAL.LOG_STORY.APOLOGY_3
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.APOLOGY_3"
msgid "{actor}把「对不起」三个字说得磕磕绊绊,{other}收下了。"
msgstr "{actor} stumbled through the word \"sorry\"; {other} accepted it."

#. resolved-locale: en
#. STRINGS.SOCIAL.LOG_STORY.APOLOGY_4
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.APOLOGY_4"
msgid "{actor}递过去一块软泥糕,算是赔罪。"
msgstr "{actor} offered a mush bar by way of apology."

#. resolved-locale: en
#. STRINGS.SOCIAL.LOG_STORY.APOLOGY_5
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.APOLOGY_5"
msgid "面子和{other}之间,{actor}选了{other}。"
msgstr "Between pride and {other}, {actor} chose {other}."

#. resolved-locale: en
#. STRINGS.SOCIAL.LOG_STORY.APOLOGY_BOND_1
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.APOLOGY_BOND_1"
msgid "一场冲突反倒让{pair}成了好朋友。"
msgstr "A conflict, of all things, made {pair} good friends."

#. resolved-locale: en
#. STRINGS.SOCIAL.LOG_STORY.APOLOGY_BOND_2
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.APOLOGY_BOND_2"
msgid "{pair}把话说透,反倒成了朋友。"
msgstr "{pair} talked it all out and came out of it friends."

#. resolved-locale: en
#. STRINGS.SOCIAL.LOG_STORY.APOLOGY_BOND_3
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.APOLOGY_BOND_3"
msgid "道完歉的{pair},比吵架前还要亲近。"
msgstr "After the apology, {pair} were closer than before the fight."

#. resolved-locale: en
#. STRINGS.SOCIAL.LOG_STORY.APOLOGY_BOND_4
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.APOLOGY_BOND_4"
msgid "{pair}先是吵了一架,然后成了朋友——事情就是这样。"
msgstr "{pair} had a fight, then became friends. That's just how it went."

#. resolved-locale: en
#. STRINGS.SOCIAL.LOG_STORY.ARGUMENT_1
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.ARGUMENT_1"
msgid "{pair}吵了一架。"
msgstr "{pair} had an argument."

#. resolved-locale: en
#. STRINGS.SOCIAL.LOG_STORY.ARGUMENT_2
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.ARGUMENT_2"
msgid "{pair}争执了起来,谁也不让谁。"
msgstr "{pair} quarreled, neither willing to back down."

#. resolved-locale: en
#. STRINGS.SOCIAL.LOG_STORY.ARGUMENT_3
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.ARGUMENT_3"
msgid "{pair}的声音越抬越高,惊动了隔壁的哈奇。"
msgstr "{pair}'s voices rose high enough to startle the hatches next door."

#. resolved-locale: en
#. STRINGS.SOCIAL.LOG_STORY.ARGUMENT_4
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.ARGUMENT_4"
msgid "{pair}为一点小事红了脸,事后想想都不值。"
msgstr "{pair} got heated over something trivial; in hindsight, neither could say what."

#. resolved-locale: en
#. STRINGS.SOCIAL.LOG_STORY.ARGUMENT_5
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.ARGUMENT_5"
msgid "一场架吵完,{pair}都觉得是对方先不讲理的。"
msgstr "When the shouting was over, {pair} each blamed the other for starting it."

#. resolved-locale: en
#. STRINGS.SOCIAL.LOG_STORY.ARGUMENT_CAUSE_1
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.ARGUMENT_CAUSE_1"
msgid "因为{cause},{pair}吵了起来。"
msgstr "Over {cause}, {pair} got into an argument."

#. resolved-locale: en
#. STRINGS.SOCIAL.LOG_STORY.BESTFRIEND_1
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.BESTFRIEND_1"
msgid "{pair}聊到深夜,成了彼此的挚友。"
msgstr "{pair} talked late into the night and became best friends."

#. resolved-locale: en
#. STRINGS.SOCIAL.LOG_STORY.BESTFRIEND_2
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.BESTFRIEND_2"
msgid "{pair}说了些从没对别人说过的话。"
msgstr "{pair} said things they had never told anyone."

#. resolved-locale: en
#. STRINGS.SOCIAL.LOG_STORY.BESTFRIEND_3
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.BESTFRIEND_3"
msgid "{pair}交换了彼此的秘密,从此不分你我。"
msgstr "{pair} traded secrets, and from then on kept nothing from each other."

#. resolved-locale: en
#. STRINGS.SOCIAL.LOG_STORY.BESTFRIEND_4
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.BESTFRIEND_4"
msgid "那晚{pair}聊到天亮,谁也没提该睡觉的事。"
msgstr "{pair} talked until morning; neither mentioned bedtime."

#. resolved-locale: en
#. STRINGS.SOCIAL.LOG_STORY.BESTFRIEND_5
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.BESTFRIEND_5"
msgid "有些人认识很久才是朋友,{pair}只花了一个晚上。"
msgstr "Some friendships take years. {pair} managed it in one night."

#. resolved-locale: en
#. STRINGS.SOCIAL.LOG_STORY.BOUND_BLOCK_1
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.BOUND_BLOCK_1"
msgid "{pair}之间像隔着一层看不见的墙,关系停在了原地。"
msgstr "An invisible wall stands between {pair}; nothing moved."

#. resolved-locale: en
#. STRINGS.SOCIAL.LOG_STORY.BOUND_BLOCK_2
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.BOUND_BLOCK_2"
msgid "某种说不清的力量按住了{pair}的缘分,谁也没有再进一步。"
msgstr "Some unnameable force held the bond between {pair} exactly where it was."

#. resolved-locale: en
#. STRINGS.SOCIAL.LOG_STORY.BOUND_BLOCK_3
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.BOUND_BLOCK_3"
msgid "{pair}的故事刚要翻页,又被无形的手轻轻按住。"
msgstr "{pair}'s story was about to turn a page, until an unseen hand held it down."

#. resolved-locale: en
#. STRINGS.SOCIAL.LOG_STORY.BOUND_BLOCK_4
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.BOUND_BLOCK_4"
msgid "命运在{pair}之间画了一条线,谁也没有跨过去。"
msgstr "Fate drew a line between {pair}, and neither one crossed it."

#. resolved-locale: en
#. STRINGS.SOCIAL.LOG_STORY.BOUND_BLOCK_5
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.BOUND_BLOCK_5"
msgid "{pair}的关系起了波澜,又莫名其妙地平息了。"
msgstr "Things stirred between {pair}, then inexplicably settled again."

#. resolved-locale: en
#. STRINGS.SOCIAL.LOG_STORY.BRAWL_1
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.BRAWL_1"
msgid "{pair}打了起来。"
msgstr "{pair} came to blows."

#. resolved-locale: en
#. STRINGS.SOCIAL.LOG_STORY.BRAWL_2
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.BRAWL_2"
msgid "{pair}的争执升级成了拳脚。"
msgstr "{pair}'s quarrel turned to fists."

#. resolved-locale: en
#. STRINGS.SOCIAL.LOG_STORY.BRAWL_3
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.BRAWL_3"
msgid "{pair}扭作一团,工具散了一地。"
msgstr "{pair} grappled and tumbled, tools scattering everywhere."

#. resolved-locale: en
#. STRINGS.SOCIAL.LOG_STORY.BRAWL_4
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.BRAWL_4"
msgid "这一架打得难看,{pair}都挂了彩。"
msgstr "It was an ugly fight; {pair} both walked away bruised."

#. resolved-locale: en
#. STRINGS.SOCIAL.LOG_STORY.BRAWL_5
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.BRAWL_5"
msgid "劝架的都来了,{pair}才肯撒手。"
msgstr "Only when others pulled them apart did {pair} finally let go."

#. resolved-locale: en
#. STRINGS.SOCIAL.LOG_STORY.BREAKUP_1
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.BREAKUP_1"
msgid "{pair}分手了。"
msgstr "{pair} broke up."

#. resolved-locale: en
#. STRINGS.SOCIAL.LOG_STORY.BREAKUP_2
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.BREAKUP_2"
msgid "{pair}的感情走到了尽头。"
msgstr "{pair}'s relationship reached its end."

#. resolved-locale: en
#. STRINGS.SOCIAL.LOG_STORY.BREAKUP_3
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.BREAKUP_3"
msgid "{pair}把话说开,然后各自转身。"
msgstr "{pair} said what needed saying, then turned and walked away."

#. resolved-locale: en
#. STRINGS.SOCIAL.LOG_STORY.BREAKUP_4
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.BREAKUP_4"
msgid "{pair}的关系,像气压服的氧气一样耗尽了。"
msgstr "{pair}'s relationship ran out like an atmo suit's oxygen."

#. resolved-locale: en
#. STRINGS.SOCIAL.LOG_STORY.BREAKUP_5
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.BREAKUP_5"
msgid "{other}还想挽回,{actor}已经不想再谈了。"
msgstr "{other} wanted to try again; {actor} was done talking."

#. resolved-locale: en
#. STRINGS.SOCIAL.LOG_STORY.CARE_1
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.CARE_1"
msgid "{actor}照顾了{other}。"
msgstr "{actor} took care of {other}."

#. resolved-locale: en
#. STRINGS.SOCIAL.LOG_STORY.CARE_2
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.CARE_2"
msgid "{actor}帮{other}处理了伤势。"
msgstr "{actor} tended {other}'s injuries."

#. resolved-locale: en
#. STRINGS.SOCIAL.LOG_STORY.CARE_3
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.CARE_3"
msgid "{actor}给{other}换了绷带,动作很轻。"
msgstr "{actor} changed {other}'s bandages, gentle as could be."

#. resolved-locale: en
#. STRINGS.SOCIAL.LOG_STORY.CARE_4
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.CARE_4"
msgid "{other}嘴上说着没事,还是让{actor}照看了一整天。"
msgstr "{other} insisted it was nothing, then let {actor} fuss over them all day."

#. resolved-locale: en
#. STRINGS.SOCIAL.LOG_STORY.CARE_5
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.CARE_5"
msgid "{actor}守在{other}旁边,连药都提前晾温了。"
msgstr "{actor} stayed by {other}'s side, the medicine cooled and ready."

#. resolved-locale: en
#. STRINGS.SOCIAL.LOG_STORY.CHAT_1
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.CHAT_1"
msgid "{pair}聊了会儿天。"
msgstr "{pair} chatted for a while."

#. resolved-locale: en
#. STRINGS.SOCIAL.LOG_STORY.CHAT_2
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.CHAT_2"
msgid "{pair}凑在一起闲聊,气氛不错。"
msgstr "{pair} sat together shooting the breeze; the mood was good."

#. resolved-locale: en
#. STRINGS.SOCIAL.LOG_STORY.CHAT_3
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.CHAT_3"
msgid "{pair}聊起了家长里短。"
msgstr "{pair} talked about everyday things."

#. resolved-locale: en
#. STRINGS.SOCIAL.LOG_STORY.CHAT_4
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.CHAT_4"
msgid "{pair}聊起了{topic}。"
msgstr "{pair} talked about {topic}."

#. resolved-locale: en
#. STRINGS.SOCIAL.LOG_STORY.CHAT_5
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.CHAT_5"
msgid "{pair}交换了今天的见闻。"
msgstr "{pair} traded the day's stories."

#. resolved-locale: en
#. STRINGS.SOCIAL.LOG_STORY.CHAT_6
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.CHAT_6"
msgid "{pair}有一搭没一搭地聊着,时间过得飞快。"
msgstr "{pair} chatted idly, and the time flew by."

#. resolved-locale: en
#. STRINGS.SOCIAL.LOG_STORY.CHAT_BRAWL_BOND_1
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.CHAT_BRAWL_BOND_1"
msgid "{pair}聊得热络——不打不相识。"
msgstr "{pair} hit it off — no friendship like one forged in a fight."

#. resolved-locale: en
#. STRINGS.SOCIAL.LOG_STORY.CHAT_COLD_1
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.CHAT_COLD_1"
msgid "{pair}僵着脖子,交换了几句必要的话。"
msgstr "{pair} stiffly exchanged the few words that were necessary."

#. resolved-locale: en
#. STRINGS.SOCIAL.LOG_STORY.CHAT_COMRADE_1
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.CHAT_COMRADE_1"
msgid "{pair}聊起那次死里逃生,话就没个完。"
msgstr "{pair} got talking about that narrow escape and couldn't stop."

#. resolved-locale: en
#. STRINGS.SOCIAL.LOG_STORY.CHAT_COUPLE_1
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.CHAT_COUPLE_1"
msgid "{pair}凑在一起说悄悄话,旁若无人。"
msgstr "{pair} whispered together, oblivious to everyone else."

#. resolved-locale: en
#. STRINGS.SOCIAL.LOG_STORY.CHAT_CRUSH_1
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.CHAT_CRUSH_1"
msgid "{pair}聊着聊着,目光就躲到了别处。"
msgstr "{pair} chatted, eyes drifting away from each other."

#. resolved-locale: en
#. STRINGS.SOCIAL.LOG_STORY.CHAT_CRYBABY_1
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.CHAT_CRYBABY_1"
msgid "{actor}说着说着眼圈就红了,{other}赶紧岔开了话题。"
msgstr "{actor}'s eyes welled up mid-sentence; {other} quickly changed the subject."

#. resolved-locale: en
#. STRINGS.SOCIAL.LOG_STORY.CHAT_EATER_1
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.CHAT_EATER_1"
msgid "{actor}边吃边聊,{other}的话头总被咀嚼声盖过去。"
msgstr "{actor} talked between bites, chewing over {other}'s every sentence."

#. resolved-locale: en
#. STRINGS.SOCIAL.LOG_STORY.CHAT_EX_1
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.CHAT_EX_1"
msgid "{pair}聊了几句,客气得像刚认识。"
msgstr "{pair} exchanged a few words, polite as strangers."

#. resolved-locale: en
#. STRINGS.SOCIAL.LOG_STORY.CHAT_GENTLE_1
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.CHAT_GENTLE_1"
msgid "{actor}说话轻声细语,{other}听得直点头。"
msgstr "{actor} spoke softly, and {other} nodded along."

#. resolved-locale: en
#. STRINGS.SOCIAL.LOG_STORY.CHAT_HOTHEAD_1
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.CHAT_HOTHEAD_1"
msgid "{actor}说着说着就提高了音量,{other}居然没介意。"
msgstr "{actor}'s voice kept rising; {other} somehow didn't mind."

#. resolved-locale: en
#. STRINGS.SOCIAL.LOG_STORY.CHAT_HOTHEAD_2
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.CHAT_HOTHEAD_2"
msgid "{actor}越聊越激动,差点拍了桌子。"
msgstr "{actor} got so worked up mid-chat they nearly slammed the table."

#. resolved-locale: en
#. STRINGS.SOCIAL.LOG_STORY.CHAT_LOUD_1
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.CHAT_LOUD_1"
msgid "{actor}大着嗓门跟{other}聊了个痛快。"
msgstr "{actor} chatted with {other} at full volume, thoroughly enjoying it."

#. resolved-locale: en
#. STRINGS.SOCIAL.LOG_STORY.CHAT_NERVOUS_1
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.CHAT_NERVOUS_1"
msgid "{actor}压低声音跟{other}嘀咕了半天,不知在担心什么。"
msgstr "{actor} muttered to {other} in hushed tones, worried about who knows what."

#. resolved-locale: en
#. STRINGS.SOCIAL.LOG_STORY.CHAT_RIVAL_1
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.CHAT_RIVAL_1"
msgid "{pair}话里带刺,聊得像在过招。"
msgstr "{pair} traded barbed words; the chat was a duel."

#. resolved-locale: en
#. STRINGS.SOCIAL.LOG_STORY.CHAT_WAITED_1
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.CHAT_WAITED_1"
msgid "{pair}有说有笑,当初那次拒绝如今成了笑谈。"
msgstr "{pair} laughed together; that old rejection is just a funny story now."

#. resolved-locale: en
#. STRINGS.SOCIAL.LOG_STORY.COMFORT_1
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.COMFORT_1"
msgid "{actor}陪着{other},直到他缓过来。"
msgstr "{actor} stayed with {other} until they came around."

#. resolved-locale: en
#. STRINGS.SOCIAL.LOG_STORY.COMFORT_2
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.COMFORT_2"
msgid "{other}在{actor}的陪伴下平静了下来。"
msgstr "{other} calmed down in {actor}'s company."

#. resolved-locale: en
#. STRINGS.SOCIAL.LOG_STORY.COMFORT_3
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.COMFORT_3"
msgid "{actor}没说什么大道理,只是陪着{other}。"
msgstr "{actor} offered no grand wisdom — just stayed with {other}."

#. resolved-locale: en
#. STRINGS.SOCIAL.LOG_STORY.COMFORT_4
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.COMFORT_4"
msgid "{other}想说谢谢,{actor}摆摆手让他省点力气。"
msgstr "{other} tried to say thanks; {actor} waved it off to save them the breath."

#. resolved-locale: en
#. STRINGS.SOCIAL.LOG_STORY.COMFORT_5
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.COMFORT_5"
msgid "有些夜晚只能熬过去,好在{other}不是一个人熬。"
msgstr "Some nights can only be endured. At least {other} didn't endure this one alone."

#. resolved-locale: en
#. STRINGS.SOCIAL.LOG_STORY.CONFESSION_1
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.CONFESSION_1"
msgid "{actor}向{other}表明了心意——{other}答应了。"
msgstr "{actor} confessed their feelings to {other} — {other} said yes."

#. resolved-locale: en
#. STRINGS.SOCIAL.LOG_STORY.CONFESSION_2
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.CONFESSION_2"
msgid "{actor}鼓起勇气告白,{other}红着脸点了头。"
msgstr "{actor} found the courage to confess; {other}, blushing, nodded."

#. resolved-locale: en
#. STRINGS.SOCIAL.LOG_STORY.CONFESSION_3
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.CONFESSION_3"
msgid "{actor}把练习了十遍的话说到一半,{other}就答应了。"
msgstr "{actor} got halfway through the rehearsed speech before {other} said yes."

#. resolved-locale: en
#. STRINGS.SOCIAL.LOG_STORY.CONFESSION_4
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.CONFESSION_4"
msgid "在打印舱的见证下,{actor}和{other}牵起了手。"
msgstr "With the printing pod as their witness, {actor} took {other}'s hand."

#. resolved-locale: en
#. STRINGS.SOCIAL.LOG_STORY.CONFESSION_5
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.CONFESSION_5"
msgid "{other}等这句话等了很久,{actor}终于说出口了。"
msgstr "{other} had waited a long time for those words; {actor} finally said them."

#. resolved-locale: en
#. STRINGS.SOCIAL.LOG_STORY.CONFESSION_FAIL_1
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.CONFESSION_FAIL_1"
msgid "{actor}向{other}表白了,但{other}没有答应。"
msgstr "{actor} confessed to {other}, but {other} did not say yes."

#. resolved-locale: en
#. STRINGS.SOCIAL.LOG_STORY.CONFESSION_FAIL_2
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.CONFESSION_FAIL_2"
msgid "{actor}的心意,{other}没能接住。"
msgstr "{other} could not return {actor}'s feelings."

#. resolved-locale: en
#. STRINGS.SOCIAL.LOG_STORY.CONFESSION_FAIL_3
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.CONFESSION_FAIL_3"
msgid "{actor}说完那句排练好的告白,{other}沉默了很久。"
msgstr "{actor} delivered the rehearsed confession; {other} stayed silent for a long while."

#. resolved-locale: en
#. STRINGS.SOCIAL.LOG_STORY.CONFESSION_FAIL_4
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.CONFESSION_FAIL_4"
msgid "不是所有真心都有回音,{actor}今天明白了。"
msgstr "Not every heartfelt word finds an echo; {actor} learned that today."

#. resolved-locale: en
#. STRINGS.SOCIAL.LOG_STORY.DATE_1
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.DATE_1"
msgid "{pair}约了一次会,气氛正好。"
msgstr "{pair} went on a date; the mood was just right."

#. resolved-locale: en
#. STRINGS.SOCIAL.LOG_STORY.DATE_2
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.DATE_2"
msgid "{pair}独处了一会儿,眼里只有彼此。"
msgstr "{pair} stole a moment alone, with eyes only for each other."

#. resolved-locale: en
#. STRINGS.SOCIAL.LOG_STORY.DATE_3
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.DATE_3"
msgid "{pair}并肩散步,谁也没提回工作站的事。"
msgstr "{pair} walked side by side; neither mentioned going back to work."

#. resolved-locale: en
#. STRINGS.SOCIAL.LOG_STORY.DATE_4
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.DATE_4"
msgid "{pair}在望远镜旁约会,轮流看同一片星空。"
msgstr "{pair} had their date by the telescope, taking turns at the same patch of stars."

#. resolved-locale: en
#. STRINGS.SOCIAL.LOG_STORY.DATE_5
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.DATE_5"
msgid "约会的规矩是{pair}定的:不许谈排班表。"
msgstr "{pair} set one rule for the date: no talk of work schedules."

#. resolved-locale: en
#. STRINGS.SOCIAL.LOG_STORY.ERA_FAMINE
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.ERA_FAMINE"
msgid "在断粮的阴影下,"
msgstr "In the shadow of the famine, "

#. resolved-locale: en
#. STRINGS.SOCIAL.LOG_STORY.ERA_WRATH
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.ERA_WRATH"
msgid "在众怒未平的日子里,"
msgstr "In those days of unspent anger, "

#. resolved-locale: en
#. STRINGS.SOCIAL.LOG_STORY.FALLOUT_1
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.FALLOUT_1"
msgid "{pair}大吵一架,从此形同陌路。"
msgstr "{pair} had a bitter fight and became strangers."

#. resolved-locale: en
#. STRINGS.SOCIAL.LOG_STORY.FALLOUT_2
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.FALLOUT_2"
msgid "{pair}之间那点情分,一夜之间清了零。"
msgstr "Whatever warmth {pair} had left was gone overnight."

#. resolved-locale: en
#. STRINGS.SOCIAL.LOG_STORY.FALLOUT_3
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.FALLOUT_3"
msgid "从那天起,{pair}在走廊里遇见都绕着走。"
msgstr "Since that day, {pair} take detours to avoid each other in the corridors."

#. resolved-locale: en
#. STRINGS.SOCIAL.LOG_STORY.FALLOUT_4
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.FALLOUT_4"
msgid "朋友做到头,{pair}连招呼都省了。"
msgstr "The friendship ran its course; {pair} don't even nod anymore."

#. resolved-locale: en
#. STRINGS.SOCIAL.LOG_STORY.FAMINE_AVERTED_1
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.FAMINE_AVERTED_1"
msgid "粮食补上了,大家松了一口气。"
msgstr "Food arrived; the colony breathed again."

#. resolved-locale: en
#. STRINGS.SOCIAL.LOG_STORY.FAMINE_AVERTED_2
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.FAMINE_AVERTED_2"
msgid "储藏室重新有了存货,咀嚼声又回来了。"
msgstr "The pantry has stock again, and with it the sound of chewing."

#. resolved-locale: en
#. STRINGS.SOCIAL.LOG_STORY.FAMINE_AVERTED_3
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.FAMINE_AVERTED_3"
msgid "危机解除了,没人追问粮食从哪来的。"
msgstr "The crisis passed, and nobody asked where the food came from."

#. resolved-locale: en
#. STRINGS.SOCIAL.LOG_STORY.FAMINE_CULL_1
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.FAMINE_CULL_1"
msgid "{actor}和{other}为了最后一口吃的动了手。"
msgstr "{actor} and {other} fought over the last bite of food."

#. resolved-locale: en
#. STRINGS.SOCIAL.LOG_STORY.FAMINE_CULL_2
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.FAMINE_CULL_2"
msgid "饿极了的人不讲道理,{actor}和{other}为了一口吃的撕破了脸。"
msgstr "Starving people don't reason; {actor} and {other} fell out over a single bite."

#. resolved-locale: en
#. STRINGS.SOCIAL.LOG_STORY.FAMINE_CULL_3
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.FAMINE_CULL_3"
msgid "{actor}盯上了{other}的那份口粮,拳头比理智先到。"
msgstr "{actor} fixed their eyes on {other}'s ration, and fists moved faster than thought."

#. resolved-locale: en
#. STRINGS.SOCIAL.LOG_STORY.FAMINE_OVER_1
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.FAMINE_OVER_1"
msgid "断粮的日子终于过去了。"
msgstr "The days of hunger were finally over."

#. resolved-locale: en
#. STRINGS.SOCIAL.LOG_STORY.FAMINE_OVER_2
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.FAMINE_OVER_2"
msgid "粮仓重新满了,有些事大家心照不宣地不再提。"
msgstr "The granary is full again; some things are silently never mentioned."

#. resolved-locale: en
#. STRINGS.SOCIAL.LOG_STORY.FAMINE_OVER_3
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.FAMINE_OVER_3"
msgid "又能吃饱的日子来了,仿佛饥荒从没发生过。"
msgstr "Full bellies are back, as if the famine never happened."

#. resolved-locale: en
#. STRINGS.SOCIAL.LOG_STORY.FAMINE_WARNING_1
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.FAMINE_WARNING_1"
msgid "粮仓见了底,恐慌在殖民地蔓延。"
msgstr "The granary ran empty, and panic spread through the colony."

#. resolved-locale: en
#. STRINGS.SOCIAL.LOG_STORY.FAMINE_WARNING_2
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.FAMINE_WARNING_2"
msgid "最后一块软泥糕也见了底,没人敢想明天。"
msgstr "The last mush bar is gone, and no one dares think about tomorrow."

#. resolved-locale: en
#. STRINGS.SOCIAL.LOG_STORY.FAMINE_WARNING_3
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.FAMINE_WARNING_3"
msgid "饿肚子的消息比氧气传得还快。"
msgstr "Word of empty stomachs travels faster than oxygen."

#. resolved-locale: en
#. STRINGS.SOCIAL.LOG_STORY.GREET_1
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.GREET_1"
msgid "{pair}擦肩而过,互相点了点头。"
msgstr "{pair} crossed paths and exchanged a nod."

#. resolved-locale: en
#. STRINGS.SOCIAL.LOG_STORY.GREET_2
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.GREET_2"
msgid "{pair}在走廊里打了个招呼。"
msgstr "{pair} said hello in the corridor."

#. resolved-locale: en
#. STRINGS.SOCIAL.LOG_STORY.GREET_3
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.GREET_3"
msgid "{pair}碰面时寒暄了两句。"
msgstr "{pair} traded a few pleasantries when they met."

#. resolved-locale: en
#. STRINGS.SOCIAL.LOG_STORY.GREET_4
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.GREET_4"
msgid "{pair}远远地挥了挥手。"
msgstr "{pair} waved at each other from afar."

#. resolved-locale: en
#. STRINGS.SOCIAL.LOG_STORY.GREET_5
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.GREET_5"
msgid "{pair}隔着半条走廊对视了一眼,心照不宣。"
msgstr "{pair} exchanged a glance across half the corridor; nothing needed saying."

#. resolved-locale: en
#. STRINGS.SOCIAL.LOG_STORY.GREET_6
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.GREET_6"
msgid "{pair}在打印舱前排着队,顺便打了招呼。"
msgstr "{pair} queued at the printing pod and said hello while they waited."

#. resolved-locale: en
#. STRINGS.SOCIAL.LOG_STORY.GREET_BRAWL_BOND_1
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.GREET_BRAWL_BOND_1"
msgid "{pair}一照面就乐了,谁还记得当初那一架。"
msgstr "{pair} grinned at each other on sight — who remembers that old brawl?"

#. resolved-locale: en
#. STRINGS.SOCIAL.LOG_STORY.GREET_EATER_1
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.GREET_EATER_1"
msgid "{actor}嘴里还嚼着米虱糕,含混地跟{other}打了招呼。"
msgstr "Mouth full of lice loaf, {actor} mumbled a greeting to {other}."

#. resolved-locale: en
#. STRINGS.SOCIAL.LOG_STORY.GREET_GENTLE_1
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.GREET_GENTLE_1"
msgid "{actor}轻轻朝{other}点了点头,笑得很暖。"
msgstr "{actor} gave {other} a soft nod and a warm smile."

#. resolved-locale: en
#. STRINGS.SOCIAL.LOG_STORY.GREET_HOTHEAD_1
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.GREET_HOTHEAD_1"
msgid "{actor}打招呼跟下命令似的,{other}还是应了。"
msgstr "{actor}'s greeting sounded like an order; {other} answered anyway."

#. resolved-locale: en
#. STRINGS.SOCIAL.LOG_STORY.GREET_LOUD_1
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.GREET_LOUD_1"
msgid "{actor}大老远就冲{other}嚷了一嗓子问好。"
msgstr "{actor} bellowed a hello at {other} from across the room."

#. resolved-locale: en
#. STRINGS.SOCIAL.LOG_STORY.GREET_NERVOUS_1
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.GREET_NERVOUS_1"
msgid "{actor}左右看了看,才小声跟{other}打了招呼。"
msgstr "{actor} glanced around before quietly saying hi to {other}."

#. resolved-locale: en
#. STRINGS.SOCIAL.LOG_STORY.HAZARD_COMRADE_1
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.HAZARD_COMRADE_1"
msgid "{pair}一起扛过了危险的活,有了过命的交情。"
msgstr "{pair} got through dangerous work side by side — comrades now."

#. resolved-locale: en
#. STRINGS.SOCIAL.LOG_STORY.HAZARD_COMRADE_2
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.HAZARD_COMRADE_2"
msgid "从危险区活着出来,{pair}看彼此的眼神都不一样了。"
msgstr "Coming out of the hazard zone alive, {pair} looked at each other differently."

#. resolved-locale: en
#. STRINGS.SOCIAL.LOG_STORY.HAZARD_COMRADE_3
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.HAZARD_COMRADE_3"
msgid "生死关头上{pair}谁都没先跑,这交情假不了。"
msgstr "{pair} faced the danger and neither ran first; that kind of bond can't be faked."

#. resolved-locale: en
#. STRINGS.SOCIAL.LOG_STORY.HAZARD_EASED_1
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.HAZARD_EASED_1"
msgid "{actor}对{other}的那点怨气,慢慢散了。"
msgstr "{actor}'s resentment toward {other} slowly faded."

#. resolved-locale: en
#. STRINGS.SOCIAL.LOG_STORY.HAZARD_EASED_2
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.HAZARD_EASED_2"
msgid "{actor}想通了:危险活总得有人干,不该怨{other}。"
msgstr "{actor} came around: someone has to take the dangerous work; blaming {other} was wrong."

#. resolved-locale: en
#. STRINGS.SOCIAL.LOG_STORY.HAZARD_EASED_3
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.HAZARD_EASED_3"
msgid "时间把那点火气磨平了,{actor}看{other}顺眼多了。"
msgstr "Time wore the anger smooth; {other} looks a lot more agreeable to {actor} now."

#. resolved-locale: en
#. STRINGS.SOCIAL.LOG_STORY.HAZARD_GRATITUDE_1
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.HAZARD_GRATITUDE_1"
msgid "{other}替{actor}挡了危险活,{actor}记在了心里。"
msgstr "{other} took the dangerous work off {actor}'s hands, and {actor} remembered."

#. resolved-locale: en
#. STRINGS.SOCIAL.LOG_STORY.HAZARD_GRATITUDE_2
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.HAZARD_GRATITUDE_2"
msgid "危险活落下来的时候,{other}先一步接了,{actor}不会忘。"
msgstr "When the dangerous assignment came down, {other} took it first. {actor} won't forget."

#. resolved-locale: en
#. STRINGS.SOCIAL.LOG_STORY.HAZARD_GRATITUDE_3
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.HAZARD_GRATITUDE_3"
msgid "{actor}欠{other}一个人情,还是拿命换的那种。"
msgstr "{actor} owes {other} a favor — the life-risking kind."

#. resolved-locale: en
#. STRINGS.SOCIAL.LOG_STORY.HAZARD_RESENT_1
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.HAZARD_RESENT_1"
msgid "{actor}又下了一天危险区,对{other}的轻松差事有了怨气。"
msgstr "{actor} spent another day in the hazard zone and resented {other}'s easy duty."

#. resolved-locale: en
#. STRINGS.SOCIAL.LOG_STORY.HAZARD_RESENT_2
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.HAZARD_RESENT_2"
msgid "同样是下矿井,凭什么{actor}总去危险的那头——{actor}越想越不是滋味。"
msgstr "Same mine, so why does {actor} always draw the dangerous end? {actor} couldn't let it go."

#. resolved-locale: en
#. STRINGS.SOCIAL.LOG_STORY.HAZARD_RESENT_3
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.HAZARD_RESENT_3"
msgid "{actor}数着{other}的清闲日子,心里的账越记越厚。"
