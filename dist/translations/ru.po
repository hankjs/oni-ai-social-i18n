msgstr "Сначала включите «Местные данные партии» в настройках мода"

#. resolved-locale: ru
#. STRINGS.SOCIAL.MANAGEMENT.TELEMETRY_EXPORT
msgctxt "ONIAiSocial.STRINGS.SOCIAL.MANAGEMENT.TELEMETRY_EXPORT"
msgid "导出诊断报告"
msgstr "Выгрузить диагностический отчёт"

#. resolved-locale: ru
#. STRINGS.SOCIAL.MANAGEMENT.TELEMETRY_EXPORTED
msgctxt "ONIAiSocial.STRINGS.SOCIAL.MANAGEMENT.TELEMETRY_EXPORTED"
msgid "诊断报告已导出：{0}"
msgstr "Диагностический отчёт выгружен: {0}"

#. resolved-locale: ru
#. STRINGS.SOCIAL.MANAGEMENT.TELEMETRY_EXPORT_FAILED
msgctxt "ONIAiSocial.STRINGS.SOCIAL.MANAGEMENT.TELEMETRY_EXPORT_FAILED"
msgid "诊断报告导出失败：{0}"
msgstr "Не удалось выгрузить диагностический отчёт: {0}"

#. resolved-locale: ru
#. STRINGS.SOCIAL.MANAGEMENT.UNDO_BUTTON
msgctxt "ONIAiSocial.STRINGS.SOCIAL.MANAGEMENT.UNDO_BUTTON"
msgid "撤销"
msgstr "Отменить"

#. resolved-locale: ru
#. STRINGS.SOCIAL.MANAGEMENT.UNDO_COMPLETED
msgctxt "ONIAiSocial.STRINGS.SOCIAL.MANAGEMENT.UNDO_COMPLETED"
msgid "已撤销上一项标记操作"
msgstr "Предыдущее изменение меток отменено."

#. resolved-locale: ru
#. STRINGS.SOCIAL.SCENE.BOUND_BLOCK_COUPLE_1
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.BOUND_BLOCK_COUPLE_1"
msgid "我还有点没想好。"
msgstr "Слова подступили к горлу — и там остались..."

#. resolved-locale: ru
#. STRINGS.SOCIAL.SCENE.BOUND_BLOCK_COUPLE_2
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.BOUND_BLOCK_COUPLE_2"
msgid "有些话，我现在说不出口。"
msgstr "Сердце колотится, а слов нет."

#. resolved-locale: ru
#. STRINGS.SOCIAL.SCENE.BOUND_BLOCK_COUPLE_3
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.BOUND_BLOCK_COUPLE_3"
msgid "也许……我们再等等。"
msgstr "Может... подождём ещё немного."

#. resolved-locale: ru
#. STRINGS.SOCIAL.SCENE.BOUND_BLOCK_FADE_1
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.BOUND_BLOCK_FADE_1"
msgid "好久没好好说话了。"
msgstr "Давно не разговаривали — а всё как было."

#. resolved-locale: ru
#. STRINGS.SOCIAL.SCENE.BOUND_BLOCK_FADE_2
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.BOUND_BLOCK_FADE_2"
msgid "有空还是想找你聊聊。"
msgstr "Странно: никак не остывает."

#. resolved-locale: ru
#. STRINGS.SOCIAL.SCENE.BOUND_BLOCK_RIVAL_1
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.BOUND_BLOCK_RIVAL_1"
msgid "算了……犯不着。"
msgstr "Ладно... оно того не стоит."

#. resolved-locale: ru
#. STRINGS.SOCIAL.SCENE.BOUND_BLOCK_RIVAL_2
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.BOUND_BLOCK_RIVAL_2"
msgid "不说了，越说越气。"
msgstr "Злость вспыхнула — и сама собой погасла."

#. resolved-locale: ru
#. STRINGS.SOCIAL.SCENE.BOUND_BLOCK_RIVAL_3
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.BOUND_BLOCK_RIVAL_3"
msgid "我先走，省得又吵起来。"
msgstr "Видеть его больше не хочу. Наверное."

#. resolved-locale: ru
#. STRINGS.SOCIAL.SCENE.BOUND_BLOCK_SPLIT_1
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.BOUND_BLOCK_SPLIT_1"
msgid "先到这儿吧，我不想再吵了。"
msgstr "На середине ссоры расхотелось ссориться."

#. resolved-locale: ru
#. STRINGS.SOCIAL.SCENE.BOUND_BLOCK_SPLIT_2
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.BOUND_BLOCK_SPLIT_2"
msgid "有些话还是别说绝了。"
msgstr "Злые слова так и не прозвучали."

#. resolved-locale: ru
#. STRINGS.SOCIAL.SCENE.BOUND_BLOCK_SPLIT_3
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.BOUND_BLOCK_SPLIT_3"
msgid "……让我想一想吧。"
msgstr "...Считай, ничего не было."

#. resolved-locale: ru
#. STRINGS.SOCIAL.SCENE.BOUND_BLOCK_UP_1
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.BOUND_BLOCK_UP_1"
msgid "总感觉……还是差了一点火候。"
msgstr "Кажется... чего-то всё же не хватает."

#. resolved-locale: ru
#. STRINGS.SOCIAL.SCENE.BOUND_BLOCK_UP_2
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.BOUND_BLOCK_UP_2"
msgid "有些话，现在还不是时候。"
msgstr "Кое-что лучше сказать не сейчас."

#. resolved-locale: ru
#. STRINGS.SOCIAL.SCENE.BOUND_BLOCK_UP_3
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.BOUND_BLOCK_UP_3"
msgid "就到这里吧，也挺好的。"
msgstr "И так хорошо. Этого достаточно."

#. resolved-locale: ru
#. STRINGS.SOCIAL.SCENE.BRAWL_CHEER_1
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.BRAWL_CHEER_1"
msgid "真打起来了！"
msgstr "ДЕРУТСЯ! ДЕРУТСЯ!"

#. resolved-locale: ru
#. STRINGS.SOCIAL.SCENE.BRAWL_CHEER_2
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.BRAWL_CHEER_2"
msgid "你们倒是停一下啊！"
msgstr "Не разнимайте! ...А, никто и не собирался."

#. resolved-locale: ru
#. STRINGS.SOCIAL.SCENE.BRAWL_CHEER_3
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.BRAWL_CHEER_3"
msgid "这也能打起来？"
msgstr "Пусть дерутся!"

#. resolved-locale: ru
#. STRINGS.SOCIAL.SCENE.BRAWL_CHEER_4
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.BRAWL_CHEER_4"
msgid "谁去拉开他们？"
msgstr "Я просто посмотреть."

#. resolved-locale: ru
#. STRINGS.SOCIAL.SCENE.BRAWL_CHEER_5
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.BRAWL_CHEER_5"
msgid "小心！……我是说你们两个！"
msgstr "Давай его! Э-э — давайте оба!"

#. resolved-locale: ru
#. STRINGS.SOCIAL.SCENE.BRAWL_CHEER_6
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.BRAWL_CHEER_6"
msgid "都退开一点！"
msgstr "Это вообще кто-нибудь снимает?"

#. resolved-locale: ru
#. STRINGS.SOCIAL.SCENE.BRAWL_SURRENDER_1
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.BRAWL_SURRENDER_1"
msgid "停一下，我站不稳了！"
msgstr "Я не был готов! НЕ ГОТОВ!"

#. resolved-locale: ru
#. STRINGS.SOCIAL.SCENE.BRAWL_SURRENDER_2
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.BRAWL_SURRENDER_2"
msgid "够了，我认输。"
msgstr "Ладно. Ладно! Твоя взяла."

#. resolved-locale: ru
#. STRINGS.SOCIAL.SCENE.BRAWL_SURRENDER_3
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.BRAWL_SURRENDER_3"
msgid "不打了，让我缓缓！"
msgstr "Сдаюсь! Сдаюсь!"

#. resolved-locale: ru
#. STRINGS.SOCIAL.SCENE.BRAWL_SURRENDER_4
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.BRAWL_SURRENDER_4"
msgid "别打了，我错了！"
msgstr "Хватит — хватит, я был неправ!"

#. resolved-locale: ru
#. STRINGS.SOCIAL.SCENE.BRAWL_SURRENDER_5
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.BRAWL_SURRENDER_5"
msgid "不打了，到这儿吧！"
msgstr "Всё. Больше не буду."

#. resolved-locale: ru
#. STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_1
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_1"
msgid "你还想接着吵？"
msgstr "Ничего личного. Просто здесь все бесполезны — ты в первую очередь."

#. resolved-locale: ru
#. STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_10
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_10"
msgid "我可不会一直让着你！"
msgstr "Промедлил — проиграл. Ты промедлил."

#. resolved-locale: ru
#. STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_11
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_11"
msgid "你倒是解释啊！"
msgstr "Поплачь ещё."

#. resolved-locale: ru
#. STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_12
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_12"
msgid "这事我还没跟你算完！"
msgstr "Ну всё, теперь давление на твоей стороне."

#. resolved-locale: ru
#. STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_13
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_13"
msgid "你还真敢动手！"
msgstr "Смело для того, кто в зоне удара."

#. resolved-locale: ru
#. STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_14
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_14"
msgid "少说两句漂亮话！"
msgstr "Расширь кругозор. Начни с лица."

#. resolved-locale: ru
#. STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_15
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_15"
msgid "行，这回是我没站稳！"
msgstr "Клоун здесь я — раз тебе поверил."

#. resolved-locale: ru
#. STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_16
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_16"
msgid "旧账也不是你想翻就翻！"
msgstr "То было тогда. А это — сейчас."

#. resolved-locale: ru
#. STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_17
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_17"
msgid "说着话怎么就动手了！"
msgstr "Молодёжь пошла — никакого понятия о чести."

#. resolved-locale: ru
#. STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_18
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_18"
msgid "退后，别再挤过来！"
msgstr "Назад. Назад. НАЗАД."

#. resolved-locale: ru
#. STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_19
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_19"
msgid "别打完才来道歉！"
msgstr "Извинения оставь себе. Терпеть их не могу."

#. resolved-locale: ru
#. STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_2
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_2"
msgid "有话说清楚，别推我！"
msgstr "Руки кривые — тренируйся."

#. resolved-locale: ru
#. STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_20
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_20"
msgid "你能不能把嘴放干净点！"
msgstr "У тебя рот грязнее, чем вентиляция без фильтра."

#. resolved-locale: ru
#. STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_3
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_3"
msgid "你非得动手是吧？"
msgstr "Такого бесстыдства я ещё не встречал."

#. resolved-locale: ru
#. STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_4
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_4"
msgid "看着我，把话说完！"
msgstr "Смотри на меня. СМОТРИ НА МЕНЯ."

#. resolved-locale: ru
#. STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_5
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_5"
msgid "还没完呢！"
msgstr "И это всё? Серьёзно, всё?"

#. resolved-locale: ru
#. STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_6
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_6"
msgid "别冲我指手画脚！"
msgstr "О, теперь ты будешь учить меня работать?"

#. resolved-locale: ru
#. STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_7
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_7"
msgid "你就一点错都没有？"
msgstr "А не думал, что проблема — в тебе?"

#. resolved-locale: ru
#. STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_8
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_8"
msgid "先别得意！"
msgstr "Шампанское в перерыве открываешь?"

#. resolved-locale: ru
#. STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_9
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_9"
msgid "你声音大就有理了？"
msgstr "О-о, кто-то занервничал."

#. resolved-locale: ru
#. STRINGS.SOCIAL.SCENE.BREAKUP_KEY
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.BREAKUP_KEY"
msgid "我们还是到这里吧。"
msgstr "Давай на этом и остановимся."

#. resolved-locale: ru
#. STRINGS.SOCIAL.SCENE.BREAKUP_REPLY
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.BREAKUP_REPLY"
msgid "……我知道了。"
msgstr "…Ясно."

#. resolved-locale: ru
#. STRINGS.SOCIAL.SCENE.CHAT_KEY
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.CHAT_KEY"
msgid "嗨。"
msgstr "Привет."

#. resolved-locale: ru
#. STRINGS.SOCIAL.SCENE.CONFESSION_FAIL_REPLY
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.CONFESSION_FAIL_REPLY"
msgid "对不起，我不能答应。"
msgstr "Прости, я не могу согласиться."

#. resolved-locale: ru
#. STRINGS.SOCIAL.SCENE.CONFESSION_FAIL_RESULT
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.CONFESSION_FAIL_RESULT"
msgid "……我明白了。"
msgstr "…Понятно."

#. resolved-locale: ru
#. STRINGS.SOCIAL.SCENE.CONFESSION_INTRO
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.CONFESSION_INTRO"
msgid "我有件重要的事想告诉你。"
msgstr "Мне нужно тебе кое-что сказать."

#. resolved-locale: ru
#. STRINGS.SOCIAL.SCENE.CONFESSION_KEY
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.CONFESSION_KEY"
msgid "我喜欢你。"
msgstr "Ты мне нравишься."

#. resolved-locale: ru
#. STRINGS.SOCIAL.SCENE.CONFESSION_REPLY
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.CONFESSION_REPLY"
msgid "我也一直喜欢你。"
msgstr "Ты мне тоже давно нравишься."

#. resolved-locale: ru
#. STRINGS.SOCIAL.SCENE.CONFESSION_RESULT
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.CONFESSION_RESULT"
msgid "那就一起走下去吧。"
msgstr "Тогда пойдём дальше вместе."

#. resolved-locale: ru
#. STRINGS.SOCIAL.SCENE.FAMINE_BUTCHER_1
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.FAMINE_BUTCHER_1"
msgid "对不起……对不起……"
msgstr "Прости. Прости меня."

#. resolved-locale: ru
#. STRINGS.SOCIAL.SCENE.FAMINE_BUTCHER_2
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.FAMINE_BUTCHER_2"
msgid "别看我。谁都别看我。"
msgstr "Не смотрите на меня. Пусть никто не смотрит."

#. resolved-locale: ru
#. STRINGS.SOCIAL.SCENE.FAMINE_BUTCHER_3
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.FAMINE_BUTCHER_3"
msgid "我们得活下去。就这样而已。"
msgstr "Нам нужно жить. Только и всего."

#. resolved-locale: ru
#. STRINGS.SOCIAL.SCENE.FAMINE_BUTCHER_4
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.FAMINE_BUTCHER_4"
msgid "这不算杀人。这是活下去。"
msgstr "Это не убийство. Это выживание."

#. resolved-locale: ru
#. STRINGS.SOCIAL.SCENE.FAMINE_BUTCHER_5
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.FAMINE_BUTCHER_5"
msgid "闭上眼睛，很快就好。"
msgstr "Не смотри. Это быстро."

#. resolved-locale: ru
#. STRINGS.SOCIAL.SCENE.FAMINE_BUTCHER_6
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.FAMINE_BUTCHER_6"
msgid "我会记得你的名字。"
msgstr "Я запомню твоё имя."

#. resolved-locale: ru
#. STRINGS.SOCIAL.SCENE.FAMINE_BUTCHER_7
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.FAMINE_BUTCHER_7"
msgid "总得有人做这件事。"
msgstr "Кто-то должен был это сделать."

#. resolved-locale: ru
#. STRINGS.SOCIAL.SCENE.GRIEF_KEY
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.GRIEF_KEY"
msgid "我会记得你的。"
msgstr "Я тебя запомню."

#. resolved-locale: ru
#. STRINGS.SOCIAL.SCENE.RECONCILE_KEY
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.RECONCILE_KEY"
msgid "别再这样僵下去了。"
msgstr "Не будем так дальше стоять в холодной войне."

#. resolved-locale: ru
#. STRINGS.SOCIAL.SCENE.RECONCILE_REPLY
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.RECONCILE_REPLY"
msgid "好，我们重新来过。"
msgstr "Хорошо, начнём сначала."

#. resolved-locale: ru
#. STRINGS.SOCIAL.SCENE.REKINDLE_INTRO
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.REKINDLE_INTRO"
msgid "有些话，我还是想再说一次。"
msgstr "Некоторые слова я всё же хочу сказать ещё раз."

#. resolved-locale: ru
#. STRINGS.SOCIAL.SCENE.REKINDLE_KEY
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.REKINDLE_KEY"
msgid "我们能重新开始吗？"
msgstr "Мы можем начать сначала?"

#. resolved-locale: ru
#. STRINGS.SOCIAL.SCENE.REKINDLE_REPLY
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.REKINDLE_REPLY"
msgid "这次别再错过了。"
msgstr "На этот раз не упустим."

#. resolved-locale: ru
#. STRINGS.SOCIAL.SCENE.REKINDLE_RESULT
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.REKINDLE_RESULT"
msgid "重新认识彼此吧。"
msgstr "Давай узнаем друг друга заново."

#. resolved-locale: ru
#. STRINGS.SOCIAL.SCENE.RIVAL_KEY
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.RIVAL_KEY"
msgid "这笔账，我不会就这么算了。"
msgstr "Этот счёт я так не оставлю."

#. resolved-locale: ru
#. STRINGS.SOCIAL.SCENE.RIVAL_REPLY
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.RIVAL_REPLY"
msgid "正好，我也没打算和你和解。"
msgstr "Как раз, я тоже не собирался мириться."

#. resolved-locale: ru
#. STRINGS.SOCIAL.SCENE.WRATH_MEAL_SNUB_1
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.WRATH_MEAL_SNUB_1"
msgid "我去别处坐。"
msgstr "Я уже поел."

#. resolved-locale: ru
#. STRINGS.SOCIAL.SCENE.WRATH_MEAL_SNUB_2
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.WRATH_MEAL_SNUB_2"
msgid "……我端到那边去。"
msgstr "...Пойду доем там."

#. resolved-locale: ru
#. STRINGS.SOCIAL.SCENE.WRATH_MEAL_SNUB_3
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.WRATH_MEAL_SNUB_3"
msgid "我想自己吃。"
msgstr "За этим столом занято."

#. resolved-locale: ru
#. STRINGS.SOCIAL.SCENE.WRATH_MEAL_SNUB_4
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SCENE.WRATH_MEAL_SNUB_4"
msgid "这顿我想清静点。"
msgstr "Точно, у меня же ещё работа."

#. resolved-locale: ru
#. STRINGS.SOCIAL.SETTINGS.AFFINITY_POPUPS
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SETTINGS.AFFINITY_POPUPS"
msgid "好感增减飘字"
msgstr "Всплывающие числа симпатии"

#. resolved-locale: ru
#. STRINGS.SOCIAL.SETTINGS.AI_WIP_HINT
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SETTINGS.AI_WIP_HINT"
msgid "AI 对话仍在完善中，默认关闭。关闭时使用内置台词，社交玩法照常运行。"
msgstr "Реплики ИИ ещё сырые, по умолчанию выкл.; при выключении всегда играют встроенные реплики, игра полная"

#. resolved-locale: ru
#. STRINGS.SOCIAL.SETTINGS.AMBIENT_CHAT_COOLDOWN
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SETTINGS.AMBIENT_CHAT_COOLDOWN"
msgid "模组闲聊：同一复制人的间隔（秒）"
msgstr "Перезарядка добавленной модом болтовни одного дубликанта (сек.)"

#. resolved-locale: ru
#. STRINGS.SOCIAL.SETTINGS.API_ENDPOINT_MISSING
msgctxt "ONIAiSocial.STRINGS.SOCIAL.SETTINGS.API_ENDPOINT_MISSING"
msgid "请检查 API 地址和模型名称。填写完整前，将使用内置台词。"
msgstr "Key заполнен, но адрес API или модель пусты/неверны: ИИ-диалог не запускается"

#. resolved-locale: ru
