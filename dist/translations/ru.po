msgstr "{pair} отметили дни вместе."

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.ANNIVERSARY_2
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.ANNIVERSARY_2"
msgid "{pair}又安稳地走过了一年,值得碰一杯。"
msgstr "{pair} спокойно прошли ещё один год — есть за что чокнуться."

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.ANNIVERSARY_3
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.ANNIVERSARY_3"
msgid "在这个连日历都要自己记的地方,{pair}没有忘记今天。"
msgstr "Там, где календарь ведут сами, {pair} сегодняшний день не забыли."

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.ANNIVERSARY_4
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.ANNIVERSARY_4"
msgid "{pair}把纪念日过成了全殖民地的节日——至少他们自己是这么觉得的。"
msgstr "{pair} превратили годовщину в праздник всей колонии — по крайней мере, сами так решили."

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.ANNIVERSARY_MISSED_1
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.ANNIVERSARY_MISSED_1"
msgid "{actor}忘了和{other}的纪念日。"
msgstr "{actor} забыл годовщину с {other}."

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.ANNIVERSARY_MISSED_2
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.ANNIVERSARY_MISSED_2"
msgid "{actor}的排班表上唯独漏掉了和{other}的纪念日。"
msgstr "В расписании {actor} не оказалось только годовщины с {other}."

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.ANNIVERSARY_MISSED_3
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.ANNIVERSARY_MISSED_3"
msgid "{other}等了一晚上,{actor}在矿井里浑然不觉。"
msgstr "{other} ждал весь вечер, а {actor} в шахте и не подозревал."

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.ANNIVERSARY_MISSED_4
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.ANNIVERSARY_MISSED_4"
msgid "日子一忙就糊涂,{actor}把最重要的那天忘了。"
msgstr "В суете дни путаются — {actor} забыл самый важный."

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.APOLOGY_1
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.APOLOGY_1"
msgid "{actor}向{other}道了歉。"
msgstr "{actor} извинился перед {other}."

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.APOLOGY_2
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.APOLOGY_2"
msgid "{actor}先低了头,{other}也就顺势原谅了。"
msgstr "{actor} склонил голову первым, и {other} оттого простил."

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.APOLOGY_3
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.APOLOGY_3"
msgid "{actor}把「对不起」三个字说得磕磕绊绊,{other}收下了。"
msgstr "{actor} выговорил «прости» спотыкаясь, {other} принял."

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.APOLOGY_4
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.APOLOGY_4"
msgid "{actor}递过去一块软泥糕,算是赔罪。"
msgstr "{actor} протянул кусок каши-батончика — вместо извинения."

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.APOLOGY_5
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.APOLOGY_5"
msgid "面子和{other}之间,{actor}选了{other}。"
msgstr "Между самолюбием и {other} {actor} выбрал {other}."

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.APOLOGY_BOND_1
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.APOLOGY_BOND_1"
msgid "一场冲突反倒让{pair}成了好朋友。"
msgstr "Ссора наоборот сделала {pair} хорошими друзьями."

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.APOLOGY_BOND_2
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.APOLOGY_BOND_2"
msgid "{pair}把话说透,反倒成了朋友。"
msgstr "{pair} всё проговорили начистоту и стали друзьями."

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.APOLOGY_BOND_3
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.APOLOGY_BOND_3"
msgid "道完歉的{pair},比吵架前还要亲近。"
msgstr "После извинений {pair} стали ближе, чем до ссоры."

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.APOLOGY_BOND_4
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.APOLOGY_BOND_4"
msgid "{pair}先是吵了一架,然后成了朋友——事情就是这样。"
msgstr "{pair} сначала поссорились, потом стали друзьями — вот так это и вышло."

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.ARGUMENT_1
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.ARGUMENT_1"
msgid "{pair}吵了一架。"
msgstr "{pair} поссорились."

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.ARGUMENT_2
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.ARGUMENT_2"
msgid "{pair}争执了起来,谁也不让谁。"
msgstr "{pair} вступили в ссору, никто не уступал."

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.ARGUMENT_3
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.ARGUMENT_3"
msgid "{pair}的声音越抬越高,惊动了隔壁的哈奇。"
msgstr "Голоса {pair} поднимались всё выше и вспугнули хэтча за стеной."

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.ARGUMENT_4
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.ARGUMENT_4"
msgid "{pair}为一点小事红了脸,事后想想都不值。"
msgstr "{pair} покраснели из-за пустяка и потом сами видели, что не стоило."

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.ARGUMENT_5
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.ARGUMENT_5"
msgid "一场架吵完,{pair}都觉得是对方先不讲理的。"
msgstr "Ссора кончилась, и {pair} оба решили, что первым зарвался другой."

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.ARGUMENT_CAUSE_1
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.ARGUMENT_CAUSE_1"
msgid "因为{cause},{pair}吵了起来。"
msgstr "Из-за {cause} {pair} поссорились."

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.BESTFRIEND_1
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.BESTFRIEND_1"
msgid "{pair}聊到深夜,成了彼此的挚友。"
msgstr "{pair} проговорили до глубокой ночи и стали лучшими друзьями."

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.BESTFRIEND_2
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.BESTFRIEND_2"
msgid "{pair}说了些从没对别人说过的话。"
msgstr "{pair} сказали друг другу то, чего не говорили никому."

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.BESTFRIEND_3
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.BESTFRIEND_3"
msgid "{pair}交换了彼此的秘密,从此不分你我。"
msgstr "{pair} обменялись секретами и с тех пор не делят «твоё» и «моё»."

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.BESTFRIEND_4
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.BESTFRIEND_4"
msgid "那晚{pair}聊到天亮,谁也没提该睡觉的事。"
msgstr "В ту ночь {pair} проговорили до утра, и никто не вспомнил про сон."

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.BESTFRIEND_5
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.BESTFRIEND_5"
msgid "有些人认识很久才是朋友,{pair}只花了一个晚上。"
msgstr "Иным нужны годы, чтобы стать друзьями, — {pair} хватило одного вечера."

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.BOUND_BLOCK_1
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.BOUND_BLOCK_1"
msgid "{pair}之间像隔着一层看不见的墙,关系停在了原地。"
msgstr "Между {pair} встала невидимая стена, и отношения замерли на месте."

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.BOUND_BLOCK_2
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.BOUND_BLOCK_2"
msgid "某种说不清的力量按住了{pair}的缘分,谁也没有再进一步。"
msgstr "Некая сила придержала судьбу {pair}, и никто не сделал шаг дальше."

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.BOUND_BLOCK_3
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.BOUND_BLOCK_3"
msgid "{pair}的故事刚要翻页,又被无形的手轻轻按住。"
msgstr "История {pair} уже переворачивала страницу — невидимая рука мягко прижала её обратно."

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.BOUND_BLOCK_4
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.BOUND_BLOCK_4"
msgid "命运在{pair}之间画了一条线,谁也没有跨过去。"
msgstr "Судьба провела черту между {pair}, и никто её не переступил."

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.BOUND_BLOCK_5
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.BOUND_BLOCK_5"
msgid "{pair}的关系起了波澜,又莫名其妙地平息了。"
msgstr "Отношения {pair} всколыхнулись и так же непонятно улеглись."

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.BRAWL_1
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.BRAWL_1"
msgid "{pair}打了起来。"
msgstr "{pair} подрались."

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.BRAWL_2
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.BRAWL_2"
msgid "{pair}的争执升级成了拳脚。"
msgstr "Ссора {pair} перешла на кулаки."

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.BRAWL_3
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.BRAWL_3"
msgid "{pair}扭作一团,工具散了一地。"
msgstr "{pair} сцепились в клубок, инструменты — по полу."

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.BRAWL_4
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.BRAWL_4"
msgid "这一架打得难看,{pair}都挂了彩。"
msgstr "Драка вышла некрасивая, {pair} оба в синяках."

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.BRAWL_5
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.BRAWL_5"
msgid "劝架的都来了,{pair}才肯撒手。"
msgstr "Пока не сбежались разнимать, {pair} не хотели разжимать руки."

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.BREAKUP_1
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.BREAKUP_1"
msgid "{pair}分手了。"
msgstr "{pair} расстались."

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.BREAKUP_2
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.BREAKUP_2"
msgid "{pair}的感情走到了尽头。"
msgstr "Чувства {pair} дошли до конца."

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.BREAKUP_3
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.BREAKUP_3"
msgid "{pair}把话说开,然后各自转身。"
msgstr "{pair} всё сказали вслух и повернулись прочь."

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.BREAKUP_4
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.BREAKUP_4"
msgid "{pair}的关系,像气压服的氧气一样耗尽了。"
msgstr "Отношения {pair} кончились, как кислород в атмосфекостюме."

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.BREAKUP_5
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.BREAKUP_5"
msgid "{other}还想挽回,{actor}已经不想再谈了。"
msgstr "{other} ещё хотел вернуть, {actor} больше не хотел говорить."

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.CARE_1
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.CARE_1"
msgid "{actor}照顾了{other}。"
msgstr "{actor} ухаживал за {other}."

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.CARE_2
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.CARE_2"
msgid "{actor}帮{other}处理了伤势。"
msgstr "{actor} обработал раны {other}."

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.CARE_3
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.CARE_3"
msgid "{actor}给{other}换了绷带,动作很轻。"
msgstr "{actor} сменил повязку {other}, очень осторожно."

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.CARE_4
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.CARE_4"
msgid "{other}嘴上说着没事,还是让{actor}照看了一整天。"
msgstr "{other} твердил, что всё в порядке, и всё равно весь день дал {actor} за собой смотреть."

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.CARE_5
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.CARE_5"
msgid "{actor}守在{other}旁边,连药都提前晾温了。"
msgstr "{actor} дежурил у {other} и даже заранее остудил лекарство."

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.CHAT_1
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.CHAT_1"
msgid "{pair}聊了会儿天。"
msgstr "{pair} немного поговорили."

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.CHAT_2
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.CHAT_2"
msgid "{pair}凑在一起闲聊,气氛不错。"
msgstr "{pair} столпились поболтать — настроение было хорошее."

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.CHAT_3
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.CHAT_3"
msgid "{pair}聊起了家长里短。"
msgstr "{pair} судачили о мелочах базы."

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.CHAT_4
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.CHAT_4"
msgid "{pair}聊起了{topic}。"
msgstr "{pair} заговорили о {topic}."

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.CHAT_5
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.CHAT_5"
msgid "{pair}交换了今天的见闻。"
msgstr "{pair} обменялись новостями дня."

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.CHAT_6
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.CHAT_6"
msgid "{pair}有一搭没一搭地聊着,时间过得飞快。"
msgstr "{pair} болтали ни о чём, и время пролетело."

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.CHAT_BRAWL_BOND_1
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.CHAT_BRAWL_BOND_1"
msgid "{pair}聊得热络——不打不相识。"
msgstr "{pair} разговорились горячо — поссорились, стало быть, подружились."

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.CHAT_COLD_1
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.CHAT_COLD_1"
msgid "{pair}僵着脖子,交换了几句必要的话。"
msgstr "{pair} с каменными шеями обменялись необходимыми словами."

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.CHAT_COMRADE_1
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.CHAT_COMRADE_1"
msgid "{pair}聊起那次死里逃生,话就没个完。"
msgstr "{pair} завели ту историю, как выбрались живыми, и словам не было конца."

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.CHAT_COUPLE_1
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.CHAT_COUPLE_1"
msgid "{pair}凑在一起说悄悄话,旁若无人。"
msgstr "{pair} шептались вплотную, будто вокруг никого нет."

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.CHAT_CRUSH_1
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.CHAT_CRUSH_1"
msgid "{pair}聊着聊着,目光就躲到了别处。"
msgstr "{pair} говорили — и взгляды сами прятались в сторону."

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.CHAT_CRYBABY_1
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.CHAT_CRYBABY_1"
msgid "{actor}说着说着眼圈就红了,{other}赶紧岔开了话题。"
msgstr "{actor} говорил — и глаза уже на мокром месте, {other} поспешил сменить тему."

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.CHAT_EATER_1
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.CHAT_EATER_1"
msgid "{actor}边吃边聊,{other}的话头总被咀嚼声盖过去。"
msgstr "{actor} болтал с набитым ртом, и слова {other} то и дело тонули в жевании."

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.CHAT_EX_1
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.CHAT_EX_1"
msgid "{pair}聊了几句,客气得像刚认识。"
msgstr "{pair} перекинулись парой фраз, вежливо, как едва знакомые."

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.CHAT_GENTLE_1
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.CHAT_GENTLE_1"
msgid "{actor}说话轻声细语,{other}听得直点头。"
msgstr "{actor} говорил тихо и мягко, {other} только кивал."

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.CHAT_HOTHEAD_1
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.CHAT_HOTHEAD_1"
msgid "{actor}说着说着就提高了音量,{other}居然没介意。"
msgstr "{actor} в разговоре сам повысил голос, а {other} почему-то не обиделся."

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.CHAT_HOTHEAD_2
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.CHAT_HOTHEAD_2"
msgid "{actor}越聊越激动,差点拍了桌子。"
msgstr "{actor} разговорился всё горячее и чуть не хлопнул по столу."

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.CHAT_LOUD_1
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.CHAT_LOUD_1"
msgid "{actor}大着嗓门跟{other}聊了个痛快。"
msgstr "{actor} во всё горло наговорился с {other} от души."

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.CHAT_NERVOUS_1
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.CHAT_NERVOUS_1"
msgid "{actor}压低声音跟{other}嘀咕了半天,不知在担心什么。"
msgstr "{actor} долго шептался с {other} приглушённо — сам не знает, чего боится."

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.CHAT_RIVAL_1
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.CHAT_RIVAL_1"
msgid "{pair}话里带刺,聊得像在过招。"
msgstr "В словах {pair} торчали колючки, разговор был как обмен ударами."

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.CHAT_WAITED_1
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.CHAT_WAITED_1"
msgid "{pair}有说有笑,当初那次拒绝如今成了笑谈。"
msgstr "{pair} смеялись в разговоре: тот давний отказ теперь стал шуткой."

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.COMFORT_1
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.COMFORT_1"
msgid "{actor}陪着{other},直到他缓过来。"
msgstr "{actor} оставался с {other}, пока тот не пришёл в себя."

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.COMFORT_2
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.COMFORT_2"
msgid "{other}在{actor}的陪伴下平静了下来。"
msgstr "{other} рядом с {actor} наконец успокоился."

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.COMFORT_3
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.COMFORT_3"
msgid "{actor}没说什么大道理,只是陪着{other}。"
msgstr "{actor} не читал нотаций — просто был рядом с {other}."

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.COMFORT_4
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.COMFORT_4"
msgid "{other}想说谢谢,{actor}摆摆手让他省点力气。"
msgstr "{other} хотел сказать спасибо, но {actor} махнул рукой: береги силы."

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.COMFORT_5
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.COMFORT_5"
msgid "有些夜晚只能熬过去,好在{other}不是一个人熬。"
msgstr "Иные ночи можно только пережить — хорошо, что {other} переживал не один."

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.CONFESSION_1
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.CONFESSION_1"
msgid "{actor}向{other}表明了心意——{other}答应了。"
msgstr "{actor} открыл чувства {other} — и {other} согласился."

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.CONFESSION_2
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.CONFESSION_2"
msgid "{actor}鼓起勇气告白,{other}红着脸点了头。"
msgstr "{actor} набрался духу для признания, {other} кивнул, покраснев."

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.CONFESSION_3
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.CONFESSION_3"
msgid "{actor}把练习了十遍的话说到一半,{other}就答应了。"
msgstr "{actor} не договорил фразу, которую твердил десять раз, — {other} уже согласился."

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.CONFESSION_4
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.CONFESSION_4"
msgid "在打印舱的见证下,{actor}和{other}牵起了手。"
msgstr "При свете Печатного станка {actor} и {other} взялись за руки."

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.CONFESSION_5
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.CONFESSION_5"
msgid "{other}等这句话等了很久,{actor}终于说出口了。"
msgstr "{other} давно ждал этих слов, и {actor} наконец их сказал."

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.CONFESSION_FAIL_1
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.CONFESSION_FAIL_1"
msgid "{actor}向{other}表白了,但{other}没有答应。"
msgstr "{actor} сделал признание {other}, но {other} не ответил согласием."

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.CONFESSION_FAIL_2
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.CONFESSION_FAIL_2"
msgid "{actor}的心意,{other}没能接住。"
msgstr "Чувства {actor} {other} не сумел принять."

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.CONFESSION_FAIL_3
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.CONFESSION_FAIL_3"
msgid "{actor}说完那句排练好的告白,{other}沉默了很久。"
msgstr "{actor} произнёс заученное признание, и {other} долго молчал."

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.CONFESSION_FAIL_4
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.CONFESSION_FAIL_4"
msgid "不是所有真心都有回音,{actor}今天明白了。"
msgstr "Не на каждое сердце есть эхо — сегодня {actor} это понял."

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.DATE_1
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.DATE_1"
msgid "{pair}约了一次会,气氛正好。"
msgstr "{pair} сходили на свидание — настроение было то."

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.DATE_2
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.DATE_2"
msgid "{pair}独处了一会儿,眼里只有彼此。"
msgstr "{pair} побыли наедине, и в глазах был только друг друга."

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.DATE_3
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.DATE_3"
msgid "{pair}并肩散步,谁也没提回工作站的事。"
msgstr "{pair} шли рядом, и никто не заикнулся про рабочую станцию."

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.DATE_4
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.DATE_4"
msgid "{pair}在望远镜旁约会,轮流看同一片星空。"
msgstr "{pair} назначили свидание у телескопа и по очереди смотрели в одно небо."

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.DATE_5
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.DATE_5"
msgid "约会的规矩是{pair}定的:不许谈排班表。"
msgstr "Правило свидания {pair} придумали сами: о расписании ни слова."

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.ERA_FAMINE
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.ERA_FAMINE"
msgid "在断粮的阴影下,"
msgstr "В тени голодных дней "

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.ERA_WRATH
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.ERA_WRATH"
msgid "在众怒未平的日子里,"
msgstr "В дни, когда гнев толпы ещё не стих, "

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.FALLOUT_1
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.FALLOUT_1"
msgid "{pair}大吵一架,从此形同陌路。"
msgstr "{pair} громко поссорились и с тех пор чужие."

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.FALLOUT_2
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.FALLOUT_2"
msgid "{pair}之间那点情分,一夜之间清了零。"
msgstr "Та капля приязни между {pair} за ночь обнулилась."

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.FALLOUT_3
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.FALLOUT_3"
msgid "从那天起,{pair}在走廊里遇见都绕着走。"
msgstr "С того дня {pair} в коридоре обходят друг друга."

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.FALLOUT_4
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.FALLOUT_4"
msgid "朋友做到头,{pair}连招呼都省了。"
msgstr "Дружба кончилась — {pair} даже кивать перестали."

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.FAMINE_AVERTED_1
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.FAMINE_AVERTED_1"
msgid "粮食补上了,大家松了一口气。"
msgstr "Еду подвезли, все выдохнули."

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.FAMINE_AVERTED_2
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.FAMINE_AVERTED_2"
msgid "储藏室重新有了存货,咀嚼声又回来了。"
msgstr "В кладовой снова есть запас, и снова слышно жевание."

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.FAMINE_AVERTED_3
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.FAMINE_AVERTED_3"
msgid "危机解除了,没人追问粮食从哪来的。"
msgstr "Кризис миновал, никто не спрашивает, откуда взялась еда."

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.FAMINE_CULL_1
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.FAMINE_CULL_1"
msgid "{actor}和{other}为了最后一口吃的动了手。"
msgstr "{actor} и {other} схватились за последний кусок."

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.FAMINE_CULL_2
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.FAMINE_CULL_2"
msgid "饿极了的人不讲道理,{actor}和{other}为了一口吃的撕破了脸。"
msgstr "Сильный голод не слушает доводов: {actor} и {other} порвали лица из-за глотка еды."

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.FAMINE_CULL_3
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.FAMINE_CULL_3"
msgid "{actor}盯上了{other}的那份口粮,拳头比理智先到。"
msgstr "{actor} положил глаз на пайку {other}, и кулак пришёл раньше рассудка."

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.FAMINE_OVER_1
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.FAMINE_OVER_1"
msgid "断粮的日子终于过去了。"
msgstr "Голодные дни наконец миновали."

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.FAMINE_OVER_2
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.FAMINE_OVER_2"
msgid "粮仓重新满了,有些事大家心照不宣地不再提。"
msgstr "Амбар снова полон, и иное все молча больше не поднимают."

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.FAMINE_OVER_3
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.FAMINE_OVER_3"
msgid "又能吃饱的日子来了,仿佛饥荒从没发生过。"
msgstr "Снова можно наесться — будто голода и не было."

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.FAMINE_WARNING_1
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.FAMINE_WARNING_1"
msgid "粮仓见了底,恐慌在殖民地蔓延。"
msgstr "Амбар опустел, по колонии расползлась паника."

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.FAMINE_WARNING_2
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.FAMINE_WARNING_2"
msgid "最后一块软泥糕也见了底,没人敢想明天。"
msgstr "Последний кусок каши-батончика тоже кончился, о завтра никто не смеет думать."

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.FAMINE_WARNING_3
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.FAMINE_WARNING_3"
msgid "饿肚子的消息比氧气传得还快。"
msgstr "Весть о голодных желудках бежит быстрее кислорода."

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.GREET_1
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.GREET_1"
msgid "{pair}擦肩而过,互相点了点头。"
msgstr "{pair} разминулись в проходе и кивнули друг другу."

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.GREET_2
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.GREET_2"
msgid "{pair}在走廊里打了个招呼。"
msgstr "{pair} поздоровались в коридоре."

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.GREET_3
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.GREET_3"
msgid "{pair}碰面时寒暄了两句。"
msgstr "{pair} при встрече обменялись парой слов."

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.GREET_4
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.GREET_4"
msgid "{pair}远远地挥了挥手。"
msgstr "{pair} помахали друг другу издалека."

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.GREET_5
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.GREET_5"
msgid "{pair}隔着半条走廊对视了一眼,心照不宣。"
msgstr "{pair} переглянулись через полкоридора — и всё было понятно без слов."

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.GREET_6
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.GREET_6"
msgid "{pair}在打印舱前排着队,顺便打了招呼。"
msgstr "{pair} стояли в очереди у Печатного станка и заодно поздоровались."

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.GREET_BRAWL_BOND_1
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.GREET_BRAWL_BOND_1"
msgid "{pair}一照面就乐了,谁还记得当初那一架。"
msgstr "{pair} едва увидели друг друга и уже улыбаются: ту драку давно никто не помнит."

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.GREET_EATER_1
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.GREET_EATER_1"
msgid "{actor}嘴里还嚼着米虱糕,含混地跟{other}打了招呼。"
msgstr "{actor} ещё жевал батончик из мукоедов и невнятно поздоровался с {other}."

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.GREET_GENTLE_1
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.GREET_GENTLE_1"
msgid "{actor}轻轻朝{other}点了点头,笑得很暖。"
msgstr "{actor} мягко кивнул {other} и улыбнулся тепло."

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.GREET_HOTHEAD_1
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.GREET_HOTHEAD_1"
msgid "{actor}打招呼跟下命令似的,{other}还是应了。"
msgstr "{actor} здоровается так, будто отдаёт приказ, — {other} всё равно отозвался."

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.GREET_LOUD_1
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.GREET_LOUD_1"
msgid "{actor}大老远就冲{other}嚷了一嗓子问好。"
msgstr "{actor} ещё издали рявкнул привет {other}."

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.GREET_NERVOUS_1
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.GREET_NERVOUS_1"
msgid "{actor}左右看了看,才小声跟{other}打了招呼。"
msgstr "{actor} огляделся и лишь потом тихо поздоровался с {other}."

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.HAZARD_COMRADE_1
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.HAZARD_COMRADE_1"
msgid "{pair}一起扛过了危险的活,有了过命的交情。"
msgstr "{pair} вместе вынесли опасную работу и сроднились насмерть."

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.HAZARD_COMRADE_2
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.HAZARD_COMRADE_2"
msgid "从危险区活着出来,{pair}看彼此的眼神都不一样了。"
msgstr "Выйдя живыми из опасной зоны, {pair} смотрят друг на друга иначе."

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.HAZARD_COMRADE_3
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.HAZARD_COMRADE_3"
msgid "生死关头上{pair}谁都没先跑,这交情假不了。"
msgstr "На грани жизни {pair} никто не бросился бежать первым — такая дружба не притворство."

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.HAZARD_EASED_1
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.HAZARD_EASED_1"
msgid "{actor}对{other}的那点怨气,慢慢散了。"
msgstr "Та обида {actor} на {other} понемногу рассеялась."

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.HAZARD_EASED_2
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.HAZARD_EASED_2"
msgid "{actor}想通了:危险活总得有人干,不该怨{other}。"
msgstr "{actor} понял: опасную работу кто-то должен делать, и злиться на {other} незачем."

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.HAZARD_EASED_3
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.HAZARD_EASED_3"
msgid "时间把那点火气磨平了,{actor}看{other}顺眼多了。"
msgstr "Время сточило тот жар, и {actor} смотрит на {other} куда спокойнее."

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.HAZARD_GRATITUDE_1
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.HAZARD_GRATITUDE_1"
msgid "{other}替{actor}挡了危险活,{actor}记在了心里。"
msgstr "{other} принял опасную работу вместо {actor}, и {actor} это запомнил."

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.HAZARD_GRATITUDE_2
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.HAZARD_GRATITUDE_2"
msgid "危险活落下来的时候,{other}先一步接了,{actor}不会忘。"
msgstr "Когда упала опасная работа, {other} взял её первым, и {actor} не забудет."

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.HAZARD_GRATITUDE_3
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.HAZARD_GRATITUDE_3"
msgid "{actor}欠{other}一个人情,还是拿命换的那种。"
msgstr "{actor} должен {other} услугу — ту, что платят жизнью."

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.HAZARD_RESENT_1
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.HAZARD_RESENT_1"
msgid "{actor}又下了一天危险区,对{other}的轻松差事有了怨气。"
msgstr "{actor} снова провёл день в опасной зоне и затаил обиду на лёгкую работу {other}."

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.HAZARD_RESENT_2
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.HAZARD_RESENT_2"
msgid "同样是下矿井,凭什么{actor}总去危险的那头——{actor}越想越不是滋味。"
msgstr "В шахту спускаются оба, так почему {actor} всегда на опасном конце — {actor} чем дальше думал, тем кислее."

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.HAZARD_RESENT_3
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.HAZARD_RESENT_3"
msgid "{actor}数着{other}的清闲日子,心里的账越记越厚。"
msgstr "{actor} считал праздные дни {other}, и счёт в груди толстел."

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.JEALOUSY_1
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.JEALOUSY_1"
msgid "{actor}看见{other}和{third}有说有笑,心里很不是滋味。"
msgstr "{actor} видел, как {other} смеётся с {third}, и на душе было кисло."

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.JEALOUSY_2
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.JEALOUSY_2"
msgid "{actor}吃醋了。"
msgstr "{actor} приревновал."

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.JEALOUSY_3
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.JEALOUSY_3"
msgid "{third}和{other}聊得投机,{actor}在旁边数了很久的浮土。"
msgstr "{third} и {other} говорили запойно, а {actor} рядом долго пересчитывал землю."

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.JEALOUSY_4
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.JEALOUSY_4"
msgid "那股酸劲儿,{actor}自己也说不清来由。"
msgstr "Откуда взялась эта кислота, {actor} и сам бы не объяснил."

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.LOSS_CRUSH_1
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.LOSS_CRUSH_1"
msgid "{other}走了,{actor}把没说出口的话咽了回去。"
msgstr "{other} ушёл, и {actor} проглотил слова, которые так и не сказал."

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.LOSS_CRUSH_2
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.LOSS_CRUSH_2"
msgid "{other}没能等到{actor}鼓起勇气的那一天。"
msgstr "{other} не дождался дня, когда {actor} наберётся духу."

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.LOSS_CRUSH_3
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.LOSS_CRUSH_3"
msgid "{actor}把准备了好久的话,说给了{other}空着的床铺。"
msgstr "Слова, которые {actor} так долго готовил, он сказал пустой койке {other}."

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.LOSS_PARTNER_1
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.LOSS_PARTNER_1"
msgid "{actor}失去了{other},整个人都垮了。"
msgstr "{actor} потерял {other} и весь обмяк."

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.LOSS_PARTNER_2
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.LOSS_PARTNER_2"
msgid "{other}的床铺空了下来,{actor}很久都不去看那个方向。"
msgstr "Койка {other} опустела, и {actor} долго не смотрел в ту сторону."

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.LOSS_PARTNER_3
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.LOSS_PARTNER_3"
msgid "往后的排班表上再没有{other}的名字,{actor}的日子也空了一块。"
msgstr "В следующих расписаниях имени {other} больше нет, и в днях {actor} дыра."

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.MEAL_1
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.MEAL_1"
msgid "{pair}在{place}一起吃了顿饭。"
msgstr "{pair} вместе поели в {place}."

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.MEAL_2
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.MEAL_2"
msgid "{pair}边吃边聊,很放松。"
msgstr "{pair} ели и болтали, очень спокойно."

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.MEAL_3
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.MEAL_3"
msgid "{pair}拼了一桌,聊了很久。"
msgstr "{pair} сели за один стол и проговорили долго."

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.MEAL_4
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.MEAL_4"
msgid "{pair}端着餐盘坐到了一起。"
msgstr "{pair} с подносами сели рядом."

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.MEAL_5
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.MEAL_5"
msgid "{pair}分食了一份软泥糕,谁也没嫌弃谁。"
msgstr "{pair} разделили порцию каши-батончика, и никто не побрезговал."

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.MEAL_6
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.MEAL_6"
msgid "饭菜还是老样子,但{pair}这桌的笑声是新的。"
msgstr "Еда как всегда, а смех за столом {pair} был новый."

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.MEAL_COLD_1
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.MEAL_COLD_1"
msgid "{pair}隔着一张桌子,谁也没先开口。"
msgstr "{pair} сидели через стол, и никто не заговорил первым."

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.MEAL_COMRADE_1
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.MEAL_COMRADE_1"
msgid "{pair}边吃边碰了碰杯,过命的交情都在里头。"
msgstr "{pair} ели и чокнулись: в этом вся дружба, купленная жизнью."

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.MEAL_COUPLE_1
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.MEAL_COUPLE_1"
msgid "{pair}挨着坐下,这顿饭吃得很甜。"
msgstr "{pair} сели вплотную, и еда показалась сладкой."

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.MEAL_CRUSH_1
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.MEAL_CRUSH_1"
msgid "{pair}同桌吃饭,谁都吃得心不在焉。"
msgstr "{pair} ели за одним столом, и оба жевали впустую."

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.MEAL_EATER_1
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.MEAL_EATER_1"
msgid "{actor}把自己那份点心拨给了{other}。"
msgstr "{actor} отложил свою порцию сладости {other}."

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.MEAL_EATER_2
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.MEAL_EATER_2"
msgid "{pair}的餐盘收得格外干净。"
msgstr "Подносы {pair} вылизали особенно чисто."

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.MEAL_EX_1
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.MEAL_EX_1"
msgid "{pair}同桌吃饭,各自盯着餐盘。"
msgstr "{pair} ели за одним столом, каждый в свой поднос."

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.MEAL_GENTLE_1
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.MEAL_GENTLE_1"
msgid "{actor}把热乎的那份让给了{other}。"
msgstr "{actor} отдал {other} ту порцию, что ещё тёплая."

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.MEAL_HOTHEAD_1
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.MEAL_HOTHEAD_1"
msgid "{actor}嫌饭菜淡了,{other}默默把盐罐推了过去。"
msgstr "{actor} бранил еду за пресность, {other} молча пододвинул солонку."

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.MEAL_LOUD_1
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.MEAL_LOUD_1"
msgid "{pair}这桌最热闹,{actor}的嗓门半个餐厅都听得见。"
msgstr "Стол {pair} был самым шумным: голос {actor} слышала полстоловой."

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.MEAL_NERVOUS_1
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.MEAL_NERVOUS_1"
msgid "{actor}吃得心不在焉,{other}问了三遍才应声。"
msgstr "{actor} ел рассеянно, {other} окликнул трижды, пока тот отозвался."

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.MEAL_RIVAL_1
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.MEAL_RIVAL_1"
msgid "{pair}同桌吃饭,刀叉碰得格外响。"
msgstr "{pair} ели за одним столом, приборы стучали особенно громко."

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.MEAL_WAITED_1
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.MEAL_WAITED_1"
msgid "{pair}挨着坐下,这顿饭等了不止一天。"
msgstr "{pair} сели рядом — эту трапезу ждали не один день."

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.MERGE_CHAT_1
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.MERGE_CHAT_1"
msgid "{pair}这天凑在一起聊了好几回。"
msgstr "{pair} в этот день по нескольку раз сходились поговорить."

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.MERGE_CHAT_2
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.MERGE_CHAT_2"
msgid "{pair}这一天有说不完的话。"
msgstr "В этот день у {pair} словам не было конца."

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.MERGE_GREET_1
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.MERGE_GREET_1"
msgid "{pair}这一天打了不少照面,越来越熟络。"
msgstr "{pair} в этот день много раз пересеклись и становились всё более знакомыми."

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.MERGE_MEAL_1
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.MERGE_MEAL_1"
msgid "{pair}这天一起吃了好几顿饭。"
msgstr "{pair} в этот день поели вместе не раз."

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.MERGE_SOCIALIZE_1
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.MERGE_SOCIALIZE_1"
msgid "{pair}这天一有空就凑在一块儿玩。"
msgstr "{pair} в этот день при каждой свободной минуте сходились играть."

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.PAIR_JOINER
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.PAIR_JOINER"
msgid "{0} 和 {1}"
msgstr "{0} и {1}"

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.PARTY_1
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.PARTY_1"
msgid "{pair}参加了{place}的聚会。"
msgstr "{pair} были на вечеринке в {place}."

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.PARTY_2
msgctxt "ONIAiSocial.STRINGS.SOCIAL.LOG_STORY.PARTY_2"
msgid "{pair}在聚会上玩开了。"
msgstr "{pair} на вечеринке вошли во вкус."

#. resolved-locale: ru
#. STRINGS.SOCIAL.LOG_STORY.PARTY_3
