        "actorSlots": { "type": "array", "uniqueItems": true, "items": { "type": "integer", "minimum": 0 } },
        "selectionDimensions": { "type": "array", "uniqueItems": true, "items": {
          "enum": ["emotions", "intensities", "stances", "voices", "personalities", "moods", "relationshipStates", "causes", "resolvedTopics", "conversationKinds", "topicDomains", "utteranceModes", "appraisals", "moodWildcardEmergency"]
