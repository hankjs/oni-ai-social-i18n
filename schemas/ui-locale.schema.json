{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oni-ai-social.local/schemas/ui-locale.schema.json",
  "title": "UI locale namespace file",
  "type": "object",
  "additionalProperties": false,
  "required": ["locale", "namespace", "entries"],
  "properties": {
    "locale": { "type": "string" },
    "namespace": { "type": "string" },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "text", "sourceHash", "status"],
        "properties": {
          "key": { "type": "string", "minLength": 1 },
          "text": { "type": "string", "minLength": 1, "maxLength": 10000 },
          "sourceHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "status": { "type": "string", "enum": ["draft", "reviewed"] }
        }
      }
    }
  }
}
