{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oni-ai-social.local/schemas/chronicle-locale.schema.json",
  "title": "Chronicle locale family file",
  "type": "object",
  "additionalProperties": false,
  "required": ["locale", "family", "templates"],
  "properties": {
    "locale": { "type": "string" },
    "family": { "type": "string", "minLength": 1 },
    "templates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["templateId", "status", "text", "sourceHash"],
        "properties": {
          "templateId": { "type": "string", "minLength": 1 },
          "status": { "type": "string", "enum": ["draft", "reviewed"] },
          "text": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "sourceHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
        }
      }
    }
  }
}
