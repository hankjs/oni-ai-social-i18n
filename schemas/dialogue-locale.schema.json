{
  "type": "object", "additionalProperties": false, "required": ["locale", "family", "candidates"],
  "properties": {
    "locale": { "type": "string", "minLength": 2 }, "family": { "type": "string", "minLength": 1 },
    "candidates": { "type": "array", "items": {
      "type": "object", "additionalProperties": false,
      "required": ["candidateId", "storyletId", "contractRevision", "status", "selection", "weight", "ordinal", "turns"],
      "properties": {
        "candidateId": { "type": "string", "minLength": 1 }, "diversityKey": { "type": "string", "minLength": 1 }, "storyletId": { "type": "string", "minLength": 1 },
        "contractRevision": { "type": "integer", "minimum": 1 }, "status": { "enum": ["reviewed", "draft"] },
        "selection": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "actors": { "type": "array", "items": {
              "type": "object", "additionalProperties": false, "required": ["slot"],
              "properties": {
                "slot": { "type": "integer", "minimum": -1 },
                "emotions": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
                "intensities": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
                "stances": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
                "voices": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
                "personalities": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
                "moods": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }
              }
            } },
            "relationshipStates": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
            "causes": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
            "resolvedTopics": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
            "conversationKinds": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
            "topicDomains": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
            "utteranceModes": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
            "appraisals": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
            "responseActs": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
            "listenerAvailabilities": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
            "moodWildcardEmergency": { "type": "boolean" }
          }
        }, "weight": { "type": "number", "minimum": 0.000001 },
        "ordinal": { "type": "integer", "minimum": 1 },
        "turns": { "type": "array", "minItems": 1, "items": {
          "type": "object", "additionalProperties": false, "required": ["turnId", "speakerSlot", "text"],
          "properties": { "turnId": { "type": "string", "minLength": 1 }, "speakerSlot": { "type": "integer", "minimum": 0 }, "text": { "type": "string", "minLength": 1 } }
        }}
      }
    }}
  }
}
