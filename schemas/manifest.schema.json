{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "contentVersion", "defaultLocale", "fallbackLocale", "locales", "exports"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "contentVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "defaultLocale": { "type": "string", "pattern": "^[a-z]{2,3}(?:-[a-z0-9]{2,8})*$" },
    "fallbackLocale": { "type": "string", "pattern": "^[a-z]{2,3}(?:-[a-z0-9]{2,8})*$" },
    "locales": { "type": "array", "minItems": 1, "items": {
      "type": "object", "additionalProperties": false, "required": ["id", "status", "ship"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z]{2,3}(?:-[a-z0-9]{2,8})*$" },
        "status": { "enum": ["stable", "preview", "draft"] }, "ship": { "type": "boolean" }
      }
    }},
    "exports": { "type": "object", "additionalProperties": false,
      "required": ["ui", "dialogue", "chronicle", "prompts"], "properties": {
        "ui": { "const": "po+json" }, "dialogue": { "const": "json" },
        "chronicle": { "const": "json" }, "prompts": { "const": "json" }
      }
    }
  }
}
