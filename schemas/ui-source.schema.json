{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oni-ai-social.local/schemas/ui-source.schema.json",
  "title": "UI source namespace file",
  "type": "object",
  "additionalProperties": false,
  "required": ["namespace", "entries"],
  "properties": {
    "namespace": { "type": "string" },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "source", "arguments", "richText"],
        "properties": {
          "key": { "type": "string", "minLength": 1, "pattern": "^STRINGS\\." },
          "seq": { "type": "integer" },
          "source": { "type": "string", "minLength": 1, "maxLength": 10000 },
          "description": { "type": "string" },
          "arguments": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["token", "name", "kind"],
              "properties": {
                "token": { "type": "string" },
                "name": { "type": "string" },
                "kind": { "type": "string" }
              }
            }
          },
          "richText": { "type": "boolean" },
          "maxLength": { "type": ["integer", "null"] }
        }
      }
    }
  }
}
