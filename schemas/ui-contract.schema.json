{
  "type": "object", "additionalProperties": false, "required": ["namespace", "entries"],
  "properties": {
    "namespace": { "type": "string", "minLength": 1 },
    "entries": { "type": "array", "items": {
      "type": "object", "additionalProperties": false,
      "required": ["key", "meaning", "contractRevision", "importance", "arguments", "richText", "maxLength"],
      "properties": {
        "key": { "type": "string", "pattern": "^STRINGS\\." }, "meaning": { "type": "string", "minLength": 1 },
        "contractRevision": { "type": "integer", "minimum": 1 }, "importance": { "enum": ["critical", "standard", "optional"] },
        "arguments": { "type": "array", "items": { "type": "object", "required": ["token", "name", "kind"], "properties": {
          "token": { "type": "string", "minLength": 1 }, "name": { "type": "string", "minLength": 1 }, "kind": { "type": "string", "minLength": 1 }
        }}},
        "richText": { "type": "boolean" }, "maxLength": { "type": "integer", "minimum": 1 }
      }
    }}
  }
}
