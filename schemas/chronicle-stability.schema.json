{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oni-ai-social.local/schemas/chronicle-stability.schema.json",
  "title": "Persisted chronicle id stability contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "pools"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "pools": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["poolId", "introducedIn", "highestStableNumber"],
        "properties": {
          "poolId": {
            "type": "string",
            "pattern": "^chronicle\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
          },
          "introducedIn": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
          },
          "highestStableNumber": { "type": "integer", "minimum": 1, "maximum": 999 }
        }
      }
    }
  }
}
