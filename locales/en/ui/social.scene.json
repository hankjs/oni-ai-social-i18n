{
  "locale": "en",
  "namespace": "social.scene",
  "entries": [
    {
      "key": "STRINGS.SOCIAL.SCENE.CONFESSION_INTRO",
      "text": "There is something important I need to tell you.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.CONFESSION_KEY",
      "text": "I like you.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.CONFESSION_REPLY",
      "text": "I have always liked you too.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.CONFESSION_RESULT",
      "text": "Then let's face whatever comes next together.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.REKINDLE_INTRO",
      "text": "There is something I still need to say.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.REKINDLE_KEY",
      "text": "Can we start over?",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.REKINDLE_REPLY",
      "text": "Let's not miss our chance this time.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.REKINDLE_RESULT",
      "text": "Let's get to know each other again.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.CONFESSION_FAIL_REPLY",
      "text": "I'm sorry. I can't.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.CONFESSION_FAIL_RESULT",
      "text": "...I understand.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BREAKUP_KEY",
      "text": "I think this is where we part.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BREAKUP_REPLY",
      "text": "...I understand.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.RECONCILE_KEY",
      "text": "I do not want us to stay like this.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.RECONCILE_REPLY",
      "text": "Okay. Let's start again.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.GRIEF_KEY",
      "text": "I will remember you.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.CHAT_KEY",
      "text": "Hi.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.RIVAL_KEY",
      "text": "I am not letting this go.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.RIVAL_REPLY",
      "text": "Good. I was not planning to make peace with you either.",
      "contractRevision": 1,
      "status": "reviewed"
    }
  ]
}
