{
  "locale": "en",
  "namespace": "social.scene",
  "entries": [
    {"key":"STRINGS.SOCIAL.SCENE.CONFESSION_INTRO","text":"There is something important I need to tell you.","sourceHash":"sha256:de1372d4a233a36b41c4cff22cb98dca080883109b67799eef74d3ff81adb27b","status":"reviewed"},
    {"key":"STRINGS.SOCIAL.SCENE.CONFESSION_KEY","text":"I like you.","sourceHash":"sha256:5dc857ac8158297e477c10691a5775830ed8e16ca1969aa5cd05f87ecf54f7fa","status":"reviewed"},
    {"key":"STRINGS.SOCIAL.SCENE.CONFESSION_REPLY","text":"I have always liked you too.","sourceHash":"sha256:6447176908c38df87ebbb5e474760866f9bdc3025497b23bcffdb84361cfe4b5","status":"reviewed"},
    {"key":"STRINGS.SOCIAL.SCENE.CONFESSION_RESULT","text":"Then let's face whatever comes next together.","sourceHash":"sha256:cea79c063d42aff5585bd1c639036c09a130e006003a869d1c7ebe0c9298874b","status":"reviewed"},
    {"key":"STRINGS.SOCIAL.SCENE.REKINDLE_INTRO","text":"There is something I still need to say.","sourceHash":"sha256:1dfadc14cb548f1c386c3d909cf3d2a73d541ea1ad1ea4f949161926b6e31ad4","status":"reviewed"},
    {"key":"STRINGS.SOCIAL.SCENE.REKINDLE_KEY","text":"Can we start over?","sourceHash":"sha256:690d892bb44d2343e9e023abc0b5724745317b79178ad1a80e2736d60d06e337","status":"reviewed"},
    {"key":"STRINGS.SOCIAL.SCENE.REKINDLE_REPLY","text":"Let's not miss our chance this time.","sourceHash":"sha256:836d707f225b3009507ac96621b60774aa6836ee44b9979c69cca2888f1a3641","status":"reviewed"},
    {"key":"STRINGS.SOCIAL.SCENE.REKINDLE_RESULT","text":"Let's get to know each other again.","sourceHash":"sha256:1a25d71917990a19d1f9d3d270938fdd3e069881027d5e580ada44269ee4a48d","status":"reviewed"},
    {"key":"STRINGS.SOCIAL.SCENE.CONFESSION_FAIL_REPLY","text":"I'm sorry. I can't.","sourceHash":"sha256:3259d62dcb15e7b27a6a53873aed0b003c97e2232cfe8b3ef9c49da2e6b75a0f","status":"reviewed"},
    {"key":"STRINGS.SOCIAL.SCENE.CONFESSION_FAIL_RESULT","text":"...I understand.","sourceHash":"sha256:1b5ba25ff31afa9931a27a3fd84a377d30308b624379162ce7e7712d3a80e61e","status":"reviewed"},
    {"key":"STRINGS.SOCIAL.SCENE.BREAKUP_KEY","text":"I think this is where we part.","sourceHash":"sha256:bf4d398fafd189767c1c7f2fcbd8ed3625772b03bd6e200e8e498c774378e78a","status":"reviewed"},
    {"key":"STRINGS.SOCIAL.SCENE.BREAKUP_REPLY","text":"...I understand.","sourceHash":"sha256:1219a11c74935e2b506ae2de3ccf30669b3b9d7c8fb239eff0c7188f5eac3cf3","status":"reviewed"},
    {"key":"STRINGS.SOCIAL.SCENE.RECONCILE_KEY","text":"I do not want us to stay like this.","sourceHash":"sha256:9e1fe6d72a94d26338fbe00730cb80b2b3f58dc2c0ddd5597889aada4a394d25","status":"reviewed"},
    {"key":"STRINGS.SOCIAL.SCENE.RECONCILE_REPLY","text":"Okay. Let's start again.","sourceHash":"sha256:f688fea0da37e7bf5ab5440aa0a34fe2ba64a88dffa06dc2301e0bf89c9694c9","status":"reviewed"},
    {"key":"STRINGS.SOCIAL.SCENE.GRIEF_KEY","text":"I will remember you.","sourceHash":"sha256:bb8d4bb0267f30c276841eea90f327fc51d0b5692a6fc2741b72349b2451aaa2","status":"reviewed"},
    {"key":"STRINGS.SOCIAL.SCENE.CHAT_KEY","text":"Hi.","sourceHash":"sha256:ee15a2fe6d3793f9612e67c3c6a5bc9de11378c616a518cb381f4df22f587cf8","status":"reviewed"},
    {"key":"STRINGS.SOCIAL.SCENE.RIVAL_KEY","text":"I am not letting this go.","sourceHash":"sha256:e22a8b38d15a6d2505b0eb2f85dbe9c035b907d8e0bc91c851e13ae61a526f1c","status":"reviewed"},
    {"key":"STRINGS.SOCIAL.SCENE.RIVAL_REPLY","text":"Good. I was not planning to make peace with you either.","sourceHash":"sha256:3a4670156b81332b3adaa5bb6c92771d009c3754c7e78191c2aff40f6ddb876d","status":"reviewed"}
  ]
}
