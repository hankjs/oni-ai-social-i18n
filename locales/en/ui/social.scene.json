{
  "locale": "en",
  "namespace": "social.scene",
  "entries": [
    {
      "key": "STRINGS.SOCIAL.SCENE.CONFESSION_INTRO",
      "text": "There is something important I need to tell you.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.CONFESSION_KEY",
      "text": "I like you.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.CONFESSION_REPLY",
      "text": "I have always liked you too.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.CONFESSION_RESULT",
      "text": "Then let's face whatever comes next together.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.REKINDLE_INTRO",
      "text": "There is something I still need to say.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.REKINDLE_KEY",
      "text": "Can we start over?",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.REKINDLE_REPLY",
      "text": "Let's not miss our chance this time.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.REKINDLE_RESULT",
      "text": "Let's get to know each other again.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.CONFESSION_FAIL_REPLY",
      "text": "I'm sorry. I can't.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.CONFESSION_FAIL_RESULT",
      "text": "...I understand.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BREAKUP_KEY",
      "text": "I think this is where we part.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BREAKUP_REPLY",
      "text": "...I understand.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.RECONCILE_KEY",
      "text": "I do not want us to stay like this.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.RECONCILE_REPLY",
      "text": "Okay. Let's start again.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.GRIEF_KEY",
      "text": "I will remember you.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.CHAT_KEY",
      "text": "Hi.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.RIVAL_KEY",
      "text": "I am not letting this go.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.RIVAL_REPLY",
      "text": "Good. I was not planning to make peace with you either.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.WRATH_MEAL_SNUB_1",
      "text": "I'm done eating.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.WRATH_MEAL_SNUB_2",
      "text": "...I'll take mine over there.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.WRATH_MEAL_SNUB_3",
      "text": "This table's full.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.WRATH_MEAL_SNUB_4",
      "text": "Just remembered I've got work.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BOUND_BLOCK_UP_1",
      "text": "Feels like... something's still missing.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BOUND_BLOCK_UP_2",
      "text": "Some words are better saved for later.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BOUND_BLOCK_UP_3",
      "text": "This is fine. This is enough.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BOUND_BLOCK_COUPLE_1",
      "text": "The words rose up... and died in my throat.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BOUND_BLOCK_COUPLE_2",
      "text": "My heart raced, but nothing came out.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BOUND_BLOCK_COUPLE_3",
      "text": "Maybe... we should wait.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BOUND_BLOCK_RIVAL_1",
      "text": "Forget it... not worth it.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BOUND_BLOCK_RIVAL_2",
      "text": "The anger flared, then faded for no reason.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BOUND_BLOCK_RIVAL_3",
      "text": "I never want to see them again. Probably.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BOUND_BLOCK_SPLIT_1",
      "text": "Halfway through the fight, neither of us wanted to finish it.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BOUND_BLOCK_SPLIT_2",
      "text": "The harsh words never left our lips.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BOUND_BLOCK_SPLIT_3",
      "text": "...Let's pretend this never happened.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BOUND_BLOCK_FADE_1",
      "text": "We haven't talked in ages, yet nothing's changed.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BOUND_BLOCK_FADE_2",
      "text": "Strange — this friendship refuses to fade.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_1",
      "text": "Nothing personal. I just think everyone here is dead weight — you especially.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_2",
      "text": "Skill issue.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_3",
      "text": "I have never met a man so utterly without shame.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_4",
      "text": "Look at me. LOOK AT ME.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_5",
      "text": "That's it? That's the whole thing?",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_6",
      "text": "Oh, you're teaching me my job now?",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_7",
      "text": "Ever considered the problem might be you?",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_8",
      "text": "Popping the champagne at halftime, are we?",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_9",
      "text": "Ohhh, someone's mad.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_10",
      "text": "Hesitate and you lose. You hesitated.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_11",
      "text": "Cry about it.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_12",
      "text": "The pressure is on YOUR side of the table now.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_13",
      "text": "Bold words for someone within punching range.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_14",
      "text": "Get a bigger perspective. Starting with your face.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_15",
      "text": "Turns out the clown was me for ever trusting you.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_16",
      "text": "That was then. This is now.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_17",
      "text": "Kids these days. No honor at all.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_18",
      "text": "Back. Back. BACK.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_19",
      "text": "Save the apology. I hate apologies.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_20",
      "text": "Your mouth is filthier than an unfiltered gas vent.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BRAWL_SURRENDER_1",
      "text": "I wasn't ready! I wasn't READY!",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BRAWL_SURRENDER_2",
      "text": "Okay. Okay! You win. You win.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BRAWL_SURRENDER_3",
      "text": "I yield! I yield!",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BRAWL_SURRENDER_4",
      "text": "Stop — stop, I was wrong, I was wrong!",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BRAWL_SURRENDER_5",
      "text": "No more. No more.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BRAWL_CHEER_1",
      "text": "FIGHT! FIGHT! FIGHT!",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BRAWL_CHEER_2",
      "text": "Nobody hold them back! ...Oh. Nobody was going to.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BRAWL_CHEER_3",
      "text": "Let them go!",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BRAWL_CHEER_4",
      "text": "I'm just here for the show.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BRAWL_CHEER_5",
      "text": "Get him! Er — get both of them!",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BRAWL_CHEER_6",
      "text": "Should somebody be filming this?",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.FAMINE_BUTCHER_1",
      "text": "I'm sorry. I'm sorry.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.FAMINE_BUTCHER_2",
      "text": "Don't look at me. Nobody look at me.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.FAMINE_BUTCHER_3",
      "text": "We have to live. That is all this is.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.FAMINE_BUTCHER_4",
      "text": "This isn't murder. This is surviving.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.FAMINE_BUTCHER_5",
      "text": "Don't watch. It will be quick.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.FAMINE_BUTCHER_6",
      "text": "I will remember your name.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.FAMINE_BUTCHER_7",
      "text": "Somebody had to do it.",
      "contractRevision": 1,
      "status": "reviewed"
    }
  ]
}
