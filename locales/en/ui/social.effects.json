{
  "locale": "en",
  "namespace": "social.effects",
  "entries": [
    {
      "key": "STRINGS.SOCIAL.EFFECTS.LOVE.NAME",
      "text": "In Love",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.EFFECTS.LOVE.DESC",
      "text": "Has a sweetheart. Morale up.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.EFFECTS.LOVE_MATURE.NAME",
      "text": "Seasoned Love",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.EFFECTS.LOVE_MATURE.DESC",
      "text": "Long together, and each other's safest place. Morale way up.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.EFFECTS.DATE_AFTERGLOW.NAME",
      "text": "Date Afterglow",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.EFFECTS.DATE_AFTERGLOW.DESC",
      "text": "Fresh from a lovely date. Morale up.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.EFFECTS.CANNIBAL.NAME",
      "text": "Ate a colleague",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.EFFECTS.CANNIBAL.DESC",
      "text": "They know exactly who that meal was. Some things do not come back up once they are down.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.EFFECTS.RIVAL_DIED.NAME",
      "text": "Schadenfreude",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.EFFECTS.RIVAL_DIED.DESC",
      "text": "That one duplicant they could not stand is gone. They would never say so out loud, but the mood is good.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.EFFECTS.GRIEF.NAME",
      "text": "Grieving",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.EFFECTS.GRIEF.DESC",
      "text": "Lost a sweetheart. Morale down.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.EFFECTS.GRIEF_SOFT.NAME",
      "text": "Grieving (Supported)",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.EFFECTS.GRIEF_SOFT.DESC",
      "text": "Lost a sweetheart, but the colony's warmth softens the blow.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.EFFECTS.COLONY_COHESION.NAME",
      "text": "Colony Cohesion",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.EFFECTS.COLONY_COHESION.DESC",
      "text": "The colony stands together. Morale up for everyone.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.EFFECTS.COLONY_DISCORD.NAME",
      "text": "Colony Discord",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.EFFECTS.COLONY_DISCORD.DESC",
      "text": "Tensions run high. Morale down for everyone.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.EFFECTS.SIDE_BY_SIDE.NAME",
      "text": "Side by Side",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.EFFECTS.SIDE_BY_SIDE.DESC",
      "text": "Working alongside a friend. Efficiency up.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.EFFECTS.RIVAL_FRICTION.NAME",
      "text": "At Odds",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.EFFECTS.RIVAL_FRICTION.DESC",
      "text": "Working the same job as a rival. Both of them slow down.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.EFFECTS.STRAINED.NAME",
      "text": "Strained",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.EFFECTS.STRAINED.DESC",
      "text": "Stress is close to the breaking point. A chat, a good meal or some downtime could pull them back.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.EFFECTS.STRAINED.BUBBLE",
      "text": "Deep breath... holding it together",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.EFFECTS.WRATH_ISOLATED.NAME",
      "text": "Frozen out",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.EFFECTS.WRATH_ISOLATED.DESC",
      "text": "Something went wrong in the colony and they were the least liked person here - so the bill landed on them, whether or not they had anything to do with it. It lifts the moment somebody tends to them, talks with them, or shares a meal; given long enough, it fades on its own.",
      "contractRevision": 1,
      "status": "reviewed"
    }
  ]
}
