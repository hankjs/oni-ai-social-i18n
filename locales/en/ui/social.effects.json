  "entries": [
    {
      "key": "STRINGS.SOCIAL.EFFECTS.LOVE.NAME",
      "text": "In Love",
      "sourceHash": "sha256:4391f50d36774c56d24f9da53944792d422958726b54ff6642a6c1bfc2130c4d",
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.EFFECTS.LOVE.DESC",
      "text": "Has a sweetheart. Morale up.",
      "sourceHash": "sha256:bb49d14f05d32f7a1051f4c02f9010a63c53401ce00b10ddd6a296cd403d2f71",
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.EFFECTS.LOVE_MATURE.NAME",
      "text": "Seasoned Love",
      "sourceHash": "sha256:9287c8944f1c00742e4f2fa6f14f8de1f101950249fcef8daab9fe2de49fad8a",
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.EFFECTS.LOVE_MATURE.DESC",
      "text": "Long together, and each other's safest place. Morale way up.",
      "sourceHash": "sha256:5b65a9bea660853b7befe977dd27aa2dafb1363c6518757ca8cc71ad61024c78",
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.EFFECTS.DATE_AFTERGLOW.NAME",
      "text": "Date Afterglow",
      "sourceHash": "sha256:798827b73f409f95621e87b3db92e375ff64378298f041026c74d7a1ef5609bd",
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.EFFECTS.DATE_AFTERGLOW.DESC",
      "text": "Fresh from a lovely date. Morale up.",
      "sourceHash": "sha256:318afbb16cb1fdd0c1322a01458a28f900f190983e3384c4f7ee43f8d1a3d72f",
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.EFFECTS.CANNIBAL.NAME",
      "text": "Ate a colleague",
      "sourceHash": "sha256:8a0f76b86c700d420d26d8e23edc48166cedd150374c4d6752c51212e896fdef",
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.EFFECTS.CANNIBAL.DESC",
      "text": "They know exactly who that meal was. Some things do not come back up once they are down.",
      "sourceHash": "sha256:4b2a3e6eeeb3cacc2b0da15fe6e8eae9d027e01e8311280c0ce0c3cdcafc19a4",
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.EFFECTS.RIVAL_DIED.NAME",
      "text": "Schadenfreude",
      "sourceHash": "sha256:63f1051dbd89f821e61a9bd881fa47978f8cdd756a1355cfd32119594e9d0f76",
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.EFFECTS.RIVAL_DIED.DESC",
      "text": "That one duplicant they could not stand is gone. They would never say so out loud, but the mood is good.",
      "sourceHash": "sha256:5fbea48c03c6644f6b44fc6d53cee0cf5003a3f2eddf83c761dca9032d879d3b",
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.EFFECTS.GRIEF.NAME",
      "text": "Grieving",
      "sourceHash": "sha256:4f562ccfc7ee94ba73b5b458cf907979cc6dd8a71293a2bf6f1a1dc005c21bdd",
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.EFFECTS.GRIEF.DESC",
      "text": "Lost a sweetheart. Morale down.",
      "sourceHash": "sha256:836107b2ee6bdc9ad53761877fdbb67ec0979a4740c851ecbecb5b8e82a0461d",
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.EFFECTS.GRIEF_SOFT.NAME",
      "text": "Grieving (Supported)",
      "sourceHash": "sha256:7c79cbab9d28c505ef918079b2bf274b42d5c881f9dbea1b32104d72224e4fea",
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.EFFECTS.GRIEF_SOFT.DESC",
      "text": "Lost a sweetheart, but the colony's warmth softens the blow.",
      "sourceHash": "sha256:0c4b6070a9dedb514fd4b7f766c81e04d1448cbd4e918114b0ea514b31661910",
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.EFFECTS.COLONY_COHESION.NAME",
      "text": "Colony Cohesion",
      "sourceHash": "sha256:b2d7cb7c79e6ca219c431f86a3c540752e60a419b18794cc0a91deaa5ffbeb11",
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.EFFECTS.COLONY_COHESION.DESC",
      "text": "The colony stands together. Morale up for everyone.",
      "sourceHash": "sha256:ad447e45eff934bcd5b617dd437ea5c095a8ffe52478f1dd29b16468a47d9d6a",
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.EFFECTS.COLONY_DISCORD.NAME",
      "text": "Colony Discord",
      "sourceHash": "sha256:982105196656904bab9062ad8a3ea315d0439545f0d3b81389f4051314d7d450",
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.EFFECTS.COLONY_DISCORD.DESC",
      "text": "Tensions run high. Morale down for everyone.",
      "sourceHash": "sha256:6638cb60252f551410b614c1c5b32436f828567951bac8d5d57350ffa292c3bc",
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.EFFECTS.SIDE_BY_SIDE.NAME",
      "text": "Side by Side",
      "sourceHash": "sha256:71cc8749f5a5efecfce61c584c67608d02783e913fc9abcfbdb701741e90b482",
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.EFFECTS.SIDE_BY_SIDE.DESC",
      "text": "Working alongside a friend. Efficiency up.",
      "sourceHash": "sha256:5247cd6b34a737b5e6677e3b48d4bcf79724814f8d9a9685abdc8e4e1bceac31",
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.EFFECTS.STRAINED.NAME",
      "text": "Strained",
      "sourceHash": "sha256:0b25358ef6567345565cecafa285de6084877d5c3cc55e8b6b90d99eee1d2d62",
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.EFFECTS.STRAINED.DESC",
      "text": "Stress is close to the breaking point. A chat, a good meal or some downtime could pull them back.",
      "sourceHash": "sha256:72762f915502dfbf5efd29f1478f2354dc34793b083df4ee5bafa24e49a6f3d3",
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.EFFECTS.STRAINED.BUBBLE",
      "text": "Deep breath... holding it together",
      "sourceHash": "sha256:28f356bdc221bf180c899a5da8221e908fac313864d723b2efe9412c2d568e8f",
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.EFFECTS.WRATH_ISOLATED.NAME",
      "text": "Frozen out",
      "sourceHash": "sha256:4138999af7bbcbf1e592b22e07ada83da338b912e0ac20bcfa47385065d495a9",
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.EFFECTS.WRATH_ISOLATED.DESC",
      "text": "Something went wrong in the colony and they were the least liked person here - so the bill landed on them, whether or not they had anything to do with it. It lifts the moment somebody tends to them, talks with them, or shares a meal; given long enough, it fades on its own.",
      "sourceHash": "sha256:4531392095b12c9181cd411f0580d353448b883a99b5f90bdd4e52aea582ddfa",
      "status": "reviewed"
    }
  ]
}
