        },
        {
          "turnId": "b",
          "speakerSlot": 1,
          "text": "Welcome home! We saved you a place at the table.",
          "sourceHash": "sha256:985b878d965941f70c952339c72dd1f3be3811c467d5c46a3a72d606a6ff349a"
        }
      ]
    },
    {
