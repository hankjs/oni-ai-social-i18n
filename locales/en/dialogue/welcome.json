      "turns": [
        {
          "turnId": "a",
          "speakerSlot": 0,
          "text": "Do I get a locker?",
          "sourceHash": "sha256:22139d40e40c0b2543d2fbccb485802a82ebc3bf9f5f421177eaad4ae6b55eaa"
        },
        {
          "turnId": "b",
