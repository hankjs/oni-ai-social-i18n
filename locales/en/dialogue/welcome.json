      "status": "reviewed",
      "turns": [
        {
          "turnId": "a",
          "speakerSlot": 0,
          "text": "It's... livelier than the brochure said.",
          "sourceHash": "sha256:74d97d1dab6a66c0c4ebaa342b62a49d414f1db181470e599ee92c83f769b828"
        },
        {
          "turnId": "b",
          "speakerSlot": 1,
          "text": "That's the spirit. Ask us anything.",
          "sourceHash": "sha256:d69cc88a084276badb9f001043c72343c14b933fe24d3c354f5d5456c8b6c4bf"
        }
      ]
    },
    {
      "candidateId": "storylet.welcome.base.003",
      "status": "reviewed",
      "turns": [
        {
          "turnId": "a",
          "speakerSlot": 0,
          "text": "The Printing Pod's light was warm, and you were all here when I stepped out.",
          "sourceHash": "sha256:dd2e4e49488c9ed00a2701b545d6a8422a4a6028f33a048aab8fdaeb1faffeda"
        },
        {
          "turnId": "b",
          "speakerSlot": 1,
          "text": "Whenever it lights up again, we will welcome the next newcomer together.",
          "sourceHash": "sha256:30791b7e63ae98eb3f273b18cef9e9baba2159371f1f559222e9582dde5c2c11"
        }
      ]
    },
    {
      "candidateId": "storylet.welcome.base.004",
      "status": "reviewed",
      "turns": [
        {
          "turnId": "a",
          "speakerSlot": 0,
          "text": "Quick question: which way to the lavatory?",
          "sourceHash": "sha256:682048357ef919261d3f51d5f2d6fa32cb3520336b22bd7decb9bbd786ee8ac4"
        },
        {
          "turnId": "b",
          "speakerSlot": 1,
          "text": "Excellent question. That's the most important knowledge here.",
          "sourceHash": "sha256:d161eafacdcc40ddd97ee7ac7bb05ebfa3af36927b0ad388255f337cc902585f"
        }
      ]
    },
    {
      "candidateId": "storylet.welcome.base.005",
      "status": "reviewed",
      "turns": [
        {
          "turnId": "a",
          "speakerSlot": 0,
          "text": "I have three skills. Here's my resume.",
          "sourceHash": "sha256:5823725aca6611efe9511dd046067ceb279a4487426206b0b4196dd8eecf4ff4"
        },
        {
          "turnId": "b",
          "speakerSlot": 1,
          "text": "Breathing is the only requirement. We'll teach the rest.",
          "sourceHash": "sha256:0d02b98138c8342a0d345251338fa1042963bb61ebc8d63b34b91991798be0ff"
        }
      ]
    },
    {
      "candidateId": "storylet.welcome.base.006",
      "status": "reviewed",
      "turns": [
        {
          "turnId": "a",
          "speakerSlot": 0,
          "text": "The Printing Pod just brought me here. I'd like to get to know this place.",
          "sourceHash": "sha256:f906063537c1fc167554021b5c399706a7070658f7195cae9c247162b8877713"
        },
        {
          "turnId": "b",
          "speakerSlot": 1,
          "text": "Start with us. Welcome home—we'll show you around the base.",
          "sourceHash": "sha256:d6fa49a79dabe489f8224b35bcbae0b0087176c56ca066cadb8687dd4a8ab4d3"
        }
      ]
    },
    {
      "candidateId": "storylet.welcome.base.007",
      "status": "reviewed",
      "turns": [
        {
          "turnId": "a",
          "speakerSlot": 0,
          "text": "Hello! When the Printing Pod lit up, I couldn't wait to meet all of you.",
          "sourceHash": "sha256:ae0bf463a63d4e7015a1c0366609b93060df7a4bfe508633d47daf19253ed0f7"
        },
        {
          "turnId": "b",
          "speakerSlot": 1,
          "text": "We're happy too. Every time the Printing Pod lights up, our family grows.",
          "sourceHash": "sha256:d5c013a37d6a71324e7e02c98e0eaeea397d6c766ca1f9ecc8973ff2db59e708"
        }
      ]
    },
    {
      "candidateId": "storylet.welcome.base.008",
      "status": "reviewed",
      "turns": [
        {
          "turnId": "a",
          "speakerSlot": 0,
          "text": "Does that little green creature live here too?",
          "sourceHash": "sha256:84acd86f2cb26d2a54eef164267d79e36a692a909cf89765d576401938d6e43e"
        },
        {
          "turnId": "b",
          "speakerSlot": 1,
          "text": "It's one of our little animal neighbors. We'll introduce you and show you around the Printing Pod.",
          "sourceHash": "sha256:20d3ac5dc4e0009fd4daa4ddcacdabe47f46892b1d18366c8b8a404ee66b3c40"
        }
      ]
    }
