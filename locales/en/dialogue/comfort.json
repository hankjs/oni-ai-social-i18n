  "candidates": [
    {
      "candidateId": "storylet.comfort.base.001",
      "status": "reviewed",
      "turns": [
        {
          "turnId": "a",
          "speakerSlot": 0,
          "text": "You don't have to talk. I'll just sit here.",
          "sourceHash": "sha256:9981debb457a8223b5f11dbf01863efa5741d831a20d3437faa25b84cf65aefa"
        },
        {
          "turnId": "b",
          "speakerSlot": 1,
          "text": "...Thanks. The fans sound quieter today.",
          "sourceHash": "sha256:22f44f3b4692ccb1954be850a50bb3d0e6aa2da5ce2771e68eea18452dece1f9"
        }
      ]
    },
    {
      "candidateId": "storylet.comfort.base.002",
      "status": "reviewed",
      "turns": [
        {
          "turnId": "a",
          "speakerSlot": 0,
          "text": "I covered your shift. Go rest a while.",
          "sourceHash": "sha256:93ea2f70dca1204e7f0414318d7579492960f250262d141a10121d33b82b44b3"
        },
        {
          "turnId": "b",
          "speakerSlot": 1,
          "text": "That's what they always said too... thank you.",
          "sourceHash": "sha256:e60031d0663b628956c8b9cbc418fa5a710ec25a13576e551c51eec6e150b34b"
        }
      ]
    },
    {
      "candidateId": "storylet.comfort.base.003",
      "status": "reviewed",
      "turns": [
        {
          "turnId": "a",
          "speakerSlot": 0,
          "text": "I brought two meals. We can just chew if talking's too much.",
          "sourceHash": "sha256:1faeb0783f3f8bc92d1ffa83190e0abd137e422a77bbe66ff2813ab0fada2644"
        },
        {
          "turnId": "b",
          "speakerSlot": 1,
          "text": "...Chewing does quiet the thinking. A little.",
          "sourceHash": "sha256:bcc61e4df765eac95f09f4dbbb315c50fc874596981f696373b3c780abb78120"
        }
      ]
    },
    {
      "candidateId": "storylet.comfort.base.004",
      "status": "reviewed",
      "turns": [
        {
          "turnId": "a",
          "speakerSlot": 0,
          "text": "I'm in the next cot tonight. Knock the wall if you can't sleep.",
          "sourceHash": "sha256:81fe554654807690ab19dd0c67c02ab327082dbe1debe3795fe4bf56c25c9471"
        },
        {
          "turnId": "b",
          "speakerSlot": 1,
          "text": "...Okay. I might knock.",
          "sourceHash": "sha256:24b31749de365d0ff63aa409beadf405ba4148fafde66d046cf9cd08b415a613"
        }
      ]
    },
    {
      "candidateId": "storylet.comfort.base.005",
      "status": "reviewed",
      "turns": [
        {
          "turnId": "a",
          "speakerSlot": 0,
          "text": "We split the work they left unfinished. You take your time.",
          "sourceHash": "sha256:3d8a22752de4a1b143e0b8cc8c8dc1bd7755c528901ab53116c12e215cb46f7a"
        },
        {
          "turnId": "b",
          "speakerSlot": 1,
          "text": "...Thanks. I just... need company being slow.",
          "sourceHash": "sha256:d773cfe85f996cf8868c974282148831c2db1615ee57a10a8eee92a2ee397238"
        }
      ]
    },
    {
      "candidateId": "storylet.comfort.base.006",
      "status": "reviewed",
      "turns": [
        {
          "turnId": "a",
          "speakerSlot": 0,
          "text": "One day I'll build you a small room. A lamp. One plant that isn't food.",
          "sourceHash": "sha256:83354a771ba74030dbebb7572213e2f3d11979d61a21b583d146c3253af2eee0"
        },
        {
          "turnId": "b",
          "speakerSlot": 1,
          "text": "...Put me in that room. I'll allow the plant.",
          "sourceHash": "sha256:1224e52676b6b0f09d7feb678567dc394ff9ab4f8a6468a27b52a6a74649031b"
        }
      ]
    }
  ]
