        },
        {
          "turnId": "b",
          "speakerSlot": 1,
          "text": "...Thank you.",
          "sourceHash": "sha256:ff4fdb31db6c0ded5368e976e80a4215a462caacaec4fc286dafaf3dfdd33847"
        }
      ]
