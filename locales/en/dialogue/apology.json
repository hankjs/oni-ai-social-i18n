{
  "locale": "en",
  "family": "apology",
  "candidates": [
    {
      "candidateId": "storylet.apology.gentle.001",
      "status": "reviewed",
      "turns": [
        {
          "turnId": "a",
          "speakerSlot": 0,
          "text": "I thought about it all night. I owe you a proper sorry.",
          "sourceHash": "sha256:2de95c614d6525c9f3d8f350e96e4215076ad2f33110e64f152724e23e9fa8a9"
        },
        {
          "turnId": "b",
          "speakerSlot": 1,
          "text": "You showing up says more than the words.",
          "sourceHash": "sha256:b6160360e2f7992698a0ecfcdab7ffa04af1937c0486f86783fc35357ed5289d"
        }
      ]
    },
    {
      "candidateId": "storylet.apology.gentle.002",
      "status": "reviewed",
      "turns": [
        {
          "turnId": "a",
          "speakerSlot": 0,
          "text": "I'm sorry I left that whole mess on you alone.",
          "sourceHash": "sha256:7f582705006f739b413a9d8c7e580da89445017159f37bcbafcf4d97985bb427"
        },
        {
          "turnId": "b",
          "speakerSlot": 1,
          "text": "It's fine. Just lend a hand next time.",
          "sourceHash": "sha256:6290416bef2d198d2888d22ca21b44dfdd4da058d43bf344e92b924911826ca1"
        }
      ]
    },
    {
      "candidateId": "storylet.apology.gentle.003",
      "status": "reviewed",
      "turns": [
        {
          "turnId": "a",
          "speakerSlot": 0,
          "text": "What I said that day? I take it back. Gently.",
          "sourceHash": "sha256:807f34c0b6db96c0b9d17772ee31a100c6722377d71bb5e724dfe8cae2b8b400"
        },
        {
          "turnId": "b",
          "speakerSlot": 1,
          "text": "Retraction accepted. The tea's still warm, sit.",
          "sourceHash": "sha256:07b5238f72541f4e0f8ed2bc1128be2d4d28c3613a9ca1a44df28973d8c753a4"
        }
      ]
    },
    {
      "candidateId": "storylet.apology.gentle.004",
      "status": "reviewed",
      "turns": [
        {
          "turnId": "a",
          "speakerSlot": 0,
          "text": "I brewed two cups of berry juice. One is an apology.",
          "sourceHash": "sha256:fa04265987c0990d408233e4825d9b7f6d53c0a6de0ce941f38bdd0338f537ee"
        },
        {
          "turnId": "b",
          "speakerSlot": 1,
          "text": "And the other?",
          "sourceHash": "sha256:41814fb886ab74e810f04fb8b8c99a963570d2098cd9ca9feb53cb7635422bc5"
        },
        {
          "turnId": "c",
          "speakerSlot": 0,
          "text": "A thank-you for still talking to me.",
          "sourceHash": "sha256:d52ed23ab788eeb314518376da1c7e711b0e0de94475179c8618a03d4fca3950"
        }
      ]
    },
    {
      "candidateId": "storylet.apology.hothead.001",
      "status": "reviewed",
      "turns": [
        {
          "turnId": "a",
          "speakerSlot": 0,
          "text": "Yesterday... wasn't entirely my fault. Partly was. Fine. Sorry.",
          "sourceHash": "sha256:785a36d12f3dc6e320dff0968f7873f03ec9f355ee77fb2708edc8ee9110f722"
        },
        {
          "turnId": "b",
          "speakerSlot": 1,
          "text": "An apology squeezed out like toothpaste. Accepted.",
          "sourceHash": "sha256:01060bcbaeec46f1dbf1c29149be87331e3f610a40afdb99dbec0385786c573d"
        }
      ]
    },
    {
      "candidateId": "storylet.apology.hothead.002",
      "status": "reviewed",
      "turns": [
        {
          "turnId": "a",
          "speakerSlot": 0,
          "text": "I'm not here to apologize. ...Okay, I am. Sorry.",
          "sourceHash": "sha256:050473313c066b28f8230dc36e9a1bbb574d5dad03ebb8ef1dd06d9d503cc48a"
        },
        {
          "turnId": "b",
          "speakerSlot": 1,
          "text": "Your voice dropped an octave at the door. I knew.",
          "sourceHash": "sha256:cadd8ff6bb58ab4dd85f6bca86848fa06b28b94b649b6cd0b16edc0f38e81b56"
        }
      ]
    },
    {
      "candidateId": "storylet.apology.hothead.003",
      "status": "reviewed",
      "turns": [
        {
          "turnId": "a",
          "speakerSlot": 0,
          "text": "SORRY! There! Loud means it counts!",
          "sourceHash": "sha256:1aec3909394fe476066db91fc504bd3e70742d374308dd801c6eee94f934d9ce"
        },
        {
          "turnId": "b",
          "speakerSlot": 1,
          "text": "It counts, it counts. Indoor volume works too.",
          "sourceHash": "sha256:2aee951f2ca660928648ed95da2fcfd5eb2ca7fa29e2d6ab1fba3fff3caafb05"
        }
      ]
    },
    {
      "candidateId": "storylet.apology.hothead.004",
      "status": "reviewed",
      "turns": [
        {
          "turnId": "a",
          "speakerSlot": 0,
          "text": "Your pipework is... actually decent. Yesterday was on me.",
          "sourceHash": "sha256:7bf8f89f28ab15350cb896dc4459216349e3aed7e4647142c9b99bd6faf59ff0"
        },
        {
          "turnId": "b",
          "speakerSlot": 1,
          "text": "I'm framing the first half and accepting the second.",
          "sourceHash": "sha256:d1c82f47ecb9643371959c0b8b920df9c304a197929898c6b0f8fec1ffccb6d5"
        }
      ]
    },
    {
      "candidateId": "storylet.apology.base.001",
      "status": "reviewed",
      "turns": [
        {
          "turnId": "a",
          "speakerSlot": 0,
          "text": "I lost my temper last time. I'm sorry.",
          "sourceHash": "sha256:f335c90fb6ebe0795be7bc4506f9f28d8a21843ab25bc6ede761f3d1a5d2d325"
        },
        {
          "turnId": "b",
          "speakerSlot": 1,
          "text": "I went too far too. Let's move on.",
          "sourceHash": "sha256:0793732e37d16b0c56c12a1d0870af81f9d36d9712744b8620b60c3660f5883d"
        }
      ]
    },
    {
      "candidateId": "storylet.apology.base.002",
      "status": "reviewed",
      "turns": [
        {
          "turnId": "a",
          "speakerSlot": 0,
          "text": "I should not have taken it out on you.",
          "sourceHash": "sha256:0f5bc089aaebf086f786421edee93e782b1edf40a40a8318fed34b7e2a0b86f0"
        },
        {
          "turnId": "b",
          "speakerSlot": 1,
          "text": "Breathe first next time. And yes, I forgive you.",
          "sourceHash": "sha256:bcf5a5910a1473b1d77fc9ad0ee8998488891f5188c580cbb41672cd3cefaa5c"
        }
      ]
    },
    {
      "candidateId": "storylet.apology.base.003",
      "status": "reviewed",
      "turns": [
        {
          "turnId": "a",
          "speakerSlot": 0,
          "text": "I went too far. Here — barbeque. The real kind.",
          "sourceHash": "sha256:8ad87baa97547fa7db80a1f7fa3e0c8141a09d5080f698b5da61f9aff27886ab"
        },
        {
          "turnId": "b",
          "speakerSlot": 1,
          "text": "...Fine. For the barbeque's sake.",
          "sourceHash": "sha256:85ca420c16181dfaf6ef57280a94a80ac38c4db9d853b424c4032634b7abc61e"
        }
      ]
    },
    {
      "candidateId": "storylet.apology.base.004",
      "status": "reviewed",
      "turns": [
        {
          "turnId": "a",
          "speakerSlot": 0,
          "text": "I was wrong to drag up old fights.",
          "sourceHash": "sha256:0aa5eb1d1a79240ebe8c51c636f6a22ca146608920f482a8b3052f8f231b0a0c"
        },
        {
          "turnId": "b",
          "speakerSlot": 1,
          "text": "All dragged up now? Then come eat.",
          "sourceHash": "sha256:996bb55a4f8ef795ebf5a40b9d51b750741bff11acfbcf1e99be426dd99498cd"
        }
      ]
    },
    {
      "candidateId": "storylet.apology.base.005",
      "status": "reviewed",
      "turns": [
        {
          "turnId": "a",
          "speakerSlot": 0,
          "text": "I'm sorry. Your pipework isn't that bad.",
          "sourceHash": "sha256:f90b09b3a28ce26ff475b60bddfd9beac573147f362bbced4a9e74831b5c17c2"
        },
        {
          "turnId": "b",
          "speakerSlot": 1,
          "text": "Apology accepted. Review returned to sender.",
          "sourceHash": "sha256:b9d31a05b44ca82cdbb6507942018ef783ca70b80afbad2d49e6a4d03bb28da3"
        }
      ]
    },
    {
      "candidateId": "storylet.apology.base.006",
      "status": "reviewed",
      "turns": [
        {
          "turnId": "a",
          "speakerSlot": 0,
          "text": "I rehearsed this apology all the way here.",
          "sourceHash": "sha256:76f3b58f23dddb7b1a46233c7706176da17a64c50a8f04cbffb9353f1010d74c"
        },
        {
          "turnId": "b",
          "speakerSlot": 1,
          "text": "Good rehearsal. Never need it again.",
          "sourceHash": "sha256:1ef9dcf6bde3f6f7ffb6eea67bd49c18d61b06604dfed0a50863c710cb5736b6"
        }
      ]
    },
    {
      "candidateId": "storylet.apology.base.007",
      "status": "reviewed",
      "turns": [
        {
          "turnId": "a",
          "speakerSlot": 0,
          "text": "I yelled about the wire. It was the hunger talking.",
          "sourceHash": "sha256:6319f5c9c5f30cdec2cc8426f198ca3032a064641505d9c5f23263bc4c59e042"
        },
        {
          "turnId": "b",
          "speakerSlot": 1,
          "text": "Then eat first, apologize second. Both accepted.",
          "sourceHash": "sha256:9c33d4ad35cb0a5b0e02d342baf93ca1040d98afaa686efdecf522f154bd6341"
        }
      ]
    }
  ]
}
