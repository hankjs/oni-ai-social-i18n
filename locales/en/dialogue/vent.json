{
  "locale": "en",
  "family": "vent",
  "candidates": [
    {
      "candidateId": "storylet.vent.crybaby.001",
      "status": "reviewed",
      "turns": [
        {
          "turnId": "a",
          "speakerSlot": 0,
          "text": "I can't hold it in... the mush bars are gone again...",
          "sourceHash": "sha256:7fb4befcb1bd6397a8dcea5809484e92181d268958ace1fddfc214ed884fe6fc"
        },
        {
          "turnId": "b",
          "speakerSlot": 1,
          "text": "Cry it out. Half of mine tomorrow is yours.",
          "sourceHash": "sha256:fcaeb963c043e8fd8988ef6d6c5e8b81cb75c5c8e1e18a502a4e1b75ce203dd2"
        },
        {
          "turnId": "c",
          "speakerSlot": 0,
          "text": "Snff... you're the best...",
          "sourceHash": "sha256:9386fbfcdc6aff4e297587dcc396c1f35cd336337d8d33666628d9ddabdea02a"
        }
      ]
    },
    {
      "candidateId": "storylet.vent.crybaby.002",
      "status": "reviewed",
      "turns": [
        {
          "turnId": "a",
          "speakerSlot": 0,
          "text": "I dreamed the printing pod didn't want me anymore...",
          "sourceHash": "sha256:820b2beec024ee92d23c64d4bc5dea2598d17a1b798c33ff0396dc306dc9c159"
        },
        {
          "turnId": "b",
          "speakerSlot": 1,
          "text": "Dreams lie. Who else would it even print?",
          "sourceHash": "sha256:b4ceeba30147ff1cba834be9b2c3e9d4f9af41a69e51b661ff9a660f38bef5a6"
        },
        {
          "turnId": "c",
          "speakerSlot": 0,
          "text": "R-really...? Okay...",
          "sourceHash": "sha256:a10238ba5651352c5b5d702df01d109334440c95eb583861bc7e9486ac2394b6"
        }
      ]
    },
    {
      "candidateId": "storylet.vent.crybaby.003",
      "status": "reviewed",
      "turns": [
        {
          "turnId": "a",
          "speakerSlot": 0,
          "text": "My tears fell into the regolith. Will something grow...?",
          "sourceHash": "sha256:3030c5be197cc0bee9de01ae04d374691be913aacb62f81808ff4b34a726ff86"
        },
        {
          "turnId": "b",
          "speakerSlot": 1,
          "text": "You'll be the first to know. Here, wipe up.",
          "sourceHash": "sha256:b48925596133c33190c30207677f3e9f41e1212d3d37c8cee4fc810f3da83421"
        },
        {
          "turnId": "c",
          "speakerSlot": 0,
          "text": "...Ha. Now I'm laughing and crying.",
          "sourceHash": "sha256:7693f94333f4b65a71ee47d0e5245d24d68629408bcac20ea3d6bcbc1c44bdf4"
        }
      ]
    },
    {
      "candidateId": "storylet.vent.crybaby.004",
      "status": "reviewed",
      "turns": [
        {
          "turnId": "a",
          "speakerSlot": 0,
          "text": "I'm not fragile. I just have surplus water draining through my eyes.",
          "sourceHash": "sha256:e3177f71a7474a42f0645768e235b39ebd9e7f40350e23ff7bd54ffc7ec7b219"
        },
        {
          "turnId": "b",
          "speakerSlot": 1,
          "text": "Drain away. Drainage is honest work.",
          "sourceHash": "sha256:7ad9a4135aa5f0907a086a6a3d4d6fa3280d0a55736770441629e42d7a14c391"
        },
        {
          "turnId": "c",
          "speakerSlot": 0,
          "text": "...Mm! Feeling better already.",
          "sourceHash": "sha256:7941db052f5fe0b73c0666f5eef476974a2fa96fa3d5f8b585da6c5b018f5382"
        }
      ]
    },
    {
      "candidateId": "storylet.vent.hothead.001",
      "status": "reviewed",
      "turns": [
        {
          "turnId": "a",
          "speakerSlot": 0,
          "text": "I nearly took the hamster wheel apart today! It spins too slow!!",
          "sourceHash": "sha256:a217a8dcca1aac76bb0c668a951e9a21be4aa8a5dcdb8cde008f573ad95eb81a"
        },
        {
          "turnId": "b",
          "speakerSlot": 1,
          "text": "Breathe before dismantling. The wheel is public property.",
          "sourceHash": "sha256:a5318c78e514abce304445fbb1063dfdc3d1b912ea24f096a0bc3d3b41ae7a8c"
        },
        {
          "turnId": "c",
          "speakerSlot": 0,
          "text": "...Hooo. Fine. It lives. For now.",
          "sourceHash": "sha256:bd468d8bc503085ad39f665b9372a4b9b2ced5c508e9473dceee139479f4008a"
        }
      ]
    },
    {
      "candidateId": "storylet.vent.hothead.002",
      "status": "reviewed",
      "turns": [
        {
          "turnId": "a",
          "speakerSlot": 0,
          "text": "Why do I get every busted pipe?!",
          "sourceHash": "sha256:18c082f10b6a27acb69287c151e800f1a37306bdb28b765b6df7708f00e01e21"
        },
        {
          "turnId": "b",
          "speakerSlot": 1,
          "text": "Because you're fastest. That's a compliment, stop glaring.",
          "sourceHash": "sha256:e6a9d3bc67ad9791db5e3aed614a69d7b66758ce0a45eaa7fe13ebe5807b7d38"
        },
        {
          "turnId": "c",
          "speakerSlot": 0,
          "text": "...Fine. That reason I accept.",
          "sourceHash": "sha256:6a5ce22aab00f7d1a66885802bf3f825c1248fa10efa25fdd6d4f695d22b31c1"
        }
      ]
    },
    {
      "candidateId": "storylet.vent.hothead.003",
      "status": "reviewed",
      "turns": [
        {
          "turnId": "a",
          "speakerSlot": 0,
          "text": "I'm counting to three, and if this base blacks out again—",
          "sourceHash": "sha256:1a5654a4c0db0efa16176c416161c09ea1594ef25fb3880f2d2254c40f5d80bc"
        },
        {
          "turnId": "b",
          "speakerSlot": 1,
          "text": "At three we go crank the generator together.",
          "sourceHash": "sha256:6a406064cae8598c374d3d7911b57cd5aa3285eebe26ab782e90370ded1a6e6b"
        },
        {
          "turnId": "c",
          "speakerSlot": 0,
          "text": "...Deal. One, two... move.",
          "sourceHash": "sha256:5e681c652eef3fb7393f1dcd877b9de7aac7bd19ca4beeafac3f64193e0836d2"
        }
      ]
    },
    {
      "candidateId": "storylet.vent.hothead.004",
      "status": "reviewed",
      "turns": [
        {
          "turnId": "a",
          "speakerSlot": 0,
          "text": "I'm not angry! I'm just too efficient to sit still!",
          "sourceHash": "sha256:0b5c307cc6588caceac603d6532dda49a1b4bc2f1a44b79989378cf069c5eb0e"
        },
        {
          "turnId": "b",
          "speakerSlot": 1,
          "text": "Then lend me half that energy for hauling.",
          "sourceHash": "sha256:9f0c458e1acb0666101339c07cb18a1197b4ce090d252c63ffd73f6c640e398d"
        },
        {
          "turnId": "c",
          "speakerSlot": 0,
          "text": "...Take it, take it. Feels better out loud.",
          "sourceHash": "sha256:c0e0479d17e5d253a5e86c3819f123f08241622091187c0e3e18f7b88b3ec02a"
        }
      ]
    },
    {
      "candidateId": "storylet.vent.nervous.001",
      "status": "reviewed",
      "turns": [
        {
          "turnId": "a",
          "speakerSlot": 0,
          "text": "I keep thinking the backup battery isn't full. It is full. I checked...",
          "sourceHash": "sha256:8baaaf1e604176f7374f958b7f1db7bb306ef330a8624288fef0747432622ef4"
        },
        {
          "turnId": "b",
          "speakerSlot": 1,
          "text": "Then we check once more. Together.",
          "sourceHash": "sha256:fd143df368643468dabf79eee19271f19043aaed33ac799860257a4937e68458"
        },
        {
          "turnId": "c",
          "speakerSlot": 0,
          "text": "...That was the seventh check. Thanks for coming.",
          "sourceHash": "sha256:91915f11e93c224a47dfdd431ba0c96db65be600b11a89afb5141061cac7bac2"
        }
      ]
    },
    {
      "candidateId": "storylet.vent.nervous.002",
      "status": "reviewed",
      "turns": [
        {
          "turnId": "a",
          "speakerSlot": 0,
          "text": "What if? What if the oxygen, while I'm asleep—",
          "sourceHash": "sha256:a60ec527535de5d19e542543faef4ae25ba1888b96924bfee1413ba60ecabdee"
        },
        {
          "turnId": "b",
          "speakerSlot": 1,
          "text": "Stop. The alarm works nights. You work days. Clear division of labor.",
          "sourceHash": "sha256:ba01a287030a37da6fe0d81cfe05f4fcf5fbcb105ceb7c154fa510f47eb2181f"
        },
        {
          "turnId": "c",
          "speakerSlot": 0,
          "text": "...Fine. I'll only wake up three times.",
          "sourceHash": "sha256:e9c6afbe43472ebfd7f507060965b0080b70e583cb9bb34e7d3611b09bd36e75"
        }
      ]
    },
    {
      "candidateId": "storylet.vent.nervous.003",
      "status": "reviewed",
      "turns": [
        {
          "turnId": "a",
          "speakerSlot": 0,
          "text": "The pipe made a noise! You heard it, right?!",
          "sourceHash": "sha256:0c5a1da6f0f504e6cfd049c6dafeb0328c5017daef19295e60977ff9c6b4e854"
        },
        {
          "turnId": "b",
          "speakerSlot": 1,
          "text": "Heard it. Thermal expansion. I signed its health certificate.",
          "sourceHash": "sha256:cc6975dad3f78264ba6a57ebe3ea6b5bacb09e440795959f6f1ab682504be7b8"
        },
        {
          "turnId": "c",
          "speakerSlot": 0,
          "text": "...You made that up. It helped anyway.",
          "sourceHash": "sha256:3840177fad0ff6d2b93dc028b253a3aff8c08144631c02a4c8f62cc8aed72775"
        }
      ]
    },
    {
      "candidateId": "storylet.vent.nervous.004",
      "status": "reviewed",
      "turns": [
        {
          "turnId": "a",
          "speakerSlot": 0,
          "text": "My heart is racing. Is the base about to blow?",
          "sourceHash": "sha256:35e414edb756a7b31ef61967eca1456196beab2864d0ed6462685ca314c5bba5"
        },
        {
          "turnId": "b",
          "speakerSlot": 1,
          "text": "That's from three ladder sprints. Sit. Sip water.",
          "sourceHash": "sha256:ec7f5a80152d1a2e3d8a4f3c00dac0c9bcf00c99c27b95428847250577354022"
        },
        {
          "turnId": "c",
          "speakerSlot": 0,
          "text": "...Oh. Right. Okay, settling down now.",
          "sourceHash": "sha256:3ed2ff2e982ab1bb85c94c4b3ce214aa1247a8feca8529460f007be69c7541dd"
        }
      ]
    },
    {
      "candidateId": "storylet.vent.base.001",
      "status": "reviewed",
      "turns": [
        {
          "turnId": "a",
          "speakerSlot": 0,
          "text": "I can't take it anymore, there are pipes to fix everywhere...",
          "sourceHash": "sha256:52df876ff36b0221a7a8072173a6920adc8bcfaa1a0f169998ca9e6b2ecf0b46"
        },
        {
          "turnId": "b",
          "speakerSlot": 1,
          "text": "Breathe. Pipes are infinite; you are not.",
          "sourceHash": "sha256:e952bf7b6168971de9ee16f9d9fb1d06e2bb1c4143359b525a7f952ae8d4aa01"
        },
        {
          "turnId": "c",
          "speakerSlot": 0,
          "text": "...Thanks. Saying it out loud helps.",
          "sourceHash": "sha256:addaf19a829b0311eb63db54528578617a6b09c0a68e61ffec9237e1d58ad4eb"
        }
      ]
    },
    {
      "candidateId": "storylet.vent.base.002",
      "status": "reviewed",
      "turns": [
        {
          "turnId": "a",
          "speakerSlot": 0,
          "text": "Dreamed the power grid died again. My hands are still shaking.",
          "sourceHash": "sha256:5284490b23f7713a63335e2e2e2767d78984ab4dc559731dced54752ed9fb8dc"
        },
        {
          "turnId": "b",
          "speakerSlot": 1,
          "text": "Just a dream. Come sit with me a while.",
          "sourceHash": "sha256:ea99aaeac0dc1724d347c9abcabe4b261f3efc07de8cdc4c9e713474cf9fd3de"
        },
        {
          "turnId": "c",
          "speakerSlot": 0,
          "text": "Yeah. Glad you're here.",
          "sourceHash": "sha256:57b7eed1cd18ca5cd3ff66268fbcc6abfa2a2edcd83e65d79297ce4d1827f192"
        }
      ]
    },
    {
      "candidateId": "storylet.vent.base.003",
      "status": "reviewed",
      "turns": [
        {
          "turnId": "a",
          "speakerSlot": 0,
          "text": "The electrolyzer blew again. Everyone's oxygen is on me...",
          "sourceHash": "sha256:1c16add231ecaf60dfaa2342f671cfee3f461d75fbd1ae4288dfb3e6ab55310e"
        },
        {
          "turnId": "b",
          "speakerSlot": 1,
          "text": "Sit down. Oxygen has reserves. You don't have a backup.",
          "sourceHash": "sha256:dac9eca47276aa769f9b73025d69392248a006eaf1dcbac43eb173b85196ac1d"
        },
        {
          "turnId": "c",
          "speakerSlot": 0,
          "text": "...Okay. Breathing first.",
          "sourceHash": "sha256:c52b9ab4ddb72812fd813c059e4e6940db03cc7d71faf2e145ada5325e616f94"
        }
      ]
    },
    {
      "candidateId": "storylet.vent.base.004",
      "status": "reviewed",
      "turns": [
        {
          "turnId": "a",
          "speakerSlot": 0,
          "text": "A full shift on the hamster wheel. My legs won't stop.",
          "sourceHash": "sha256:e7e02a7cad6305ea5bba3d72b042507be6571ef397196c71939117d5865cfb79"
        },
        {
          "turnId": "b",
          "speakerSlot": 1,
          "text": "I'll take tomorrow. The wheel can't bully both of us.",
          "sourceHash": "sha256:a765eb217ce6b032046098f3ddd84c78ee9c77076031179f3e420349615ad71c"
        },
        {
          "turnId": "c",
          "speakerSlot": 0,
          "text": "...Deal. You're a good one.",
          "sourceHash": "sha256:593e3ab08f54a476466c98969485ef9d3818e024c387c85533b7242bda191755"
        }
      ]
    },
    {
      "candidateId": "storylet.vent.base.005",
      "status": "reviewed",
      "turns": [
        {
          "turnId": "a",
          "speakerSlot": 0,
          "text": "The meteors keep hammering. I can't sleep.",
          "sourceHash": "sha256:603ad6f4d7200b13477fd5d0de8812ee0fc4cd00f753cf5bb4b6b038d56e53da"
        },
        {
          "turnId": "b",
          "speakerSlot": 1,
          "text": "They won't get through. I checked every tile myself.",
          "sourceHash": "sha256:83e5238c9c0bd2121ffbec8c2a3169183a7bfd9a1aa53c6ff165f102eaa7e3bb"
        },
        {
          "turnId": "c",
          "speakerSlot": 0,
          "text": "...Somehow that actually helps.",
          "sourceHash": "sha256:9e164c1a451e9c1685305b3bbdc889f0836977161a96369537d4ecb54b889665"
        }
      ]
    },
    {
      "candidateId": "storylet.vent.base.006",
      "status": "reviewed",
      "turns": [
        {
          "turnId": "a",
          "speakerSlot": 0,
          "text": "What if I wake up and the oxygen reads zero?",
          "sourceHash": "sha256:6e4c0b6a37140f616896c837690478be15ae838d62db885eddc588676286f093"
        },
        {
          "turnId": "b",
          "speakerSlot": 1,
          "text": "You'd wake up next to me first. Panic later.",
          "sourceHash": "sha256:a83c30850697633a001ef81b25d43ed1881ceb0b154acbd6bf3e2ed8b9a0c18b"
        },
        {
          "turnId": "c",
          "speakerSlot": 0,
          "text": "Ha... fair.",
          "sourceHash": "sha256:19480ca6e30103e1f804c8ba3114daf42e3f5dc41bae97991e4c512f65c3c61e"
        }
      ]
    },
    {
      "candidateId": "storylet.vent.base.007",
      "status": "reviewed",
      "turns": [
        {
          "turnId": "a",
          "speakerSlot": 0,
          "text": "I'm fine. I'm fine. I'm fine.",
          "sourceHash": "sha256:815865ecbef598594f350ca1404f6bce3eb0253d23fbdab90ceb21b37d7d3131"
        },
        {
          "turnId": "b",
          "speakerSlot": 1,
          "text": "That's four this cycle. Sit. I'll take the next shift.",
          "sourceHash": "sha256:81d685ae733c14059c06cd0d3ebfd93a96197f506ac7ab71be3da1dd67fd8d13"
        },
        {
          "turnId": "c",
          "speakerSlot": 0,
          "text": "...One more: I'm fine. Okay. Sitting.",
          "sourceHash": "sha256:7fc0d6358e75c8e365b7ca9ca74e49f6156b36ff59300878f691c59180ab075a"
        }
      ]
    },
    {
      "candidateId": "storylet.vent.base.008",
      "status": "reviewed",
      "turns": [
        {
          "turnId": "a",
          "speakerSlot": 0,
          "text": "I am one broken pipe away from crashing out entirely.",
          "sourceHash": "sha256:92602dedd062827745e70bfbb1e353b4ee5579fdc3192e55ca0d0a821d92b025"
        },
        {
          "turnId": "b",
          "speakerSlot": 1,
          "text": "Then I'll fix the pipe. Sit down.",
          "sourceHash": "sha256:2b811d7907174b7d558598e649dbd39b386464d1cef1c1c6d6c1c07cc0c48b08"
        },
        {
          "turnId": "c",
          "speakerSlot": 0,
          "text": "...Okay. Watching you fix it helps.",
          "sourceHash": "sha256:9bb3abac667330d8fa50480bc655d65432f1dad43990386898cd1c0a453028e6"
        }
      ]
    },
    {
      "candidateId": "storylet.vent.base.009",
      "status": "reviewed",
      "turns": [
        {
          "turnId": "a",
          "speakerSlot": 0,
          "text": "What are you thinking about?",
          "sourceHash": "sha256:02b4c3412baa1525e9418ce9982e77be29c668bccc53ce2f1c75afc8e633bb41"
        },
        {
          "turnId": "b",
          "speakerSlot": 1,
          "text": "Nothing. Beautifully, completely nothing.",
          "sourceHash": "sha256:f59681b02d0d6b13fc191845c8ed99d71dbe27816299a476de7298e429c62211"
        },
        {
          "turnId": "c",
          "speakerSlot": 0,
          "text": "Finally, someone at peace in this colony.",
          "sourceHash": "sha256:4825e4fda3fb0b6481e3ce4d874391b2eb7b29b66ff8910eb6cb9a59a3f64a30"
        }
      ]
    },
    {
      "candidateId": "storylet.vent.base.010",
      "status": "reviewed",
      "turns": [
        {
          "turnId": "a",
          "speakerSlot": 0,
          "text": "How often do you think about that one flooded shaft?",
          "sourceHash": "sha256:8c43b8d3ab8280295f70b4d195571fc6c3ad27a694533428ee05a360910fe488"
        },
        {
          "turnId": "b",
          "speakerSlot": 1,
          "text": "Daily. Sometimes twice, if the pump hums wrong.",
          "sourceHash": "sha256:7d5e4258bd508501e22feb2b06917b8ffe14f401ccea42f9376e4815a42fc06b"
        },
        {
          "turnId": "c",
          "speakerSlot": 0,
          "text": "...It haunts me too. Cycle 12. Never again.",
          "sourceHash": "sha256:db04b494837581efbafc8d25a684da3545f8b5db6e691d2215a8b46b1b6d8155"
        }
      ]
    },
    {
      "candidateId": "storylet.vent.base.011",
      "status": "reviewed",
      "turns": [
        {
          "turnId": "a",
          "speakerSlot": 0,
          "text": "Two straight shifts on the manual generator.",
          "sourceHash": "sha256:ae7769a42ffc1aa521085b65f77df8fb8b9dd3148a67fb4a0512eaddc6888244"
        },
        {
          "turnId": "b",
          "speakerSlot": 1,
          "text": "Sad hamster hours. Tiniest violin. I'm taking the next one.",
          "sourceHash": "sha256:74e392f44b9b8079a50b34023fabfff6d5c9c7e2276229c129a7160b5b5c224c"
        },
        {
          "turnId": "c",
          "speakerSlot": 0,
          "text": "...Okay. You win.",
          "sourceHash": "sha256:a967788fe5fc25c2f8e1edec31e279b6c94f088efc2dda0df6b50e26bf385555"
        }
      ]
    }
  ]
}
