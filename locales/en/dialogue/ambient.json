{
  "locale": "en",
  "family": "ambient",
  "candidates": [
    {
      "candidateId": "storylet.casual.ambient.001",
      "status": "reviewed",
      "turns": [
        {
          "turnId": "a",
          "speakerSlot": 0,
          "text": "How many tons of granite did you dig today?",
          "sourceHash": "sha256:42f8dd7ee2b7e53979f618a3ec37ac6bd7145804df87035418f4f99ca556d382"
        },
        {
          "turnId": "b",
          "speakerSlot": 1,
          "text": "Don't ask. My back filed a complaint.",
          "sourceHash": "sha256:5b0ce9a720543e5d2766e7448eef04a5c835523565d1580c94d2fba6dfce2314"
        }
      ]
    },
    {
      "candidateId": "storylet.casual.ambient.002",
      "status": "reviewed",
      "turns": [
        {
          "turnId": "a",
          "speakerSlot": 0,
          "text": "The mush bar got even harder today.",
          "sourceHash": "sha256:edfb9ff50fc9fb135e9a4a9ba5132aa5986e8bb1def1e477f1e8255cfa708036"
        },
        {
          "turnId": "b",
          "speakerSlot": 1,
          "text": "At least it's warm... okay, it's not.",
          "sourceHash": "sha256:a3c6793f80f8faeea4bae7e6e0db2c5fb98b9f8671de4590404153f05ab7fb17"
        }
      ]
    },
    {
      "candidateId": "storylet.casual.ambient.003",
      "status": "reviewed",
      "turns": [
        {
          "turnId": "a",
          "speakerSlot": 0,
          "text": "Do you think there are other planets out there?",
          "sourceHash": "sha256:7873193375c0635873511d03dfca470527c99672152ccc9a8eb095b7bc548aeb"
        },
        {
          "turnId": "b",
          "speakerSlot": 1,
          "text": "If so, I hope their toilets don't clog.",
          "sourceHash": "sha256:525e5cb167d9967c9e6ecbb8c92b30c2e2fa22979bcc730959c83b65d87e4114"
        }
      ]
    },
    {
      "candidateId": "storylet.casual.ambient.004",
      "status": "reviewed",
      "turns": [
        {
          "turnId": "a",
          "speakerSlot": 0,
          "text": "Dreamed about falling into magma again.",
          "sourceHash": "sha256:d91a6f66b4ad1425b9541e17af249f3a9c15db6f67d31cac0e9aac45ece1b41a"
        },
        {
          "turnId": "b",
          "speakerSlot": 1,
          "text": "At least you didn't sleepwalk into the oxygen diffuser.",
          "sourceHash": "sha256:ec599bb14b0a51e6ac4b4b55bc0bfe068c0071d953fd69d18446aec6eba27503"
        }
      ]
    },
    {
      "candidateId": "storylet.casual.ambient.005",
      "status": "reviewed",
      "turns": [
        {
          "turnId": "a",
          "speakerSlot": 0,
          "text": "The air feels thinner today.",
          "sourceHash": "sha256:32d315e5e0f637c7b7ea39885a6f202d3884cd3cf84fc34fc484b65a487ee2cd"
        },
        {
          "turnId": "b",
          "speakerSlot": 1,
          "text": "Breathe slowly. Call it cardio.",
          "sourceHash": "sha256:31137093f7062a2d0cded637405d95e1f35ae2d71bb7a0ff2fcad0fb4eaf1fe8"
        }
      ]
    },
    {
      "candidateId": "storylet.casual.ambient.006",
      "status": "reviewed",
      "turns": [
        {
          "turnId": "a",
          "speakerSlot": 0,
          "text": "They say stress makes people smash things at night.",
          "sourceHash": "sha256:f84b4b225abc8448daa8e120dee458c007c5f409b746e5715a0b0a6f6b9a5f07"
        },
        {
          "turnId": "b",
          "speakerSlot": 1,
          "text": "I stress-eat. Can't smash anything on a full stomach.",
          "sourceHash": "sha256:dbab486b42780a57fd92d1ebca1f6f1cd59f29ce8d3e20887be0aac86d65668c"
        }
      ]
    },
    {
      "candidateId": "storylet.casual.ambient.007",
      "status": "reviewed",
      "turns": [
        {
          "turnId": "a",
          "speakerSlot": 0,
          "text": "Whenever I pass the Printing Pod, I want to thank it.",
          "sourceHash": "sha256:8e34cc862943510e9401d0c76a7be360ca7794eec4d82941d9fce8d46838e503"
        },
        {
          "turnId": "b",
          "speakerSlot": 1,
          "text": "Without it, the two of us would never have met.",
          "sourceHash": "sha256:ffec3ddb03a48e0ad2a2f2f01c2332bb5e0cd247896a313e9f798ac364e406e7"
        }
      ]
    },
    {
      "candidateId": "storylet.casual.ambient.008",
      "status": "reviewed",
      "turns": [
        {
          "turnId": "a",
          "speakerSlot": 0,
          "text": "The lavatory's clogged. Third time this week.",
          "sourceHash": "sha256:1480dedd26fea3ea4151bfcd4282e39070630186d214ce5ad248c6a732860eda"
        },
        {
          "turnId": "b",
          "speakerSlot": 1,
          "text": "Don't look at me. I clog, I don't fix.",
          "sourceHash": "sha256:55c15ce581efbc96ec01dd610d0d1ba6b912bfebf8c35947577d968b8aa34887"
        }
      ]
    },
    {
      "candidateId": "storylet.casual.ambient.009",
      "status": "reviewed",
      "turns": [
        {
          "turnId": "a",
          "speakerSlot": 0,
          "text": "The slickster is sleeping on my cot again.",
          "sourceHash": "sha256:7ccb412af80bbb6c3ad9419868f760c3ed2773dbfff0f2fd8c801c9d2ae98a48"
        },
        {
          "turnId": "b",
          "speakerSlot": 1,
          "text": "It likes you. Well, it likes your carbon dioxide.",
          "sourceHash": "sha256:5056f21b81065931e77eadf2658ab9cf94b0d31026b78d20998920bf559107f1"
        }
      ]
    },
    {
      "candidateId": "storylet.casual.ambient.010",
      "status": "reviewed",
      "turns": [
        {
          "turnId": "a",
          "speakerSlot": 0,
          "text": "Nice new hairstyle.",
          "sourceHash": "sha256:9e74b83b968f9b0082c52b55d14e6090775ec112b152f0bb45a63bb8bc1945d0"
        },
        {
          "turnId": "b",
          "speakerSlot": 1,
          "text": "It's from the wire. Thanks for noticing.",
          "sourceHash": "sha256:7a3855f13e04abda42c42aa13858e97c0475faa1b8b785a33df0dd0f3eac63c9"
        }
      ]
    },
    {
      "candidateId": "storylet.casual.ambient.011",
      "status": "reviewed",
      "turns": [
        {
          "turnId": "a",
          "speakerSlot": 0,
          "text": "Whose puddle is that in corridor three?",
          "sourceHash": "sha256:6a5547c2c4b18074b97eafa3d4688b1b88b856a03dc69b67bddca2a7b97369a5"
        },
        {
          "turnId": "b",
          "speakerSlot": 1,
          "text": "Stress. The stress threw up. Nobody else.",
          "sourceHash": "sha256:414006fde78f4a4594b44781fd88705673ace463b9b2bf1c180cd8839fbe6d41"
        }
      ]
    },
    {
      "candidateId": "storylet.casual.ambient.012",
      "status": "reviewed",
      "turns": [
        {
          "turnId": "a",
          "speakerSlot": 0,
          "text": "If you got reprinted, what would you come back as?",
          "sourceHash": "sha256:25798d5c5e5aa8f413bbdb47283a805eba8ad3f6b2fe35800656fbdba9f32e16"
        },
        {
          "turnId": "b",
          "speakerSlot": 1,
          "text": "A solar panel. Lie there all day, then lie there all night.",
          "sourceHash": "sha256:5d30cb17516c903858199b0047fa52055c526aecaaf07589398ee9f4f365d405"
        }
      ]
    },
    {
      "candidateId": "storylet.casual.ambient.013",
      "status": "reviewed",
      "turns": [
        {
          "turnId": "a",
          "speakerSlot": 0,
          "text": "The alarm's going off. Why aren't you running?",
          "sourceHash": "sha256:f4262698cc138f4f010b458ae2258ac9cf9a59a5089c24dd04318ef7d4fa9101"
        },
        {
          "turnId": "b",
          "speakerSlot": 1,
          "text": "Running where? Outside doesn't even have air.",
          "sourceHash": "sha256:c2893f768bced169473c860cba28209275b3c38385c2112c6469ccd13f090017"
        }
      ]
    },
    {
      "candidateId": "storylet.casual.ambient.014",
      "status": "reviewed",
      "turns": [
        {
          "turnId": "a",
          "speakerSlot": 0,
          "text": "I unlocked a new skill: Advanced Digging.",
          "sourceHash": "sha256:701d5b6919e6458a45f1cc2bd9aad556ba728d399b6ecf87896e9a6f7ce38399"
        },
        {
          "turnId": "b",
          "speakerSlot": 1,
          "text": "Congrats. Your reward is more digging.",
          "sourceHash": "sha256:09d79b5146eb16efdc266b3395d21d5829fb1bf73f17e028e88b4efb4f7821a1"
        }
      ]
    },
    {
      "candidateId": "storylet.casual.ambient.015",
      "status": "reviewed",
      "turns": [
        {
          "turnId": "a",
          "speakerSlot": 0,
          "text": "Tell me a bedtime story?",
          "sourceHash": "sha256:ad1227719cc9163000f6c8b35b0c2ea66c798ae3390735802dfd8188fb3d977a"
        },
        {
          "turnId": "b",
          "speakerSlot": 1,
          "text": "Once upon a time, a duplicant deconstructed the wrong airlock. The end.",
          "sourceHash": "sha256:2d16691d9d7be54173199125e1fd47bfa03c0a287b91304e3a3f1183e7eae5af"
        }
      ]
    },
    {
      "candidateId": "storylet.casual.ambient.016",
      "status": "reviewed",
      "turns": [
        {
          "turnId": "a",
          "speakerSlot": 0,
          "text": "The electrolyzer flooded again.",
          "sourceHash": "sha256:1e5132aea987b4bdcc2d1caeb5489eef669dbf4d39d307ac9967d09bb6decf3a"
        },
        {
          "turnId": "b",
          "speakerSlot": 1,
          "text": "It is what it is.",
          "sourceHash": "sha256:214250edb15468c2246a0bfd5e089acdc3111d00961856343cc179b3b63f3521"
        }
      ]
    },
    {
      "candidateId": "storylet.casual.ambient.017",
      "status": "reviewed",
      "turns": [
        {
          "turnId": "a",
          "speakerSlot": 0,
          "text": "You've read the same daily report nine times.",
          "sourceHash": "sha256:7ec600595e8279780ce869a35fbc2734867124773c05d60c3d600f77fe88e1df"
        },
        {
          "turnId": "b",
          "speakerSlot": 1,
          "text": "The numbers might improve if I stare harder.",
          "sourceHash": "sha256:dbb2356ffef454fdaf6d1f579e05223652ac6d94336d46b345ba7ea8bbb7640c"
        }
      ]
    },
    {
      "candidateId": "storylet.casual.ambient.018",
      "status": "reviewed",
      "turns": [
        {
          "turnId": "a",
          "speakerSlot": 0,
          "text": "Your shift ended six hours ago. Why are you still in the cot?",
          "sourceHash": "sha256:7213a448a6cc2897632f5b9a6428df0ce87e0370326ad9441132b1f090f348f5"
        },
        {
          "turnId": "b",
          "speakerSlot": 1,
          "text": "I'm banking horizontal time against future digging.",
          "sourceHash": "sha256:e4aa3230c023ee90e764a101ad7be451ba83c66e917052345050af4d74a23cb8"
        }
      ]
    },
    {
      "candidateId": "storylet.casual.ambient.019",
      "status": "reviewed",
      "turns": [
        {
          "turnId": "a",
          "speakerSlot": 0,
          "text": "I'm not slacking. I'm delivering exactly forty kilograms of effort.",
          "sourceHash": "sha256:77b4532a92f24fee9d1df2a51b00b1618782b6c93a9602f2d9881162f3d7df21"
        },
        {
          "turnId": "b",
          "speakerSlot": 1,
          "text": "That is the job description, yes.",
          "sourceHash": "sha256:aad106d663ff46f18613b92c82e17e9635a5877acf3982db1fc8b88ba162ecc5"
        }
      ]
    },
    {
      "candidateId": "storylet.casual.ambient.020",
      "status": "reviewed",
      "turns": [
        {
          "turnId": "a",
          "speakerSlot": 0,
          "text": "The whole west wing flooded.",
          "sourceHash": "sha256:de16007666d8de57bb6a954b69136049bb95992bc858d536ede072468b09443c"
        },
        {
          "turnId": "b",
          "speakerSlot": 1,
          "text": "GG. Go next. ...What do you mean it's our only base?",
          "sourceHash": "sha256:eaecc429078e17743820e7b4558aa78a390943dc428bd53a6eda34789199faa7"
        }
      ]
    },
    {
      "candidateId": "storylet.casual.ambient.021",
      "status": "reviewed",
      "turns": [
        {
          "turnId": "a",
          "speakerSlot": 0,
          "text": "They discontinued my favorite mush bar flavor.",
          "sourceHash": "sha256:5de0e6fc35768e4ad946e79709a649611c2c78a69359ee7627ba3dd5d7ce6eba"
        },
        {
          "turnId": "b",
          "speakerSlot": 1,
          "text": "Womp womp. ...Sorry, I meant: there, there.",
          "sourceHash": "sha256:052e38a64c091444841f5681903ff2ad5eccc49cb98a481bbd09b14370faef9c"
        }
      ]
    },
    {
      "candidateId": "storylet.casual.ambient.022",
      "status": "reviewed",
      "turns": [
        {
          "turnId": "a",
          "speakerSlot": 0,
          "text": "A slickster followed me home through the airlock.",
          "sourceHash": "sha256:9c79efdf2673224d76cee1b493eee842dd4163565be0bb3b3dd9bf477f29605e"
        },
        {
          "turnId": "b",
          "speakerSlot": 1,
          "text": "Cat distribution system. It chose you. Congratulations.",
          "sourceHash": "sha256:0c8da3409587d5b69372dde0d630aa56700b959b9f86110c6601e7a2d07099ce"
        }
      ]
    },
    {
      "candidateId": "storylet.casual.breaking.001",
      "status": "reviewed",
      "turns": [
        {
          "turnId": "a",
          "speakerSlot": 0,
          "text": "Don't talk to me yet... I need a second to breathe.",
          "sourceHash": "sha256:c3d63a5b6cb86545deb50fb28d58d7d6ef9156cf1986e8e28a2f52ce14c84adc"
        },
        {
          "turnId": "b",
          "speakerSlot": 1,
          "text": "Okay. I'm right here. Not talking.",
          "sourceHash": "sha256:11746e68075222e2875ff627bbbc1deca673b38042ab09f7ebfec5506817f7d5"
        }
      ]
    },
    {
      "candidateId": "storylet.casual.breaking.002",
      "status": "reviewed",
      "turns": [
        {
          "turnId": "a",
          "speakerSlot": 0,
          "text": "The alarm in my head is louder than the base's.",
          "sourceHash": "sha256:bbc23c5b22de2884e9b98024c33cbcddfe06697d7d00edc515006b5e097bb28e"
        },
        {
          "turnId": "b",
          "speakerSlot": 1,
          "text": "Then switch one off: sit down, drink some water.",
          "sourceHash": "sha256:b3c592d618ce10d8eeab39a298c3063cea4d78187e6efb5279cc966ba0b9bd83"
        }
      ]
    },
    {
      "candidateId": "storylet.casual.breaking.003",
      "status": "reviewed",
      "turns": [
        {
          "turnId": "a",
          "speakerSlot": 0,
          "text": "One more thing and I will lose it.",
          "sourceHash": "sha256:4257139794d44dfaff18ca88511ea00fcec279b443d406e6aa9a8e413519b3d1"
        },
        {
          "turnId": "b",
          "speakerSlot": 1,
          "text": "Then that one thing is mine. Go lie down.",
          "sourceHash": "sha256:7ea3efbe3440887ca554a0f3b1b2969126f2a1bfae171fa241abde8a1f3f08c9"
        }
      ]
    },
    {
      "candidateId": "storylet.casual.breaking.004",
      "status": "reviewed",
      "turns": [
        {
          "turnId": "a",
          "speakerSlot": 0,
          "text": "I'm barely holding on.",
          "sourceHash": "sha256:c39b0c7e08bb3489e7ad3069a1e90cc340aa71d183834ec9835f82a09b170e81"
        },
        {
          "turnId": "b",
          "speakerSlot": 1,
          "text": "Say it out loud. It weighs half as much once you do.",
          "sourceHash": "sha256:06f3c790e87a8b6e9a7df7df2b470de4bd9f750f2355802daa05bcaa43c5390e"
        }
      ]
    }
  ]
}
