{
  "locale": "en",
  "family": "casual",
  "candidates": [
    {
      "candidateId": "storylet.casual.crybaby.001",
      "status": "reviewed",
      "turns": [
        {
          "turnId": "a",
          "speakerSlot": 0,
          "text": "I read today's schedule and... I might cry a little.",
          "sourceHash": "sha256:b4ad727314d41a288decff09a14857d7ebfc5091b533c00af6b38706951828d7"
        },
        {
          "turnId": "b",
          "speakerSlot": 1,
          "text": "Don't cry, don't cry. I'll take your latrine shift.",
          "sourceHash": "sha256:d83fe57387d860e9e1a526edf8335a7e91b331a34629e323679620a41d9b020a"
        }
      ]
    },
    {
      "candidateId": "storylet.casual.crybaby.002",
      "status": "reviewed",
      "turns": [
        {
          "turnId": "a",
          "speakerSlot": 0,
          "text": "That hatch looked at me so gently...",
          "sourceHash": "sha256:3165858e17592c901b6fb08b3b800ebfabeced255a7001d8fbee839041f22bb1"
        },
        {
          "turnId": "b",
          "speakerSlot": 1,
          "text": "It wants your boots. Don't get attached.",
          "sourceHash": "sha256:b3a56107233e6a280f849f1dadd33f251d802e28fafd4b2aaccbf78c831884b5"
        }
      ]
    },
    {
      "candidateId": "storylet.casual.crybaby.003",
      "status": "reviewed",
      "turns": [
        {
          "turnId": "a",
          "speakerSlot": 0,
          "text": "I'm not crying. It's the CO2.",
          "sourceHash": "sha256:8d98749aa7f3ddf238a5e51ff26da6bd66dc1a422a093f67d65ea2f0ed2bb68a"
        },
        {
          "turnId": "b",
          "speakerSlot": 1,
          "text": "Sure. The CO2. Tissues are in locker two.",
          "sourceHash": "sha256:36b5cc4998ea16bb40ddceab84165deba3e1961862061acd01f900d9b913ea85"
        }
      ]
    },
    {
      "candidateId": "storylet.casual.crybaby.004",
      "status": "reviewed",
      "turns": [
        {
          "turnId": "a",
          "speakerSlot": 0,
          "text": "When the Printing Pod lights up, I always feel safe...",
          "sourceHash": "sha256:d6e7d29d2f97903123ebedf6e1ab8ea49b7660fae521c12b4e6915b99208bd4d"
        },
        {
          "turnId": "b",
          "speakerSlot": 1,
          "text": "It is where every one of us began.",
          "sourceHash": "sha256:e138a2db25f9633327e91c64bfc9aaf299a71db4b0e2ce9b5075aacf4a8da340"
        }
      ]
    },
    {
      "candidateId": "storylet.casual.eater.001",
      "status": "reviewed",
      "turns": [
        {
          "turnId": "a",
          "speakerSlot": 0,
          "text": "Think a mush bar would taste better toasted?",
          "sourceHash": "sha256:40a39b6e9079ef53f506d1f8b1d8bdedfa5c625ff72f708a1387e2948b282617"
        },
        {
          "turnId": "b",
          "speakerSlot": 1,
          "text": "Last time you toasted one, the mess hall blew a fuse.",
          "sourceHash": "sha256:241eda11f39dffc53bb7f451d200d2fbfa342f3ae3d2c770c72c6da9db151925"
        }
      ]
    },
    {
      "candidateId": "storylet.casual.eater.002",
      "status": "reviewed",
      "turns": [
        {
          "turnId": "a",
          "speakerSlot": 0,
          "text": "I'm not hungry. I'm eating preventively.",
          "sourceHash": "sha256:c77e1505a323eaabe3eb4346d646547e4dbf1198933240f55ef5d3a5f3840f32"
        },
        {
          "turnId": "b",
          "speakerSlot": 1,
          "text": "You've preventively eaten tomorrow's ration too.",
          "sourceHash": "sha256:b391032b6b03aaa66ef3a07b100e8956ca86a6c222cc7c0ef798583ac338d458"
        }
      ]
    },
    {
      "candidateId": "storylet.casual.eater.003",
      "status": "reviewed",
      "turns": [
        {
          "turnId": "a",
          "speakerSlot": 0,
          "text": "What are we talking about? ...Is there food?",
          "sourceHash": "sha256:6271a3a70e18b4587e02f9a0a13f644a156fadb0d8cf128fd0ae2b45efafbb69"
        },
        {
          "turnId": "b",
          "speakerSlot": 1,
          "text": "Three sentences in and you're back to food.",
          "sourceHash": "sha256:4dfc6124532556f07987fc97d498293f5f79b5d50afd085e1f7b100ba4069d50"
        }
      ]
    },
    {
      "candidateId": "storylet.casual.eater.004",
      "status": "reviewed",
      "turns": [
        {
          "turnId": "a",
          "speakerSlot": 0,
          "text": "Night shift bonus should be fried mush bars.",
          "sourceHash": "sha256:07a7f2b92e349b1e92f1c70caf40e5fc7ef8104862731df60e4eb46c33edff81"
        },
        {
          "turnId": "b",
          "speakerSlot": 1,
          "text": "You already wrote yourself into the schedule as taste-tester.",
          "sourceHash": "sha256:cb2d6ad809c4a666b0ce3f3c2cb493c693c34fa21680e0c1c96835bfd5faafd8"
        }
      ]
    },
    {
      "candidateId": "storylet.casual.hothead.001",
      "status": "reviewed",
      "turns": [
        {
          "turnId": "a",
          "speakerSlot": 0,
          "text": "Move, move, I'll do it myself! — Not yelling at you. Yelling near you.",
          "sourceHash": "sha256:da8f4a4651214609265a80c06781386af8e1becc7c90a24011342f41dd668c30"
        },
        {
          "turnId": "b",
          "speakerSlot": 1,
          "text": "Noted. Observing the champion from a safe distance.",
          "sourceHash": "sha256:b4a818696ae284cb7afb6ac494bce7ebfb665e59d440294527402600d50031c2"
        }
      ]
    },
    {
      "candidateId": "storylet.casual.hothead.002",
      "status": "reviewed",
      "turns": [
        {
          "turnId": "a",
          "speakerSlot": 0,
          "text": "Who designed these ladders? Third climb today!",
          "sourceHash": "sha256:e87589003d4b610de68bccd2480ae3e40d5ecaed85a19abe97d0a8a41f21fdc4"
        },
        {
          "turnId": "b",
          "speakerSlot": 1,
          "text": "Someone who never climbs. Keep it down, the regolith is shaking.",
          "sourceHash": "sha256:85272433a9a1c5bdbd607c3cd6b1f3e51235b0b40d6634be9c87026009c000db"
        }
      ]
    },
    {
      "candidateId": "storylet.casual.hothead.003",
      "status": "reviewed",
      "turns": [
        {
          "turnId": "a",
          "speakerSlot": 0,
          "text": "When the Printing Pod lights up, I want to be first to welcome the newcomer.",
          "sourceHash": "sha256:b631bcef0e375a70c2d30077a2eea95cf687b573302aabc4f6356ccf4c0c6ed8"
        },
        {
          "turnId": "b",
          "speakerSlot": 1,
          "text": "Prepare a welcome meal first. Do not scare them.",
          "sourceHash": "sha256:01fdd0a4239a5b58f0661d0b60ef2990099ce77e0bc1fa201239ca7319570f21"
        }
      ]
    },
    {
      "candidateId": "storylet.casual.hothead.004",
      "status": "reviewed",
      "turns": [
        {
          "turnId": "a",
          "speakerSlot": 0,
          "text": "Blocked tunnel? Step aside. Two minutes.",
          "sourceHash": "sha256:5c9ad2bbe1f51471e05abf8a8de1a6e03e9b46845185056fa6b8d1d33154d697"
        },
        {
          "turnId": "b",
          "speakerSlot": 1,
          "text": "All yours. I'll go fetch the spare shovel.",
          "sourceHash": "sha256:2d82c8f79fd8b3dab0217bb9431c7180853b492c29b2099b8c44f484ca755618"
        }
      ]
    },
    {
      "candidateId": "storylet.casual.loud.001",
      "status": "reviewed",
      "turns": [
        {
          "turnId": "a",
          "speakerSlot": 0,
          "text": "GOOD MORNING!! OXYGEN'S GREAT TODAY!!",
          "sourceHash": "sha256:d35ea61a19bad1c6c1411dedc31b16054213e2af3b2b6796b40fc194d5feba3e"
        },
        {
          "turnId": "b",
          "speakerSlot": 1,
          "text": "Heard. The whole shaft heard.",
          "sourceHash": "sha256:008f7579af86da9f9befe057bb2483baf38704ef061c72992ec86d9e048877d5"
        }
      ]
    },
    {
      "candidateId": "storylet.casual.loud.002",
      "status": "reviewed",
      "turns": [
        {
          "turnId": "a",
          "speakerSlot": 0,
          "text": "I'm not shouting! This is my normal volume!",
          "sourceHash": "sha256:e465613abbd17a71815d49f459d541cea5c34623593d56dc7a2ff2a4279a3a36"
        },
        {
          "turnId": "b",
          "speakerSlot": 1,
          "text": "The hatches evacuated. That's your normal volume.",
          "sourceHash": "sha256:9b75b4c4816aeef4c195f4d07a4a105b34958b284b45694819d36a6ecb9378d2"
        }
      ]
    },
    {
      "candidateId": "storylet.casual.loud.003",
      "status": "reviewed",
      "turns": [
        {
          "turnId": "a",
          "speakerSlot": 0,
          "text": "EVERYONE LISTEN— hey, why the earplugs?",
          "sourceHash": "sha256:4b54ff036967b6f1771ce07bad1e0807b5885fcbd2e105ae0c15d803d0d8c1e6"
        },
        {
          "turnId": "b",
          "speakerSlot": 1,
          "text": "Go ahead. We're listening with our eyes.",
          "sourceHash": "sha256:86f78147b2185a5e7a2de7da9f9d029af58d4ab9a683aad0ba592ccbb4e9818f"
        }
      ]
    },
    {
      "candidateId": "storylet.casual.loud.004",
      "status": "reviewed",
      "turns": [
        {
          "turnId": "a",
          "speakerSlot": 0,
          "text": "Learned a new song! Let me belt it!",
          "sourceHash": "sha256:ce14d2a90969bc68585e24ab6e7bea99aa01962743cf48f30ef207b3020bea53"
        },
        {
          "turnId": "b",
          "speakerSlot": 1,
          "text": "Take it to the airlock. Both doors, please.",
          "sourceHash": "sha256:46d0b320250a905c1176309d1b9d53b64b6680763d635da32c6982080c4f2e8b"
        }
      ]
    },
    {
      "candidateId": "storylet.casual.nervous.001",
      "status": "reviewed",
      "turns": [
        {
          "turnId": "a",
          "speakerSlot": 0,
          "text": "D-did you hear that? There's something in the pipes.",
          "sourceHash": "sha256:d4dab72853d084d25e00908b1a5c8c7347732c4fc711a6f3c10194cd2ad37407"
        },
        {
          "turnId": "b",
          "speakerSlot": 1,
          "text": "That's water. Probably. ...Probably!",
          "sourceHash": "sha256:9f86e93a63426fc71b11a9e61a03ac7c6cdf54f645aacd336eb9f6751a36ed73"
        }
      ]
    },
    {
      "candidateId": "storylet.casual.nervous.002",
      "status": "reviewed",
      "turns": [
        {
          "turnId": "a",
          "speakerSlot": 0,
          "text": "I counted the oxygen three times. It checks out. I still don't feel okay.",
          "sourceHash": "sha256:656cc8e1f402c1bd57d953b416fc280abed5c166a2379047aec9ff4fc690ecb3"
        },
        {
          "turnId": "b",
          "speakerSlot": 1,
          "text": "I'll sit with you for the fourth count.",
          "sourceHash": "sha256:9b10f80dfb580348f42eed7493158be166f3acd050dd92a4cbcedb42e1f92cb6"
        }
      ]
    },
    {
      "candidateId": "storylet.casual.nervous.003",
      "status": "reviewed",
      "turns": [
        {
          "turnId": "a",
          "speakerSlot": 0,
          "text": "What if a meteor punches through tonight??",
          "sourceHash": "sha256:355a74123681b26c444d50625b8a768851fa7b0a83d93461cb61e2e13507b5e8"
        },
        {
          "turnId": "b",
          "speakerSlot": 1,
          "text": "Then it hits my shift and you get the night off.",
          "sourceHash": "sha256:7d180b88faf8f66e62d00ae8d4157b37e971cb3fd118b48b79df73c73da4a260"
        }
      ]
    },
    {
      "candidateId": "storylet.casual.nervous.004",
      "status": "reviewed",
      "turns": [
        {
          "turnId": "a",
          "speakerSlot": 0,
          "text": "Don't sneak up on me, I drop live wires.",
          "sourceHash": "sha256:6521f06bfe709ac7d218dcc9f63117fb024f7fd2adec2e3206e1d9a752021370"
        },
        {
          "turnId": "b",
          "speakerSlot": 1,
          "text": "Got it, I'll knock next time. On the wall. We have no doors.",
          "sourceHash": "sha256:58c911f9b92ba503f8868f39c68a7b2172b97d391dc11fa58fb484a341305f60"
        }
      ]
    },
    {
      "candidateId": "storylet.casual.base.001",
      "status": "reviewed",
      "turns": [
        {
          "turnId": "a",
          "speakerSlot": 0,
          "text": "You haul like a champion.",
          "sourceHash": "sha256:5a7d43f86bb1c17b75da38a283f4ef7751239795dfcacebc3ad00dc7d1699109"
        },
        {
          "turnId": "b",
          "speakerSlot": 1,
          "text": "Thanks. My back has filed a formal complaint.",
          "sourceHash": "sha256:716fbff1208368f1ffda29d8b04b1dff9962caabcf211602cec47985bbdab9ed"
        }
      ]
    },
    {
      "candidateId": "storylet.casual.base.002",
      "status": "reviewed",
      "turns": [
        {
          "turnId": "a",
          "speakerSlot": 0,
          "text": "The printing pod lit up by itself last night.",
          "sourceHash": "sha256:f16c1d563d6718556befa268f6228a805ee4770ebdbca81a8ecd53f26db732d3"
        },
        {
          "turnId": "b",
          "speakerSlot": 1,
          "text": "It's deciding who to print next. Don't interrupt.",
          "sourceHash": "sha256:5de0206678c03be48cb92469460a0c286bb76e0d9c72eaa58a37a744c9508665"
        }
      ]
    },
    {
      "candidateId": "storylet.casual.base.003",
      "status": "reviewed",
      "turns": [
        {
          "turnId": "a",
          "speakerSlot": 0,
          "text": "I climb so many ladders I climb them in my dreams.",
          "sourceHash": "sha256:35d44fdf66fe3a394e224e6d2daffd0383d4c4bb7455aa703d2b741b7e3aa423"
        },
        {
          "turnId": "b",
          "speakerSlot": 1,
          "text": "At least dream ladders don't come with a hauling errand.",
          "sourceHash": "sha256:0a20237b1b161263cc8d8bc647950702704ec7f61015dd1755042b1e47a9d82a"
        }
      ]
    },
    {
      "candidateId": "storylet.casual.base.004",
      "status": "reviewed",
      "turns": [
        {
          "turnId": "a",
          "speakerSlot": 0,
          "text": "What will you do when the colony is finished?",
          "sourceHash": "sha256:6e07e8d23691eafd227888c99107b45cb54008f59f3d6b98ae17cfd01c03f43c"
        },
        {
          "turnId": "b",
          "speakerSlot": 1,
          "text": "Sleep without an alarm clock.",
          "sourceHash": "sha256:1948dd8ccc66b0c3717dff3565cb3545f709cb809fe2192cae455c2a21dd423e"
        }
      ]
    },
    {
      "candidateId": "storylet.casual.base.005",
      "status": "reviewed",
      "turns": [
        {
          "turnId": "a",
          "speakerSlot": 0,
          "text": "A hatch ate my spare boots again.",
          "sourceHash": "sha256:30828686bb65e9e675b9e0b10fb313449f1562cb253cef2739e5439ca6e4bde2"
        },
        {
          "turnId": "b",
          "speakerSlot": 1,
          "text": "It eats better than we do. Let that sink in.",
          "sourceHash": "sha256:b5099bde522609632376bc3b5dcd81863dcf61be2d6eea7491181eee97555bf9"
        }
      ]
    },
    {
      "candidateId": "storylet.casual.base.006",
      "status": "reviewed",
      "turns": [
        {
          "turnId": "a",
          "speakerSlot": 0,
          "text": "Do you smell something weird?",
          "sourceHash": "sha256:d6473bb5404048a6eeccd9af745b6bd5824440c65106e2e48b8e2d34677eb918"
        },
        {
          "turnId": "b",
          "speakerSlot": 1,
          "text": "Narrow it down. This base is a bouquet.",
          "sourceHash": "sha256:5eb2ab76fd33d350a847b6cdf295dedf53a1a154a33e608f7e7c26cb848151a4"
        }
      ]
    },
    {
      "candidateId": "storylet.casual.base.007",
      "status": "reviewed",
      "turns": [
        {
          "turnId": "a",
          "speakerSlot": 0,
          "text": "The printing pod has new picks tomorrow.",
          "sourceHash": "sha256:64ba575ea0d6101e98f97aa079496937389d776d46d03ad225e6bb25243a82f2"
        },
        {
          "turnId": "b",
          "speakerSlot": 1,
          "text": "Please be someone who can wire a battery.",
          "sourceHash": "sha256:08fae636e3f55e97f948a9a3dedadb30cf8d11fffc9a772b187b025df781c6a3"
        }
      ]
    },
    {
      "candidateId": "storylet.casual.base.008",
      "status": "reviewed",
      "turns": [
        {
          "turnId": "a",
          "speakerSlot": 0,
          "text": "I dug three tons of granite yesterday. I counted.",
          "sourceHash": "sha256:7cb709b402425ca57084da48024e1803ef85cbc759e6e10dd062f793e36fb959"
        },
        {
          "turnId": "b",
          "speakerSlot": 1,
          "text": "Stop counting. The number only ever goes up.",
          "sourceHash": "sha256:00ec28cfbaaf3b953919d30401a675c1d82983ea526ee3249da25741b315844d"
        }
      ]
    },
    {
      "candidateId": "storylet.casual.base.009",
      "status": "reviewed",
      "turns": [
        {
          "turnId": "a",
          "speakerSlot": 0,
          "text": "That pacu doesn't look stressed at all.",
          "sourceHash": "sha256:115559bf0865c33bfa37dcea77b94f1399e839ccd738dd19a5210b4eca870e61"
        },
        {
          "turnId": "b",
          "speakerSlot": 1,
          "text": "It never has to read the schedule.",
          "sourceHash": "sha256:e468f543316e1e023298c12a6faa790e15fcd0221cb930fdc4d05f81c1e67682"
        }
      ]
    },
    {
      "candidateId": "storylet.casual.base.010",
      "status": "reviewed",
      "turns": [
        {
          "turnId": "a",
          "speakerSlot": 0,
          "text": "All the carbon dioxide sinks to the bottom floor.",
          "sourceHash": "sha256:69b4bc0efdec3420a3dfcb05ee7472933141c751882d4c17a3f84d5b28bd3266"
        },
        {
          "turnId": "b",
          "speakerSlot": 1,
          "text": "That's why top bunks are a survival strategy.",
          "sourceHash": "sha256:d5b357a1802ad618064ebded727e0473d65e7e10319f3afec1405fc989c814ac"
        }
      ]
    },
    {
      "candidateId": "storylet.casual.base.011",
      "status": "reviewed",
      "turns": [
        {
          "turnId": "a",
          "speakerSlot": 0,
          "text": "Did you understand the new painting?",
          "sourceHash": "sha256:21e1cb16c2215f9944358eb51a49646597d4ab403ed922d30f0c2cfe2296b8ab"
        },
        {
          "turnId": "b",
          "speakerSlot": 1,
          "text": "No. But the decor number went up, so I nodded.",
          "sourceHash": "sha256:97b285d9aa951e3071824aa6ee3fde3327e89fae6db6fc45c380a2266243882c"
        }
      ]
    },
    {
      "candidateId": "storylet.casual.base.012",
      "status": "reviewed",
      "turns": [
        {
          "turnId": "a",
          "speakerSlot": 0,
          "text": "My atmo suit smell has developed layers.",
          "sourceHash": "sha256:b6a94466c4170cc850aa220ee9aab6baf4ab3ef67e1ebfdec26529a3f5528e48"
        },
        {
          "turnId": "b",
          "speakerSlot": 1,
          "text": "That's the smell of seniority.",
          "sourceHash": "sha256:e92eb7d98053c3323e91c8f9cd371f36fde05e71d047ec4c448d93e31aa5f179"
        }
      ]
    },
    {
      "candidateId": "storylet.casual.base.013",
      "status": "reviewed",
      "turns": [
        {
          "turnId": "a",
          "speakerSlot": 0,
          "text": "Meteor shower tonight. Don't look up.",
          "sourceHash": "sha256:0fca38e87498443497ffbd674a88ed924c106cd4a7338e77e4abab0316d6891f"
        },
        {
          "turnId": "b",
          "speakerSlot": 1,
          "text": "Don't worry. The regolith will remember for us.",
          "sourceHash": "sha256:bdefe4ad0a753041a45dc6db995f4ad04db501480be22d68018a913ef99f5e4e"
        }
      ]
    },
    {
      "candidateId": "storylet.casual.base.014",
      "status": "reviewed",
      "turns": [
        {
          "turnId": "a",
          "speakerSlot": 0,
          "text": "Are we a family delivered by the Printing Pod?",
          "sourceHash": "sha256:7fcefb429c3cb6e4be481dd5f961cf0a5c97b12be401aaf5fea14354d2bd3fa0"
        },
        {
          "turnId": "b",
          "speakerSlot": 1,
          "text": "We are. Every one of us simply grew into someone different.",
          "sourceHash": "sha256:7c9fa5793424e7902c3d3aed3561b16d22054330acf8f0dc2d7d06a46e94d11f"
        }
      ]
    },
    {
      "candidateId": "storylet.casual.base.015",
      "status": "reviewed",
      "turns": [
        {
          "turnId": "a",
          "speakerSlot": 0,
          "text": "You know what you need? To go outside and touch some grass.",
          "sourceHash": "sha256:a4611a8f4a5f4e37d87e6f051da563bd4005902f9f95dfe84b12db0a7bb6af61"
        },
        {
          "turnId": "b",
          "speakerSlot": 1,
          "text": "We are four hundred meters underground. I'll touch the algae.",
          "sourceHash": "sha256:ff5b5c4b4079a96ff86a898b70c4dcf28b2f707713a4848565456041f82d21b7"
        }
      ]
    },
    {
      "candidateId": "storylet.casual.base.016",
      "status": "reviewed",
      "turns": [
        {
          "turnId": "a",
          "speakerSlot": 0,
          "text": "The far wall is on fire and you are still eating.",
          "sourceHash": "sha256:2652fd51c85c422861b1cd59616db8920efab904c56b26c892e2870c31c6eee8"
        },
        {
          "turnId": "b",
          "speakerSlot": 1,
          "text": "It's contained. Mostly. This is fine.",
          "sourceHash": "sha256:a4c969e9e3ef613dfcfc491982ec29e7dd5d558a52caa00e6bef9fc28adec36f"
        }
      ]
    },
    {
      "candidateId": "storylet.casual.base.017",
      "status": "reviewed",
      "turns": [
        {
          "turnId": "a",
          "speakerSlot": 0,
          "text": "When work is done, I want to sit beside the Printing Pod for a while.",
          "sourceHash": "sha256:680ed2d3033d5b5f3a292c2bb4be6875943850a3ed088ff6649776c39b47de24"
        },
        {
          "turnId": "b",
          "speakerSlot": 1,
          "text": "Take me with you. It feels like home to all of us.",
          "sourceHash": "sha256:273d731f69aad5e1a2e401a098c5e8908d6d4ace9988f80bbd3f3b91a9864d7a"
        }
      ]
    },
    {
      "candidateId": "storylet.casual.base.018",
      "status": "reviewed",
      "turns": [
        {
          "turnId": "a",
          "speakerSlot": 0,
          "text": "Reactor's overheating and the farm is flooded.",
          "sourceHash": "sha256:8e6c71a1d917864de8991b65559391f565314915c7f6022a914d166162d023dc"
        },
        {
          "turnId": "b",
          "speakerSlot": 1,
          "text": "We're so cooked.",
          "sourceHash": "sha256:c8adcf11e7b782a5c6270bb4da7f1e703ffbe82ec1eaa7f4d59e87bb0cc84efe"
        },
        {
          "turnId": "c",
          "speakerSlot": 0,
          "text": "Literally, if that reactor blows.",
          "sourceHash": "sha256:407055ff66810d5eedb0db9e830b8ed2feb94d4d519351c01a3639416cc9786a"
        }
      ]
    },
    {
      "candidateId": "storylet.casual.base.019",
      "status": "reviewed",
      "turns": [
        {
          "turnId": "a",
          "speakerSlot": 0,
          "text": "You are eating over the compost in an unwashed suit.",
          "sourceHash": "sha256:bd45366276f18639295dab3520c5a4d3055d0742b3657624e16ba81204bfe8c6"
        },
        {
          "turnId": "b",
          "speakerSlot": 1,
          "text": "The suit and I have an arrangement. Don't get involved.",
          "sourceHash": "sha256:0ad806ed68b4ae2d972dbee8d906c94e815376adc91db751ac1147f28c1c48d5"
        }
      ]
    },
    {
      "candidateId": "storylet.casual.base.020",
      "status": "reviewed",
      "turns": [
        {
          "turnId": "a",
          "speakerSlot": 0,
          "text": "I dug the same corridor so long I forgot my own name.",
          "sourceHash": "sha256:e643341c34859b3910d573e1a48a4cdca115e1c46a343766b7c0fb7f82255479"
        },
        {
          "turnId": "b",
          "speakerSlot": 1,
          "text": "It's on your suit.",
          "sourceHash": "sha256:66a7e9203a21260294edb8137f0aa402f11abda3ae2149ecb569021c4bd4c336"
        },
        {
          "turnId": "c",
          "speakerSlot": 0,
          "text": "...Huh. So it is.",
          "sourceHash": "sha256:407055ff66810d5eedb0db9e830b8ed2feb94d4d519351c01a3639416cc9786a"
        }
      ]
    },
    {
      "candidateId": "storylet.casual.base.021",
      "status": "reviewed",
      "turns": [
        {
          "turnId": "a",
          "speakerSlot": 0,
          "text": "Why do you always dig the front tunnel?",
          "sourceHash": "sha256:249a5bd38896ef619eb82037f5b7e03fd52e8b059ee05d54ce2c2764f1d2dca9"
        },
        {
          "turnId": "b",
          "speakerSlot": 1,
          "text": "Someone has to be the one the story follows.",
          "sourceHash": "sha256:d2744d4aaf999c43fd49f43598d1787d50964755b47d776d1bf650ea7ac02c46"
        },
        {
          "turnId": "c",
          "speakerSlot": 0,
          "text": "The story is about oxygen.",
          "sourceHash": "sha256:407055ff66810d5eedb0db9e830b8ed2feb94d4d519351c01a3639416cc9786a"
        }
      ]
    },
    {
      "candidateId": "storylet.casual.base.022",
      "status": "reviewed",
      "turns": [
        {
          "turnId": "a",
          "speakerSlot": 0,
          "text": "What the hatch doin'?",
          "sourceHash": "sha256:e6aa93b2408e7acdc571e7188a3124194f5dce8252d4c36e8504b60d99bdc4ab"
        },
        {
          "turnId": "b",
          "speakerSlot": 1,
          "text": "Head first into the granite. Third time this shift.",
          "sourceHash": "sha256:f4b03928c85582f62721f57bc3d342ff45625758dc0dbb3659771d50a4e761e8"
        }
      ]
    },
    {
      "candidateId": "storylet.casual.base.023",
      "status": "reviewed",
      "turns": [
        {
          "turnId": "a",
          "speakerSlot": 0,
          "text": "That pacu has been circling the same pond all night.",
          "sourceHash": "sha256:d0593244e8759db8022b2f64c282db7564e8bdb63711a82c96ba23975baf5e4a"
        },
        {
          "turnId": "b",
          "speakerSlot": 1,
          "text": "Oiia, oiia.",
          "sourceHash": "sha256:4377deb249a6153305d200b4b6068aeda3dbbadd6f79d5f8e4f6f5be2ceee881"
        },
        {
          "turnId": "c",
          "speakerSlot": 0,
          "text": "Stop narrating. Help me with the filter.",
          "sourceHash": "sha256:407055ff66810d5eedb0db9e830b8ed2feb94d4d519351c01a3639416cc9786a"
        }
      ]
    },
    {
      "candidateId": "storylet.casual.base.024",
      "status": "reviewed",
      "turns": [
        {
          "turnId": "a",
          "speakerSlot": 0,
          "text": "The airlock cycled eight hundred times today.",
          "sourceHash": "sha256:368c9947ab4713fdada795434700eeb12dbfb73161f39577756c09493ab3bd8d"
        },
        {
          "turnId": "b",
          "speakerSlot": 1,
          "text": "Hardest worker in the colony. Give it the raise.",
          "sourceHash": "sha256:992bffc3390941397feb6d846eebe7971c019d342bb8a817bbd2aee067b10d9a"
        }
      ]
    },
    {
      "candidateId": "storylet.casual.base.025",
      "status": "reviewed",
      "turns": [
        {
          "turnId": "a",
          "speakerSlot": 0,
          "text": "I labeled every pipe in the base.",
          "sourceHash": "sha256:1a628fe5faf42ab99d5b69f150098209b136ea5a55ab63a541b170a8a840f798"
        },
        {
          "turnId": "b",
          "speakerSlot": 1,
          "text": "Wonderful. The next flood will be beautifully documented.",
          "sourceHash": "sha256:b87302080e369f1e33e6b1b7560011bcf6abc86f84cdffdde88079fcb7eb2430"
        }
      ]
    }
  ]
}
