  "candidates": [
    {
      "candidateId": "storylet.confessionfail.base.001",
      "status": "reviewed",
      "turns": [
        {
          "turnId": "a",
          "speakerSlot": 0,
          "text": "I... I've liked you for a long time...",
          "sourceHash": "sha256:1840b6168ff9920ef1537464273dc890e42271004ed4e75e1c6e1f4177d149fa"
        },
        {
          "turnId": "b",
          "speakerSlot": 1,
          "text": "Oh... I'm sorry. I need to focus on surviving right now.",
          "sourceHash": "sha256:c92815ac4b8f1b6e9f3495dd55ab5584a450632d851b618b06d3a7f1a3053b9a"
        },
        {
          "turnId": "c",
          "speakerSlot": 0,
          "text": "...Forget I said anything.",
          "sourceHash": "sha256:731d0c14d376b07a3fdb44a3b400b6db65f7b2c0888a0f6e05220c9ae29a2e8c"
        }
      ]
    },
    {
      "candidateId": "storylet.confessionfail.base.002",
      "status": "reviewed",
      "turns": [
        {
          "turnId": "a",
          "speakerSlot": 0,
          "text": "So... I might, sort of, like you.",
          "sourceHash": "sha256:2e747ae277a7185ccb17cbe08a2119edc4321fd12d580f88942ac0a53ae1a5d6"
        },
        {
          "turnId": "b",
          "speakerSlot": 1,
          "text": "You're one of the good ones. My heart's just full elsewhere.",
          "sourceHash": "sha256:c76b7c44a5e71b77c1127b4e482e052e8e0df4051b1578edc453d27906e6d3e7"
        },
        {
          "turnId": "c",
          "speakerSlot": 0,
          "text": "Understood. Friends as usual?",
          "sourceHash": "sha256:8fc051fd93f95224422d7f99d988fc09a159a6fe563a1ed55a234e33f9f84945"
        }
      ]
    },
    {
      "candidateId": "storylet.confessionfail.base.003",
      "status": "reviewed",
      "turns": [
        {
          "turnId": "a",
          "speakerSlot": 0,
          "text": "I like you. Took me ten cycles to say it.",
          "sourceHash": "sha256:a8eafd143da3ab3b086f39d70e8b0f529f0cfed460a522592daf9039d9b882b9"
        },
        {
          "turnId": "b",
          "speakerSlot": 1,
          "text": "Thank you for telling me. I can't answer the same way.",
          "sourceHash": "sha256:4cbaaf0faee748c5513a82d445039a5ecf7b4a1e72ca7e48240dc67db9bf20d1"
        },
        {
          "turnId": "c",
          "speakerSlot": 0,
          "text": "It's fine. Saying it was worth it.",
          "sourceHash": "sha256:8cf8b24be308f9f2e7efa252ca0e72fdf10cb499c2ce5abd9e73fc21a8ca71c1"
        }
      ]
    },
    {
      "candidateId": "storylet.confessionfail.base.004",
      "status": "reviewed",
      "turns": [
        {
          "turnId": "a",
          "speakerSlot": 0,
          "text": "I always look forward to pipe duty with you.",
          "sourceHash": "sha256:c95884baf0830ba120e0ca12c050f2e419f169261cd3a04989aaab0bf0c8557e"
        },
        {
          "turnId": "b",
          "speakerSlot": 1,
          "text": "To me you're my best workmate... I'm sorry.",
          "sourceHash": "sha256:e58dea995c1815dad6ec4608303402650a93ac23d2488371c649d0cb19002425"
        },
        {
          "turnId": "c",
          "speakerSlot": 0,
          "text": "Workmate's still good. Plenty of pipes left.",
          "sourceHash": "sha256:74fa4107d6ab7b215f2c91d33878a639550113d7a15e97d3b206e1e1f69bdb81"
        }
      ]
    },
    {
      "candidateId": "storylet.confessionfail.base.005",
      "status": "reviewed",
      "turns": [
        {
          "turnId": "a",
          "speakerSlot": 0,
          "text": "He smiled at me near the printing pod.",
          "sourceHash": "sha256:6a1aa829232a2bc3b7510a7e81f737db98512a500a779267fb653705240bc6c7"
        },
        {
          "turnId": "b",
          "speakerSlot": 1,
          "text": "He was smiling at the pod. It makes new coworkers.",
          "sourceHash": "sha256:254b49d0daba658b17048c6b2f7c5503f82fdac3ec971583ccfa738320cc3ecd"
        },
        {
          "turnId": "c",
          "speakerSlot": 0,
          "text": "...Let me have this for one more cycle.",
          "sourceHash": "sha256:f5e4b3560d012437b834b76a88417c59dd97f42006dbfa206fd4c7f7904e0273"
        }
      ]
    }
  ]
