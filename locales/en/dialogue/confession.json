      "status": "reviewed",
      "turns": [
        {
          "turnId": "a",
          "speakerSlot": 0,
          "text": "When the power died that night, my first thought was you.",
          "sourceHash": "sha256:9781d294fd2cb352c418761b74f58b4d42f591db879b0300844a5d8e834f6a33"
        },
        {
          "turnId": "b",
          "speakerSlot": 1,
          "text": "...I crossed half the base in the dark to find you.",
          "sourceHash": "sha256:de75511cc4d7bef5b7466cc33c6431c6d8b1eeabeed1155a130df4bcfd611e2d"
        }
      ]
    },
    {
      "candidateId": "storylet.confession.base.004",
      "status": "reviewed",
      "turns": [
        {
          "turnId": "a",
          "speakerSlot": 0,
          "text": "Half of my oxygen canister is yours. Always.",
          "sourceHash": "sha256:66fcb3476888f77b1de57a8f44fb910b5e128144abcf656aea83c66a6212bb3b"
        },
        {
          "turnId": "b",
          "speakerSlot": 1,
          "text": "Dummy. Then we'd have to stay together forever.",
