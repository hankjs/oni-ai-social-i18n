        },
        {
          "turnId": "c",
          "speakerSlot": 0,
          "text": "And you smile, and none of it matters.",
          "sourceHash": "sha256:4431b42722178877fed20f9fd8ee17eee823b0e944cb07e1914ef3431f8ea884"
