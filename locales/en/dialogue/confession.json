        },
        {
          "turnId": "c",
          "speakerSlot": 0,
          "text": "That's the idea.",
          "sourceHash": "sha256:c7d6ae14ec04011f4f19bc4063dce89ed65ea8c4ab3760a8cd94d26f35499a27"
        }
      ]
    },
    {
      "candidateId": "storylet.confession.base.005",
      "status": "reviewed",
      "turns": [
        {
          "turnId": "a",
          "speakerSlot": 0,
          "text": "The decor is negative and the food is grim.",
