      "turns": [
        {
          "turnId": "a",
          "speakerSlot": 0,
          "text": "Your technique is off. Watch me once.",
          "sourceHash": "sha256:a582b191c68b08867a40fc611306b716b649ab7fd91d201b54e9c8536618a6de"
        },
        {
          "turnId": "b",
          "speakerSlot": 1,
          "text": "So that's it! No wonder I'm always a step slow.",
          "sourceHash": "sha256:54488a5ae7128876fc3d1056568a995cbbb34bda7850ed1234ea514e9c7114b9"
        }
      ]
    },
    {
