      "status": "reviewed",
      "turns": [
        {
          "turnId": "a",
          "speakerSlot": 0,
          "text": "There's a trick to this job. Let me show you.",
          "sourceHash": "sha256:d5deebd8ca2492448845a94205f6d0b2d41b4806b562cdc7fd34944fd992ad10"
        },
        {
          "turnId": "b",
          "speakerSlot": 1,
          "text": "Noted! I owe you a soft mush bar.",
          "sourceHash": "sha256:a3b7d89a0561260943dd54e917938375e7a37e7e6987071045540ab1fcdaeaaa"
        }
      ]
    },
    {
      "candidateId": "storylet.teach.base.003",
      "status": "reviewed",
      "turns": [
        {
          "turnId": "a",
          "speakerSlot": 0,
          "text": "Don't fight the pick. Let it fall on its own.",
          "sourceHash": "sha256:b6e6bf97760baaef8db7033a3b5a5edda5f957c66aff391056ac369491079ad8"
        },
        {
          "turnId": "b",
          "speakerSlot": 1,
          "text": "Oh! And the saved energy goes to dinner.",
          "sourceHash": "sha256:1c4b2a576ce5e65e4f9684326d648ddefa4509192c490a5f5038dd016b6ce7b5"
        }
      ]
    },
    {
      "candidateId": "storylet.teach.base.004",
      "status": "reviewed",
      "turns": [
        {
          "turnId": "a",
          "speakerSlot": 0,
          "text": "Before touching a wire, tap it with the back of your hand.",
          "sourceHash": "sha256:e4058b61c3c05a5680e217bec65c805986351f5371c659f680b420de97160895"
        },
        {
          "turnId": "b",
          "speakerSlot": 1,
          "text": "Why the back?",
          "sourceHash": "sha256:94da9a0a3d1bab681a34eefb4062046a766e35e17ee6c9cb0ac22c7ed5966548"
        },
        {
          "turnId": "c",
          "speakerSlot": 0,
          "text": "So the shock throws your hand clear. Remember it.",
          "sourceHash": "sha256:715fa47ad3e9c51712dcd6bb4fb88212f07c65a1901291c765f4046f805d35db"
        }
      ]
    },
    {
      "candidateId": "storylet.teach.base.005",
      "status": "reviewed",
      "turns": [
        {
          "turnId": "a",
          "speakerSlot": 0,
          "text": "Save your research data before you click around.",
          "sourceHash": "sha256:af9b59dfde6e06aafdd92aa7f4b5be6f0c58a88baac17d31bb132a35bc2940c7"
        },
        {
          "turnId": "b",
          "speakerSlot": 1,
          "text": "So that's how last week's report died... noted.",
          "sourceHash": "sha256:1d463fdcaa4db6491783e16e177fdbe39c39e2ccf6ebcf3ebb1008f12f5b98cb"
        }
      ]
    },
    {
      "candidateId": "storylet.teach.base.006",
      "status": "reviewed",
      "turns": [
        {
          "turnId": "a",
          "speakerSlot": 0,
          "text": "Don't vent the whole room to kill the germs. You are also in the room.",
          "sourceHash": "sha256:ed0e645c8f7231ff0b4dfa865c0a73a2f8fabdc2d394eddb06ef8e0d8444544c"
        },
        {
          "turnId": "b",
          "speakerSlot": 1,
