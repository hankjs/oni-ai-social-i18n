{
  "locale": "vi",
  "namespace": "social.announce",
  "entries": [
    {
      "key": "STRINGS.SOCIAL.ANNOUNCE.INTRO_TITLE",
      "text": "Đời sống xã hội đã bắt đầu",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.ANNOUNCE.INTRO_BODY",
      "text": "Người nhân bản có đời sống xã hội của riêng họ: trò chuyện, kết bạn, yêu đương, cãi vã đều xảy ra tự nhiên. Menu quản lý trên cùng mục «Xã hội» cho phép xem toàn cục và se duyên; thẻ «Xã hội» trong chi tiết người nhân bản xem quan hệ của từng người.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.ANNOUNCE.CONFESSION_TITLE",
      "text": "Nên duyên",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.ANNOUNCE.CONFESSION_BODY",
      "text": "{0} tỏ tình thành công với {1}, hai người chính thức thành người yêu!",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.ANNOUNCE.BREAKUP_TITLE",
      "text": "Chia tay rồi",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.ANNOUNCE.BREAKUP_BODY",
      "text": "Tình cảm của {0} và {1} đã đi đến hồi kết.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.ANNOUNCE.STRAW_SUFFIX",
      "text": "Giọt nước tràn ly: {0} (chu kỳ {1}).",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.ANNOUNCE.WIDOWED_TITLE",
      "text": "Mất người thương",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.ANNOUNCE.WIDOWED_BODY",
      "text": "{0} mất người thương {1}, chìm trong đau buồn.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.ANNOUNCE.COLDWAR_TITLE",
      "text": "Chiến tranh lạnh",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.ANNOUNCE.COLDWAR_BODY",
      "text": "{0} và {1} bước vào chiến tranh lạnh, quan hệ mong manh. Gắn đánh dấu se duyên có thể thúc đẩy hòa giải.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.ANNOUNCE.RECONCILE_TITLE",
      "text": "Lại như xưa",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.ANNOUNCE.RECONCILE_BODY",
      "text": "{0} và {1} gỡ hết hiềm khích, lại vui vẻ với nhau.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.ANNOUNCE.MOURNING_TITLE",
      "text": "Thầm tưởng niệm",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.ANNOUNCE.MOURNING_BODY",
      "text": "{0} thầm tưởng niệm {1} đã khuất.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.ANNOUNCE.BESTFRIEND_TITLE",
      "text": "Bạn thân",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.ANNOUNCE.BESTFRIEND_BODY",
      "text": "{0} và {1} trở thành bạn thân của nhau.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.ANNOUNCE.COHESION_ON_TITLE",
      "text": "Gắn kết thuộc địa",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.ANNOUNCE.COHESION_ON_BODY",
      "text": "Lòng người thuộc địa quy tụ, sĩ khí cả nhóm tăng.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.ANNOUNCE.DISCORD_ON_TITLE",
      "text": "Bất hòa thuộc địa",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.ANNOUNCE.DISCORD_ON_BODY",
      "text": "Không khí thuộc địa căng thẳng, sĩ khí cả nhóm sụt.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.ANNOUNCE.COHESION_OFF_TITLE",
      "text": "Không khí lắng lại",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.ANNOUNCE.COHESION_OFF_BODY",
      "text": "Tâm trạng tập thể của thuộc địa trở lại bình thường.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.ANNOUNCE.ANNIVERSARY_TITLE",
      "text": "Ngày kỷ niệm",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.ANNOUNCE.ANNIVERSARY_BODY",
      "text": "Buổi hẹn ngày kỷ niệm của {0} và {1} viên mãn, ngọt ngào nhân đôi.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.ANNOUNCE.ANNIVERSARY_MISSED_TITLE",
      "text": "Ngày kỷ niệm bị bỏ lỡ",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.ANNOUNCE.ANNIVERSARY_MISSED_BODY",
      "text": "Ngày kỷ niệm của {0} và {1} trôi mất trong bộn bề, cả hai hơi u uất.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.ANNOUNCE.FALLOUT_TITLE",
      "text": "Cạch mặt",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.ANNOUNCE.FALLOUT_BODY",
      "text": "{0} và {1} vỡ oán, chính thức cạch mặt — một thời gian tình cảm khó ấm lên, một lần xin lỗi là hòa và xóa sổ.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.ANNOUNCE.COMFORT_TITLE",
      "text": "Bên cạnh lúc sa sút",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.ANNOUNCE.COMFORT_BODY",
      "text": "{0} ngồi bên {1}, lặng lẽ bầu bạn với người đang đau buồn.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.ANNOUNCE.LOVE_MATURE_TITLE",
      "text": "Cặp đôi lâu năm",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.ANNOUNCE.LOVE_MATURE_BODY",
      "text": "{0} và {1} bên nhau đã lâu, tình cảm vào giai đoạn chảy chậm mà bền.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.ANNOUNCE.RIVAL_TITLE",
      "text": "Kết thù địch",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.ANNOUNCE.RIVAL_BODY",
      "text": "{0} và {1} oán đến đáy, chính thức kết thù địch — quan hệ này không tự ấm lại, trừ khi bạn ra tay se duyên hòa giải.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.ANNOUNCE.RIVAL_OVER_TITLE",
      "text": "Thù địch hòa giải",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.ANNOUNCE.RIVAL_OVER_BODY",
      "text": "Oán cũ của {0} và {1} cuối cùng tan, quan hệ trở lại đường thường.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.ANNOUNCE.BRAWL_TITLE",
      "text": "Đánh nhau rồi!",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.ANNOUNCE.BRAWL_BODY",
      "text": "{0} và {1} từ cãi vã nâng thành đánh nhau. Dừng khi vừa đủ, nhưng cả hai đều mang thương.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.ANNOUNCE.WRATH_BLAME_TITLE",
      "text": "Phải có người chịu",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.ANNOUNCE.WRATH_BLAME_BODY",
      "text": "Thuộc địa vừa có chuyện, mà {0} là người duyên kém nhất — món nợ cứ thế tính lên đầu họ. Hãy se duyên họ với một đồng nghiệp được kính nể, người ấy sẽ đứng ra nói lời công bằng; bỏ lỡ khoảng này, họ sẽ bị cô lập.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.ANNOUNCE.WRATH_ISOLATED_TITLE",
      "text": "Không ai nói với họ nữa",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.ANNOUNCE.WRATH_ISOLATED_BODY",
      "text": "Không ai bênh {0}. Từ nay đồng nghiệp đi qua sẽ ngoảnh mặt, người cùng bàn đứng dậy sớm. Chỉ cần một người chịu chăm họ, tìm họ nói chuyện hoặc cùng ăn một bữa, chuyện này kết thúc.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.ANNOUNCE.WRATH_SPEAK_UP_TITLE",
      "text": "Có người nói lời công bằng",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.ANNOUNCE.WRATH_SPEAK_UP_BODY",
      "text": "{0} bênh {1} trước mọi người. Không ai nhắc chuyện ấy nữa.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.ANNOUNCE.WRATH_RESCUE_TITLE",
      "text": "Người đầu tiên ngồi xuống",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.ANNOUNCE.WRATH_RESCUE_BODY",
      "text": "{0} ngồi xuống cạnh {1}. Cô lập kết thúc ở đây — chuyện này vốn chỉ cần một người bước trước.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.ANNOUNCE.WRATH_PUNCH_TITLE",
      "text": "Không ai thấy",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.ANNOUNCE.WRATH_PUNCH_BODY",
      "text": "Lúc không một bóng người, {0} ra tay đánh {1}. Đồng nghiệp không biết — chỉ bạn thấy chuyện này.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.ANNOUNCE.WRATH_FADED_TITLE",
      "text": "Bị lãng quên",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.ANNOUNCE.WRATH_FADED_BODY",
      "text": "Không ai cứu {0}, nhưng cũng chẳng ai còn nhớ chuyện ấy. Ngày vẫn trôi.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.ANNOUNCE.BREAKDOWN_TITLE",
      "text": "Cả phòng đều nhìn",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.ANNOUNCE.BREAKDOWN_BODY",
      "text": "{0} {2} ngay tại chỗ, {1} người dừng lại nhìn. Vài chu kỳ tới, nếu có người chịu lại ngồi bên, họ sẽ nhớ cả đời.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.ANNOUNCE.BREAKDOWN_COMFORT_TITLE",
      "text": "Người đầu tiên ngồi xuống",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.ANNOUNCE.BREAKDOWN_COMFORT_BODY",
      "text": "{0} tới ngồi với {1} một lúc. Chẳng nói gì trọng đại — nhưng {1} sẽ nhớ mãi ai đến trước.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.ANNOUNCE.BRAWL_BOND_TITLE",
      "text": "Đánh nhau mới thành bạn",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.ANNOUNCE.BRAWL_BOND_BODY",
      "text": "{0} và {1} đánh xong trận này lại nhận nhau, oán cũ khép lại.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.ANNOUNCE.FAMINE_WARNING_TITLE",
      "text": "Kho lương cạn đáy",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.ANNOUNCE.FAMINE_WARNING_BODY",
      "text": "Kho trống, nhiều người đang đói. Cứ thế họ sẽ tự lo lấy — giờ bổ sung lương vẫn còn kịp.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.ANNOUNCE.FAMINE_AVERTED_TITLE",
      "text": "Khủng hoảng qua rồi",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.ANNOUNCE.FAMINE_AVERTED_BODY",
      "text": "Thức ăn tới kịp, thuộc địa lùi khỏi mép vực. Không ai nhắc mấy ngày trước từng nghĩ gì.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.ANNOUNCE.FAMINE_CULL_TITLE",
      "text": "Sống sót!",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.ANNOUNCE.FAMINE_CULL_BODY",
      "text": "Chuyện giữa {0} và {1} không còn là cãi nhau. Đói đã lấy nốt chút thể diện cuối.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.ANNOUNCE.FAMINE_OVER_TITLE",
      "text": "Nạn đói đã qua",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.ANNOUNCE.FAMINE_OVER_BODY",
      "text": "Kho lại có thức ăn. Không ai hỏi đó là gì.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.ANNOUNCE.FAMINE_LAST_ONE_TITLE",
      "text": "Người thuộc địa cuối cùng",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.ANNOUNCE.FAMINE_LAST_ONE_BODY",
      "text": "Chỉ còn một người. Căn cứ im ắng, thức ăn cũng đủ.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.ANNOUNCE.RIVAL_DIED_TITLE",
      "text": "Đối thủ đã mất",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.ANNOUNCE.RIVAL_DIED_BODY",
      "text": "{1} đã đi. {0} miệng không nói gì, tâm trạng lại khá hơn một lúc.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.ANNOUNCE.CONFESSION_FAIL_TITLE",
      "text": "Tỏ tình bị từ chối",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.ANNOUNCE.CONFESSION_FAIL_BODY",
      "text": "{0} bày tỏ với {1}, nhưng không được đáp lại.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.ANNOUNCE.REKINDLE_TITLE",
      "text": "Lại nắm tay",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.ANNOUNCE.REKINDLE_BODY",
      "text": "{0} và {1} quyết định bắt đầu lại.",
      "contractRevision": 1,
      "status": "reviewed"
    }
  ]
}
