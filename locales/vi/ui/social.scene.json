{
  "locale": "vi",
  "namespace": "social.scene",
  "entries": [
    {
      "key": "STRINGS.SOCIAL.SCENE.CONFESSION_INTRO",
      "text": "Mình có chuyện quan trọng muốn nói với bạn.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.CONFESSION_KEY",
      "text": "Mình thích bạn.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.CONFESSION_REPLY",
      "text": "Mình cũng thích bạn từ lâu.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.CONFESSION_RESULT",
      "text": "Vậy cùng đi tiếp nhé.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.REKINDLE_INTRO",
      "text": "Có vài lời, mình vẫn muốn nói lại.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.REKINDLE_KEY",
      "text": "Mình bắt đầu lại được không?",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.REKINDLE_REPLY",
      "text": "Lần này đừng bỏ lỡ nữa.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.REKINDLE_RESULT",
      "text": "Cùng làm quen lại nhau.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.CONFESSION_FAIL_REPLY",
      "text": "Xin lỗi, mình không thể nhận.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.CONFESSION_FAIL_RESULT",
      "text": "……Mình hiểu rồi.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BREAKUP_KEY",
      "text": "Mình dừng ở đây thôi.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BREAKUP_REPLY",
      "text": "……Mình biết rồi.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.RECONCILE_KEY",
      "text": "Đừng cứng như thế nữa.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.RECONCILE_REPLY",
      "text": "Được, mình làm lại từ đầu.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.GRIEF_KEY",
      "text": "Mình sẽ nhớ bạn.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.CHAT_KEY",
      "text": "Chào.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.RIVAL_KEY",
      "text": "Món này, mình không tính xong thế.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.RIVAL_REPLY",
      "text": "Vừa hay, mình cũng chẳng định hòa giải.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.WRATH_MEAL_SNUB_1",
      "text": "Mình ăn xong rồi.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.WRATH_MEAL_SNUB_2",
      "text": "...Mình mang qua bên kia ăn.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.WRATH_MEAL_SNUB_3",
      "text": "Bàn này đầy rồi.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.WRATH_MEAL_SNUB_4",
      "text": "À, mình còn việc chưa xong.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BOUND_BLOCK_UP_1",
      "text": "Cảm giác... vẫn còn thiếu một chút gì đó.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BOUND_BLOCK_UP_2",
      "text": "Có vài lời, bây giờ chưa phải lúc.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BOUND_BLOCK_UP_3",
      "text": "Đến đây là được rồi. Vậy cũng ổn.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BOUND_BLOCK_COUPLE_1",
      "text": "Lời đã đến miệng, lại nuốt xuống...",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BOUND_BLOCK_COUPLE_2",
      "text": "Tim đập thình thịch, mà chẳng nói được câu nào.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BOUND_BLOCK_COUPLE_3",
      "text": "Có lẽ... mình chờ thêm chút nữa.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BOUND_BLOCK_RIVAL_1",
      "text": "Thôi bỏ đi... không đáng.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BOUND_BLOCK_RIVAL_2",
      "text": "Cơn giận bốc lên, rồi tự dưng lại nguội.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BOUND_BLOCK_RIVAL_3",
      "text": "Không muốn gặp lại nữa. Chắc vậy.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BOUND_BLOCK_SPLIT_1",
      "text": "Cãi được nửa chừng, tự dưng chẳng buồn cãi nữa.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BOUND_BLOCK_SPLIT_2",
      "text": "Lời nặng đã đến miệng, rốt cuộc không ai nói ra.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BOUND_BLOCK_SPLIT_3",
      "text": "...Coi như chưa có gì đi.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BOUND_BLOCK_FADE_1",
      "text": "Lâu rồi không nói chuyện, mà chẳng thấy khác gì.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BOUND_BLOCK_FADE_2",
      "text": "Lạ thật, tình cảm này chẳng chịu nhạt đi.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_1",
      "text": "Không phải nói riêng bạn. Ý mình là cả đám ở đây đều vô dụng.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_2",
      "text": "Kém thì tập thêm đi.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_3",
      "text": "Chưa từng thấy ai mặt dày đến thế.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_4",
      "text": "Nhìn mình đây. NHÌN ĐÂY!",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_5",
      "text": "Chỉ vậy thôi? Hết rồi à?",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_6",
      "text": "Ồ, giờ bạn dạy mình làm việc cơ đấy?",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_7",
      "text": "Có bao giờ nghĩ vấn đề nằm ở bạn không?",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_8",
      "text": "Mới nửa chừng đã mở sâm banh à?",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_9",
      "text": "Ồ, có người cáu rồi đấy.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_10",
      "text": "Do dự là thua. Bạn vừa do dự đấy.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_11",
      "text": "Ấm ức thì khóc đi.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_12",
      "text": "Đấy, áp lực chuyển sang phía bạn rồi.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_13",
      "text": "Nói to gớm, trong tầm đấm đấy.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_14",
      "text": "Mở rộng tầm mắt đi. Bắt đầu từ cái mặt ấy.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_15",
      "text": "Hóa ra thằng hề là mình, từ lúc tin bạn.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_16",
      "text": "Trước là trước, giờ là giờ.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_17",
      "text": "Bọn trẻ bây giờ, chẳng còn tí đạo nghĩa nào.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_18",
      "text": "Lùi. Lùi. LÙI RA!",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_19",
      "text": "Khỏi xin lỗi. Mình ghét nhất kiểu xin lỗi sau.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_20",
      "text": "Cái miệng bạn còn bẩn hơn ống xả không lọc.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BRAWL_SURRENDER_1",
      "text": "Mình sơ ý! Chưa kịp né!",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BRAWL_SURRENDER_2",
      "text": "Được. Được rồi! Bạn thắng.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BRAWL_SURRENDER_3",
      "text": "Mình chịu thua! Thua rồi!",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BRAWL_SURRENDER_4",
      "text": "Dừng — dừng lại, mình sai rồi!",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BRAWL_SURRENDER_5",
      "text": "Thôi. Thôi không đánh nữa.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BRAWL_CHEER_1",
      "text": "Đánh nhau kìa! Đánh nhau kìa!",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BRAWL_CHEER_2",
      "text": "Đừng ai can nhé! ...Ồ, vốn chẳng ai định can.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BRAWL_CHEER_3",
      "text": "Cứ để họ đánh!",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BRAWL_CHEER_4",
      "text": "Mình chỉ hóng thôi.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BRAWL_CHEER_5",
      "text": "Tới đi! Ờ... cả hai tới đi!",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BRAWL_CHEER_6",
      "text": "Cái này có ai quay lại không đấy?",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.FAMINE_BUTCHER_1",
      "text": "Xin lỗi... xin lỗi...",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.FAMINE_BUTCHER_2",
      "text": "Đừng nhìn mình. Đừng ai nhìn cả.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.FAMINE_BUTCHER_3",
      "text": "Chúng ta phải sống. Chỉ có vậy thôi.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.FAMINE_BUTCHER_4",
      "text": "Đây không phải giết người. Đây là sống sót.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.FAMINE_BUTCHER_5",
      "text": "Đừng nhìn. Sẽ nhanh thôi.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.FAMINE_BUTCHER_6",
      "text": "Mình sẽ nhớ tên bạn.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.FAMINE_BUTCHER_7",
      "text": "Rồi cũng phải có người làm.",
      "contractRevision": 1,
      "status": "reviewed"
    }
  ]
}
