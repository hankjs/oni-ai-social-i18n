    {
      "key": "STRINGS.SOCIAL.DETAILS.REPUTATION_TOOLTIP",
      "text": "Thiện cảm trung bình với mọi người nhân bản còn sống. Hiện chỉ phản ánh duyên cao thấp, không ảnh hưởng phán định nào; lối chơi uy tín để bản sau.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.DETAILS.COLONY_LABEL",
      "text": "Thuộc địa",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.DETAILS.COLONY_TOOLTIP",
      "text": "Trung bình thiện cảm từng cặp giữa mọi người nhân bản còn sống. ≥40 kích gắn kết thuộc địa (sĩ khí cả nhóm +1); nhiều cặp chiến tranh lạnh kích bất hòa thuộc địa (sĩ khí cả nhóm -1, cãi vã dày hơn). Ăn chung, tiệc và se duyên đều nâng gắn kết.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.DETAILS.SYSTEM_UNAVAILABLE",
