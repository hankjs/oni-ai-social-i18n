{
  "locale": "ru",
  "namespace": "social.scene",
  "entries": [
    {
      "key": "STRINGS.SOCIAL.SCENE.CONFESSION_INTRO",
      "text": "Мне нужно тебе кое-что сказать.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.CONFESSION_KEY",
      "text": "Ты мне нравишься.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.CONFESSION_REPLY",
      "text": "Ты мне тоже давно нравишься.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.CONFESSION_RESULT",
      "text": "Тогда пойдём дальше вместе.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.REKINDLE_INTRO",
      "text": "Некоторые слова я всё же хочу сказать ещё раз.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.REKINDLE_KEY",
      "text": "Мы можем начать сначала?",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.REKINDLE_REPLY",
      "text": "На этот раз не упустим.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.REKINDLE_RESULT",
      "text": "Давай узнаем друг друга заново.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.CONFESSION_FAIL_REPLY",
      "text": "Прости, я не могу согласиться.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.CONFESSION_FAIL_RESULT",
      "text": "…Понятно.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BREAKUP_KEY",
      "text": "Давай на этом и остановимся.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BREAKUP_REPLY",
      "text": "…Ясно.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.RECONCILE_KEY",
      "text": "Не будем так дальше стоять в холодной войне.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.RECONCILE_REPLY",
      "text": "Хорошо, начнём сначала.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.GRIEF_KEY",
      "text": "Я тебя запомню.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.CHAT_KEY",
      "text": "Привет.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.RIVAL_KEY",
      "text": "Этот счёт я так не оставлю.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.RIVAL_REPLY",
      "text": "Как раз, я тоже не собирался мириться.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.WRATH_MEAL_SNUB_1",
      "text": "Я уже поел.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.WRATH_MEAL_SNUB_2",
      "text": "...Пойду доем там.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.WRATH_MEAL_SNUB_3",
      "text": "За этим столом занято.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.WRATH_MEAL_SNUB_4",
      "text": "Точно, у меня же ещё работа.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BOUND_BLOCK_UP_1",
      "text": "Кажется... чего-то всё же не хватает.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BOUND_BLOCK_UP_2",
      "text": "Кое-что лучше сказать не сейчас.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BOUND_BLOCK_UP_3",
      "text": "И так хорошо. Этого достаточно.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BOUND_BLOCK_COUPLE_1",
      "text": "Слова подступили к горлу — и там остались...",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BOUND_BLOCK_COUPLE_2",
      "text": "Сердце колотится, а слов нет.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BOUND_BLOCK_COUPLE_3",
      "text": "Может... подождём ещё немного.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BOUND_BLOCK_RIVAL_1",
      "text": "Ладно... оно того не стоит.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BOUND_BLOCK_RIVAL_2",
      "text": "Злость вспыхнула — и сама собой погасла.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BOUND_BLOCK_RIVAL_3",
      "text": "Видеть его больше не хочу. Наверное.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BOUND_BLOCK_SPLIT_1",
      "text": "На середине ссоры расхотелось ссориться.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BOUND_BLOCK_SPLIT_2",
      "text": "Злые слова так и не прозвучали.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BOUND_BLOCK_SPLIT_3",
      "text": "...Считай, ничего не было.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BOUND_BLOCK_FADE_1",
      "text": "Давно не разговаривали — а всё как было.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BOUND_BLOCK_FADE_2",
      "text": "Странно: никак не остывает.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_1",
      "text": "Ничего личного. Просто здесь все бесполезны — ты в первую очередь.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_2",
      "text": "Руки кривые — тренируйся.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_3",
      "text": "Такого бесстыдства я ещё не встречал.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_4",
      "text": "Смотри на меня. СМОТРИ НА МЕНЯ.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_5",
      "text": "И это всё? Серьёзно, всё?",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_6",
      "text": "О, теперь ты будешь учить меня работать?",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_7",
      "text": "А не думал, что проблема — в тебе?",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_8",
      "text": "Шампанское в перерыве открываешь?",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_9",
      "text": "О-о, кто-то занервничал.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_10",
      "text": "Промедлил — проиграл. Ты промедлил.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_11",
      "text": "Поплачь ещё.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_12",
      "text": "Ну всё, теперь давление на твоей стороне.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_13",
      "text": "Смело для того, кто в зоне удара.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_14",
      "text": "Расширь кругозор. Начни с лица.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_15",
      "text": "Клоун здесь я — раз тебе поверил.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_16",
      "text": "То было тогда. А это — сейчас.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_17",
      "text": "Молодёжь пошла — никакого понятия о чести.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_18",
      "text": "Назад. Назад. НАЗАД.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_19",
      "text": "Извинения оставь себе. Терпеть их не могу.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_20",
      "text": "У тебя рот грязнее, чем вентиляция без фильтра.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BRAWL_SURRENDER_1",
      "text": "Я не был готов! НЕ ГОТОВ!",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BRAWL_SURRENDER_2",
      "text": "Ладно. Ладно! Твоя взяла.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BRAWL_SURRENDER_3",
      "text": "Сдаюсь! Сдаюсь!",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BRAWL_SURRENDER_4",
      "text": "Хватит — хватит, я был неправ!",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BRAWL_SURRENDER_5",
      "text": "Всё. Больше не буду.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BRAWL_CHEER_1",
      "text": "ДЕРУТСЯ! ДЕРУТСЯ!",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BRAWL_CHEER_2",
      "text": "Не разнимайте! ...А, никто и не собирался.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BRAWL_CHEER_3",
      "text": "Пусть дерутся!",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BRAWL_CHEER_4",
      "text": "Я просто посмотреть.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BRAWL_CHEER_5",
      "text": "Давай его! Э-э — давайте оба!",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BRAWL_CHEER_6",
      "text": "Это вообще кто-нибудь снимает?",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.FAMINE_BUTCHER_1",
      "text": "Прости. Прости меня.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.FAMINE_BUTCHER_2",
      "text": "Не смотрите на меня. Пусть никто не смотрит.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.FAMINE_BUTCHER_3",
      "text": "Нам нужно жить. Только и всего.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.FAMINE_BUTCHER_4",
      "text": "Это не убийство. Это выживание.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.FAMINE_BUTCHER_5",
      "text": "Не смотри. Это быстро.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.FAMINE_BUTCHER_6",
      "text": "Я запомню твоё имя.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.FAMINE_BUTCHER_7",
      "text": "Кто-то должен был это сделать.",
      "contractRevision": 1,
      "status": "reviewed"
    }
  ]
}
