{
  "locale": "ru",
  "namespace": "social.announce",
  "entries": [
    {
      "key": "STRINGS.SOCIAL.ANNOUNCE.INTRO_TITLE",
      "text": "Социальная жизнь началась",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.ANNOUNCE.INTRO_BODY",
      "text": "У дубликантов появилась своя социальная жизнь: разговоры, дружба, любовь и ссоры случаются сами. В верхнем меню управления пункт «Общение» позволяет следить за общей картиной и заниматься сводничеством; вкладка «Общение» в карточке дубликанта показывает отношения каждого.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.ANNOUNCE.CONFESSION_TITLE",
      "text": "Стали парой",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.ANNOUNCE.CONFESSION_BODY",
      "text": "{0} успешно сделал признание {1}, и они официально стали парой!",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.ANNOUNCE.BREAKUP_TITLE",
      "text": "Расстались",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.ANNOUNCE.BREAKUP_BODY",
      "text": "Чувства {0} и {1} подошли к концу.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.ANNOUNCE.STRAW_SUFFIX",
      "text": "Последняя капля, сломавшая чувства: {0} (цикл {1}).",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.ANNOUNCE.WIDOWED_TITLE",
      "text": "Потеря пары",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.ANNOUNCE.WIDOWED_BODY",
      "text": "{0} потерял пару {1} и впал в скорбь.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.ANNOUNCE.COLDWAR_TITLE",
      "text": "Холодная война",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.ANNOUNCE.COLDWAR_BODY",
      "text": "{0} и {1} вступили в холодную войну, отношения на грани. Метка сводничества поможет добиться примирения.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.ANNOUNCE.RECONCILE_TITLE",
      "text": "Снова в ладу",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.ANNOUNCE.RECONCILE_BODY",
      "text": "{0} и {1} забыли старое и помирились.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.ANNOUNCE.MOURNING_TITLE",
      "text": "Тихий траур",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.ANNOUNCE.MOURNING_BODY",
      "text": "{0} в душе держит траур по ушедшему {1}.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.ANNOUNCE.BESTFRIEND_TITLE",
      "text": "Лучшие друзья",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.ANNOUNCE.BESTFRIEND_BODY",
      "text": "{0} и {1} стали лучшими друзьями друг другу.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.ANNOUNCE.COHESION_ON_TITLE",
      "text": "Сплочённость колонии",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.ANNOUNCE.COHESION_ON_BODY",
      "text": "Колония сплотилась, Моральный дух всех вырос.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.ANNOUNCE.DISCORD_ON_TITLE",
      "text": "Разлад колонии",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.ANNOUNCE.DISCORD_ON_BODY",
      "text": "В колонии напряжённо, Моральный дух всех падает.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.ANNOUNCE.COHESION_OFF_TITLE",
      "text": "Снова спокойно",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.ANNOUNCE.COHESION_OFF_BODY",
      "text": "Общие настроения колонии вернулись к обычным.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.ANNOUNCE.ANNIVERSARY_TITLE",
      "text": "Годовщина",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.ANNOUNCE.ANNIVERSARY_BODY",
      "text": "Свидание {0} и {1} в годовщину прошло отлично, нежности стало вдвое больше.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.ANNOUNCE.ANNIVERSARY_MISSED_TITLE",
      "text": "Пропущенная годовщина",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.ANNOUNCE.ANNIVERSARY_MISSED_BODY",
      "text": "Годовщина {0} и {1} утонула в суете, обоим от этого не по себе.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.ANNOUNCE.FALLOUT_TITLE",
      "text": "Разрыв",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.ANNOUNCE.FALLOUT_BODY",
      "text": "Накопленная злоба {0} и {1} прорвалась, они официально в разрыве — какое-то время чувства не согреются; одного извинения хватит, чтобы помириться и закрыть счёт.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.ANNOUNCE.COMFORT_TITLE",
      "text": "Рядом в беде",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.ANNOUNCE.COMFORT_BODY",
      "text": "{0} сел рядом с {1} и молча остался с товарищем в скорби.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.ANNOUNCE.LOVE_MATURE_TITLE",
      "text": "Давняя пара",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.ANNOUNCE.LOVE_MATURE_BODY",
      "text": "{0} и {1} давно вместе, чувства вошли в тихую долгую пору.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.ANNOUNCE.RIVAL_TITLE",
      "text": "Стали заклятыми врагами",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.ANNOUNCE.RIVAL_BODY",
      "text": "Злоба {0} и {1} дошла до дна, они официально стали заклятыми врагами — эти отношения сами не отогреются, пока вы не вмешаетесь сводничеством.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.ANNOUNCE.RIVAL_OVER_TITLE",
      "text": "Примирение заклятых врагов",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.ANNOUNCE.RIVAL_OVER_BODY",
      "text": "Старая вражда {0} и {1} наконец растаяла, отношения вернулись на обычную колею.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.ANNOUNCE.BRAWL_TITLE",
      "text": "Драка!",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.ANNOUNCE.BRAWL_BODY",
      "text": "Ссора {0} и {1} переросла в драку. До смертельного не дошло, но оба в синяках.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.ANNOUNCE.WRATH_BLAME_TITLE",
      "text": "Кто-то должен ответить",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.ANNOUNCE.WRATH_BLAME_BODY",
      "text": "В колонии только что случилась беда, а {0} — с самой плохой репутацией: вот счёт и выставили. Сведите сейчас с уважаемым коллегой — тот заступится честным словом; упустите время — наступит изоляция.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.ANNOUNCE.WRATH_ISOLATED_TITLE",
      "text": "С ним больше не говорят",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.ANNOUNCE.WRATH_ISOLATED_BODY",
      "text": "За {0} никто не заступился. Теперь коллеги отворачиваются в проходе, а за общим столом встают раньше. Если кто-то один согласится позаботиться, поговорить или поесть вместе — на этом всё кончится.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.ANNOUNCE.WRATH_SPEAK_UP_TITLE",
      "text": "Кто-то сказал честное слово",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.ANNOUNCE.WRATH_SPEAK_UP_BODY",
      "text": "{0} при всех заступился за {1}. Об этом больше не вспоминают.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.ANNOUNCE.WRATH_RESCUE_TITLE",
      "text": "Первый, кто сел рядом",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.ANNOUNCE.WRATH_RESCUE_BODY",
      "text": "{0} сел рядом с {1}. Изоляция кончилась — в таких делах всегда достаточно, чтобы кто-то один сделал шаг.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.ANNOUNCE.WRATH_PUNCH_TITLE",
      "text": "Никто не видел",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.ANNOUNCE.WRATH_PUNCH_BODY",
      "text": "Когда вокруг никого не было, {0} ударил {1}. Коллеги не знают — это видели только вы.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.ANNOUNCE.WRATH_FADED_TITLE",
      "text": "Забыто",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.ANNOUNCE.WRATH_FADED_BODY",
      "text": "{0} никто не спас, но и ту историю уже никто не помнит. Жизнь идёт.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.ANNOUNCE.BREAKDOWN_TITLE",
      "text": "Смотрела вся комната",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.ANNOUNCE.BREAKDOWN_BODY",
      "text": "{0} прямо на месте {2}, и {1} человек остановились смотреть. Если в ближайшие циклы кто-то сядет рядом, это запомнится на всю жизнь.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.ANNOUNCE.BREAKDOWN_COMFORT_TITLE",
      "text": "Первый, кто сел рядом",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.ANNOUNCE.BREAKDOWN_COMFORT_BODY",
      "text": "{0} пошёл посидеть с {1}. Важных слов не было — но {1} навсегда запомнит, кто подошёл первым.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.ANNOUNCE.BRAWL_BOND_TITLE",
      "text": "Поссорились — подружились",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.ANNOUNCE.BRAWL_BOND_BODY",
      "text": "После этой драки {0} и {1} наоборот признали друг друга, и старая вражда кончилась.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.ANNOUNCE.FAMINE_WARNING_TITLE",
      "text": "Амбар пуст",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.ANNOUNCE.FAMINE_WARNING_BODY",
      "text": "Кладовая пуста, многие голодают. Если так пойдёт, они начнут искать выход сами — ещё не поздно подвезти еду.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.ANNOUNCE.FAMINE_AVERTED_TITLE",
      "text": "Кризис миновал",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.ANNOUNCE.FAMINE_AVERTED_BODY",
      "text": "Еда подоспела вовремя, колония отступила от края. О том, что думалось в те дни, никто не говорит.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.ANNOUNCE.FAMINE_CULL_TITLE",
      "text": "Выжить!",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.ANNOUNCE.FAMINE_CULL_BODY",
      "text": "Между {0} и {1} это уже не ссора. Голод забрал и остатки достоинства.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.ANNOUNCE.FAMINE_OVER_TITLE",
      "text": "Голод миновал",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.ANNOUNCE.FAMINE_OVER_BODY",
      "text": "В кладовой снова есть еда. Никто не спрашивает, что это было.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.ANNOUNCE.FAMINE_LAST_ONE_TITLE",
      "text": "Последний колонист",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.ANNOUNCE.FAMINE_LAST_ONE_BODY",
      "text": "Остался один. На базе тихо, еды хватает.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.ANNOUNCE.RIVAL_DIED_TITLE",
      "text": "Неприятеля больше нет",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.ANNOUNCE.RIVAL_DIED_BODY",
      "text": "{1} ушёл. {0} вслух ничего не сказал, но настроение на время поднялось.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.ANNOUNCE.CONFESSION_FAIL_TITLE",
      "text": "В признании отказали",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.ANNOUNCE.CONFESSION_FAIL_BODY",
      "text": "{0} открыл чувства {1}, но ответа не последовало.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.ANNOUNCE.REKINDLE_TITLE",
      "text": "Снова за руки",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.ANNOUNCE.REKINDLE_BODY",
      "text": "{0} и {1} решили начать сначала.",
      "contractRevision": 1,
      "status": "reviewed"
    }
  ]
}
