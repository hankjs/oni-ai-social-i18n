{
  "locale": "ru",
  "namespace": "social.effects",
  "entries": [
    {
      "key": "STRINGS.SOCIAL.EFFECTS.LOVE.NAME",
      "text": "Влюблён",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.EFFECTS.LOVE.DESC",
      "text": "Появился дорогой человек, Моральный дух растёт.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.EFFECTS.LOVE_MATURE.NAME",
      "text": "Давняя пара",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.EFFECTS.LOVE_MATURE.DESC",
      "text": "Вместе так давно, что друг для друга — самое спокойное место. Моральный дух сильно растёт.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.EFFECTS.DATE_AFTERGLOW.NAME",
      "text": "Послесветие свидания",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.EFFECTS.DATE_AFTERGLOW.DESC",
      "text": "Только что было приятное свидание, Моральный дух растёт.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.EFFECTS.CANNIBAL.NAME",
      "text": "Съел коллегу",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.EFFECTS.CANNIBAL.DESC",
      "text": "Кто был тем ужином, известно. Иное, однажды съеденное, уже не выплюнуть.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.EFFECTS.RIVAL_DIED.NAME",
      "text": "Злорадство",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.EFFECTS.RIVAL_DIED.DESC",
      "text": "Тот, кто бесил, больше не здесь. Вслух не говорят, но на душе и правда легче.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.EFFECTS.GRIEF.NAME",
      "text": "Скорбь по паре",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.EFFECTS.GRIEF.DESC",
      "text": "Дорогой человек погиб, Моральный дух падает.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.EFFECTS.GRIEF_SOFT.NAME",
      "text": "Скорбь по паре (есть кто рядом)",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.EFFECTS.GRIEF_SOFT.DESC",
      "text": "Дорогой человек погиб, но присутствие колонии смягчает боль.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.EFFECTS.COLONY_COHESION.NAME",
      "text": "Сплочённость колонии",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.EFFECTS.COLONY_COHESION.DESC",
      "text": "Вся колония заодно, Моральный дух всех растёт.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.EFFECTS.COLONY_DISCORD.NAME",
      "text": "Разлад колонии",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.EFFECTS.COLONY_DISCORD.DESC",
      "text": "В колонии напряжённо, Моральный дух всех падает.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.EFFECTS.SIDE_BY_SIDE.NAME",
      "text": "Плечом к плечу",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.EFFECTS.SIDE_BY_SIDE.DESC",
      "text": "Работа вместе с близким человеком идёт спорее.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.EFFECTS.RIVAL_FRICTION.NAME",
      "text": "Не в ладах",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.EFFECTS.RIVAL_FRICTION.DESC",
      "text": "Работает бок о бок с соперником. Оба теряют в скорости.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.EFFECTS.STRAINED.NAME",
      "text": "На пределе",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.EFFECTS.STRAINED.DESC",
      "text": "Стресс почти на грани, срыв может случиться в любой момент. Пусть поговорят, поедят как следует или отдохнут.",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.EFFECTS.STRAINED.BUBBLE",
      "text": "Глубокий вдох… сдержался",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.EFFECTS.WRATH_ISOLATED.NAME",
      "text": "В изоляции",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.EFFECTS.WRATH_ISOLATED.DESC",
      "text": "В колонии случилась беда, а репутация была самой низкой — вот счёт и выставили, независимо от вины. Если кто-то согласится позаботиться, поговорить или поесть вместе, состояние спадёт; ещё чуть позже историю и так забудут.",
      "contractRevision": 1,
      "status": "reviewed"
    }
  ]
}
