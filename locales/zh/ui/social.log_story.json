    {
      "key": "STRINGS.SOCIAL.LOG_STORY.FALLOUT_2",
      "text": "{pair}之间那点情分,一夜之间清了零。",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.LOG_STORY.FALLOUT_3",
      "text": "从那天起,{pair}在走廊里遇见都绕着走。",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.LOG_STORY.FALLOUT_4",
