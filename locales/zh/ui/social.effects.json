{
  "locale": "zh",
  "namespace": "social.effects",
  "entries": [
    {
      "key": "STRINGS.SOCIAL.EFFECTS.LOVE.NAME",
      "text": "恋爱中",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.EFFECTS.LOVE.DESC",
      "text": "有心上人了，士气提升。",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.EFFECTS.LOVE_MATURE.NAME",
      "text": "相伴已久",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.EFFECTS.LOVE_MATURE.DESC",
      "text": "相伴已久，是彼此安心的存在。士气大幅提升。",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.EFFECTS.DATE_AFTERGLOW.NAME",
      "text": "约会余韵",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.EFFECTS.DATE_AFTERGLOW.DESC",
      "text": "刚度过愉快的约会，士气提升。",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.EFFECTS.CANNIBAL.NAME",
      "text": "吃了同事",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.EFFECTS.CANNIBAL.DESC",
      "text": "那顿饭是谁，心里清楚。有些事情吃下去就吐不出来了。",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.EFFECTS.RIVAL_DIED.NAME",
      "text": "幸灾乐祸",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.EFFECTS.RIVAL_DIED.DESC",
      "text": "看不顺眼的那个人不在了。嘴上不说，心情确实不错。",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.EFFECTS.GRIEF.NAME",
      "text": "丧偶悲伤",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.EFFECTS.GRIEF.DESC",
      "text": "失去了心上人，士气下降。",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.EFFECTS.GRIEF_SOFT.NAME",
      "text": "丧偶悲伤（有人陪着）",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.EFFECTS.GRIEF_SOFT.DESC",
      "text": "失去了心上人，但殖民地的陪伴减轻了痛苦。",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.EFFECTS.COLONY_COHESION.NAME",
      "text": "殖民地羁绊",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.EFFECTS.COLONY_COHESION.DESC",
      "text": "殖民地上下一条心，全员士气提升。",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.EFFECTS.COLONY_DISCORD.NAME",
      "text": "殖民地不和",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.EFFECTS.COLONY_DISCORD.DESC",
      "text": "殖民地关系紧张，全员士气下降。",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.EFFECTS.SIDE_BY_SIDE.NAME",
      "text": "并肩作战",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.EFFECTS.SIDE_BY_SIDE.DESC",
      "text": "和要好的人一起干活，效率提升。",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.EFFECTS.RIVAL_FRICTION.NAME",
      "text": "碍手碍脚",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.EFFECTS.RIVAL_FRICTION.DESC",
      "text": "和宿敌干同一件活，两个人都慢下来。",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.EFFECTS.STRAINED.NAME",
      "text": "情绪紧绷",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.EFFECTS.STRAINED.DESC",
      "text": "压力已经逼近极限，随时可能崩溃。找人聊聊、吃顿好的，或者让 TA 歇一歇。",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.EFFECTS.STRAINED.BUBBLE",
      "text": "深吸一口气……忍住了",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.EFFECTS.WRATH_ISOLATED.NAME",
      "text": "被孤立",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.EFFECTS.WRATH_ISOLATED.DESC",
      "text": "成了众人迁怒的对象，正在被疏远。有人主动照顾、听取倾诉或一起吃饭，就能打破孤立；这个状态也会随时间消退。",
      "contractRevision": 1,
      "status": "reviewed"
    }
  ]
}
