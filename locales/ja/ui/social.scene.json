{
  "locale": "ja",
  "namespace": "social.scene",
  "entries": [
    {
      "key": "STRINGS.SOCIAL.SCENE.CONFESSION_INTRO",
      "text": "大事な話がある。",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.CONFESSION_KEY",
      "text": "好きだ。",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.CONFESSION_REPLY",
      "text": "私もずっと好きだった。",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.CONFESSION_RESULT",
      "text": "じゃあ、一緒に歩いていこう。",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.REKINDLE_INTRO",
      "text": "どうしても、もう一度言っておきたいことがある。",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.REKINDLE_KEY",
      "text": "やり直せるかな？",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.REKINDLE_REPLY",
      "text": "今度は、もう逃さないで。",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.REKINDLE_RESULT",
      "text": "もう一度、互いを知ろう。",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.CONFESSION_FAIL_REPLY",
      "text": "ごめん、答えられない。",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.CONFESSION_FAIL_RESULT",
      "text": "……分かった。",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BREAKUP_KEY",
      "text": "ここまでにしよう。",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BREAKUP_REPLY",
      "text": "……分かった。",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.RECONCILE_KEY",
      "text": "もう、こんなふうに拗れたままはやめよう。",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.RECONCILE_REPLY",
      "text": "うん、やり直そう。",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.GRIEF_KEY",
      "text": "君のことは忘れない。",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.CHAT_KEY",
      "text": "やあ。",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.RIVAL_KEY",
      "text": "この借りは、そう簡単には済まさない。",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.RIVAL_REPLY",
      "text": "ちょうどいい、こっちも和解する気はない。",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.WRATH_MEAL_SNUB_1",
      "text": "もう食べ終わった。",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.WRATH_MEAL_SNUB_2",
      "text": "……あっちで食べる。",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.WRATH_MEAL_SNUB_3",
      "text": "この席、いっぱいだから。",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.WRATH_MEAL_SNUB_4",
      "text": "そういえば、まだ仕事が残ってた。",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BOUND_BLOCK_UP_1",
      "text": "なんだか……あと一歩、足りない気がする。",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BOUND_BLOCK_UP_2",
      "text": "言いたいことはある。でも、今じゃない。",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BOUND_BLOCK_UP_3",
      "text": "ここまでで十分だ。悪くない。",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BOUND_BLOCK_COUPLE_1",
      "text": "喉まで出かかった言葉を、飲み込んだ……",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BOUND_BLOCK_COUPLE_2",
      "text": "心臓はうるさいのに、声が出ない。",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BOUND_BLOCK_COUPLE_3",
      "text": "たぶん……もう少しだけ待とう。",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BOUND_BLOCK_RIVAL_1",
      "text": "やめとこう……割に合わない。",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BOUND_BLOCK_RIVAL_2",
      "text": "かっとなって、なぜか、すっと引いた。",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BOUND_BLOCK_RIVAL_3",
      "text": "もう二度と会いたくない。……たぶん。",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BOUND_BLOCK_SPLIT_1",
      "text": "喧嘩の途中で、急にどうでもよくなった。",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BOUND_BLOCK_SPLIT_2",
      "text": "きつい言葉は、どちらの口からも出なかった。",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BOUND_BLOCK_SPLIT_3",
      "text": "……なかったことにしよう。",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BOUND_BLOCK_FADE_1",
      "text": "しばらく話してないのに、何も変わらない。",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BOUND_BLOCK_FADE_2",
      "text": "薄れてくれないのも、変な話だ。",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_1",
      "text": "別にお前だけじゃない。ここにいる全員、役立たずだと言ってるんだ。",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_2",
      "text": "下手なら練習しろ。",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_3",
      "text": "これほど恥知らずな奴は見たことがない。",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_4",
      "text": "こっちを見ろ。こっちを見ろって！",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_5",
      "text": "それだけ？それで全部か？",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_6",
      "text": "へえ、俺に仕事を教えてくれるのか？",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_7",
      "text": "問題はお前の方だと考えたことは？",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_8",
      "text": "まだ半分だぞ、もう祝う気か？",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_9",
      "text": "おっ、怒った？怒ったな？",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_10",
      "text": "迷えば負ける。お前は迷った。",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_11",
      "text": "悔しかったら泣けよ。",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_12",
      "text": "さあ、プレッシャーはそっちだ。",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_13",
      "text": "殴られる距離でよく言えたな。",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_14",
      "text": "視野を広げろ。まずその顔からだ。",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_15",
      "text": "道化は俺だったってわけだ、お前を信じた時点で。",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_16",
      "text": "昔は昔、今は今だ。",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_17",
      "text": "最近の若いのは、礼儀ってものがない。",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_18",
      "text": "下がれ。下がれ。下がれっ！",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_19",
      "text": "謝罪はいらない。後から謝る奴が一番嫌いだ。",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BRAWL_TRASH_TALK_20",
      "text": "お前の口は、フィルターなしの排気口より汚い。",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BRAWL_SURRENDER_1",
      "text": "油断した！避けられなかった！",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BRAWL_SURRENDER_2",
      "text": "わかった。わかったって！お前の勝ちだ。",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BRAWL_SURRENDER_3",
      "text": "降参だ！降参！",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BRAWL_SURRENDER_4",
      "text": "やめろ、やめてくれ、俺が悪かった！",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BRAWL_SURRENDER_5",
      "text": "もうやめだ。もうやめ。",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BRAWL_CHEER_1",
      "text": "やった！喧嘩だ！喧嘩だ！",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BRAWL_CHEER_2",
      "text": "誰も止めるな！……ああ、誰も止める気なかったか。",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BRAWL_CHEER_3",
      "text": "やらせておけ！",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BRAWL_CHEER_4",
      "text": "俺は見てるだけ。",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BRAWL_CHEER_5",
      "text": "いけっ！……えっと、両方いけっ！",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BRAWL_CHEER_6",
      "text": "これ、誰か撮ってた方がいいんじゃないか？",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.FAMINE_BUTCHER_1",
      "text": "ごめん……ごめんなさい……",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.FAMINE_BUTCHER_2",
      "text": "こっちを見るな。誰も、見るな。",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.FAMINE_BUTCHER_3",
      "text": "生きなきゃならない。ただ、それだけだ。",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.FAMINE_BUTCHER_4",
      "text": "これは殺しじゃない。生き延びることだ。",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.FAMINE_BUTCHER_5",
      "text": "見ないでくれ。すぐ終わる。",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.FAMINE_BUTCHER_6",
      "text": "お前の名前は、忘れない。",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.FAMINE_BUTCHER_7",
      "text": "誰かがやらなきゃならなかった。",
      "contractRevision": 1,
      "status": "reviewed"
    }
  ]
}
