{
  "locale": "ja",
  "namespace": "social.scene",
  "entries": [
    {
      "key": "STRINGS.SOCIAL.SCENE.CONFESSION_INTRO",
      "text": "大事な話がある。",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.CONFESSION_KEY",
      "text": "好きだ。",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.CONFESSION_REPLY",
      "text": "私もずっと好きだった。",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.CONFESSION_RESULT",
      "text": "じゃあ、一緒に歩いていこう。",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.REKINDLE_INTRO",
      "text": "どうしても、もう一度言っておきたいことがある。",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.REKINDLE_KEY",
      "text": "やり直せるかな？",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.REKINDLE_REPLY",
      "text": "今度は、もう逃さないで。",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.REKINDLE_RESULT",
      "text": "もう一度、互いを知ろう。",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.CONFESSION_FAIL_REPLY",
      "text": "ごめん、答えられない。",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.CONFESSION_FAIL_RESULT",
      "text": "……分かった。",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BREAKUP_KEY",
      "text": "ここまでにしよう。",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.BREAKUP_REPLY",
      "text": "……分かった。",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.RECONCILE_KEY",
      "text": "もう、こんなふうに拗れたままはやめよう。",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.RECONCILE_REPLY",
      "text": "うん、やり直そう。",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.GRIEF_KEY",
      "text": "君のことは忘れない。",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.CHAT_KEY",
      "text": "やあ。",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.RIVAL_KEY",
      "text": "この借りは、そう簡単には済まさない。",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.SCENE.RIVAL_REPLY",
      "text": "ちょうどいい、こっちも和解する気はない。",
      "contractRevision": 1,
      "status": "reviewed"
    }
  ]
}
