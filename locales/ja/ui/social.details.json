    {
      "key": "STRINGS.SOCIAL.DETAILS.TRAITS_LABEL",
      "text": "特性",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.DETAILS.TRAITS_TOOLTIP",
      "text": "一部の特性は社交に影響します。言い争いと殴り合いが減る、教えを請われたときの好感度が増減する、スケジュールが合わないと同室就寝で揉めやすくなる、などです。名前のあとの括弧がその特性の具体的な影響です。",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.DETAILS.TRAIT_EFFECT_SCAREDYCAT",
      "text": "言い争いを嫌う",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.DETAILS.TRAIT_EFFECT_FASTLEARNER",
