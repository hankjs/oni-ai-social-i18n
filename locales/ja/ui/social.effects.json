{
  "locale": "ja",
  "namespace": "social.effects",
  "entries": [
    {
      "key": "STRINGS.SOCIAL.EFFECTS.LOVE.NAME",
      "text": "恋愛中",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.EFFECTS.LOVE.DESC",
      "text": "想い人ができ、士気が上がる。",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.EFFECTS.LOVE_MATURE.NAME",
      "text": "長年の連れ合い",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.EFFECTS.LOVE_MATURE.DESC",
      "text": "長く連れ添い、互いにとっていちばん安心できる存在だ。士気が大きく上がる。",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.EFFECTS.DATE_AFTERGLOW.NAME",
      "text": "デートの余韻",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.EFFECTS.DATE_AFTERGLOW.DESC",
      "text": "楽しいデートを終えたばかりで、士気が上がる。",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.EFFECTS.CANNIBAL.NAME",
      "text": "同僚を食べた",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.EFFECTS.CANNIBAL.DESC",
      "text": "あの食事が誰だったか、心では分かっている。飲み込んだものは、もう吐き出せない。",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.EFFECTS.RIVAL_DIED.NAME",
      "text": "ほくそ笑み",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.EFFECTS.RIVAL_DIED.DESC",
      "text": "目障りだった者がいなくなった。口では言わないが、気分は確かにいい。",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.EFFECTS.GRIEF.NAME",
      "text": "伴侶喪失の悲嘆",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.EFFECTS.GRIEF.DESC",
      "text": "想い人を失い、士気が下がる。",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.EFFECTS.GRIEF_SOFT.NAME",
      "text": "伴侶喪失の悲嘆（そばに人がいる）",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.EFFECTS.GRIEF_SOFT.DESC",
      "text": "想い人を失ったが、コロニーの寄り添いが痛みを和らげている。",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.EFFECTS.COLONY_COHESION.NAME",
      "text": "コロニーの絆",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.EFFECTS.COLONY_COHESION.DESC",
      "text": "コロニーが心をひとつにし、全員の士気が上がる。",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.EFFECTS.COLONY_DISCORD.NAME",
      "text": "コロニーの不和",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.EFFECTS.COLONY_DISCORD.DESC",
      "text": "コロニーの関係が張りつめ、全員の士気が下がる。",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.EFFECTS.SIDE_BY_SIDE.NAME",
      "text": "肩を並べて働く",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.EFFECTS.SIDE_BY_SIDE.DESC",
      "text": "仲のよい相手と一緒に働き、効率が上がる。",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.EFFECTS.STRAINED.NAME",
      "text": "張りつめた気分",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.EFFECTS.STRAINED.DESC",
      "text": "ストレスが限界に迫り、いつ崩れてもおかしくない。誰かと話す、おいしいものを食べる、あるいは少し休ませる。",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.EFFECTS.STRAINED.BUBBLE",
      "text": "深く息を吸って……こらえた",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.EFFECTS.WRATH_ISOLATED.NAME",
      "text": "孤立している",
      "contractRevision": 1,
      "status": "reviewed"
    },
    {
      "key": "STRINGS.SOCIAL.EFFECTS.WRATH_ISOLATED.DESC",
      "text": "コロニーで何かが起き、その人は人望がいちばん底だった——だから帳尻はその人に回された。その人がやったかどうかは関係ない。誰かが世話をしたり、話しかけたり、一緒に食事をしたりすれば、この状態は解ける。もう少し経てば、件自体も忘れ去られる。",
      "contractRevision": 1,
      "status": "reviewed"
    }
  ]
}
